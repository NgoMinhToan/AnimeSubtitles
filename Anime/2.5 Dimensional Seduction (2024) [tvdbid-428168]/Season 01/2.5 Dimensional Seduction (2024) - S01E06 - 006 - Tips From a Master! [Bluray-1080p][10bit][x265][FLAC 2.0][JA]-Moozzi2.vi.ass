Comment: 0,0:23:59.96,0:24:01.96,sign,,0,0,0,,Line
Dialogue: 0,0:00:01.06,0:00:03.82,Default,,0,0,0,,Cậu nghĩ như thế nào về anh ấy vậy?
Dialogue: 0,0:00:04.15,0:00:09.57,Default,,0,0,0,,Ví dụ nghe hơi nồng mùi otaku, nhưng tự nhiên \Ntớ thấy anh ấy giống ngài Ashford ghê luôn.
Dialogue: 0,0:00:09.57,0:00:12.16,Default,,0,0,0,,Như vậy thì có khác gì tình yêu nữa?
Dialogue: 0,0:00:14.95,0:00:19.21,Default,,0,0,0,,Hôm trước, cậu ấy đi sự kiện với anh ấy nhỉ.
Dialogue: 0,0:00:19.92,0:00:24.42,Default,,0,0,0,,Lỡ như Ririsa thích anh ấy thật,\N thì đi chơi riêng như vậy là một dịp quá tốt.
Dialogue: 0,0:00:25.30,0:00:28.30,Default,,0,0,0,,Em ấy nhé, đã yêu đàn anh mất rồi.
Dialogue: 0,0:00:28.30,0:00:29.47,Default,,0,0,0,,Ririsa.
Dialogue: 0,0:00:31.14,0:00:34.93,Default,,0,0,0,,Ầy, chỉ riêng cái cậu Ririsa đó \Nthì không thể nào.
Dialogue: 0,0:00:34.93,0:00:38.52,Default,,0,0,0,,Đừng lo gì hết Mikari, \Ncho dù Ririsa có làm gì đi chăng nữa,
Dialogue: 0,0:00:38.52,0:00:41.19,Default,,0,0,0,,thì mị lực của mình sẽ cưa đổ anh ấy thôi.
Dialogue: 0,0:00:46.23,0:00:47.32,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:00:48.15,0:00:51.53,Default,,0,0,0,,Anh ơi~ em đến chơi nè...
Dialogue: 0,0:02:33.01,0:02:35.47,Default,,0,0,0,,Tưởng gì, hóa ra là Ririsa.
Dialogue: 0,0:02:35.47,0:02:37.47,Default,,0,0,0,,Ít nhất cũng phải khóa cửa lại chứ.
Dialogue: 0,0:02:37.47,0:02:40.52,Default,,0,0,0,,Mikari ơi! Hôm trước cảm ơn cậu rất nhiều.
Dialogue: 0,0:02:40.52,0:02:42.56,Default,,0,0,0,,Bộ đồ Tây này tớ đã giặt sạch sẽ...
Dialogue: 0,0:02:42.56,0:02:44.02,Default,,0,0,0,,Đủ rồi, mau mặc đồ vào đi!
Dialogue: 0,0:02:44.02,0:02:44.94,Default,,0,0,0,,A, vâng!
Dialogue: 0,0:02:44.94,0:02:49.69,Default,,0,0,0,,À, quan trọng hơn là hai người thế nào rồi?\N Đừng nói là cậu tiến triển tốt với anh ấy lắm nha?
Dialogue: 0,0:02:50.94,0:02:53.36,Default,,0,0,0,,Đi sự kiện thì vui lắm...
Dialogue: 0,0:02:53.90,0:02:58.28,Default,,0,0,0,,Nhưng từ khi được Mikari hỏi \Ncảm thấy như thế nào về đàn anh,
Dialogue: 0,0:02:58.28,0:03:00.08,Default,,0,0,0,,thì tớ cứ suy tư mãi.
Dialogue: 0,0:03:01.79,0:03:06.87,Default,,0,0,0,,{Với tư cách là anh phó nháy luôn hỗ trợ cho tớ\N trong việc cosplay và là người đồng đội đáng tin cậy,}Rồi tớ nhận ra mình rất thích đàn anh với tư cách\N là anh phó nháy luôn hỗ trợ cho tớ khi cosplay,
Dialogue: 0,0:03:06.87,0:03:09.00,Default,,0,0,0,,{tớ nhận ra là mình rất thích đàn anh!}và với tư cách là người đồng đội đáng tin cậy.
Dialogue: 0,0:03:09.34,0:03:12.46,Default,,0,0,0,,À há, hiểu luôn, hóa ra có một cô ngốc ở đây.
Dialogue: 0,0:03:13.01,0:03:15.05,Default,,0,0,0,,Tóm lại là không có tiến triển.
Dialogue: 0,0:03:15.05,0:03:19.80,Default,,0,0,0,,Cái anh kia đang mê đắm Liliel thì không nói đi,\N nhưng may mà Ririsa cũng ngáo ngơ.
Dialogue: 0,0:03:20.26,0:03:23.18,Default,,0,0,0,,Tức là mình vẫn còn nhiều cơ hội.
Dialogue: 0,0:03:25.18,0:03:26.81,Default,,0,0,0,,Thế rồi anh ấy đâu?
Dialogue: 0,0:03:26.81,0:03:29.86,Default,,0,0,0,,À, năm hai có bài kiểm tra \Nnên xem ra anh ấy sẽ đến hơi trễ.
Dialogue: 0,0:03:29.86,0:03:34.28,Default,,0,0,0,,Còn tớ đang định thay đồ trước \Ncho buổi chụp hình hôm nay.
Dialogue: 0,0:03:34.28,0:03:35.15,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:03:35.82,0:03:40.28,Default,,0,0,0,,Trò Amano Ririsa năm nhất lớp một,\N hãy mau quay lại lớp học!
Dialogue: 0,0:03:40.28,0:03:42.70,Default,,0,0,0,,Á, tớ quên mất buổi học phụ đạo rồi.
Dialogue: 0,0:03:43.20,0:03:45.91,Default,,0,0,0,,Ai bảo cậu ngủ mê man hết các tiết học làm gì.
Dialogue: 0,0:03:46.16,0:03:48.46,Default,,0,0,0,,Mikari này, đồ đạc của tớ...
Dialogue: 0,0:03:48.46,0:03:49.92,Default,,0,0,0,,Nhờ cậu trông đồ giúp tớ nhé.
Dialogue: 0,0:03:49.92,0:03:50.59,Default,,0,0,0,,Hả?
Dialogue: 0,0:03:50.59,0:03:51.79,Default,,0,0,0,,Cảm ơn cậu rất nhiều!
Dialogue: 0,0:03:51.79,0:03:53.55,Default,,0,0,0,,Tôi vẫn chưa đồng ý mà!
Dialogue: 0,0:04:00.64,0:04:02.89,Default,,0,0,0,,Mình có rảnh đến thế đâu chứ.
Dialogue: 0,0:04:06.77,0:04:09.31,Default,,0,0,0,,Từ dãy câu lạc bộ đến dãy lớp học xa quá.
Dialogue: 0,0:04:11.48,0:04:13.40,Default,,0,0,0,,Ối, coi chừng!
Dialogue: 0,0:04:18.74,0:04:21.41,Default,,0,0,0,,E-Em xin lỗi.
Dialogue: 0,0:04:21.41,0:04:25.12,Default,,0,0,0,,Em có bị thương không?\N Không được phép chạy trên hành lang đâu nhé.
Dialogue: 0,0:04:25.12,0:04:27.62,Default,,0,0,0,,Con gái mà bị bầm thì biết phải làm sao?
Dialogue: 0,0:04:28.29,0:04:31.42,Default,,0,0,0,,Vâng, em xin lỗi cô.\N Em xin phép đi trước ạ.
Dialogue: 0,0:04:32.79,0:04:36.30,Default,,0,0,0,,C-Cô ấy đẹp quá.
Dialogue: 0,0:04:40.97,0:04:44.68,Default,,0,0,0,,Xin lỗi Ririsa, mất nhiều thời gian hơn tôi tưởng...
Dialogue: 0,0:04:45.56,0:04:47.27,Default,,0,0,0,,H-Hiểu lầm rồi anh ơi.
Dialogue: 0,0:04:47.27,0:04:50.77,Default,,0,0,0,,Chẳng qua là em muốn hiểu hơn\N về sở thích của anh,
Dialogue: 0,0:04:50.77,0:04:54.23,Default,,0,0,0,,nên nghĩ là nếu em hóa thân thành Liliel \Nthì sẽ hiểu ra được gì đó...
Dialogue: 0,0:04:55.40,0:04:58.11,Default,,0,0,0,,N-Nếu em cũng có thể trở thành Liliel,
Dialogue: 0,0:04:58.11,0:05:01.95,Default,,0,0,0,,thì biết đâu sẽ thân thiết hơn\N với anh giống như Ririsa.
Dialogue: 0,0:05:01.95,0:05:06.24,Default,,0,0,0,,Em thay ra ngay đây,\N em cũng biết mình không hợp với bộ này.
Dialogue: 0,0:05:08.29,0:05:09.04,Default,,0,0,0,,Đâu có.
Dialogue: 0,0:05:09.66,0:05:11.67,Default,,0,0,0,,Anh thấy... à thì...
Dialogue: 0,0:05:11.67,0:05:13.38,Default,,0,0,0,,Có tác dụng!
Dialogue: 0,0:05:13.38,0:05:15.63,Default,,0,0,0,,Miễn là Liliel thì ai hóa trang cũng được hả?
Dialogue: 0,0:05:15.63,0:05:18.71,Default,,0,0,0,,Mà khoan, đây cũng là bằng chứng cho thấy
Dialogue: 0,0:05:18.71,0:05:21.88,Default,,0,0,0,,anh ấy chỉ chết mê chết mệt vì Liliel thôi \Nchứ không hẳn là yêu Ririsa.
Dialogue: 0,0:05:21.88,0:05:23.76,Default,,0,0,0,,Nói chung,
Dialogue: 0,0:05:24.10,0:05:26.14,Default,,0,0,0,,đây là cơ hội của mình!
Dialogue: 0,0:05:27.35,0:05:29.85,Default,,0,0,0,,Ngài Ashford~
Dialogue: 0,0:05:33.60,0:05:37.02,Default,,0,0,0,,Liliel lao vào lòng mình...
Dialogue: 0,0:05:37.02,0:05:40.78,Default,,0,0,0,,Cái quái gì đây? \NKích thích mãnh liệt quá.
Dialogue: 0,0:05:40.78,0:05:41.99,Default,,0,0,0,,Lý trí của mình...
Dialogue: 0,0:05:43.74,0:05:49.50,Default,,0,0,0,,Ngài Ashford ơi, \Nhôm nay Liliel hơi khác với mọi khi...
Dialogue: 0,0:05:51.29,0:05:55.42,Default,,0,0,0,,nên là ngài thích làm gì em cũng được hết.
Dialogue: 0,0:05:55.92,0:05:57.88,Default,,0,0,0,,L-Làm gì cũng được!!
Dialogue: 0,0:05:58.80,0:05:59.59,Default,,0,0,0,,Nào~
Dialogue: 0,0:06:00.51,0:06:04.26,Default,,0,0,0,,Ngài muốn chạm vào đâu của em ạ?
Dialogue: 0,0:06:04.76,0:06:08.22,Default,,0,0,0,,Muốn chạm vào đâu ư!?
Dialogue: 0,0:06:08.76,0:06:13.19,Default,,0,0,0,,Thế nào hả anh? Không kháng cự được\N nét quyến rũ của Liliel chứ gì?
Dialogue: 0,0:06:15.65,0:06:16.94,Default,,0,0,0,,Không được đâu.
Dialogue: 0,0:06:17.73,0:06:18.86,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:06:18.86,0:06:23.32,Default,,0,0,0,,Quả thật Liliel là waifu của anh,\N nhưng waifu thì không chỉ thuộc về riêng mình anh.
Dialogue: 0,0:06:23.32,0:06:25.62,Default,,0,0,0,,Nên không thể nhẹ dạ mà đi quá giới hạn được.
Dialogue: 0,0:06:26.07,0:06:27.95,Default,,0,0,0,,Thất bại rồi sao...
Dialogue: 0,0:06:29.33,0:06:31.41,Default,,0,0,0,,Đành chịu thôi.
Dialogue: 0,0:06:31.41,0:06:36.63,Default,,0,0,0,,Dẫu sao mình đã yêu anh ấy vì nét tinh tế\N cũng như chung tình đến mức ngốc nghếch đó mà.
Dialogue: 0,0:06:36.63,0:06:37.84,Default,,0,0,0,,Có điều...
Dialogue: 0,0:06:38.21,0:06:42.30,Default,,0,0,0,,mình vẫn mong cảm xúc của anh ấy\N hướng về phía mình nhiều hơn.
Dialogue: 0,0:06:43.30,0:06:47.01,Default,,0,0,0,,Em xin lỗi đã đến trễ,\N tụi mình mau chụp hình...
Dialogue: 0,0:06:49.51,0:06:51.47,Default,,0,0,0,,K-Không phải đâu, Ririsa.
Dialogue: 0,0:06:51.47,0:06:54.35,Default,,0,0,0,,Hiểu lầm rồi, Ririsa, chuyện này...
Dialogue: 0,0:07:02.03,0:07:04.61,Default,,0,0,0,,Đây là lần đầu tiên tớ được tận mắt \Nngắm nhìn Liliel thế này.
Dialogue: 0,0:07:04.61,0:07:05.95,Default,,0,0,0,,Đáng yêu quá! Thiên thần!
Dialogue: 0,0:07:05.95,0:07:09.95,Default,,0,0,0,,Đ-Đừng có trêu tôi nữa.\N Tôi tự biết là không hợp với mình rồi.
Dialogue: 0,0:07:09.95,0:07:12.50,Default,,0,0,0,,Như thế này chẳng giống Liliel chút nào.
Dialogue: 0,0:07:12.50,0:07:14.41,Default,,0,0,0,,Phần ngực cũng không đầy đặn nữa.
Dialogue: 0,0:07:14.41,0:07:16.37,Default,,0,0,0,,- Cậu nói sai rồi.\N- Ể?
Dialogue: 0,0:07:16.37,0:07:23.05,Default,,0,0,0,,Quả thật tớ từng nói Mikari hợp với Miliella hơn, \Nnhưng chưa từng nghĩ rằng cậu không hợp với Liliel.
Dialogue: 0,0:07:23.05,0:07:25.01,Default,,0,0,0,,Cậu muốn hóa thân thành ai cũng được.
Dialogue: 0,0:07:25.01,0:07:28.34,Default,,0,0,0,,Bất cứ ai cũng có thể trở thành nhân vật mình thích\N chính là điểm hấp dẫn của cosplay.
Dialogue: 0,0:07:28.84,0:07:30.55,Default,,0,0,0,,Hóa thân thành ai cũng được...
Dialogue: 0,0:07:30.55,0:07:32.81,Default,,0,0,0,,Anh cũng nghĩ giống vậy đấy, Mikari.
Dialogue: 0,0:07:33.18,0:07:36.77,Default,,0,0,0,,Trong fanart làm gì có phân biệt đúng sai.\N Cho dù không đẹp cũng được mà.
Dialogue: 0,0:07:37.35,0:07:41.61,Default,,0,0,0,,Anh chỉ cần cảm nhận được tình cảm \N từ người muốn trao đi cảm xúc của họ,
Dialogue: 0,0:07:41.61,0:07:43.98,Default,,0,0,0,,như vậy là đã đủ hạnh phúc rồi.
Dialogue: 0,0:07:45.07,0:07:47.86,Default,,0,0,0,,Ririsa, anh...
Dialogue: 0,0:07:48.86,0:07:50.99,Default,,0,0,0,,Hai người này quá trong sáng.
Dialogue: 0,0:07:53.45,0:07:56.79,Default,,0,0,0,,Sẵn tiện cho hỏi \Nquần lót dưới này là loại nào thế?
Dialogue: 0,0:07:57.42,0:07:59.54,Default,,0,0,0,,Oa, vẫn là quần lót đời thực nhỉ?
Dialogue: 0,0:07:59.54,0:08:01.00,Default,,0,0,0,,Ừ thì quần lót của tôi đấy!
Dialogue: 0,0:08:01.00,0:08:02.34,Default,,0,0,0,,Cho tớ soi thêm chút đi.
Dialogue: 0,0:08:02.34,0:08:03.80,Default,,0,0,0,,Đừng lại đây, tha cho tôi đi.
Dialogue: 0,0:08:03.80,0:08:06.80,Default,,0,0,0,,Tôi không hóa thân \Nthành Liliel thêm lần nào nữa đâu!
Dialogue: 0,0:08:10.09,0:08:12.56,Default,,0,0,0,,Cậu Okumura, bên này.
Dialogue: 0,0:08:12.56,0:08:13.64,Default,,0,0,0,,Anh Ogino.
Dialogue: 0,0:08:13.97,0:08:18.44,Default,,0,0,0,,H-Hôm nay mong được anh chỉ giáo.\N Thật xin lỗi vì đột ngột liên lạc.
Dialogue: 0,0:08:18.44,0:08:19.35,Default,,0,0,0,,Có gì đâu.
Dialogue: 0,0:08:19.94,0:08:24.36,Default,,0,0,0,,Tôi nghĩ bản thân mình cũng cần\N phải làm gì đó để chuẩn bị cho sự kiện tiếp theo.
Dialogue: 0,0:08:24.36,0:08:26.82,Default,,0,0,0,,Nên muốn nhờ anh dạy thêm về chụp hình.
Dialogue: 0,0:08:26.82,0:08:28.07,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:08:28.07,0:08:32.91,Default,,0,0,0,,Thái độ tích cực thỉnh giáo đàn anh thế này\N đúng là một chàng trai trẻ đầy triển vọng.
Dialogue: 0,0:08:32.91,0:08:37.33,Default,,0,0,0,,Chắc chọn tôi là vì thấy tôi tỏa ra\N phong thái của một tay chụp lão luyện chứ gì.
Dialogue: 0,0:08:37.33,0:08:38.79,Default,,0,0,0,,Thật hết cách mà.
Dialogue: 0,0:08:38.79,0:08:42.63,Default,,0,0,0,,Làm sao mình dám mở miệng nói\N"Vì anh là người duy nhất tôi quen" được.
Dialogue: 0,0:08:42.63,0:08:44.04,Default,,0,0,0,,Thế thì xuất phát thôi.
Dialogue: 0,0:08:45.21,0:08:47.51,Default,,0,0,0,,M-Mong được anh chiếu cố.
Dialogue: 0,0:08:48.59,0:08:51.22,Default,,0,0,0,,Về cơ bản thì ảnh vẫn là người tốt nhỉ.
Dialogue: 0,0:08:52.60,0:08:56.10,Default,,0,0,0,,Hôm nay sẽ diện trang phục Nhật,\N nên tôi đã thuê studio là phòng kiểu Nhật luôn.
Dialogue: 0,0:08:57.31,0:09:01.35,Default,,0,0,0,,Nếu có phông nền hợp với nhân vật,\N thì độ hoàn thiện của tấm hình cũng khác hẳn.
Dialogue: 0,0:09:01.35,0:09:02.98,Default,,0,0,0,,T-Tuyệt quá.
Dialogue: 0,0:09:02.98,0:09:06.19,Default,,0,0,0,,Nếu muốn tạo được ROM bán chạy\N thì nhất thiết phải thuê studio chụp ảnh.
Dialogue: 0,0:09:07.03,0:09:11.82,Default,,0,0,0,,Dạo này, thị trường cosplay ngày càng lớn mạnh,\Nnên cũng có nhiều studio để thuê hơn.
Dialogue: 0,0:09:11.82,0:09:14.24,Default,,0,0,0,,Vào ngày thường thì giá cũng rẻ hơn nữa.
Dialogue: 0,0:09:15.41,0:09:18.79,Default,,0,0,0,,Ogino, xem giúp tôi \Nthắt lưng phía sau có bị tụt ra không?
Dialogue: 0,0:09:18.79,0:09:22.79,Default,,0,0,0,,Trang phục này may đẹp nhưng đến khi mặc vào \Nthì không với tay ra sau được nữa.
Dialogue: 0,0:09:22.79,0:09:24.17,Default,,0,0,0,,Tôi tới ngay!
Dialogue: 0,0:09:24.17,0:09:28.46,Default,,0,0,0,,Forosso trong trang phục kĩ nữ đỉnh quá!\N Lại là bản cosplay mới nhất nữa.
Dialogue: 0,0:09:29.42,0:09:31.59,Default,,0,0,0,,A, nhóc là Okumura nhỉ?
Dialogue: 0,0:09:31.59,0:09:33.34,Default,,0,0,0,,Xin chào, hôm nay giúp đỡ nhau nhé.
Dialogue: 0,0:09:33.34,0:09:36.31,Default,,0,0,0,,E-Em xin lỗi vì đã làm phiền ạ.
Dialogue: 0,0:09:36.31,0:09:39.73,Default,,0,0,0,,Không sao, không sao, \Ncó người trẻ ở đây dễ bùng cháy hơn.
Dialogue: 0,0:09:39.73,0:09:42.23,Default,,0,0,0,,Cô Magino cũng mới là sinh viên thôi mà.
Dialogue: 0,0:09:43.65,0:09:45.65,Default,,0,0,0,,V-Vậy thì chúng ta bắt đầu thôi.
Dialogue: 0,0:09:45.98,0:09:49.86,Default,,0,0,0,,Trước hết, điều cơ bản nhất trong số \Ncác điều cơ bản là "thời điểm" và "lấy nét".
Dialogue: 0,0:09:50.19,0:09:55.74,Default,,0,0,0,,Vì một số tấm nếu không chụp được biểu cảm \Nhay bị mất nét thì dù chỉnh sửa cũng không cứu vãn nổi.
Dialogue: 0,0:09:55.74,0:10:00.20,Default,,0,0,0,,Và lời khuyên của tôi là cậu nên xây dựng\N ý tưởng cho từng tấm hình mình chụp.
Dialogue: 0,0:10:00.20,0:10:01.33,Default,,0,0,0,,Ý tưởng...
Dialogue: 0,0:10:01.33,0:10:04.50,Default,,0,0,0,,Tức là không chỉ chụp mặt \Nhay toàn thân không thôi,
Dialogue: 0,0:10:04.50,0:10:09.09,Default,,0,0,0,,mà phải chú ý thêm lúc này bản thân muốn chụp\N ở góc độ nào và muốn thể hiện tấm hình ra sao.
Dialogue: 0,0:10:09.09,0:10:12.84,Default,,0,0,0,,{Thời điểm mà cosplayer thể hiện\N biểu cảm hoặc kiểu dáng nào đó,} Nhiệm vụ của chúng ta là \N căn thời điểm bấm máy thật chuẩn xác
Dialogue: 0,0:10:12.84,0:10:17.39,Default,,0,0,0,,{thì nhiệm vụ của chúng ta là phải canh thời gian nhấn} để có thể bắt trọn được những khoảnh khắc \Ncosplayer tạo dáng và biểu cảm mà họ muốn.
Dialogue: 0,0:10:18.60,0:10:19.47,Default,,0,0,0,,Triển thôi!
Dialogue: 0,0:10:19.47,0:10:20.72,Default,,0,0,0,,Ok!
Dialogue: 0,0:10:23.23,0:10:27.57,Default,,0,0,0,,Đầu tiên, cậu cứ chụp theo cách mà cậu nghĩ\N là đã căn thời điểm chuẩn nhất thử xem.
Dialogue: 0,0:10:27.57,0:10:28.65,Default,,0,0,0,,V-Vâng.
Dialogue: 0,0:10:34.82,0:10:35.91,Default,,0,0,0,,Hưm.
Dialogue: 0,0:10:35.91,0:10:37.12,Default,,0,0,0,,Tấm chiếu mới.
Dialogue: 0,0:10:38.99,0:10:42.96,Default,,0,0,0,,Không được, mình đã chủ động nhờ vả\N thì không được hậm hực.
Dialogue: 0,0:10:42.96,0:10:45.54,Default,,0,0,0,,Cậu thử so sánh với những tấm tôi chụp đi.
Dialogue: 0,0:10:45.54,0:10:46.13,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:47.59,0:10:51.09,Default,,0,0,0,,Liệu cậu có nhận ra tấm của tôi \Ncanh thời điểm chuẩn hơn thế nào không?
Dialogue: 0,0:10:51.09,0:10:53.09,Default,,0,0,0,,Mỗi người chụp mỗi khác.
Dialogue: 0,0:10:53.38,0:10:55.76,Default,,0,0,0,,{Tấm hình phải do một đôi phối hợp tạo ra.}Một tấm hình phải đến từ sự phối hợp của đôi bên.
Dialogue: 0,0:10:55.76,0:10:57.18,Default,,0,0,0,,V-Vâng.
Dialogue: 0,0:10:59.18,0:11:00.14,Default,,0,0,0,,Cậu Okumura.
Dialogue: 0,0:11:00.81,0:11:03.35,Default,,0,0,0,,Tập trung vào nhịp thở của cô Magino.
Dialogue: 0,0:11:03.35,0:11:04.60,Default,,0,0,0,,Vâng!
Dialogue: 0,0:11:05.14,0:11:10.11,Default,,0,0,0,,Hãy trau chuốt hơn vào cách tạo điểm nhấn,\N cảm nhận hơi thở của sự sống!
Dialogue: 0,0:11:10.11,0:11:11.53,Default,,0,0,0,,Đâu nào, chị xem với.
Dialogue: 0,0:11:11.53,0:11:15.20,Default,,0,0,0,,Ồ, đẹp mà, chụp nghệ đấy,\N em cũng có khiếu lắm nha.
Dialogue: 0,0:11:15.20,0:11:17.74,Default,,0,0,0,,X-Xem ra cậu tiếp thu cũng nhanh đó.
Dialogue: 0,0:11:17.74,0:11:20.45,Default,,0,0,0,,Hay là do tôi hướng dẫn giỏi quá chăng?
Dialogue: 0,0:11:20.45,0:11:22.75,Default,,0,0,0,,Không khác với hình Ogino chụp là mấy đâu.
Dialogue: 0,0:11:22.75,0:11:25.54,Default,,0,0,0,,À, chị muốn dùng mấy tấm này\N để làm ROM nên gửi qua cho chị đi.
Dialogue: 0,0:11:25.54,0:11:26.75,Default,,0,0,0,,A, vâng.
Dialogue: 0,0:11:27.58,0:11:31.88,Default,,0,0,0,,Giờ thì... chúng ta chuyển sang chụp \Nmấy kiểu khiêu gợi chút, chú em ổn không?
Dialogue: 0,0:11:31.88,0:11:36.43,Default,,0,0,0,,Ế! À, em ổn ạ.\N Ngược lại, chị có ổn không?
Dialogue: 0,0:11:36.43,0:11:39.05,Default,,0,0,0,,Quá ổn là đằng khác, \Nchớ xịt máu mũi đấy nhá.
Dialogue: 0,0:11:47.81,0:11:49.19,Default,,0,0,0,,Bị làm sao vậy?
Dialogue: 0,0:11:49.69,0:11:54.23,Default,,0,0,0,,Q-Quả nhiên, chụp mấy kiểu này \Ntôi thấy không được thoải mái cho lắm.
Dialogue: 0,0:11:54.23,0:11:58.16,Default,,0,0,0,,Nếu tôi là anh, tôi sẽ không thích \Nđể cho người khác làm vậy.
Dialogue: 0,0:11:58.78,0:12:02.91,Default,,0,0,0,,Không hẳn là tôi không hiểu điều cậu muốn nói.
Dialogue: 0,0:12:02.91,0:12:06.12,Default,,0,0,0,,Nhưng đối với cosplayer, \Nđược người khác ngắm nhìn là một niềm vui.
Dialogue: 0,0:12:06.12,0:12:08.37,Default,,0,0,0,,Còn phó nháy là người hỗ trợ.
Dialogue: 0,0:12:08.37,0:12:11.00,Default,,0,0,0,,Nên không cần cảm thấy cắn rứt lương tâm đâu.
Dialogue: 0,0:12:11.00,0:12:17.05,Default,,0,0,0,,Lẽ nào Okumura thích bé Liliel hả? \NNếu đúng vậy thì tâm trạng rối bời thật ha.
Dialogue: 0,0:12:17.05,0:12:18.76,Default,,0,0,0,,Ấy không, nhầm rồi ạ.
Dialogue: 0,0:12:18.76,0:12:21.76,Default,,0,0,0,,Em thấy cách nghĩ của anh Ogino \Nlà hợp lí nhất rồi, chẳng qua...
Dialogue: 0,0:12:21.76,0:12:25.06,Default,,0,0,0,,em cũng không hiểu tại sao\N bản thân lại cảm thấy như vậy thôi.
Dialogue: 0,0:12:27.35,0:12:28.52,Default,,0,0,0,,Cãi lộn với nhau đi.
Dialogue: 0,0:12:28.52,0:12:32.48,Default,,0,0,0,,Nếu hai đứa cùng làm mà cứ bị lấn cấn\N trong lòng không chịu nói ra là phạm luật đó.
Dialogue: 0,0:12:32.48,0:12:36.69,Default,,0,0,0,,Khi gặp phải chuyện khó chịu \Nthì phải thẳng thắn nói ra rồi gây nhau một trận.
Dialogue: 0,0:12:36.69,0:12:38.70,Default,,0,0,0,,Đó chính là mẹo để duy trì mối quan hệ lâu dài.
Dialogue: 0,0:12:39.78,0:12:41.16,Default,,0,0,0,,V-Vâng.
Dialogue: 0,0:12:41.70,0:12:46.37,Default,,0,0,0,,Em thật sự xin lỗi. Chỉ mới gặp mặt một lần\N mà đã đối tốt với em như vậy...
Dialogue: 0,0:12:46.75,0:12:51.08,Default,,0,0,0,,Trời, nhóc Okumura này khách sáo quá,\N đừng nói mấy câu như "chỉ mới gặp một lần" chứ.
Dialogue: 0,0:12:51.63,0:12:56.80,Default,,0,0,0,,Cạnh gian hàng nhau trong sự kiện\N cũng giống như đã trở thành bạn rồi còn gì nữa.
Dialogue: 0,0:12:56.80,0:12:57.84,Default,,0,0,0,,Nhé?
Dialogue: 0,0:12:57.84,0:13:00.01,Default,,0,0,0,,N-Như vậy cũng được thật ạ?
Dialogue: 0,0:13:00.01,0:13:02.30,Default,,0,0,0,,Tất nhiên rồi, cậu Okumura.
Dialogue: 0,0:13:02.30,0:13:04.68,Default,,0,0,0,,Tôi cũng rất biết ơn hai người đấy.
Dialogue: 0,0:13:05.72,0:13:10.19,Default,,0,0,0,,Thật sự không thể đếm xuể \Nniềm phấn khích mà Liliel đã mang lại cho tôi.
Dialogue: 0,0:13:10.77,0:13:15.90,Default,,0,0,0,,Và điều mà các phó nháy chúng ta luôn \Nbận tâm đến chính là ai sẽ xuất hiện tiếp theo.
Dialogue: 0,0:13:16.23,0:13:17.40,Default,,0,0,0,,Tiếp theo?
Dialogue: 0,0:13:17.40,0:13:20.15,Default,,0,0,0,,Cậu Okumura có biết chuyện này không nhỉ?
Dialogue: 0,0:13:20.65,0:13:23.57,Default,,0,0,0,,Hiện tại có bốn người \Nđứng đầu trong giới cosplay.
Dialogue: 0,0:13:24.24,0:13:25.70,Default,,0,0,0,,Chính là tứ thiên vương cosplay!
Dialogue: 0,0:13:25.70,0:13:27.66,Default,,0,0,0,,Tứ thiên vương cosplay!?
Dialogue: 0,0:13:27.95,0:13:32.08,Default,,0,0,0,,Người luôn giữ cho vóc dáng đúng với\N tỉ lệ cơ thể của nhân vật trong mỗi sự kiện.
Dialogue: 0,0:13:32.08,0:13:35.13,Default,,0,0,0,,mĩ nữ lạnh lùng theo chủ nghĩa khắc kỷ, \NAwayuki Erika.
Dialogue: 0,0:13:35.84,0:13:39.72,Default,,0,0,0,,Người được biết đến với những kiểu trang điểm\N và trang phục đẹp nhất thế giới,
Dialogue: 0,0:13:39.72,0:13:42.59,Default,,0,0,0,,đã vậy còn được công ti lớn hậu thuẫn,\N mĩ nhân đáng yêu vô đối 753 (Nagomi).
Dialogue: 0,0:13:43.14,0:13:45.55,Default,,0,0,0,,Người cuồng quần tất đến mức biến thái,
Dialogue: 0,0:13:45.55,0:13:49.18,Default,,0,0,0,,trở thành cơn sốt trên SNS \Nvới lượng fan cuồng đông đảo,
Dialogue: 0,0:13:49.18,0:13:52.44,Default,,0,0,0,,mĩ nhân có sở thích tà đạo, Hoshizuki Yoki.
Dialogue: 0,0:13:53.06,0:13:55.40,Default,,0,0,0,,Cuối cùng, người sở hữu thân hình bốc lửa,
Dialogue: 0,0:13:55.40,0:14:01.03,Default,,0,0,0,,với tình yêu dành cho nhân vật không bao giờ lung lay,\N và đã trở thành huyền thoại, mĩ nhân quyến rũ Mayura.
Dialogue: 0,0:14:01.36,0:14:04.16,Default,,0,0,0,,Bốn người họ đều được xưng tụng là tứ thiên vương.
Dialogue: 0,0:14:06.28,0:14:10.12,Default,,0,0,0,,À thì, cosplayer siêu đẳng \Nắt hẳn phải có trên năm người ấy chứ,
Dialogue: 0,0:14:10.12,0:14:13.58,Default,,0,0,0,,ngặt nỗi otaku thì thích mấy biệt danh như\N "Ba chàng lính ngự lâm" hay "Tứ thiên vương" cơ.
Dialogue: 0,0:14:14.96,0:14:17.67,Default,,0,0,0,,Ủa? Nhưng chẳng phải cô Mayura đã...
Dialogue: 0,0:14:17.96,0:14:21.01,Default,,0,0,0,,Ồ, xem ra cậu cũng nắm bắt \Nthông tin mới nhất nhỉ.
Dialogue: 0,0:14:21.34,0:14:26.39,Default,,0,0,0,,Phải, từ Natsu-comi năm ngoái trở đi,\N cô Mayura đã không xuất hiện trên vũ đài nữa.
Dialogue: 0,0:14:26.39,0:14:28.93,Default,,0,0,0,,Cũng không có cập nhật gì mới trên SNS luôn.
Dialogue: 0,0:14:28.93,0:14:33.85,Default,,0,0,0,,Theo đó, chủ đề nóng nhất trong giới cosplay \Nhiện tại chính là tứ thiên vương tiếp theo.
Dialogue: 0,0:14:33.85,0:14:35.94,Default,,0,0,0,,Ai sẽ là người kế thừa cho cô Mayura.
Dialogue: 0,0:14:36.81,0:14:38.40,Default,,0,0,0,,Và người xuất hiện ngay thời điểm đó...
Dialogue: 0,0:14:39.27,0:14:41.44,Default,,0,0,0,,Chính là Liliel.
Dialogue: 0,0:14:41.44,0:14:44.28,Default,,0,0,0,,Ấn tượng khi lần đầu nhìn thấy cô Mayura...
Dialogue: 0,0:14:44.28,0:14:47.91,Default,,0,0,0,,Chắc chắn ngay tại đó, \Nkhông chỉ có mình tôi là nhớ lại cảm xúc ấy đâu.
Dialogue: 0,0:14:48.24,0:14:50.24,Default,,0,0,0,,R-Ririsa ư?
Dialogue: 0,0:14:50.24,0:14:51.12,Default,,0,0,0,,Cho nên...
Dialogue: 0,0:14:51.58,0:14:55.67,Default,,0,0,0,,Hôm nay tôi chỉ đơn giản\N là "nối giáo cho giặc" mà thôi.
Dialogue: 0,0:14:55.67,0:14:59.59,Default,,0,0,0,,Vì nếu cộng sự của đối thủ hoàn toàn\N là tấm chiếu mới thì còn gì là thú vị nữa.
Dialogue: 0,0:15:00.84,0:15:06.30,Default,,0,0,0,,Tôi đây luôn ấp ủ ý định đưa cô Magino\Nvươn tới đỉnh cao trong giới cosplay này.
Dialogue: 0,0:15:06.30,0:15:09.30,Default,,0,0,0,,Vậy còn cậu Okumura thì sao?
Dialogue: 0,0:15:13.23,0:15:16.85,Default,,0,0,0,,Tôi thì chẳng có ý định đứng top hay gì đâu.
Dialogue: 0,0:15:17.90,0:15:23.44,Default,,0,0,0,,Nhưng, nếu anh đã có nhã ý dẫn lối,\N hay là tôi cũng đu theo luôn nhỉ?
Dialogue: 0,0:15:25.40,0:15:28.49,Default,,0,0,0,,Một tấm hình phải đến từ sự phối hợp của đôi bên.
Dialogue: 0,0:15:28.49,0:15:30.99,Default,,0,0,0,,Hai đứa dẫn nhau tiến lên.
Dialogue: 0,0:15:31.87,0:15:33.45,Default,,0,0,0,,Anh Okumura.
Dialogue: 0,0:15:33.45,0:15:35.50,Default,,0,0,0,,Đi thôi, Ririsa.
Dialogue: 0,0:15:36.79,0:15:42.00,Default,,0,0,0,,Thật ra, khi được gọi là đối tác hay cộng sự,\N em cảm thấy không phù hợp với mình cho lắm.
Dialogue: 0,0:15:42.00,0:15:44.46,Default,,0,0,0,,Vì dẫu sao, nhân vật chính ở đây vẫn là Ririsa.
Dialogue: 0,0:15:44.97,0:15:49.14,Default,,0,0,0,,Nhưng hóa ra em đã quá non nớt,\N đây là việc cần sự phối hợp giữa hai người.
Dialogue: 0,0:15:50.97,0:15:53.89,Default,,0,0,0,,Em đã hứa sẽ hỗ trợ đến phút cuối cùng,
Dialogue: 0,0:15:54.68,0:15:58.23,Default,,0,0,0,,nên nếu Ririsa muốn,\N thì em cũng sẽ dẫn em ấy đi.
Dialogue: 0,0:16:03.11,0:16:05.61,Default,,0,0,0,,Ririsa là tên thật của em ấy hả?
Dialogue: 0,0:16:06.32,0:16:09.41,Default,,0,0,0,,Tuyệt quá, cứ như cái tên được đặt \Nđể trở thành Liliel luôn vậy.
Dialogue: 0,0:16:09.41,0:16:14.08,Default,,0,0,0,,Thật không ngờ. \NCậu yên tâm, chúng tôi sẽ giữ bí mật giúp cho.
Dialogue: 0,0:16:14.08,0:16:17.96,Default,,0,0,0,,Thay vào đó, nhất định phải dẫn em ấy\N đến sự kiện tiếp theo đấy nhé.
Dialogue: 0,0:16:17.96,0:16:19.08,Default,,0,0,0,,Tụi chị chờ nhé.
Dialogue: 0,0:16:19.58,0:16:20.75,Default,,0,0,0,,Vâng!
Dialogue: 0,0:16:26.55,0:16:28.38,Default,,0,0,0,,Ừm, nội dung cuộc họp hôm nay
Dialogue: 0,0:16:28.38,0:16:32.80,Default,,0,0,0,,là về việc xúc tiến cho hội nghiên cứu \Nbể thủy sinh lên thành câu lạc bộ.
Dialogue: 0,0:16:32.80,0:16:37.48,Default,,0,0,0,,Hội có sáu thành viên \Nvà thầy Igarashi sẽ trở thành giáo viên cố vấn.
Dialogue: 0,0:16:37.48,0:16:42.27,Default,,0,0,0,,Có kinh nghiệm tham gia các cuộc thi,\N báo cáo về thành tích hoạt động cũng không có vấn đề gì.
Dialogue: 0,0:16:42.61,0:16:44.98,Default,,0,0,0,,Họ đã đáp ứng đủ yêu cầu\N để trở thành câu lạc bộ rồi nhỉ.
Dialogue: 0,0:16:44.98,0:16:47.15,Default,,0,0,0,,Ý kiến của mọi người thế nào?
Dialogue: 0,0:16:47.15,0:16:48.65,Default,,0,0,0,,Không phản đối.
Dialogue: 0,0:16:48.65,0:16:50.78,Default,,0,0,0,,À, xin hãy biểu quyết bằng cách giơ tay.
Dialogue: 0,0:16:50.78,0:16:53.83,Default,,0,0,0,,Nuôi sinh vật trong khu câu lạc bộ \Nthì vấn đề vệ sinh tính sao?
Dialogue: 0,0:16:53.83,0:16:56.45,Default,,0,0,0,,Rồi, đã thông qua bằng biểu quyết đa số.
Dialogue: 0,0:16:56.45,0:16:59.96,Default,,0,0,0,,Vậy thì hãy thông báo việc hôm nay \Ncho các đối tượng có liên quan.
Dialogue: 0,0:17:01.17,0:17:03.17,Default,,0,0,0,,Anh ơi, đây là...
Dialogue: 0,0:17:03.59,0:17:08.13,Default,,0,0,0,,Cuối tuần rồi, anh mày có dịp vào trung tâm\N thành phố, và đây là chiến lợi phẩm.
Dialogue: 0,0:17:08.13,0:17:10.80,Default,,0,0,0,,E-Em xin phép "mở mang tầm mắt" được không ạ?
Dialogue: 0,0:17:10.80,0:17:11.72,Default,,0,0,0,,Xin mời.
Dialogue: 0,0:17:13.64,0:17:15.93,Default,,0,0,0,,Cơ mà anh ơi, đống này...
Dialogue: 0,0:17:16.39,0:17:19.60,Default,,0,0,0,,Thôi kệ, cứ xem như là\N nghiên cứu vẻ quyến rũ đi vậy.
Dialogue: 0,0:17:19.60,0:17:21.90,Default,,0,0,0,,Xem ra em mày "rửa mắt" quen rồi chứ gì.
Dialogue: 0,0:17:24.48,0:17:26.57,Default,,0,0,0,,Ấn phẩm mới của tác giả Ririmaru ạ?
Dialogue: 0,0:17:26.57,0:17:29.44,Default,,0,0,0,,Em cũng thích nét vẽ Liliel của tác giả này lắm.
Dialogue: 0,0:17:29.44,0:17:31.57,Default,,0,0,0,,Cách vẽ mắt quá xuất sắc luôn mà.
Dialogue: 0,0:17:31.57,0:17:34.32,Default,,0,0,0,,Mà có lẽ nào anh là S không?
Dialogue: 0,0:17:34.32,0:17:37.95,Default,,0,0,0,,Ế, em nghĩ thế hả? \NTôi không để ý vụ này lắm.
Dialogue: 0,0:17:37.95,0:17:40.75,Default,,0,0,0,,Truyện về thể loại này của Liliel khá nhiều,
Dialogue: 0,0:17:40.75,0:17:44.42,Default,,0,0,0,,mà nữ chính trong shounen manga \Ncũng rất hay gặp nạn đúng chứ?
Dialogue: 0,0:17:44.42,0:17:45.67,Default,,0,0,0,,Nên mới thức tỉnh bản năng này.
Dialogue: 0,0:17:45.67,0:17:49.55,Default,,0,0,0,,Siêu hiểu luôn anh ạ. \NTruyện thiếu niên nhưng nghiệp nữ chính nặng quá.
Dialogue: 0,0:17:49.55,0:17:53.55,Default,,0,0,0,,Cơ mà, do em thường{đồng cảm với} nhập tâm\N vào cảm xúc của nữ chính,
Dialogue: 0,0:17:53.55,0:17:56.43,Default,,0,0,0,,nên nếu phải nói thì chắc em thuộc trường phái M.
Dialogue: 0,0:17:56.43,0:17:58.89,Default,,0,0,0,,Xem ra rất tương thích với anh đấy nhỉ.
Dialogue: 0,0:17:58.89,0:18:01.39,Default,,0,0,0,,T-Tương thích ư?
Dialogue: 0,0:18:02.35,0:18:04.69,Default,,0,0,0,,Ặc, đừng nghĩ bậy bạ nữa thằng ngáo này!
Dialogue: 0,0:18:06.52,0:18:10.24,Default,,0,0,0,,Tóm lại thì, nữ chính càng bị hành \Nthì càng dâm đãng.
Dialogue: 0,0:18:10.24,0:18:12.15,Default,,0,0,0,,Nói thế thì em mày là S rồi còn gì nữa.
Dialogue: 0,0:18:12.15,0:18:17.28,Default,,0,0,0,,Ngoài ra, chẳng phải cũng có nhiều nữ chính\N mạnh mẽ tự mình xoay sở vượt qua hiểm cảnh đấy thôi.
Dialogue: 0,0:18:17.28,0:18:19.24,Default,,0,0,0,,Tuy em cũng thích kiểu đó,
Dialogue: 0,0:18:19.58,0:18:22.75,Default,,0,0,0,,nhưng vì em thích Liliel,
Dialogue: 0,0:18:22.75,0:18:28.13,Default,,0,0,0,,nên đúng là vẫn ngưỡng mộ nhất khung cảnh cô ấy được\N nam chính chạy đến giải cứu trong lúc nguy nan.
Dialogue: 0,0:18:31.72,0:18:34.26,Default,,0,0,0,,Giờ thì chúng ta chuyển sang chụp ảnh thôi nhỉ?
Dialogue: 0,0:18:34.26,0:18:36.64,Default,,0,0,0,,Vâng ạ, hôm nay chắc là...
Dialogue: 0,0:18:37.18,0:18:39.81,Default,,0,0,0,,tụi mình chụp ảnh Liliel gặp nạn đi!
Dialogue: 0,0:18:41.73,0:18:45.77,Default,,0,0,0,,N-Nhất định ngài Ashford sẽ đến cứu tôi.
Dialogue: 0,0:18:45.77,0:18:48.11,Default,,0,0,0,,Hóa thân thành nhân vật luôn rồi.
Dialogue: 0,0:18:49.19,0:18:52.11,Default,,0,0,0,,Cậu nên xây dựng ý tưởng\N cho từng tấm hình mình chụp.
Dialogue: 0,0:18:52.11,0:18:55.70,Default,,0,0,0,,Xem nào, lên ý tưởng cho bức ảnh nhỉ.
Dialogue: 0,0:18:55.70,0:18:59.99,Default,,0,0,0,,Nhấn mạnh vào việc tay bị trói...\N nên đổi góc nhìn từ trên cao xuống sẽ hay hơn nhỉ.
Dialogue: 0,0:18:59.99,0:19:01.54,Default,,0,0,0,,Em quay lưng lại rồi nhìn qua đây đi.
Dialogue: 0,0:19:16.72,0:19:20.72,Default,,0,0,0,,Oa, anh ơi, hình như anh chụp nghệ hơn rồi thì phải?
Dialogue: 0,0:19:20.72,0:19:22.14,Default,,0,0,0,,À thì...
Dialogue: 0,0:19:22.77,0:19:24.98,Default,,0,0,0,,Huấn luyện? Với nhóm chị Magino ạ?
Dialogue: 0,0:19:24.98,0:19:28.31,Default,,0,0,0,,Kiểu vậy đấy, \Nnên tôi cũng học hỏi được nhiều điều.
Dialogue: 0,0:19:28.31,0:19:30.11,Default,,0,0,0,,Xin lỗi vì đã giấu em mà đi như vậy.
Dialogue: 0,0:19:30.36,0:19:32.82,Default,,0,0,0,,Anh đã vì em mà...
Dialogue: 0,0:19:32.82,0:19:36.36,Default,,0,0,0,,Anh Ogino đã nói rằng \Nchỉ một bên cố gắng thôi là không được.
Dialogue: 0,0:19:36.95,0:19:40.53,Default,,0,0,0,,Rằng đây là việc cả hai phải phối hợp với nhau.
Dialogue: 0,0:19:40.53,0:19:44.29,Default,,0,0,0,,Nếu như Ririsa muốn được nổi tiếng nhờ cosplay,
Dialogue: 0,0:19:44.29,0:19:48.88,Default,,0,0,0,,thì đồng hành cùng em thôi là chưa đủ,\N mà tôi nghĩ mình cũng phải thật sự nỗ lực.
Dialogue: 0,0:19:49.63,0:19:50.79,Default,,0,0,0,,Ririsa nghĩ sao?
Dialogue: 0,0:19:52.34,0:19:53.96,Default,,0,0,0,,Em...
Dialogue: 0,0:19:53.96,0:19:58.39,Default,,0,0,0,,Em chỉ muốn thể hiện tình yêu của mình\N với Liliel bằng cosplay thôi,
Dialogue: 0,0:19:58.39,0:20:03.81,Default,,0,0,0,,nên không có hứng thú gì với việc nổi tiếng \Nhay trở thành người kế thừa của cô Mayura.
Dialogue: 0,0:20:04.14,0:20:07.06,Default,,0,0,0,,V-Vậy à, cũng phải ha.
Dialogue: 0,0:20:07.06,0:20:08.06,Default,,0,0,0,,Thế nhưng...
Dialogue: 0,0:20:08.48,0:20:13.28,Default,,0,0,0,,trước giờ em những tưởng tự mình làm \Ntự mình ngắm là đã đủ thỏa mãn rồi.
Dialogue: 0,0:20:14.19,0:20:17.20,Default,,0,0,0,,Vậy mà khi cùng anh tham gia sự kiện đầu tiên,
Dialogue: 0,0:20:17.20,0:20:20.78,Default,,0,0,0,,rồi được đám đông \Nngắm nhìn em hóa thân thành Liliel,
Dialogue: 0,0:20:21.32,0:20:24.37,Default,,0,0,0,,em nghĩ có lẽ mình đã \Nnảy sinh thêm một chút tham vọng.
Dialogue: 0,0:20:26.25,0:20:30.13,Default,,0,0,0,,Bởi vì việc ấy... \Nchẳng phải siêu thú vị hay sao ạ!
Dialogue: 0,0:20:30.13,0:20:32.75,Default,,0,0,0,,Anh cũng thấy nó cực kì lôi cuốn đúng không ạ!
Dialogue: 0,0:20:33.13,0:20:38.47,Default,,0,0,0,,Em đã vô cùng ngạc nhiên khi nhận ra sự kiện cosplay\N mà mình ngưỡng mộ lại vui đến như vậy.
Dialogue: 0,0:20:38.84,0:20:43.51,Default,,0,0,0,,Rồi em tự hỏi, nếu như mình có thể cosplay trước \Nđông người hơn nữa, tại một sự kiện hoành tráng hơn nữa,
Dialogue: 0,0:20:43.51,0:20:45.56,Default,,0,0,0,,thì sẽ còn hào hứng đến mức nào nữa.
Dialogue: 0,0:20:45.56,0:20:47.18,Default,,0,0,0,,Nếu như em có thể...
Dialogue: 0,0:20:47.93,0:20:51.94,Default,,0,0,0,,khéo léo truyền đạt tình cảm của mình\N đến với nhiều người hơn nữa...
Dialogue: 0,0:20:52.61,0:20:56.40,Default,,0,0,0,,Em thật sự rất cảm kích\N khi nghe lời đề nghị của anh.
Dialogue: 0,0:20:58.65,0:21:01.11,Default,,0,0,0,,Liệu em có thể trông cậy vào anh thật không ạ?
Dialogue: 0,0:21:01.53,0:21:06.45,Default,,0,0,0,,Chẳng phải tôi đã hứa sẽ hỗ trợ hết mình rồi còn gì?\N Với lại tôi cũng thấy rất vui mà.
Dialogue: 0,0:21:07.04,0:21:09.25,Default,,0,0,0,,Hai đứa mình cùng tiến xa hết mức có thể xem sao.
Dialogue: 0,0:21:09.25,0:21:10.37,Default,,0,0,0,,Vâng!
Dialogue: 0,0:21:11.88,0:21:14.92,Default,,0,0,0,,Này nhé, cái studio chụp hình đó đỉnh lắm.
Dialogue: 0,0:21:14.92,0:21:17.17,Default,,0,0,0,,Tuy so với chúng ta thì chi phí khá đắt.
Dialogue: 0,0:21:17.17,0:21:20.13,Default,,0,0,0,,Oa, thật ra em chưa từng tới đó...
Dialogue: 0,0:21:20.47,0:21:24.35,Default,,0,0,0,,Nhưng nếu chúng ta trau chuốt vào phông nền \Nvà các đạo cụ nhỏ thì phòng câu lạc bộ cũng được rồi.
Dialogue: 0,0:21:24.35,0:21:27.72,Default,,0,0,0,,Anh nói phải, chúng ta vẫn còn phòng câu lạc bộ này...
Dialogue: 0,0:21:28.98,0:21:31.39,Default,,0,0,0,,Hội học sinh đây. \NHội trưởng có trong phòng không?
Dialogue: 0,0:21:32.10,0:21:33.81,Default,,0,0,0,,Hội học sinh!?
Dialogue: 0,0:21:33.81,0:21:35.19,Default,,0,0,0,,Xin hãy mở khóa cửa.
Dialogue: 0,0:21:35.52,0:21:39.74,Default,,0,0,0,,Nếu không có lí do chính đáng\N mà cứ khóa cửa là vi phạm nội qui nhà trường.
Dialogue: 0,0:21:39.74,0:21:40.95,Default,,0,0,0,,Liliel mau trốn đi.
Dialogue: 0,0:21:40.95,0:21:43.11,Default,,0,0,0,,T-Tôi mở cửa ngay đây.
Dialogue: 0,0:21:44.37,0:21:45.33,Default,,0,0,0,,Xin phép.
Dialogue: 0,0:21:45.66,0:21:47.79,Default,,0,0,0,,Hội học sinh có việc gì vậy?
Dialogue: 0,0:21:48.25,0:21:50.25,Default,,0,0,0,,Chúng tôi chỉ đến thông báo vắn tắt thôi.
Dialogue: 0,0:21:50.71,0:21:54.08,Default,,0,0,0,,Từ hôm nay, hội nghiên cứu bể thủy sinh \Nđã được thăng lên thành câu lạc bộ.
Dialogue: 0,0:21:54.08,0:21:56.09,Default,,0,0,0,,Hả? Bể thủy sinh.
Dialogue: 0,0:21:56.09,0:22:00.30,Default,,0,0,0,,Theo đó, câu lạc bộ nghiên cứu manga \Nsẽ bị giáng xuống thành hội nghiên cứu.
Dialogue: 0,0:22:00.30,0:22:02.68,Default,,0,0,0,,G-Giáng cấp ư? Tại sao lại đột ngột như vậy.
Dialogue: 0,0:22:02.68,0:22:05.72,Default,,0,0,0,,Theo ghi chép, từ ba năm trước,\N câu lạc bộ nghiên cứu manga đã không còn
Dialogue: 0,0:22:05.72,0:22:07.72,Default,,0,0,0,,đáp ứng đủ điều kiện của một câu lạc bộ nữa.
Dialogue: 0,0:22:07.72,0:22:12.02,Default,,0,0,0,,Chẳng qua là khu câu lạc bộ chưa hết phòng \Nnên mới chưa cần tới phòng này thôi.
Dialogue: 0,0:22:12.02,0:22:14.10,Default,,0,0,0,,Từ ba năm trước ư?
Dialogue: 0,0:22:14.65,0:22:17.15,Default,,0,0,0,,Là hội trường mà cậu không biết sao?
Dialogue: 0,0:22:17.15,0:22:22.15,Default,,0,0,0,,Nói chung, cậu phải giao lại \Nphòng này cho câu lạc bộ mới.
