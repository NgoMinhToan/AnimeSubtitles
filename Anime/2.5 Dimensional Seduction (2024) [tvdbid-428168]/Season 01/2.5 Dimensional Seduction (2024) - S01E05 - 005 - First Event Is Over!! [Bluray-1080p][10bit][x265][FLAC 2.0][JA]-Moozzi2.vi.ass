Dialogue: 0,0:14:56.21,0:15:00.67,sign,,0,0,0,,{\fnSVN-Bango\fs70\bord8\c&H393C4A&\3c&HFFFFFF&\b0\pos(634.667,284)\fade(500,0)}100 câu chuyện của Cosplayer (HẾT)
Dialogue: 0,0:16:07.03,0:16:10.99,sign,,0,0,0,,{\c&HD69A5A&\fs80\b1\move(480,390,418,163)\frz26.84}Amano Ririsa
Dialogue: 0,0:16:07.03,0:16:10.99,sign,,0,0,0,,{\an4\c&H393C4A&\fs70\b1\frz26.84\move(210,813,140,600)}Hội trường đóng của rồi\N nên tôi chờ ở nhà ga.
Dialogue: 0,0:16:07.03,0:16:10.99,sign,,0,0,0,,{\an4\c&H393C4A&\fs70\b1\frz26.84\move(1322,788,1226,540)}Em hiểu rồi,\Nem sẽ ra đó ngay.
Dialogue: 0,0:22:21.99,0:22:24.99,sign,,0,0,0,,{\fnSVN-Bango\an8\c&H6E667A&\b0\fs70\bord6\3c&HFFFFFF&\fade(500,0)\pos(1270,170)}Không\N một\N ai\N bắt\N bẻ\N |
Dialogue: 0,0:23:55.04,0:24:00.04,Default,,0,0,0,,{\3c&HFFFFFF&\c&HE7B50B&\bord5\fs70\b0\blur5\3a&H00&\pos(951.33,686)\fscx100\fscy100\fnUVN Van}Buổi huấn luyện đặc biệt{\c&HA965E0&} của đàn anh!?
Comment: 0,0:24:00.00,0:24:02.00,sign,,0,0,0,,Line
Dialogue: 0,0:00:06.74,0:00:10.45,Default,,0,0,0,,Bé Liliel vẫn chưa quay lại hả?\N Hay là xảy ra chuyện gì rồi?
Dialogue: 0,0:00:10.45,0:00:11.82,Default,,0,0,0,,Ririsa.
Dialogue: 0,0:00:20.50,0:00:22.00,Default,,0,0,0,,Liliel...
Dialogue: 0,0:02:20.50,0:02:22.54,Default,,0,0,0,,Ngài Ashford ơi.
Dialogue: 0,0:02:27.59,0:02:30.17,Default,,0,0,0,,Em xin lỗi, đã để anh phải đợi rồi.
Dialogue: 0,0:02:30.17,0:02:31.01,Default,,0,0,0,,Liliel.
Dialogue: 0,0:02:31.88,0:02:32.97,Default,,0,0,0,,Tốt quá rồi.
Dialogue: 0,0:02:32.97,0:02:34.68,Default,,0,0,0,,Ở đâu ra cô bé dễ thương quá vậy?
Dialogue: 0,0:02:34.68,0:02:36.72,Default,,0,0,0,,- Ai thế?\N- Không lẽ là người nổi tiếng...
Dialogue: 0,0:02:36.72,0:02:39.93,Default,,0,0,0,,- Chịu, biết chết liền.\N- Sao lại nhìn sót cô ấy \Ntrong hội trường nhỏ thế này được.
Dialogue: 0,0:02:40.35,0:02:42.43,Default,,0,0,0,,Lẽ nào chỉ vừa mới thay đồ thôi sao?
Dialogue: 0,0:02:42.43,0:02:43.89,Default,,0,0,0,,Chưa đầy 10 phút nữa là kết thúc rồi.
Dialogue: 0,0:02:45.02,0:02:47.65,Default,,0,0,0,,Đó là Liliel trong hình dạng thiên sứ!
Dialogue: 0,0:02:49.11,0:02:52.61,Default,,0,0,0,,Lúc mới nghe Liliel, mình đã không thèm \Nđể tâm vì nhân vật này xưa rồi.
Dialogue: 0,0:02:52.61,0:02:54.15,Default,,0,0,0,,Nhưng thế quái nào?
Dialogue: 0,0:02:54.15,0:02:58.12,Default,,0,0,0,,Lại nảy sinh cảm xúc phức tạp như khi \Ngặp lại tình đầu là bạn cùng lớp thế này...
Dialogue: 0,0:02:58.12,0:03:01.29,Default,,0,0,0,,Đã là con trai ắt hẳn đều từng gục ngã trước Liliel.
Dialogue: 0,0:03:01.29,0:03:04.41,Default,,0,0,0,,Làm mình nhớ lại cái thời \Nkhông dám tự xưng là otaku.
Dialogue: 0,0:03:05.21,0:03:08.08,Default,,0,0,0,,Cô ấy chính là Liliel\N mà mình đã từng yêu vào thời điểm đó.
Dialogue: 0,0:03:08.08,0:03:09.84,Default,,0,0,0,,Mà chất lượng đỉnh cao thật chứ!
Dialogue: 0,0:03:10.13,0:03:14.42,Default,,0,0,0,,K-Không thể để cô Magino\N phát hiện ra cảm xúc này được.
Dialogue: 0,0:03:14.80,0:03:17.64,Default,,0,0,0,,- Liliel lẽ nào...\N- Là cô bé lúc nãy?
Dialogue: 0,0:03:17.64,0:03:19.72,Default,,0,0,0,,Tiểu đệ à, vẫn còn quá sớm để rút quân.
Dialogue: 0,0:03:19.72,0:03:21.97,Default,,0,0,0,,Không cần anh phải nhắc đâu, đại ca.
Dialogue: 0,0:03:22.56,0:03:25.02,Default,,0,0,0,,Thế rồi, vụ chụp ảnh em tính thế nào đây?
Dialogue: 0,0:03:25.02,0:03:27.40,Default,,0,0,0,,Đ-Đây cũng là lần đầu của em,
Dialogue: 0,0:03:27.40,0:03:31.94,Default,,0,0,0,,nên chắc chỉ cần anh bắt đầu bấm máy \Nlà mọi người sẽ chụp theo luôn chăng.
Dialogue: 0,0:03:31.94,0:03:33.53,Default,,0,0,0,,Trước mắt cứ tìm chỗ...
Dialogue: 0,0:03:33.53,0:03:35.61,Default,,0,0,0,,- Chụp hình luôn được không?\N- Em có danh thiếp không?
Dialogue: 0,0:03:35.61,0:03:37.99,Default,,0,0,0,,- SNS cũng được.\N- Em có mang theo ROM luôn hả?
Dialogue: 0,0:03:37.99,0:03:40.07,Default,,0,0,0,,Ơ, ưm...
Dialogue: 0,0:03:40.45,0:03:43.62,Default,,0,0,0,,Ogino, anh có chắc\N là không muốn chụp Liliel không?
Dialogue: 0,0:03:44.66,0:03:49.50,Default,,0,0,0,,Cô nói gì vậy?\N Tôi tuyệt đối sẽ không phản bội cô Magino.
Dialogue: 0,0:03:49.50,0:03:50.54,Default,,0,0,0,,Khóc ra máu luôn?
Dialogue: 0,0:03:54.26,0:03:56.22,Default,,0,0,0,,- Tôi muốn anh chụp giùm tôi.\N- Liliel!
Dialogue: 0,0:03:56.22,0:03:58.13,Default,,0,0,0,,- Bằng tay nghề chụp hình của anh đó.\N- Liliel!
Dialogue: 0,0:03:58.13,0:03:59.26,Default,,0,0,0,,- Được rồi, mau đi đi!\N- Liliel!
Dialogue: 0,0:04:00.30,0:04:02.60,Default,,0,0,0,,Từ giờ chuẩn bị chụp hình hả? \NMong được em chiếu cố.
Dialogue: 0,0:04:02.60,0:04:03.43,Default,,0,0,0,,Ơ vâng.
Dialogue: 0,0:04:03.43,0:04:04.52,Default,,0,0,0,,Ể? Phải xếp hàng ư?
Dialogue: 0,0:04:04.52,0:04:06.56,Default,,0,0,0,,Nếu xếp hàng thì không kịp mất.
Dialogue: 0,0:04:06.56,0:04:08.39,Default,,0,0,0,,Ầy, việc đó thì phải hỏi ý cosplayer thôi.
Dialogue: 0,0:04:08.39,0:04:09.98,Default,,0,0,0,,Siêu hỗn loạn luôn.
Dialogue: 0,0:04:09.98,0:04:12.61,Default,,0,0,0,,- Vì sắp hết giờ rồi, không tên nào chịu nhường đâu.\N- Liliel!
Dialogue: 0,0:04:13.11,0:04:17.24,Default,,0,0,0,,Thưa quý vị, em ấy là Liliel,\N từ giờ sẽ chuẩn bị chụp hình.
Dialogue: 0,0:04:17.24,0:04:20.28,Default,,0,0,0,,Vì đây là lần đầu em ấy tham gia,\N nên mong quý vị chiếu cố.
Dialogue: 0,0:04:20.28,0:04:21.53,Default,,0,0,0,,Lần đầu á!
Dialogue: 0,0:04:21.95,0:04:24.49,Default,,0,0,0,,Chúng tôi có thể mượn khu vực này không?
Dialogue: 0,0:04:24.49,0:04:26.45,Default,,0,0,0,,- Xin mời.\N- Cảm ơn rất nhiều.
Dialogue: 0,0:04:26.45,0:04:29.21,Default,,0,0,0,,Vậy thì xin được phép bắt đầu buổi chụp ảnh.
Dialogue: 0,0:04:29.21,0:04:32.67,Default,,0,0,0,,Vì không còn nhiều thời gian,\N nên hãy chụp vây quanh ngay từ đầu luôn.
Dialogue: 0,0:04:35.17,0:04:38.17,Default,,0,0,0,,C-Cảm ơn anh.
Dialogue: 0,0:04:38.17,0:04:39.63,Default,,0,0,0,,Ơn nghĩa gì.
Dialogue: 0,0:04:39.63,0:04:42.18,Default,,0,0,0,,Chỉ cần vị trí ngon nhất là quá đủ rồi.
Dialogue: 0,0:04:42.18,0:04:43.85,Default,,0,0,0,,Hóa ra cũng thèm chụp à...
Dialogue: 0,0:04:43.85,0:04:46.35,Default,,0,0,0,,Xin được chiếu cố!
Dialogue: 0,0:04:47.43,0:04:49.56,Default,,0,0,0,,X-Xin được chiếu cố ạ.
Dialogue: 0,0:04:54.61,0:04:58.69,Default,,0,0,0,,Nhìn em giống đang\N họp báo xin lỗi luôn rồi, Liliel ơi!
Dialogue: 0,0:04:59.40,0:05:01.49,Default,,0,0,0,,M-Mình phải tạo dáng mới được.
Dialogue: 0,0:05:12.33,0:05:14.13,Default,,0,0,0,,Không thể nào chen vào nổi.
Dialogue: 0,0:05:14.13,0:05:16.25,Default,,0,0,0,,Được vây quanh ghê chưa kìa.
Dialogue: 0,0:05:16.25,0:05:17.42,Default,,0,0,0,,Xin hãy nhìn qua đây.
Dialogue: 0,0:05:18.17,0:05:19.55,Default,,0,0,0,,Nhìn bên này nữa.
Dialogue: 0,0:05:19.55,0:05:21.97,Default,,0,0,0,,Ể? Em không biết phải nhìn về hướng nào...
Dialogue: 0,0:05:23.51,0:05:24.89,Default,,0,0,0,,- Nguy hiểm!\N- Ririsa!
Dialogue: 0,0:05:28.10,0:05:30.06,Default,,0,0,0,,T-Thật ngại quá...
Dialogue: 0,0:05:30.31,0:05:31.89,Default,,0,0,0,,Tạ ơn trời.
Dialogue: 0,0:05:31.89,0:05:33.77,Default,,0,0,0,,Đúng là người mới mà.
Dialogue: 0,0:05:33.77,0:05:35.98,Default,,0,0,0,,Cách tạo dáng \Ncũng không giống cosplayer chút nào.
Dialogue: 0,0:05:35.98,0:05:37.73,Default,,0,0,0,,Muốn thấy mấy kiểu điển hình ghê.
Dialogue: 0,0:05:37.73,0:05:39.86,Default,,0,0,0,,Chưa đủ tinh thần chiều lòng fan cho lắm.
Dialogue: 0,0:05:39.86,0:05:43.32,Default,,0,0,0,,Bậy, em ấy không quen với việc chụp hình \Nnên ngược lại còn hấp dẫn hơn.
Dialogue: 0,0:05:44.53,0:05:48.29,Default,,0,0,0,,C-Các thanh niên à, ăn nói hàm hồ gì vậy?
Dialogue: 0,0:05:48.29,0:05:50.20,Default,,0,0,0,,Lẽ nào các cậu không nhận ra?
Dialogue: 0,0:05:52.37,0:05:56.25,Default,,0,0,0,,Cô ấy đang tái hiện lại toàn bộ \Ntư thế của Liliel trong chính tác phẩm.
Dialogue: 0,0:05:56.75,0:06:01.47,Default,,0,0,0,,Đã vậy, những tư thế đó không chỉ lấy\N từ các trang bìa bắt mắt mà còn ở phụ chương nữa.
Dialogue: 0,0:06:01.97,0:06:05.60,Default,,0,0,0,,Cứ năm giây lại đổi một kiểu... \NChẳng lẽ em ấy nằm lòng mọi tư thế sao?
Dialogue: 0,0:06:05.60,0:06:08.97,Default,,0,0,0,,Cô ấy chính là một kẻ cuồng Liliel chính hiệu!
Dialogue: 0,0:06:09.93,0:06:11.43,Default,,0,0,0,,Thấy sao hả, Ogino?
Dialogue: 0,0:06:12.23,0:06:15.94,Default,,0,0,0,,À, c-còn lâu mới sánh bằng cô Magino.
Dialogue: 0,0:06:15.94,0:06:20.28,Default,,0,0,0,,T-Tuy nhiên, tôi cho rằng\N chúng ta buộc phải ngả mũ trước cô ấy.
Dialogue: 0,0:06:20.28,0:06:21.53,Default,,0,0,0,,Đáng yêu quá mà.
Dialogue: 0,0:06:22.49,0:06:25.87,Default,,0,0,0,,Với tư cách là nhà phê bình\N cosplayer tự xưng, đại ca thấy sao?
Dialogue: 0,0:06:26.66,0:06:29.83,Default,,0,0,0,,Hình như cô ấy không quen \Nchụp vây quanh thế này nên khó chụp quá.
Dialogue: 0,0:06:29.83,0:06:31.20,Default,,0,0,0,,Cũng phải.
Dialogue: 0,0:06:31.66,0:06:34.67,Default,,0,0,0,,Thế nhưng, không có cảm giác "hóa trang".
Dialogue: 0,0:06:36.38,0:06:39.75,Default,,0,0,0,,Cảm nhận này hiếm nghe à nha.\N Ý đại ca là sao?
Dialogue: 0,0:06:40.50,0:06:45.01,Default,,0,0,0,,Cũng không biết diễn tả bằng lời thế nào, \Nnhưng không giống như đang cosplay.
Dialogue: 0,0:06:45.01,0:06:48.80,Default,,0,0,0,,Tuy thể hiện không chuyên nghiệp,\N nhưng thay vào đó lại rất sống động.
Dialogue: 0,0:06:48.80,0:06:51.43,Default,,0,0,0,,Cứ như thể, ngay từ đầu cô ấy đã như vậy rồi.
Dialogue: 0,0:06:51.43,0:06:57.48,Default,,0,0,0,,Hệt như Liliel bằng xương bằng thịt từ truyện \Nbước ra và đang đứng trước máy ảnh vậy.
Dialogue: 0,0:06:59.57,0:07:00.82,Default,,0,0,0,,Đại ca...
Dialogue: 0,0:07:01.32,0:07:04.24,Default,,0,0,0,,Vậy chẳng phải, cô ấy là đỉnh nhất rồi sao...
Dialogue: 0,0:07:05.15,0:07:07.28,Default,,0,0,0,,Không biết mình đang phản chiếu thế nào nhỉ?
Dialogue: 0,0:07:07.95,0:07:11.91,Default,,0,0,0,,Liệu mình đã truyền tải được\N tình yêu mình dành cho Liliel chưa nhỉ?
Dialogue: 0,0:07:11.91,0:07:14.16,Default,,0,0,0,,Mình cực kì...
Dialogue: 0,0:07:14.87,0:07:16.37,Default,,0,0,0,,yêu Liliel!
Dialogue: 0,0:07:18.75,0:07:22.21,Default,,0,0,0,,Chụp nhiều nhất có thể đi.\N Cô bé này sẽ còn biến hóa hơn nữa.
Dialogue: 0,0:07:22.92,0:07:25.17,Default,,0,0,0,,Một phút nữa sẽ kết thúc.
Dialogue: 0,0:07:29.10,0:07:33.35,Default,,0,0,0,,Ririsa, tại sao con gái con đứa \Nmà lại đọc những cuốn truyện này?
Dialogue: 0,0:07:33.35,0:07:35.27,Default,,0,0,0,,Con xin lỗi mẹ, nhưng...
Dialogue: 0,0:07:35.27,0:07:37.23,Default,,0,0,0,,Chỉ là lầm lỡ gì thôi đúng không?
Dialogue: 0,0:07:39.69,0:07:41.32,Default,,0,0,0,,Lầm lỡ...
Dialogue: 0,0:07:51.70,0:07:55.83,Default,,0,0,0,,Đây là... lần đầu tiên \Nmình đứng trước mọi người với tư cách là Liliel.
Dialogue: 0,0:07:55.83,0:07:57.12,Default,,0,0,0,,Còn 10 giây nữa!
Dialogue: 0,0:07:58.00,0:07:59.08,Default,,0,0,0,,Chín.
Dialogue: 0,0:07:59.08,0:08:01.29,Default,,0,0,0,,- Xin hãy nhìn qua đây!\N- Tám, bảy...
Dialogue: 0,0:08:01.96,0:08:05.05,Default,,0,0,0,,Thân là một otaku,\N tôi sẽ không phủ định những chuyện về sở thích.
Dialogue: 0,0:08:05.38,0:08:08.84,Default,,0,0,0,,Không ai hóa thân thành Liliel \Ndễ thương được như Ririsa đâu nhá!
Dialogue: 0,0:08:09.68,0:08:11.39,Default,,0,0,0,,Tất cả đều là nhờ anh ấy.
Dialogue: 0,0:08:12.51,0:08:14.60,Default,,0,0,0,,Vì anh ấy đã tiếp thêm dũng khí cho mình.
Dialogue: 0,0:08:14.60,0:08:18.56,Default,,0,0,0,,Ba, hai, một...
Dialogue: 0,0:08:36.20,0:08:38.37,Default,,0,0,0,,Xin chân thành cảm ơn.
Dialogue: 0,0:08:38.37,0:08:40.46,Default,,0,0,0,,Nét mặt cuối cùng dễ thương quá.
Dialogue: 0,0:08:40.46,0:08:43.21,Default,,0,0,0,,Nét mặt cuối cùng là dễ thương nhất.
Dialogue: 0,0:08:43.21,0:08:46.26,Default,,0,0,0,,Đó đích thị là ánh mắt say đắm Ashford.
Dialogue: 0,0:08:46.26,0:08:48.59,Default,,0,0,0,,Giá như lúc đó được nhận ánh mắt ấy...
Dialogue: 0,0:08:52.85,0:08:54.43,Default,,0,0,0,,Xin lỗi, Liliel.
Dialogue: 0,0:08:54.43,0:08:55.39,Default,,0,0,0,,A, đàn anh.
Dialogue: 0,0:08:55.97,0:08:58.60,Default,,0,0,0,,Tôi bỏ lỡ thời cơ chụp ảnh rồi.
Dialogue: 0,0:08:58.93,0:09:00.73,Default,,0,0,0,,Chụp thêm một tấm kỉ niệm nha?
Dialogue: 0,0:09:00.73,0:09:01.81,Default,,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:09:05.73,0:09:08.82,Default,,0,0,0,,Tự nhiên thấy yên tâm rồi \Nlàm nét mặt em thư giãn hết ra.
Dialogue: 0,0:09:09.74,0:09:10.86,Default,,0,0,0,,Chụp nha.
Dialogue: 0,0:09:13.66,0:09:15.49,Default,,0,0,0,,- Anh ơi, không tính!\N- Ể?
Dialogue: 0,0:09:15.49,0:09:19.66,Default,,0,0,0,,Em bị lơ đãng mất rồi.\N Tấm vừa rồi chắc chắn là em không giống Liliel.
Dialogue: 0,0:09:19.66,0:09:20.71,Default,,0,0,0,,Chụp lại đi.
Dialogue: 0,0:09:24.04,0:09:25.21,Default,,0,0,0,,Không đâu.
Dialogue: 0,0:09:26.13,0:09:28.76,Default,,0,0,0,,Tấm này đẹp lắm, Ririsa.
Dialogue: 0,0:09:32.55,0:09:37.01,Default,,0,0,0,,Mọi người vất vả rồi.
Dialogue: 0,0:09:37.01,0:09:40.10,Default,,0,0,0,,Sự kiện Haru-cos lần thứ 19 \Nxin được phép kết thúc.
Dialogue: 0,0:09:40.10,0:09:45.02,Default,,0,0,0,,Phòng thay đồ chỉ được sử dụng đến 17 giờ,\N xin các bạn hãy chú ý.
Dialogue: 0,0:09:45.52,0:09:46.48,Default,,0,0,0,,Quý cô Liliel!
Dialogue: 0,0:09:46.48,0:09:48.07,Default,,0,0,0,,Ơ vâng.
Dialogue: 0,0:09:48.07,0:09:48.61,Default,,0,0,0,,"Quý cô"?
Dialogue: 0,0:09:48.61,0:09:51.07,Default,,0,0,0,,- Chúng tôi muốn mua ROM.\N- Có bán qua mạng không?
Dialogue: 0,0:09:51.07,0:09:53.24,Default,,0,0,0,,T-Thật xin lỗi, mấy chuyện đó em vẫn chưa...
Dialogue: 0,0:09:53.24,0:09:55.20,Default,,0,0,0,,Đăng hình hôm nay lên SNS được không?
Dialogue: 0,0:09:55.20,0:09:56.74,Default,,0,0,0,,Em ngượng lắm nên xin đừng làm vậy.
Dialogue: 0,0:09:56.74,0:09:59.41,Default,,0,0,0,,- Ít nhất thì cho xin danh thiếp đi.\N- Có dùng SNS không?
Dialogue: 0,0:09:59.41,0:10:02.54,Default,,0,0,0,,- Bé Liliel ơi, phòng thay đồ sắp đóng rồi đó.\N- Mấy thứ đó em cũng không có ạ...
Dialogue: 0,0:10:02.54,0:10:03.92,Default,,0,0,0,,A, em tới liền.
Dialogue: 0,0:10:07.42,0:10:10.09,Default,,0,0,0,,Thật xin lỗi, em xin phép đi trước.
Dialogue: 0,0:10:11.34,0:10:13.88,Default,,0,0,0,,Không có danh thiếp lẫn SNS ư?
Dialogue: 0,0:10:13.88,0:10:16.26,Default,,0,0,0,,Rốt cuộc cô ấy là ai?
Dialogue: 0,0:10:16.26,0:10:17.43,Default,,0,0,0,,Nàng tiên?
Dialogue: 0,0:10:17.43,0:10:19.10,Default,,0,0,0,,Phải gọi là thiên thần chứ.
Dialogue: 0,0:10:21.43,0:10:23.44,Default,,0,0,0,,Phòng thay đồ sắp đóng cửa rồi nha.
Dialogue: 0,0:10:23.73,0:10:24.90,Default,,0,0,0,,Vâng~
Dialogue: 0,0:10:24.90,0:10:27.73,Default,,0,0,0,,Bé Liliel này, chụp với tôi một tấm luôn.
Dialogue: 0,0:10:27.94,0:10:29.57,Default,,0,0,0,,A, vâng.
Dialogue: 0,0:10:32.07,0:10:36.03,Default,,0,0,0,,Ổn không vậy? Sao nhìn cứ như \NLiliel đang phát cáu vì tên trai bao ấy.
Dialogue: 0,0:10:36.03,0:10:39.16,Default,,0,0,0,,Không, nếu phải nói thì giống như\N em ấy tới rước Akito về trời hơn.
Dialogue: 0,0:10:39.16,0:10:40.16,Default,,0,0,0,,Tôi chết rồi ư?
Dialogue: 0,0:10:40.74,0:10:42.62,Default,,0,0,0,,Chuẩn bị đóng cửa phòng thay đồ.
Dialogue: 0,0:10:42.62,0:10:44.83,Default,,0,0,0,,Chết thật, mau thay đồ thôi.
Dialogue: 0,0:10:45.58,0:10:48.84,Default,,0,0,0,,Hờ, hôm nay phấn khích ghê á.
Dialogue: 0,0:10:48.84,0:10:51.09,Default,,0,0,0,,Bé Liliel, chị nhờ chút được không?
Dialogue: 0,0:10:51.09,0:10:51.80,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:52.84,0:10:56.26,Default,,0,0,0,,Nhờ em tháo đuôi ra giúp chị nha?\N Chị lỡ dán chặt quá.
Dialogue: 0,0:10:57.85,0:11:02.14,Default,,0,0,0,,Vậy là chị không đính nó lên trang phục\N mà dán trực tiếp lên xương cụt nhỉ.
Dialogue: 0,0:11:02.14,0:11:04.31,Default,,0,0,0,,Thì chị cũng muốn trau chuốt vào điểm đó mà.
Dialogue: 0,0:11:04.69,0:11:09.40,Default,,0,0,0,,Magino này, mới tháng năm đã dị ứng phấn hoa hả?\N Thấy mang nhiều khẩu trang quá nè.
Dialogue: 0,0:11:09.40,0:11:10.52,Default,,0,0,0,,À không.
Dialogue: 0,0:11:11.36,0:11:13.24,Default,,0,0,0,,Này là để chống đồ làm bằng lông.
Dialogue: 0,0:11:13.61,0:11:16.20,Default,,0,0,0,,Tại dạo này toàn cosplay\N mấy nhân vật thú nhân.
Dialogue: 0,0:11:18.66,0:11:20.53,Default,,0,0,0,,Hóa ra là khẩu trang chống bụi.
Dialogue: 0,0:11:20.53,0:11:26.29,Default,,0,0,0,,Thỉnh thoảng tôi lại nghĩ, phút cuối đời,\Ntôi sẽ chết vì phổi chứa đầy lông trong đó.
Dialogue: 0,0:11:27.75,0:11:30.13,Default,,0,0,0,,Cơ mà vẫn chẳng thể bỏ sở thích được.
Dialogue: 0,0:11:30.13,0:11:31.34,Default,,0,0,0,,Bao hiểu.
Dialogue: 0,0:11:31.67,0:11:35.05,Default,,0,0,0,,Thật chất tôi muốn cosplay nhiều thể loại lắm,
Dialogue: 0,0:11:35.05,0:11:38.43,Default,,0,0,0,,nhưng đến khi nhận ra thì trong tủ đồ\N toàn là trang phục Nhật.
Dialogue: 0,0:11:38.43,0:11:40.60,Default,,0,0,0,,Ai rồi cũng lệch về một thể loại thôi.
Dialogue: 0,0:11:40.60,0:11:44.06,Default,,0,0,0,,Bakiko cũng toàn theo mấy nhân vật\N có sừng hoặc răng nanh thôi nhỉ.
Dialogue: 0,0:11:44.06,0:11:45.89,Default,,0,0,0,,Chuẩn luôn.
Dialogue: 0,0:11:46.27,0:11:52.61,Default,,0,0,0,,Dạo trước, trên đường đi sự kiện về \Ntôi cứ cảm thấy bị người ta nhìn chằm chằm.
Dialogue: 0,0:11:53.44,0:11:55.65,Default,,0,0,0,,Hóa ra là quên tháo răng nanh giả.
Dialogue: 0,0:11:57.61,0:11:59.99,Default,,0,0,0,,- Ghê rợn quá.\N- Phải cẩn thận hơn chứ.
Dialogue: 0,0:11:59.99,0:12:01.95,Default,,0,0,0,,Nhìn lại đôi tai cô trước khi nói đi.
Dialogue: 0,0:12:01.95,0:12:04.66,Default,,0,0,0,,Phải rồi, nhắc đến chuyện đáng sợ thì...
Dialogue: 0,0:12:04.66,0:12:06.29,Default,,0,0,0,,Bộ đang thi kể chuyện rùng rợn à?
Dialogue: 0,0:12:06.62,0:12:10.08,Default,,0,0,0,,Hôm trước, tôi đang thư giãn trong phòng\N sau khi tham gia sự kiện,
Dialogue: 0,0:12:12.88,0:12:16.92,Default,,0,0,0,,bỗng nghe tiếng thét của em trai \Ntừ phía nhà tắm nên tôi đến xem thử...
Dialogue: 0,0:12:18.59,0:12:22.35,Default,,0,0,0,,thì hóa ra tôi để quên bộ tóc giả \Nđang ngâm rửa trong bồn tắm.
Dialogue: 0,0:12:23.93,0:12:25.89,Default,,0,0,0,,Đúng chất kinh dị rồi đó!
Dialogue: 0,0:12:26.68,0:12:27.94,Default,,0,0,0,,Tôi cũng vậy,
Dialogue: 0,0:12:27.94,0:12:32.31,Default,,0,0,0,,hôm trước, bộ tóc giả mà tôi phơi\N trong phòng khách bị rớt xuống cái TV.
Dialogue: 0,0:12:33.44,0:12:34.65,Default,,0,0,0,,Y hệt Sadako.
Dialogue: 0,0:12:35.03,0:12:38.07,Default,,0,0,0,,Vụ gì vui thế? \NThấy mọi người bàn tán nhộn nhịp ghê.
Dialogue: 0,0:12:38.74,0:12:40.49,Default,,0,0,0,,C-Cho hỏi ai vậy ạ?
Dialogue: 0,0:12:40.49,0:12:42.49,Default,,0,0,0,,Lại đùa rồi, tôi là Akito đây.
Dialogue: 0,0:12:42.49,0:12:43.95,Default,,0,0,0,,Ối, em xin lỗi.
Dialogue: 0,0:12:44.37,0:12:47.41,Default,,0,0,0,,Cho dù cosplay hay không,\N chị ấy vẫn ngầu ghê.
Dialogue: 0,0:12:47.91,0:12:50.75,Default,,0,0,0,,Vậy để tôi góp thêm một câu chuyện kinh dị nữa.
Dialogue: 0,0:12:50.75,0:12:53.88,Default,,0,0,0,,Đã nói không phải đại hội\N kể chuyện kinh dị rồi mà.
Dialogue: 0,0:12:54.25,0:12:59.59,Default,,0,0,0,,Trong giới cosplayer thường nghe vụ bị nghi ngờ \Nngoại tình vì sợi tóc giả rụng ra đúng không?
Dialogue: 0,0:13:00.55,0:13:06.10,Default,,0,0,0,,Còn trường hợp của tôi, thì mỗi ngày\N đều treo đống áo khoác nam giới khắp nơi trong nhà.
Dialogue: 0,0:13:06.10,0:13:11.31,Default,,0,0,0,,Tuy gia đình biết tôi cosplay, \Nnhưng họ không nghĩ là tôi giả trai,
Dialogue: 0,0:13:11.31,0:13:13.94,Default,,0,0,0,,và cũng hiếm khi gặng hỏi về chuyện này.
Dialogue: 0,0:13:13.94,0:13:15.48,Default,,0,0,0,,Ừm, ừm.
Dialogue: 0,0:13:15.48,0:13:17.86,Default,,0,0,0,,Thế rồi không biết từ lúc nào, cả nhà tôi...
Dialogue: 0,0:13:17.86,0:13:21.03,Default,,0,0,0,,(Mẹ) Ít nhất thì con cũng nên\N bỏ cái tên mặc áo khoác da đi nhé.
Dialogue: 0,0:13:21.03,0:13:21.95,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:21.95,0:13:26.58,Default,,0,0,0,,...đều nghĩ tôi là con nhỏ bắt cá lắm tay\N với đủ hết các thể loại đàn ông.
Dialogue: 0,0:13:30.50,0:13:33.88,Default,,0,0,0,,Cơ mà, bé Liliel trông có vẻ \Nchưa gặp phải chuyện phiền muộn gì ha.
Dialogue: 0,0:13:35.50,0:13:39.13,Default,,0,0,0,,Da dẻ thì mịn màng, lại còn dễ thương,\N vóc dáng cũng rất chuẩn.
Dialogue: 0,0:13:39.84,0:13:40.80,Default,,0,0,0,,Chớ thả thính em nó!
Dialogue: 0,0:13:41.55,0:13:45.51,Default,,0,0,0,,K-Không dám đâu ạ, \Nem cũng gặp nhiều chuyện trăn trở lắm.
Dialogue: 0,0:13:46.14,0:13:49.60,Default,,0,0,0,,Em đã là nấm lùn thì chớ \Nmà được có mỗi bộ ngực là phát triển,
Dialogue: 0,0:13:49.60,0:13:53.19,Default,,0,0,0,,vì vậy dáng người của em ít nằm trong \Nkhuôn mẫu phổ biến của thế giới.
Dialogue: 0,0:13:54.31,0:13:58.15,Default,,0,0,0,,Nên là trên đời này\N không có bộ đồ nào phù hợp với em hết!
Dialogue: 0,0:13:58.73,0:14:01.61,Default,,0,0,0,, À, câu này nghe suốt...
Dialogue: 0,0:14:01.61,0:14:02.70,Default,,0,0,0,,Ừm, ừm.
Dialogue: 0,0:14:03.82,0:14:06.62,Default,,0,0,0,,Em cũng muốn cosplay nhiều kiểu lắm chứ,
Dialogue: 0,0:14:06.62,0:14:10.87,Default,,0,0,0,,nhưng nếu là trang phục không ôm theo \Nđường cong cơ thể thì nhìn em như bị béo phì,
Dialogue: 0,0:14:10.87,0:14:15.21,Default,,0,0,0,,nên là em... có lẽ cả đời này của em...
Dialogue: 0,0:14:15.21,0:14:18.21,Default,,0,0,0,,chỉ có thể mặc được mấy bộ hở hang thôi.
Dialogue: 0,0:14:18.21,0:14:20.21,Default,,0,0,0,,Nhưng em lại quá xấu hổ nên không dám mặc.
Dialogue: 0,0:14:21.17,0:14:22.84,Default,,0,0,0,,Ngoan, ngoan.
Dialogue: 0,0:14:22.84,0:14:25.51,Default,,0,0,0,,Nhưng trang phục hôm nay của em đáng yêu mà.
Dialogue: 0,0:14:25.51,0:14:27.93,Default,,0,0,0,,- Tại vì bộ này được chuyên gia chọn cho
Dialogue: 0,0:14:27.93,0:14:30.47,Default,,0,0,0,,- Gì hả?\N- nên riêng hôm nay là em gian lận ạ.
Dialogue: 0,0:14:30.47,0:14:32.10,Default,,0,0,0,,Chuyên gia cơ à.
Dialogue: 0,0:14:32.10,0:14:34.02,Default,,0,0,0,,Chuyên gia với chả chuyên môn gì.
Dialogue: 0,0:14:34.02,0:14:36.06,Default,,0,0,0,,Chứ bình thường em ăn mặc như thế nào?
Dialogue: 0,0:14:36.06,0:14:37.90,Default,,0,0,0,,Có hình gì không?
Dialogue: 0,0:14:37.90,0:14:40.32,Default,,0,0,0,,Tấm mà em gửi cho chuyên gia xem là...
Dialogue: 0,0:14:46.41,0:14:49.20,Default,,0,0,0,,Quả nhiên nhìn không vừa chút nào mấy chị nhỉ?
Dialogue: 0,0:14:50.95,0:14:53.41,Default,,0,0,0,,Trước khi bàn đến kích cỡ thì... nhìn phèn quá.
Dialogue: 0,0:14:53.41,0:14:56.54,Default,,0,0,0,,- Ngón tay chữ V hồn nhiên mà nhìn thảm thương.\N- Nhưng không dám nói.
Dialogue: 0,0:15:03.05,0:15:07.05,Default,,0,0,0,,Chị gái Elf... quần nhỏ!\N Em phải trả quần nhỏ này lại cho chị ấy.
Dialogue: 0,0:15:07.05,0:15:08.60,Default,,0,0,0,,Này là quần an toàn nha.
Dialogue: 0,0:15:08.60,0:15:10.26,Default,,0,0,0,,Giọng em to ghê á.
Dialogue: 0,0:15:10.26,0:15:11.64,Default,,0,0,0,,Cô ấy vừa đi ra rồi đó.
Dialogue: 0,0:15:11.64,0:15:13.60,Default,,0,0,0,,Ế! Em không nhận ra luôn.
Dialogue: 0,0:15:13.60,0:15:17.15,Default,,0,0,0,,Chuyện thường, thay đồ xong\N thì chẳng biết ai với ai nữa.
Dialogue: 0,0:15:17.15,0:15:19.44,Default,,0,0,0,,Cô ấy có nhắn là em không cần trả cũng được.
Dialogue: 0,0:15:19.44,0:15:22.44,Default,,0,0,0,,Nhưng... E-Em sẽ thử tìm chị ấy xem sao.
Dialogue: 0,0:15:27.95,0:15:32.62,Default,,0,0,0,,Dạ, em cảm ơn mọi người đã giúp đỡ ạ.\N Em xin phép về trước.
Dialogue: 0,0:15:34.08,0:15:35.37,Default,,0,0,0,,Bé Liliel!
Dialogue: 0,0:15:36.21,0:15:37.08,Default,,0,0,0,,Vâng!
Dialogue: 0,0:15:37.46,0:15:39.04,Default,,0,0,0,,Hẹn gặp lại ở Natsu-Comi nhé!
Dialogue: 0,0:15:41.25,0:15:42.75,Default,,0,0,0,,Natsu-Comi...
Dialogue: 0,0:15:52.85,0:15:55.64,Default,,0,0,0,,Em ấy không có SNS với danh thiếp thật luôn nhỉ.
Dialogue: 0,0:15:55.64,0:15:57.56,Default,,0,0,0,,Liệu có gặp lại không ta.
Dialogue: 0,0:16:01.98,0:16:03.57,Default,,0,0,0,,Natsu-Comi!
Dialogue: 0,0:16:12.12,0:16:13.41,Default,,0,0,0,,Đàn anh!
Dialogue: 0,0:16:15.37,0:16:16.71,Default,,0,0,0,,Ririsa.
Dialogue: 0,0:16:20.33,0:16:21.88,Default,,0,0,0,,Để anh chờ rồi ạ.
Dialogue: 0,0:16:22.34,0:16:25.13,Default,,0,0,0,,Xong xuôi hết hả? \N40 phút nữa xe điện mới tới...
Dialogue: 0,0:16:25.13,0:16:28.22,Default,,0,0,0,,Chưa, thật ra, ưm...
Dialogue: 0,0:16:29.26,0:16:33.51,Default,,0,0,0,,Chị Elf ơi! Chị Elf có ở đây không ạ?
Dialogue: 0,0:16:33.51,0:16:35.60,Default,,0,0,0,,Chị Elf!
Dialogue: 0,0:16:36.23,0:16:39.35,Default,,0,0,0,,Cháu gái, cháu đang tìm chị Erufu sao?
Dialogue: 0,0:16:39.35,0:16:43.77,Default,,0,0,0,,Vâng, tai chị ấy dài...\N À, có lẽ bây giờ không còn dài nữa ạ.
Dialogue: 0,0:16:43.77,0:16:46.36,Default,,0,0,0,,- Tai ư?\N- Tên là Erufu thì phải.
Dialogue: 0,0:16:46.36,0:16:48.45,Default,,0,0,0,,Chị gái Erufu có ở đây không?
Dialogue: 0,0:16:48.45,0:16:50.74,Default,,0,0,0,,- Elf! Chị Elf ơi!
Dialogue: 0,0:16:50.74,0:16:52.20,Default,,0,0,0,,- Chuyện quái gì đây?\N- Elf! Chị Elf ơi!
Dialogue: 0,0:16:52.20,0:16:53.78,Default,,0,0,0,,Chị gái Erufu ở có đây không?
Dialogue: 0,0:16:54.12,0:16:56.04,Default,,0,0,0,,Chị Elf ơi!
Dialogue: 0,0:16:56.04,0:16:59.25,Default,,0,0,0,,Này, bẽ mặt lắm nên đừng hét lớn lên nữa!
Dialogue: 0,0:17:01.96,0:17:04.17,Default,,0,0,0,,Chị Elf tới rồi nè.
Dialogue: 0,0:17:04.17,0:17:05.59,Default,,0,0,0,,Mĩ nhân~
Dialogue: 0,0:17:06.21,0:17:07.59,Default,,0,0,0,,Bạn này là đối tác của em?
Dialogue: 0,0:17:07.59,0:17:08.59,Default,,0,0,0,,A, vâng!
Dialogue: 0,0:17:08.97,0:17:11.26,Default,,0,0,0,,- C-Chị Elf...\N- SUỴT!
Dialogue: 0,0:17:11.26,0:17:16.14,Default,,0,0,0,,Ngày thường chị làm công sở ở gần khu này\N nên giữ miệng lại giùm chị.
Dialogue: 0,0:17:16.14,0:17:17.77,Default,,0,0,0,,Lại một người sống ngầm.
Dialogue: 0,0:17:18.10,0:17:21.94,Default,,0,0,0,,C-Chị ơi, em nghĩ là phải trả cái này lại cho chị.
Dialogue: 0,0:17:24.31,0:17:27.40,Default,,0,0,0,,Giữ luôn có phải hơn không.\N Lễ nghĩa ghê à.
Dialogue: 0,0:17:27.99,0:17:29.65,Default,,0,0,0,,ROM đầu tiên của em thế nào?
Dialogue: 0,0:17:29.65,0:17:35.12,Default,,0,0,0,,C-Chuyện đó, em bất cẩn nhiều thứ\N nên không bán được đĩa nào ạ.
Dialogue: 0,0:17:35.12,0:17:38.37,Default,,0,0,0,,Ái chà. Mà ban đầu ai cũng vậy thôi em ạ.
Dialogue: 0,0:17:38.37,0:17:40.62,Default,,0,0,0,,Mayura cũng chẳng bán được đĩa nào đó.
Dialogue: 0,0:17:40.62,0:17:42.33,Default,,0,0,0,,Thật ạ?
Dialogue: 0,0:17:42.33,0:17:46.34,Default,,0,0,0,,Một ngày nào đó em cũng sẽ tạo nên \Nmột ROM đỉnh cao giống cô Mayura ạ.
Dialogue: 0,0:17:49.30,0:17:50.55,Default,,0,0,0,,Ừm.
Dialogue: 0,0:17:51.01,0:17:53.97,Default,,0,0,0,,Nhắc mới nhớ, hôm nay cô Mayura...
Dialogue: 0,0:17:53.97,0:17:58.35,Default,,0,0,0,,Ừm... có lẽ Mayura sẽ không đến\N bất kì sự kiện nào nữa đâu.
Dialogue: 0,0:18:00.23,0:18:03.56,Default,,0,0,0,,Ể, lẽ nào cô ấy bỏ cosplay rồi ạ?
Dialogue: 0,0:18:03.94,0:18:07.77,Default,,0,0,0,,Ừ thì, có thể nói là rửa tay gác kiếm...
Dialogue: 0,0:18:07.77,0:18:10.24,Default,,0,0,0,,Kiểu nói gì nghe như tội phạm vậy.
Dialogue: 0,0:18:10.74,0:18:13.66,Default,,0,0,0,,Thì người lớn vấp phải nhiều vấn đề lắm em ơi.
Dialogue: 0,0:18:13.66,0:18:16.62,Default,,0,0,0,,Nhưng chị sẽ kể lại chuyện đã gặp em cho cô ấy.
Dialogue: 0,0:18:31.67,0:18:34.84,Default,,0,0,0,,Ririsa, "cô Mayura" là...
Dialogue: 0,0:18:35.93,0:18:39.06,Default,,0,0,0,,Vâng, là người cosplay\N trong ROM "Succubus ngực khủng".
Dialogue: 0,0:18:40.47,0:18:43.02,Default,,0,0,0,,Vậy đây là chuyện nghiêm trọng nhỉ.
Dialogue: 0,0:18:44.10,0:18:48.69,Default,,0,0,0,,Chẳng những không bán được ROM,\N mà người em ấy kính trọng còn giải nghệ nữa chứ.
Dialogue: 0,0:18:48.69,0:18:51.74,Default,,0,0,0,,Phải an ủi thế nào đây.
Dialogue: 0,0:18:52.86,0:18:55.11,Default,,0,0,0,,Anh không cần lo lắng đâu.
Dialogue: 0,0:18:55.49,0:18:59.83,Default,,0,0,0,,Miễn là em vẫn tiếp tục tham gia sự kiện,\N biết đâu một ngày nào đó có thể gặp lại cô ấy.
Dialogue: 0,0:18:59.83,0:19:03.29,Default,,0,0,0,,Em cũng muốn hội ngộ với các chị\N mà em đã được gặp gỡ hôm nay.
Dialogue: 0,0:19:09.13,0:19:12.96,Default,,0,0,0,,Anh ơi, em sẽ tham gia Natsu-Comi.
Dialogue: 0,0:19:13.76,0:19:15.18,Default,,0,0,0,,Natsu-Comi.
Dialogue: 0,0:19:15.51,0:19:20.26,Default,,0,0,0,,Tuy hôm nay vấp phải thất bại,\N nhưng em sẽ làm ra đĩa ROM tốt hơn nữa.
Dialogue: 0,0:19:20.26,0:19:22.68,Default,,0,0,0,,Vì em muốn tham gia sự kiện.
Dialogue: 0,0:19:28.56,0:19:29.48,Default,,0,0,0,,Ừ.
Dialogue: 0,0:19:30.40,0:19:32.69,Default,,0,0,0,,Xem ra mình lo lắng cả nghĩ rồi.
Dialogue: 0,0:19:33.44,0:19:37.86,Default,,0,0,0,,Ngay từ đầu, em ấy đã không bỏ cuộc mà cố gắng đến tận cấp ba đấy thôi.
Dialogue: 0,0:19:51.21,0:19:54.01,Default,,0,0,0,,A-Anh sẽ giúp em chứ?
Dialogue: 0,0:20:00.35,0:20:03.18,Default,,0,0,0,,Tất nhiên rồi, \Nsao tự nhiên đến giờ còn hỏi như thế?
Dialogue: 0,0:20:04.02,0:20:09.69,Default,,0,0,0,,Lần này, em có thể làm được ROM và tham gia sự kiện, rồi còn được cosplay nữa,
Dialogue: 0,0:20:09.69,0:20:11.61,Default,,0,0,0,,tất cả đều là nhờ có anh.
Dialogue: 0,0:20:11.61,0:20:13.53,Default,,0,0,0,,Làm gì có chuyện đó.
Dialogue: 0,0:20:13.53,0:20:15.15,Default,,0,0,0,,Là nhờ Ririsa đã cố gắng đấy chứ.
Dialogue: 0,0:20:15.15,0:20:16.70,Default,,0,0,0,,Không đúng!
Dialogue: 0,0:20:16.70,0:20:19.28,Default,,0,0,0,,Tất cả đều nhờ có anh nên em mới làm được.
Dialogue: 0,0:20:25.45,0:20:28.50,Default,,0,0,0,,Nếu không có anh, thì em...
Dialogue: 0,0:20:31.46,0:20:32.79,Default,,0,0,0,,Ririsa?
Dialogue: 0,0:20:36.13,0:20:41.18,Default,,0,0,0,,Dạo này, mỗi khi ở cạnh anh,\N tự nhiên em thấy rất kì lạ.
Dialogue: 0,0:20:41.80,0:20:44.35,Default,,0,0,0,,Lúc hai đứa ở riêng thì em lại hồi hộp.
Dialogue: 0,0:20:44.35,0:20:48.56,Default,,0,0,0,,Những lúc được anh cứu giúp,\N trong tim em lại thấy nóng bừng.
Dialogue: 0,0:20:50.81,0:20:52.40,Default,,0,0,0,,Trong tim nóng bừng?
Dialogue: 0,0:20:52.40,0:20:56.28,Default,,0,0,0,,Nói mới để ý, cứ hễ ở riêng với Ririsa là mình cũng...
Dialogue: 0,0:20:56.28,0:20:58.28,Default,,0,0,0,,Hóa ra Ririsa cũng vậy ư?
Dialogue: 0,0:20:58.28,0:20:59.82,Default,,0,0,0,,Vậy chẳng phải...
Dialogue: 0,0:21:01.78,0:21:07.04,Default,,0,0,0,,Em vẫn luôn băn khoăn rốt cuộc cảm xúc này là gì,\N và cuối cùng hôm nay em đã nhận ra.
Dialogue: 0,0:21:08.50,0:21:10.50,Default,,0,0,0,,Nên em nghĩ là...
Dialogue: 0,0:21:11.37,0:21:13.34,Default,,0,0,0,,mình cần bày tỏ với anh.
Dialogue: 0,0:21:19.67,0:21:21.18,Default,,0,0,0,,Em...
Dialogue: 0,0:21:22.80,0:21:25.51,Default,,0,0,0,,...yêu anh lắm ạ.
Dialogue: 0,0:21:35.61,0:21:36.78,Default,,0,0,0,,Ưm...
Dialogue: 0,0:21:37.11,0:21:41.28,Default,,0,0,0,,Em cực kì yêu anh...\N với tư cách là cộng sự cosplay!
Dialogue: 0,0:21:42.41,0:21:44.78,Default,,0,0,0,,Sự kiện hôm nay đã khiến em nhận ra.
Dialogue: 0,0:21:44.78,0:21:48.91,Default,,0,0,0,,Rằng em hạnh phúc biết nhường nào \Nkhi tìm được anh phó nháy tuyệt vời thế này.
Dialogue: 0,0:21:48.91,0:21:53.33,Default,,0,0,0,,H-Hóa ra là vậy! \NVới tư cách là CỘNG SỰ cosplay!
Dialogue: 0,0:21:53.33,0:21:55.17,Default,,0,0,0,,Ra vậy, mình thông não rồi.
Dialogue: 0,0:21:56.84,0:22:00.84,Default,,0,0,0,,Suy ra, cảm xúc của mình cũng không phải\N là "tình yêu" mà là giống như của em ấy.
Dialogue: 0,0:22:00.84,0:22:04.05,Default,,0,0,0,,Thì ra cái cảm giác bức bối này \Nlà do mình ghen với tư cách là phó nháy.
Dialogue: 0,0:22:04.43,0:22:08.14,Default,,0,0,0,,Thì ra tim đập loạn nhịp là do \Nmình kính trọng anh ấy với tư cách là cosplayer.
Dialogue: 0,0:22:08.14,0:22:11.52,Default,,0,0,0,,Cứ tưởng mình mà yêu anh ấy thật \Nthì chẳng biết phải làm sao luôn.
Dialogue: 0,0:22:11.52,0:22:14.77,Default,,0,0,0,,Mình làm sao có thể là đứa thất hứa trước được.
Dialogue: 0,0:22:14.77,0:22:16.27,Default,,0,0,0,,Thôi đi, ngại quá.
Dialogue: 0,0:22:20.44,0:22:22.65,Default,,0,0,0,,- Tạ ơn trời~\N- Tạ ơn trời~
