Dialogue: 0,0:00:03.98,0:00:05.99,Default,,0,0,0,,Vì tôi yêu...
Dialogue: 0,0:00:07.49,0:00:08.66,Default,,0,0,0,,Tôi yêu...
Dialogue: 0,0:00:09.66,0:00:11.24,Default,,0,0,0,,...anh Okumura.
Dialogue: 0,0:00:21.50,0:00:24.96,Default,,0,0,0,,Suốt 10 năm kể từ lúc gặp nhau, tôi vẫn luôn...
Dialogue: 0,0:00:25.76,0:00:28.42,Default,,0,0,0,,yêu một mình anh ấy.
Dialogue: 0,0:00:30.22,0:00:32.85,Default,,0,0,0,,Cậu yêu... anh Okumura...
Dialogue: 0,0:00:34.93,0:00:37.64,Default,,0,0,0,,H-Hóa ra là vậy sao!?
Dialogue: 0,0:00:37.64,0:00:40.06,Default,,0,0,0,,Biết ngay là cô nàng này không nhận ra mà.
Dialogue: 0,0:00:43.36,0:00:47.19,Default,,0,0,0,,Tớ chẳng mảy may hay biết gì.
Dialogue: 0,0:00:47.19,0:00:48.70,Default,,0,0,0,,Đã vậy,
Dialogue: 0,0:00:49.11,0:00:51.24,Default,,0,0,0,,còn làm nhiều việc riêng với anh ấy.
Dialogue: 0,0:00:53.24,0:00:56.87,Default,,0,0,0,,Mình... vừa nói ra những lời thật hèn hạ.
Dialogue: 0,0:00:57.50,0:00:59.87,Default,,0,0,0,,Tại sao mình lại buột miệng như vậy chứ.
Dialogue: 0,0:00:59.87,0:01:04.09,Default,,0,0,0,,Nếu mình nói thẳng tâm tư ra, \Nchắc chắn Ririsa sẽ tìm cách để giúp mình.
Dialogue: 0,0:01:04.59,0:01:06.88,Default,,0,0,0,,Và nếu cậu ấy thật sự nhúng tay vào,
Dialogue: 0,0:01:06.88,0:01:11.26,Default,,0,0,0,,mà dẫu có làm gì, thì chuyện giữa mình \Nvà anh ấy cũng nào được như ý cơ chứ.
Dialogue: 0,0:01:11.97,0:01:14.47,Default,,0,0,0,,Chỉ có nỗi ân hận là dằn vặt mình suốt đời thôi.
Dialogue: 0,0:01:15.18,0:01:19.73,Default,,0,0,0,,Tớ cũng đâu ngờ Natsu-Comi lần này\N lại được cùng bạn bè cosplay.
Dialogue: 0,0:01:20.23,0:01:22.60,Default,,0,0,0,,Xin lỗi cậu, tớ sẽ không rủ anh ấy...
Dialogue: 0,0:01:22.60,0:01:23.56,Default,,0,0,0,,Đừng nói nữa.
Dialogue: 0,0:01:24.81,0:01:27.44,Default,,0,0,0,,Xin cậu đấy, \Nxem như chưa từng nghe thấy gì đi.
Dialogue: 0,0:01:28.07,0:01:29.36,Default,,0,0,0,,Tôi xạo đấy.
Dialogue: 0,0:01:30.82,0:01:33.70,Default,,0,0,0,,Tôi chỉ đùa thôi, yêu đương cái nỗi gì.
Dialogue: 0,0:01:40.75,0:01:41.71,Default,,0,0,0,,Không được.
Dialogue: 0,0:01:45.17,0:01:49.01,Default,,0,0,0,,Thân là otaku, tớ sẽ không phủ định\N những chuyện thiên về sở thích.
Dialogue: 0,0:01:49.01,0:01:51.63,Default,,0,0,0,,Chính anh ấy đã dạy cho tớ biết điều đó.
Dialogue: 0,0:01:51.63,0:01:53.22,Default,,0,0,0,,Tớ cũng xin rút lại những lời vừa nãy.
Dialogue: 0,0:01:53.22,0:01:56.47,Default,,0,0,0,,Nên là cậu hãy kể cho tớ nghe\N về anh Okumura mà cậu yêu đi.
Dialogue: 0,0:01:56.47,0:01:58.77,Default,,0,0,0,,Ơ, tại sao tôi lại phải kể cho cậu nghe...
Dialogue: 0,0:01:58.77,0:02:01.35,Default,,0,0,0,,Tớ muốn biết về tình yêu của Mikari.
Dialogue: 0,0:02:05.19,0:02:07.73,Default,,0,0,0,,Tôi yêu đôi mắt lờ đờ của anh ấy.
Dialogue: 0,0:02:08.82,0:02:11.28,Default,,0,0,0,,Yêu dáng người dong dỏng cao.
Dialogue: 0,0:02:11.28,0:02:13.45,Default,,0,0,0,,Yêu cả dáng người nhỏ nhắn lúc xưa nữa.
Dialogue: 0,0:02:13.45,0:02:15.62,Default,,0,0,0,,Yêu chỏm tóc tròn phía sau gáy.
Dialogue: 0,0:02:15.62,0:02:17.66,Default,,0,0,0,,Yêu ánh mắt khi anh nhìn về phía tôi.
Dialogue: 0,0:02:18.28,0:02:21.33,Default,,0,0,0,,Yêu cái cách anh xả thân để giúp đỡ ai đó.
Dialogue: 0,0:02:23.25,0:02:25.04,Default,,0,0,0,,Cậu biết không,
Dialogue: 0,0:02:25.04,0:02:28.09,Default,,0,0,0,,anh ấy luôn sống hết lòng vì mọi người,
Dialogue: 0,0:02:28.09,0:02:31.51,Default,,0,0,0,,nhưng lại không nhận ra \Ncảm xúc của họ dành cho mình.
Dialogue: 0,0:02:31.51,0:02:33.93,Default,,0,0,0,,Ngoài mặt thì xã giao,\N nhưng trái tim lại khép chặt.
Dialogue: 0,0:02:34.72,0:02:37.18,Default,,0,0,0,,Anh ấy đã mất niềm tin\N vào con gái ngoài đời thật từ nhỏ,
Dialogue: 0,0:02:37.18,0:02:39.60,Default,,0,0,0,,và cho đến bây giờ vẫn chẳng thay đổi gì.
Dialogue: 0,0:02:40.43,0:02:42.31,Default,,0,0,0,,Vốn dĩ, từ trước khi gặp tôi thì...
Dialogue: 0,0:02:43.52,0:02:44.39,Default,,0,0,0,,Gì hả?
Dialogue: 0,0:02:44.39,0:02:47.77,Default,,0,0,0,,Mikari đúng là hiểu rõ về anh ấy ghê ha.
Dialogue: 0,0:02:48.11,0:02:51.15,Default,,0,0,0,,Ừ thì, tôi đã dõi theo anh ấy suốt 10 năm rồi còn gì.
Dialogue: 0,0:02:51.15,0:02:53.07,Default,,0,0,0,,Hẳn là cậu yêu anh ấy sâu đậm lắm.
Dialogue: 0,0:02:53.07,0:02:55.70,Default,,0,0,0,,Không phải vì yêu nên tôi mới dõi theo anh ấy đâu.
Dialogue: 0,0:02:57.41,0:02:59.33,Default,,0,0,0,,Mà là vì muốn tìm lí do để ghét anh ấy.
Dialogue: 0,0:02:59.99,0:03:03.20,Default,,0,0,0,,Đã bao lần tôi cố gạt anh ra khỏi tâm trí.
Dialogue: 0,0:03:03.20,0:03:05.79,Default,,0,0,0,,Bởi vì ôm ấp tình cảm này, \Nchỉ tổ làm đau mình thêm thôi.
Dialogue: 0,0:03:06.46,0:03:08.63,Default,,0,0,0,,Tôi tự nhủ là do mình lầm lỡ nhất thời,
Dialogue: 0,0:03:08.63,0:03:12.67,Default,,0,0,0,,là do những kỉ niệm đẹp bên nhau \Nnên tôi mới say nắng tên otaku ngớ ngẩn đó thôi.
Dialogue: 0,0:03:13.71,0:03:16.76,Default,,0,0,0,,Vì muốn căm ghét, muốn quên đi anh ấy,
Dialogue: 0,0:03:16.76,0:03:19.43,Default,,0,0,0,,nên tôi mới cố tình \Ntìm thật nhiều điểm xấu của anh.
Dialogue: 0,0:03:20.39,0:03:22.31,Default,,0,0,0,,Rốt cuộc lại không tìm thấy chứ gì?
Dialogue: 0,0:03:22.31,0:03:25.39,Default,,0,0,0,,Cậu không hiểu gì hết, ngược lại thì có.
Dialogue: 0,0:03:25.81,0:03:28.81,Default,,0,0,0,,Nhiều nữa là đằng khác, \Nđến mức không đếm xuể luôn.
Dialogue: 0,0:03:28.81,0:03:32.44,Default,,0,0,0,,Vừa là otaku ngáo ngơ, vừa chậm tiêu,\N còn nhiều cái không buồn muốn nói tới.
Dialogue: 0,0:03:32.94,0:03:36.20,Default,,0,0,0,,Tôi quyết phải tìm thật nhiều\N tật xấu hết mức có thể,
Dialogue: 0,0:03:36.20,0:03:37.82,Default,,0,0,0,,và đã tìm thấy rất nhiều...
Dialogue: 0,0:03:40.03,0:03:41.41,Default,,0,0,0,,Ấy vậy mà, tôi vẫn...
Dialogue: 0,0:03:42.41,0:03:44.54,Default,,0,0,0,,không thể ngừng yêu anh ấy.
Dialogue: 0,0:03:46.04,0:03:48.08,Default,,0,0,0,,Hóa ra không phải rung động nhất thời.
Dialogue: 0,0:03:49.21,0:03:50.79,Default,,0,0,0,,Tuyệt vọng lắm đúng không?
Dialogue: 0,0:03:51.71,0:03:54.96,Default,,0,0,0,,Tình yêu... lại khiến cậu tuyệt vọng...
Dialogue: 0,0:03:57.97,0:03:59.43,Default,,0,0,0,,Giờ tới lượt cậu.
Dialogue: 0,0:04:01.35,0:04:04.64,Default,,0,0,0,,Tôi hỏi lại lần nữa, \N cậu nghĩ sao về anh ấy hả, Ririsa?
Dialogue: 0,0:04:06.39,0:04:08.60,Default,,0,0,0,,Tớ thích anh ấy.
Dialogue: 0,0:04:08.85,0:04:09.81,Default,,0,0,0,,Trả lời ngay luôn...
Dialogue: 0,0:04:10.31,0:04:13.86,Default,,0,0,0,,Tớ không chắc là nó có giống \Nvới tình cảm của Mikari hay không,
Dialogue: 0,0:04:13.86,0:04:15.57,Default,,0,0,0,,nhưng ý tớ là...
Dialogue: 0,0:04:15.86,0:04:17.53,Default,,0,0,0,,Tớ rất hiểu cảm xúc của cậu.
Dialogue: 0,0:04:18.74,0:04:20.41,Default,,0,0,0,,Anh ấy đúng là tuyệt thật ha.
Dialogue: 0,0:04:20.41,0:04:24.41,Default,,0,0,0,,Tớ hiểu hết ý cậu khi khen cặp mắt lờ đờ,\N dáng người cao và chỏm tóc tròn của anh ấy.
Dialogue: 0,0:04:24.41,0:04:26.58,Default,,0,0,0,,Tớ cũng thích những điểm đó \Nđến mức muốn bàn thêm nữa ấy.
Dialogue: 0,0:04:27.29,0:04:28.75,Default,,0,0,0,,Gì vậy trời.
Dialogue: 0,0:04:28.75,0:04:31.42,Default,,0,0,0,,Anh ấy có phải nhân vật trong truyện đâu.
Dialogue: 0,0:04:31.42,0:04:33.67,Default,,0,0,0,,Đối với tớ thì đều như nhau thôi.
Dialogue: 0,0:04:34.34,0:04:37.92,Default,,0,0,0,,Thích một người \Nhay thích một nhân vật trong truyện,
Dialogue: 0,0:04:38.51,0:04:42.05,Default,,0,0,0,,có là động vật hay các loại tàu điện,\N chung quy đều như nhau.
Dialogue: 0,0:04:42.76,0:04:48.35,Default,,0,0,0,,Nếu không thì sẽ thành phủ định tình yêu \Nmà anh ấy dành cho Liliel mất.
Dialogue: 0,0:04:50.02,0:04:52.31,Default,,0,0,0,,Vì anh ấy là một người giàu tình cảm...
Dialogue: 0,0:04:53.40,0:04:55.19,Default,,0,0,0,,Đã có tôi ở bên cạnh em.
Dialogue: 0,0:04:55.19,0:04:57.49,Default,,0,0,0,,Tôi sẽ luôn kề bên và tin tưởng Ririsa.
Dialogue: 0,0:04:58.07,0:05:02.32,Default,,0,0,0,,Cũng nhờ gặp được một đàn anh chân thành như thế, \Ntớ mới được cứu rỗi.
Dialogue: 0,0:05:04.91,0:05:07.20,Default,,0,0,0,,Tớ là một cosplayer.
Dialogue: 0,0:05:07.20,0:05:11.87,Default,,0,0,0,,Và chỉ khi kết hợp với anh ấy,\N mới có được một cosplayer Amano Ririsa hoàn thiện.
Dialogue: 0,0:05:11.87,0:05:15.84,Default,,0,0,0,,Nếu không có anh ấy,\N thì tớ không còn là chính mình nữa.
Dialogue: 0,0:05:16.88,0:05:21.47,Default,,0,0,0,,Qua đó mới thấy, anh ấy là mảnh ghép\N không thể thiếu trong cuộc đời tớ.
Dialogue: 0,0:05:22.76,0:05:25.18,Default,,0,0,0,,Tớ không chắc liệu đó có phải\N là tình yêu đôi lứa hay không,
Dialogue: 0,0:05:25.18,0:05:26.93,Default,,0,0,0,,nhưng đối với tớ,
Dialogue: 0,0:05:27.77,0:05:30.14,Default,,0,0,0,,thì "yêu" là như vậy đó.
Dialogue: 0,0:05:31.56,0:05:33.85,Default,,0,0,0,,Cậu thấy sao?
Dialogue: 0,0:05:44.32,0:05:47.24,Default,,0,0,0,,Xem ra, cậu cũng yêu anh ấy\N không thua kém gì tôi nhỉ.
Dialogue: 0,0:05:48.37,0:05:50.20,Default,,0,0,0,,Tự nhiên thấy rối bời ghê.
Dialogue: 0,0:05:51.25,0:05:52.42,Default,,0,0,0,,Âu cũng đáng mừng.
Dialogue: 0,0:05:55.50,0:05:58.13,Default,,0,0,0,,Hai đứa mình đúng là nghiện anh Okumura ha.
Dialogue: 0,0:05:58.71,0:06:00.46,Default,,0,0,0,,Thôi đi cô.
Dialogue: 0,0:06:01.09,0:06:03.80,Default,,0,0,0,,Cậu kể cho tớ nghe thêm \Nnhiều chuyện về anh ấy nữa đi.
Dialogue: 0,0:06:03.80,0:06:04.68,Default,,0,0,0,,Ể!?
Dialogue: 0,0:06:06.05,0:06:11.68,Default,,0,0,0,,Hóa ra, không phải là mình \Nmuốn trút giận lên tình địch,
Dialogue: 0,0:06:12.52,0:06:17.52,Default,,0,0,0,,chẳng qua là muốn có người lắng nghe\N chuyện tình cay đắng mà mình đã chôn giấu bấy lâu.
Dialogue: 0,0:06:18.65,0:06:20.23,Default,,0,0,0,,Dẫu sau, Ririsa cũng là...
Dialogue: 0,0:06:26.28,0:06:28.28,Default,,0,0,0,,cô bạn thân của mình mà.
Dialogue: 0,0:06:31.91,0:06:32.96,Default,,0,0,0,,Ririsa.
Dialogue: 0,0:06:34.33,0:06:38.17,Default,,0,0,0,,Lỡ như đến một ngày, \Ncậu muốn chiếm lấy anh ấy cho riêng mình,
Dialogue: 0,0:06:38.84,0:06:40.63,Default,,0,0,0,,thì lúc đó không cần bận tâm đến tôi đâu.
Dialogue: 0,0:06:41.30,0:06:42.92,Default,,0,0,0,,Ấy, sao có thể...
Dialogue: 0,0:06:46.89,0:06:48.85,Default,,0,0,0,,Hiểu rồi, cậu cũng vậy nha.
Dialogue: 0,0:06:50.68,0:06:51.77,Default,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:06:59.02,0:07:02.94,Default,,0,0,0,,Mikari... yêu mình ư?
Dialogue: 0,0:07:02.94,0:07:05.24,Default,,0,0,0,,Vậy mà mình lại chẳng hề nhận ra.
Dialogue: 0,0:07:05.70,0:07:06.91,Default,,0,0,0,,Tình cảm đó...
Dialogue: 0,0:07:09.12,0:07:11.49,Default,,0,0,0,,có lẽ không giống với "yêu" của Ririsa.
Dialogue: 0,0:07:12.24,0:07:14.00,Default,,0,0,0,,Mà là giống như mình yêu Liliel,
Dialogue: 0,0:07:14.50,0:07:16.79,Default,,0,0,0,,giống như trước kia khi mình từng yêu một cô gái.
Dialogue: 0,0:07:17.25,0:07:18.50,Default,,0,0,0,,Chính là kiểu đó...
Dialogue: 0,0:07:21.00,0:07:23.96,Default,,0,0,0,,(Xin lỗi nhé.)
Dialogue: 0,0:07:26.22,0:07:29.47,Default,,0,0,0,,Mình không biết có bao nhiêu khả năng sẽ xảy ra,
Dialogue: 0,0:07:29.47,0:07:31.14,Default,,0,0,0,,nhưng nếu được em ấy tỏ tình thì sao?
Dialogue: 0,0:07:32.22,0:07:34.56,Default,,0,0,0,,Lỡ như được ngỏ lời \N trở thành người yêu của em ấy thì sao?
Dialogue: 0,0:07:35.64,0:07:37.52,Default,,0,0,0,,Mình buộc phải từ chối thôi.
Dialogue: 0,0:07:37.52,0:07:39.31,Default,,0,0,0,,Bởi vì mình không yêu Mikari...
Dialogue: 0,0:07:40.11,0:07:42.27,Default,,0,0,0,,Mình không có tình cảm với em ấy.
Dialogue: 0,0:07:43.28,0:07:44.32,Default,,0,0,0,,Quá tàn nhẫn.
Dialogue: 0,0:07:44.90,0:07:48.24,Default,,0,0,0,,Tại sao mình lại nảy sinh ra \Ncái suy nghĩ tàn nhẫn như vậy chứ.
Dialogue: 0,0:07:48.53,0:07:50.78,Default,,0,0,0,,Hãy làm bạn với nhau như trước giờ ư...
Dialogue: 0,0:07:51.45,0:07:53.33,Default,,0,0,0,,Ai mà nghe lọt tai cho nổi.
Dialogue: 0,0:07:53.95,0:07:57.29,Default,,0,0,0,,Ắt hẳn sẽ trở nên rất gượng gạo rồi.
Dialogue: 0,0:07:57.29,0:08:00.29,Default,,0,0,0,,Có khi Mikari sẽ không bao giờ \Nđi đến câu lạc bộ nữa.
Dialogue: 0,0:08:00.29,0:08:03.50,Default,,0,0,0,,À không, hay mình rời khỏi đó thì sẽ tốt hơn?
Dialogue: 0,0:08:03.50,0:08:06.22,Default,,0,0,0,,Nhưng làm vậy, liệu có ai được hạnh phúc không?
Dialogue: 0,0:08:10.97,0:08:12.14,Default,,0,0,0,,Mình...
Dialogue: 0,0:08:21.44,0:08:22.69,Default,,0,0,0,,Cô ơi...
Dialogue: 0,0:08:24.36,0:08:26.82,Default,,0,0,0,,C-Cô trò mình tâm sự chút đi nhỉ.
Dialogue: 0,0:08:31.70,0:08:33.87,Default,,0,0,0,,Cô nghĩ em nên làm thế nào ạ?
Dialogue: 0,0:08:34.24,0:08:36.70,Default,,0,0,0,,Làm thế nào thì chuyện đó...
Dialogue: 0,0:08:36.70,0:08:39.87,Default,,0,0,0,,còn tùy thuộc vào cảm xúc và lựa chọn\N của Mikari từ giờ về sau.
Dialogue: 0,0:08:39.87,0:08:41.58,Default,,0,0,0,,Tất nhiên, phải xét đến cảm xúc của em nữa.
Dialogue: 0,0:08:42.21,0:08:43.96,Default,,0,0,0,,Em sợ hãi điều gì?
Dialogue: 0,0:08:43.96,0:08:47.17,Default,,0,0,0,,Sợ phải từ chối nếu được tỏ tình sao?
Dialogue: 0,0:08:47.17,0:08:50.80,Default,,0,0,0,,Hay sợ từ chối rồi sẽ hủy hoại \Nmối quan hệ hiện tại với Mikari và câu lạc bộ?
Dialogue: 0,0:08:51.39,0:08:54.47,Default,,0,0,0,,Có lẽ... là vậy ạ.
Dialogue: 0,0:08:55.43,0:08:56.31,Default,,0,0,0,,Mà không.
Dialogue: 0,0:08:56.81,0:08:58.18,Default,,0,0,0,,Em cũng không biết nữa.
Dialogue: 0,0:08:58.77,0:09:01.98,Default,,0,0,0,,Em chẳng thể tưởng tượng nổi\N lại có một ngày xảy ra chuyện này.
Dialogue: 0,0:09:02.73,0:09:04.73,Default,,0,0,0,,Nếu là cô thì sẽ làm gì vào những lúc này...
Dialogue: 0,0:09:06.78,0:09:07.90,Default,,0,0,0,,Cô ơi...
Dialogue: 0,0:09:09.28,0:09:11.11,Default,,0,0,0,,Cô có kinh nghiệm yêu đương không ạ?
Dialogue: 0,0:09:11.11,0:09:12.87,Default,,0,0,0,,Bất lịch sự quá đấy.
Dialogue: 0,0:09:14.33,0:09:18.58,Default,,0,0,0,,Cô thì... cũng kém cỏi lắm.\N Vì cô cũng là otaku chính hiệu mà.
Dialogue: 0,0:09:18.91,0:09:21.25,Default,,0,0,0,,Nhưng những điều cần suy ngẫm thì nhiều lắm.
Dialogue: 0,0:09:22.54,0:09:26.50,Default,,0,0,0,,Ngày xưa, cô chẳng thể hiểu nổi mấy chuyện vô nghĩa
Dialogue: 0,0:09:26.50,0:09:30.51,Default,,0,0,0,,như đi hẹn hò trước khi làm người yêu,\N hay tỏ tình lại với người đã từ chối mình.
Dialogue: 0,0:09:31.01,0:09:33.43,Default,,0,0,0,,Chúng ta hay gọi là "đối tượng chinh phục" nhỉ.
Dialogue: 0,0:09:33.43,0:09:35.93,Default,,0,0,0,,Nếu là đối tượng có khả năng trở thành người yêu,
Dialogue: 0,0:09:35.93,0:09:38.06,Default,,0,0,0,,thì chỉ cần trò chuyện \Nsẽ giúp độ cảm mến tăng lên.
Dialogue: 0,0:09:38.06,0:09:40.98,Default,,0,0,0,,Đến lúc vượt qua một mức độ nào đó\N thì chắc chắn sẽ tỏ tình thành công.
Dialogue: 0,0:09:41.31,0:09:45.56,Default,,0,0,0,,Còn những đối tượng khác thì ngay từ đầu \Nđã mặc định là không chinh phục được.
Dialogue: 0,0:09:45.56,0:09:47.44,Default,,0,0,0,,Cô đã luôn ngộ nhận như vậy đấy.
Dialogue: 0,0:09:48.03,0:09:49.69,Default,,0,0,0,,Em thấy đó, trong mấy bộ manga lãng mạn,
Dialogue: 0,0:09:49.69,0:09:53.20,Default,,0,0,0,,mấy cặp sau này sẽ thành người yêu,\N tuy ban đầu không nhận ra nhưng thật chất
Dialogue: 0,0:09:53.20,0:09:55.07,Default,,0,0,0,,họ đã sớm phải lòng đối phương rồi,
Dialogue: 0,0:09:55.07,0:09:58.41,Default,,0,0,0,,và "tỏ tình" giống như một loại hình thức\N giúp họ nhận ra điều đó thôi, đúng không?
Dialogue: 0,0:09:59.41,0:10:00.37,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:00.62,0:10:02.37,Default,,0,0,0,,Nói tóm lại, theo như manga
Dialogue: 0,0:10:02.37,0:10:06.38,Default,,0,0,0,,thì nhân vật chỉ nghĩ xem đối tượng trước mặt họ \Ncó phải là định mệnh của mình hay không thôi.
Dialogue: 0,0:10:08.38,0:10:10.46,Default,,0,0,0,,Nhưng thực tế thì khác.
Dialogue: 0,0:10:10.92,0:10:15.85,Default,,0,0,0,,Có những người chẳng nảy sinh tình cảm gì \Nnhưng vẫn quen đại một ai đó,
Dialogue: 0,0:10:15.85,0:10:21.23,Default,,0,0,0,,hoặc một người được tỏ tình nhiều lần,\N thấy người kia thích mình đến vậy nên thôi đồng ý luôn.
Dialogue: 0,0:10:22.43,0:10:25.90,Default,,0,0,0,,À, xin lỗi, điều mà cô muốn nói...
Dialogue: 0,0:10:25.90,0:10:29.94,Default,,0,0,0,,là em không cần phải cứng nhắc từ chối \Nvì hiện tại không có tình cảm với đối phương.
Dialogue: 0,0:10:31.57,0:10:35.61,Default,,0,0,0,,Khi được tỏ tình cũng là lúc em nhận ra\N tâm tư của đối phương dành cho mình.
Dialogue: 0,0:10:35.61,0:10:38.37,Default,,0,0,0,,Rồi bắt đầu tự vấn lại \Nxem bản thân mình thấy thế nào.
Dialogue: 0,0:10:38.78,0:10:42.08,Default,,0,0,0,,Ví như những lúc ở bên nhau,\N hai đứa chẳng phải giữ kẽ làm gì.
Dialogue: 0,0:10:42.08,0:10:44.25,Default,,0,0,0,,Hay là mình cứ vô thức dõi theo người ấy.
Dialogue: 0,0:10:44.25,0:10:46.13,Default,,0,0,0,,Rồi lại thấy cô đơn khi không gặp nhau.
Dialogue: 0,0:10:46.13,0:10:48.84,Default,,0,0,0,,Như vậy... là mình đã yêu rồi chăng.
Dialogue: 0,0:10:48.84,0:10:49.92,Default,,0,0,0,,Chẳng hạn vậy.
Dialogue: 0,0:10:49.92,0:10:52.72,Default,,0,0,0,,Dần dần em sẽ tìm thấy\N nhiều điểm mình thích ở người đó,
Dialogue: 0,0:10:52.72,0:10:54.88,Default,,0,0,0,,mặc dù trước giờ chưa từng xem\N họ là đối tượng hẹn hò.
Dialogue: 0,0:10:55.55,0:10:57.14,Default,,0,0,0,,Theo quan điểm của cô,
Dialogue: 0,0:10:57.14,0:11:01.56,Default,,0,0,0,,tình yêu không chỉ gói gọn trong việc tìm kiếm \Nhay nhận ra tình cảm và định mệnh của mình.
Dialogue: 0,0:11:02.47,0:11:04.52,Default,,0,0,0,,Có cả những mối tình được vun đắp từ con số không.
Dialogue: 0,0:11:05.23,0:11:09.19,Default,,0,0,0,,Thậm chí quá trình tìm hiểu \Nđể yêu một người cũng có thể gọi là yêu.
Dialogue: 0,0:11:10.23,0:11:12.23,Default,,0,0,0,,Xin lỗi vì cô giải thích tệ quá.
Dialogue: 0,0:11:12.23,0:11:14.65,Default,,0,0,0,,Em có hiểu được ý cô muốn nói không nhỉ?
Dialogue: 0,0:11:17.49,0:11:23.58,Default,,0,0,0,,Em không nhất thiết phải chấm dứt mối quan hệ\N với Mikari vì hiện tại không có hứng thú với em ấy,
Dialogue: 0,0:11:23.58,0:11:28.33,Default,,0,0,0,,lỡ biết được tình cảm của Mikari rồi thì từ giờ \Nhãy dõi theo em ấy, biết đâu sẽ nảy sinh cảm xúc lại.
Dialogue: 0,0:11:28.33,0:11:29.63,Default,,0,0,0,,Ý cô là vậy phải không ạ?
Dialogue: 0,0:11:29.63,0:11:31.46,Default,,0,0,0,,Em học giỏi môn văn phết đấy.
Dialogue: 0,0:11:33.46,0:11:34.92,Default,,0,0,0,,Nhưng em không đủ tự tin.
Dialogue: 0,0:11:36.05,0:11:40.14,Default,,0,0,0,,Liệu từ giờ, em có để ý đến các bạn nữ thật không.
Dialogue: 0,0:11:41.22,0:11:44.14,Default,,0,0,0,,Lí do gì lại khiến em không để ý đến con gái?
Dialogue: 0,0:11:44.98,0:11:48.02,Default,,0,0,0,,Tuy cô không biết em đã chịu đựng \Ntổn thương gì trong quá khứ,
Dialogue: 0,0:11:48.81,0:11:51.48,Default,,0,0,0,,nhưng cô biết em đã trải qua những gì trong năm nay.
Dialogue: 0,0:11:52.19,0:11:57.07,Default,,0,0,0,,Và sau khi gắn kết sâu sắc với các bạn nữ \Nmà em luôn né tránh, thì giờ đây em nghĩ gì?
Dialogue: 0,0:11:57.36,0:11:59.91,Default,,0,0,0,,Em thấy sao về thế giới ngoài đời thực này?
Dialogue: 0,0:12:04.37,0:12:09.75,Default,,0,0,0,,Cô thấy rằng, quả thật trên đời này có những sự thật \Nmà ta không thể nào chấp nhận được,
Dialogue: 0,0:12:09.75,0:12:12.63,Default,,0,0,0,,nhưng cũng có những vẻ đẹp \Nđáng để ta nguyện tin theo.
Dialogue: 0,0:12:12.63,0:12:15.80,Default,,0,0,0,,Thân là giáo viên, \Ncô không thể khuyên em nên lựa chọn bên nào.
Dialogue: 0,0:12:16.22,0:12:19.09,Default,,0,0,0,,Nhưng em thật sự không thể \Nđặt lòng tin vào các bạn nữ sao?
Dialogue: 0,0:12:19.09,0:12:20.30,Default,,0,0,0,,Em...
Dialogue: 0,0:12:21.14,0:12:22.14,Default,,0,0,0,,Okumura.
Dialogue: 0,0:12:22.93,0:12:26.18,Default,,0,0,0,,Em rất có tố chất gắn bó mật thiết với người khác.{Em có sức hút mãnh liệt với những người xung quanh?}
Dialogue: 0,0:12:26.18,0:12:29.40,Default,,0,0,0,,Có bản lĩnh từ bỏ cái tôi\N để xây dựng mối quan hệ với mọi người.
Dialogue: 0,0:12:29.40,0:12:31.48,Default,,0,0,0,,Ắt hẳn, cũng có thể đón nhận ngược lại.
Dialogue: 0,0:12:31.48,0:12:34.15,Default,,0,0,0,,Nên là đừng sợ hãi những người \Nmuốn thân thiết với em.
Dialogue: 0,0:12:34.82,0:12:37.24,Default,,0,0,0,,Trái tim ta không chỉ dành riêng cho một mình ta.
Dialogue: 0,0:12:37.86,0:12:40.91,Default,,0,0,0,,Chỉ khi mở lòng với một ai đó\N thì nhịp đập cuộc sống của em mới bắt đầu.
Dialogue: 0,0:12:43.28,0:12:44.99,Default,,0,0,0,,Cảm nhận được không?
Dialogue: 0,0:12:44.99,0:12:48.50,Default,,0,0,0,,Trái tim mình không chỉ dành riêng cho mình ạ?
Dialogue: 0,0:12:49.21,0:12:53.46,Default,,0,0,0,,Giữa cô và Okumura có một điểm khác nhau\N khi bàn về Liliel đó.
Dialogue: 0,0:12:56.92,0:12:58.80,Default,,0,0,0,,Ngài Ashford ơi!
Dialogue: 0,0:12:59.43,0:13:02.26,Default,,0,0,0,,Liliel không phản bội người khác\N vì cô ấy là thiên thần.
Dialogue: 0,0:13:03.30,0:13:06.06,Default,,0,0,0,,Mà vì người đó là Ashford \Nnên cô ấy mới không muốn phản bội.
Dialogue: 0,0:13:07.81,0:13:11.23,Default,,0,0,0,,Và em là chàng trai xứng đáng \Nđược mọi người trân trọng như vậy đấy,
Dialogue: 0,0:13:11.81,0:13:12.86,Default,,0,0,0,,Okumura.
Dialogue: 0,0:13:14.06,0:13:15.19,Default,,0,0,0,,Mình ư?
Dialogue: 0,0:13:15.86,0:13:18.53,Default,,0,0,0,,Mọi người nghĩ mình giống với Ashford sao?
Dialogue: 0,0:13:18.53,0:13:20.57,Default,,0,0,0,,Giống với cách nghĩ của Liliel?
Dialogue: 0,0:13:22.61,0:13:23.78,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:13:24.70,0:13:27.66,Default,,0,0,0,,Thế nên mình mới không nhận ra\N tình cảm của Mikari.
Dialogue: 0,0:13:28.75,0:13:32.67,Default,,0,0,0,,Mình không hề lẻ loi trong thế giới của riêng mình.
Dialogue: 0,0:13:32.96,0:13:36.80,Default,,0,0,0,,Mình cho rằng chỉ cần \Nbản thân nhìn theo đối phương là đủ.
Dialogue: 0,0:13:36.80,0:13:41.88,Default,,0,0,0,,Chứ chưa bao giờ nghĩ tới việc\N đối phương nhìn nhận mình như thế nào cả.
Dialogue: 0,0:13:42.13,0:13:42.89,Default,,0,0,0,,(Mẹ yêu con.)
Dialogue: 0,0:13:46.22,0:13:49.27,Default,,0,0,0,,Mẹ ơi, những lời đó đều là giả dối sao?
Dialogue: 0,0:13:49.73,0:13:52.35,Default,,0,0,0,,Mình không muốn bị phản bội \Nthêm một lần nào nữa.
Dialogue: 0,0:13:52.81,0:13:55.15,Default,,0,0,0,,Trong thâm tâm mình vẫn luôn sợ hãi.
Dialogue: 0,0:13:55.15,0:13:56.52,Default,,0,0,0,,Sợ đến mức...
Dialogue: 0,0:13:56.52,0:14:00.28,Default,,0,0,0,,đã vô thức ngó lơ \Ntình cảm mà người khác dành cho mình.
Dialogue: 0,0:14:01.28,0:14:02.28,Default,,0,0,0,,Vốn dĩ...
Dialogue: 0,0:14:03.20,0:14:04.41,Default,,0,0,0,,Mình thật sự...
Dialogue: 0,0:14:06.91,0:14:08.37,Default,,0,0,0,,Cô hỏi lại lần nữa.
Dialogue: 0,0:14:09.41,0:14:12.33,Default,,0,0,0,,Liệu em có thể tin tưởng vào các bạn nữ không?
Dialogue: 0,0:14:13.58,0:14:14.63,Default,,0,0,0,,Vâng.
Dialogue: 0,0:14:16.59,0:14:19.80,Default,,0,0,0,,Cho dù đáp án cuối cùng\N em chọn là Liliel 2D cũng được.
Dialogue: 0,0:14:20.67,0:14:23.51,Default,,0,0,0,,Nhưng vờ như không biết \Nvới không đưa ra lựa chọn khác nhau lắm.
Dialogue: 0,0:14:24.34,0:14:26.93,Default,,0,0,0,,Đã đến lúc phải tỉnh giấc rồi đó, Okumura.
Dialogue: 0,0:14:29.01,0:14:33.23,Default,,0,0,0,,Cô tin chắc ngoài đời thực này\N cũng có một thiên sứ đang chờ em.
Dialogue: 0,0:14:36.98,0:14:37.98,Default,,0,0,0,,Vâng.
Dialogue: 0,0:14:42.28,0:14:44.70,Default,,0,0,0,,Tâm trạng đã ổn định hơn được chút nào chưa?
Dialogue: 0,0:14:45.03,0:14:47.70,Default,,0,0,0,,Vâng, cảm ơn cô rất nhiều ạ.
Dialogue: 0,0:14:47.70,0:14:51.70,Default,,0,0,0,,Có điều, em vẫn chưa thể làm được gì\N cho Mikari ngay lúc này cô nhỉ.
Dialogue: 0,0:14:51.70,0:14:53.71,Default,,0,0,0,,Ừ thì, đúng thế.
Dialogue: 0,0:14:53.71,0:14:55.67,Default,,0,0,0,,Giờ em tính sao? Về luôn hả?
Dialogue: 0,0:14:55.67,0:14:58.67,Default,,0,0,0,,Không ạ, em sẽ ở lại trại hè đến phút cuối cùng.
Dialogue: 0,0:15:00.13,0:15:01.13,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:15:01.59,0:15:05.38,Default,,0,0,0,,Giờ mình đã hiểu tại sao lúc đó lại thấy\N biểu cảm của họ đẹp đến vậy rồi.
Dialogue: 0,0:15:06.09,0:15:11.43,Default,,0,0,0,,Trước giờ, dù là qua ống kính đi chăng nữa,\N mình cũng nghĩ chỉ có mình là nhìn đối phương thôi.
Dialogue: 0,0:15:11.43,0:15:15.10,Default,,0,0,0,,Chứ không hề nghĩ xem \Nđối phương đang nhìn về mình như thế nào cả.
Dialogue: 0,0:15:15.98,0:15:18.65,Default,,0,0,0,,Thế nên mới không hiểu được tại sao lại thấy đẹp.
Dialogue: 0,0:15:19.65,0:15:20.86,Default,,0,0,0,,Đó là vì...
Dialogue: 0,0:15:21.15,0:15:23.24,Default,,0,0,0,,Những nét mặt đó chỉ dành riêng cho mình.
Dialogue: 0,0:15:23.82,0:15:28.16,Default,,0,0,0,,Là biểu cảm chỉ có thể nhìn thấy\N khi người kia thân thiết với mình.
Dialogue: 0,0:15:28.74,0:15:32.12,Default,,0,0,0,,Và cũng là biểu cảm chỉ có mình mới chụp được thôi.
Dialogue: 0,0:15:33.29,0:15:35.71,Default,,0,0,0,,Xem ra em đã nắm bắt được bí kíp rồi nhỉ.
Dialogue: 0,0:15:35.71,0:15:38.50,Default,,0,0,0,,Em cảm giác mình có thể\N phá bỏ lớp vỏ bọc ngay bây giờ ạ.
Dialogue: 0,0:15:39.63,0:15:43.63,Default,,0,0,0,,Em không thể cứ nhắm mắt làm ngơ,\N vờ như không nghe không thấy gì về Mikari,
Dialogue: 0,0:15:43.63,0:15:46.55,Default,,0,0,0,,rồi cứ thế mà cự tuyệt tình cảm của em ấy được.
Dialogue: 0,0:15:47.34,0:15:50.80,Default,,0,0,0,,Nếu vượt qua được rào cản này,\N biết đâu em sẽ hiểu ra được gì đó.
Dialogue: 0,0:15:51.39,0:15:53.81,Default,,0,0,0,,Đây không còn là vấn đề về ước mơ của Ririsa nữa,
Dialogue: 0,0:15:53.81,0:15:57.52,Default,,0,0,0,,mà vì Mikari, và vì bản thân mình...
Dialogue: 0,0:15:58.23,0:16:00.06,Default,,0,0,0,,em phải khiến cho trại hè này...
Dialogue: 0,0:16:00.86,0:16:02.32,Default,,0,0,0,,kết thúc tốt đẹp.
Dialogue: 0,0:16:03.98,0:16:08.03,Default,,0,0,0,,Mấy đứa, Okumura dậy rồi \Nnên tiếp tục buổi chụp ảnh thôi...
Dialogue: 0,0:16:08.03,0:16:09.32,Default,,0,0,0,,Ủa, sao thế?
Dialogue: 0,0:16:09.32,0:16:12.20,Default,,0,0,0,,Chuyện là Mikarin không chịu chui ra khỏi chăn ạ.
Dialogue: 0,0:16:14.62,0:16:16.04,Default,,0,0,0,,Mikari à...
Dialogue: 0,0:16:16.04,0:16:18.92,Default,,0,0,0,,Tôi khóc nhiều quá nên mắt sưng húp lên,\N lớp trang điểm cũng bị trôi rồi.
Dialogue: 0,0:16:18.92,0:16:21.59,Default,,0,0,0,,Tôi không muốn cho anh ấy thấy\N gương mặt xấu xí này đâu.
Dialogue: 0,0:16:21.59,0:16:22.50,Default,,0,0,0,,Nhưng...
Dialogue: 0,0:16:22.50,0:16:24.76,Default,,0,0,0,,Mau đi đi, đừng bận tâm đến tôi nữa.
Dialogue: 0,0:16:25.17,0:16:29.97,Default,,0,0,0,,Tôi không muốn cản trở tình yêu của Ririsa,\N cản trở việc cậu làm ROM với đàn anh yêu quý của cậu đâu.
Dialogue: 0,0:16:31.22,0:16:32.22,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:16:33.76,0:16:35.22,Default,,0,0,0,,Để anh phải đợi rồi ạ.
Dialogue: 0,0:16:36.35,0:16:37.23,Default,,0,0,0,,Mikari đâu?
Dialogue: 0,0:16:37.23,0:16:38.64,Default,,0,0,0,,Ưm...
Dialogue: 0,0:16:41.31,0:16:42.61,Default,,0,0,0,,Mikari!
Dialogue: 0,0:16:42.86,0:16:45.07,Default,,0,0,0,,Anh hả? C-Có gì không?
Dialogue: 0,0:16:45.90,0:16:49.36,Default,,0,0,0,,Anh mong chờ buổi chụp hình kế tiếp với em lắm đó.
Dialogue: 0,0:16:55.41,0:16:56.41,Default,,0,0,0,,Vâng.
Dialogue: 0,0:16:59.75,0:17:00.71,Default,,0,0,0,,Ririsa.
Dialogue: 0,0:17:00.71,0:17:01.63,Default,,0,0,0,,Vâng.
Dialogue: 0,0:17:01.63,0:17:03.59,Default,,0,0,0,,Tôi muốn thử một việc.
Dialogue: 0,0:17:04.34,0:17:07.30,Default,,0,0,0,,Cho dù giữ nguyên thiết lập máy ảnh,\Nthì bức ảnh vẫn có thể thay đổi,
Dialogue: 0,0:17:07.30,0:17:12.55,Default,,0,0,0,,là do khác biệt cảm nhận về thời điểm \Nvà khoảnh khắc muốn chụp, đúng không?
Dialogue: 0,0:17:13.39,0:17:19.02,Default,,0,0,0,,Trước giờ, tôi toàn canh chụp ngay khoảnh khắc\N nghĩ rằng Liliel giống với nguyên tác nhất.
Dialogue: 0,0:17:19.43,0:17:22.23,Default,,0,0,0,,Mà giờ nghĩ lại, \Nkhông phải theo ý phân biệt đẹp xấu,
Dialogue: 0,0:17:22.56,0:17:25.02,Default,,0,0,0,,nhưng Liliel của Shaoyu và Ririsa\N hoàn toàn khác nhau.
Dialogue: 0,0:17:25.94,0:17:29.86,Default,,0,0,0,,Nhờ Ririsa mà Liliel 2D \Nmới được tái hiện chân thực đến nhường này.
Dialogue: 0,0:17:29.86,0:17:33.53,Default,,0,0,0,,Và để chụp được một thiên thần 2.5D,\N thì nhất định phải cần có Ririsa nữa.
Dialogue: 0,0:17:33.87,0:17:37.33,Default,,0,0,0,,Vậy nên, quyết định cuối cùng\N là chụp Liliel có sự hiện diện của Ririsa.
Dialogue: 0,0:17:37.33,0:17:39.00,Default,,0,0,0,,Đó chính là câu trả lời của tôi.
Dialogue: 0,0:17:39.96,0:17:41.62,Default,,0,0,0,,Liliel của em...
Dialogue: 0,0:17:44.54,0:17:48.38,Default,,0,0,0,,Vừa hay em cũng có suy nghĩ tương tự như vậy.
Dialogue: 0,0:17:48.84,0:17:51.51,Default,,0,0,0,,Dẫu em muốn hóa thân\N thành Liliel đến mức nào đi chăng nữa,
Dialogue: 0,0:17:51.51,0:17:54.59,Default,,0,0,0,,thì vẫn không thể xóa bỏ hoàn toàn \N"một cái tôi cố gắng để hóa thân".
Dialogue: 0,0:17:55.10,0:17:59.85,Default,,0,0,0,,Em những tưởng, càng chìm đắm vào cosplay, thì càng\N tiến gần hơn đến cảnh giới xóa bỏ cái tôi của mình.
Dialogue: 0,0:17:59.85,0:18:01.81,Default,,0,0,0,,Nhưng em nghĩ cách của anh rất đáng để thử.
Dialogue: 0,0:18:02.31,0:18:05.44,Default,,0,0,0,,Em sẽ thử tìm điểm giao nhau giữa mình và Liliel.
Dialogue: 0,0:18:07.90,0:18:10.61,Default,,0,0,0,,Tụi mình đứng ngoài kiến tập thôi nhỉ.
Dialogue: 0,0:18:10.61,0:18:11.61,Default,,0,0,0,,Ế!?
Dialogue: 0,0:18:11.61,0:18:13.86,Default,,0,0,0,,Nói thật thì, đẳng cấp của cậu cao quá rồi.
Dialogue: 0,0:18:13.86,0:18:17.74,Default,,0,0,0,,Dù sao trại hè này cũng là để\N hai người luyện tập làm ROM mà,
Dialogue: 0,0:18:17.74,0:18:21.71,Default,,0,0,0,,nên chụp một mình Ririsa \Ndễ hơn là chụp cả ba, chưa kể...
Dialogue: 0,0:18:22.00,0:18:24.29,Default,,0,0,0,,Mình cũng muốn ngắm tấm ảnh đó nữa.
Dialogue: 0,0:18:24.29,0:18:26.54,Default,,0,0,0,,Ừm, cứ tập trung vào Liliel đi!
Dialogue: 0,0:18:31.92,0:18:33.34,Default,,0,0,0,,Triển thôi, Liliel!
Dialogue: 0,0:18:34.51,0:18:35.68,Default,,0,0,0,,Xin nhờ anh ạ.
Dialogue: 0,0:18:36.35,0:18:38.01,Default,,0,0,0,,Hãy nhìn cho thật kĩ!
Dialogue: 0,0:18:38.01,0:18:40.89,Default,,0,0,0,,Vì Mikari, vì Ririsa,
Dialogue: 0,0:18:41.43,0:18:44.35,Default,,0,0,0,,và vì những người sẵn sàng mở lòng với mình
Dialogue: 0,0:18:47.23,0:18:49.65,Default,,0,0,0,,Không chỉ đơn thuần lại tái hiện nguyên tác,
Dialogue: 0,0:18:49.65,0:18:51.32,Default,,0,0,0,,mà phải đúng là Liliel của mình.
Dialogue: 0,0:18:51.82,0:18:54.28,Default,,0,0,0,,Điểm chung của mình và Liliel là gì?
Dialogue: 0,0:18:55.28,0:18:58.49,Default,,0,0,0,,Cảm xúc của Liliel mà mình có thể đồng cảm...
Dialogue: 0,0:18:58.87,0:19:01.41,Default,,0,0,0,,Ngài Ashford ơi, em yêu ngài.
Dialogue: 0,0:19:04.04,0:19:08.00,Default,,0,0,0,,Không được, mình nhất định phải giấu kín cảm xúc này.
Dialogue: 0,0:19:08.00,0:19:12.84,Default,,0,0,0,,Uổng công anh ấy đã hứa sẽ không yêu mình,\N để mình được yên tâm cosplay thì chớ.
Dialogue: 0,0:19:12.84,0:19:15.84,Default,,0,0,0,,Mình tuyệt đối không thể \Nđể mối tình này nhen nhóm được.
Dialogue: 0,0:19:16.51,0:19:19.85,Default,,0,0,0,,Tớ không chắc là nó có giống \Nvới tình cảm của Mikari hay không.
Dialogue: 0,0:19:19.85,0:19:20.93,Default,,0,0,0,,Đồ nói dối.
Dialogue: 0,0:19:20.93,0:19:24.31,Default,,0,0,0,,Mình thật sự muốn cho Mikari biết \Ncảm xúc thật của mình.
Dialogue: 0,0:19:24.31,0:19:25.69,Default,,0,0,0,,Cho nên, mình sẽ...
Dialogue: 0,0:19:26.19,0:19:27.98,Default,,0,0,0,,Không phải là "thích".
Dialogue: 0,0:19:27.98,0:19:29.82,Default,,0,0,0,,tự dối với lòng.
Dialogue: 0,0:19:30.36,0:19:32.86,Default,,0,0,0,,Chứ mình vốn đã nhận ra...
Dialogue: 0,0:19:33.65,0:19:35.28,Default,,0,0,0,,cảm xúc dành cho anh ấy...
Dialogue: 0,0:19:36.24,0:19:37.24,Default,,0,0,0,,Liliel?
Dialogue: 0,0:19:38.45,0:19:43.50,Default,,0,0,0,,Không sao cả, \Ntuyệt đối sẽ không có chuyện anh ấy yêu mình.
Dialogue: 0,0:19:44.29,0:19:46.04,Default,,0,0,0,,Mối tình này sẽ không kết trái.
Dialogue: 0,0:19:46.71,0:19:48.13,Default,,0,0,0,,Cho nên sẽ ổn thôi.
Dialogue: 0,0:19:49.33,0:19:54.13,Default,,0,0,0,,Giờ đây mình sẽ thể hiện ra\N một phần cảm xúc đã kìm nén bấy lâu.
Dialogue: 0,0:19:59.30,0:20:02.43,Default,,0,0,0,,Ngài Ashford ơi, em yêu ngài.
Dialogue: 0,0:20:04.39,0:20:07.81,Default,,0,0,0,,Vẫn chưa được. \NPhải nhìn cả Ririsa đang ẩn sâu trong Liliel nữa.
Dialogue: 0,0:20:11.06,0:20:14.11,Default,,0,0,0,,Anh ơi, em yêu anh.
Dialogue: 0,0:20:22.78,0:20:26.25,Default,,0,0,0,,Chậc, thế là hết hè rồi sao.
Dialogue: 0,0:20:26.25,0:20:27.83,Default,,0,0,0,,Mọi người chụp chung tấm cuối đi.
Dialogue: 0,0:20:27.83,0:20:29.37,Default,,0,0,0,,Tớ đăng lên SNS được không?
Dialogue: 0,0:20:29.37,0:20:31.59,Default,,0,0,0,,SNS của mấy đứa hướng ngoại ghê lắm nên xin kiếu.
Dialogue: 0,0:20:31.59,0:20:32.84,Default,,0,0,0,,Văn phòng không cho nha.
Dialogue: 0,0:20:32.84,0:20:34.55,Default,,0,0,0,,Ngoài ảnh cosplay thì có hơi...
Dialogue: 0,0:20:34.55,0:20:36.21,Default,,0,0,0,,Toàn dân dị ứng mạng xã hội không vậy.
Dialogue: 0,0:20:36.42,0:20:37.30,Default,,0,0,0,,Tôi sao cũng được.
Dialogue: 0,0:20:37.30,0:20:39.68,Default,,0,0,0,,Ngon lành, vậy hai đứa mình chụp đi.
Dialogue: 0,0:20:42.68,0:20:45.27,Default,,0,0,0,,Thôi không đăng nữa,\N mất công bị hiểu lầm là bạn trai.
Dialogue: 0,0:20:45.27,0:20:46.06,Default,,0,0,0,,Thế hả?
Dialogue: 0,0:20:46.93,0:20:49.14,Default,,0,0,0,,Anh cũng phải chụp với em nữa!
Dialogue: 0,0:20:49.14,0:20:51.48,Default,,0,0,0,,Ể, hồi nãy em không chịu chụp mà...
Dialogue: 0,0:20:52.73,0:20:56.23,Default,,0,0,0,,Ra vậy, là vì Mikari muốn chụp với mình.
Dialogue: 0,0:20:57.49,0:20:58.78,Default,,0,0,0,,Dễ thương ghê.
Dialogue: 0,0:20:59.28,0:21:02.16,Default,,0,0,0,,Ủa? Hình như mình vừa cảm nhận được gì đó...
Dialogue: 0,0:21:02.91,0:21:05.33,Default,,0,0,0,,Thấy trại hè thế nào?
Dialogue: 0,0:21:06.33,0:21:09.00,Default,,0,0,0,,Trái tim ta không chỉ dành riêng cho một mình ta.
Dialogue: 0,0:21:09.58,0:21:11.83,Default,,0,0,0,,Em nghĩ mình đã hiểu được phần nào rồi ạ.
Dialogue: 0,0:21:12.42,0:21:16.55,Default,,0,0,0,,Em đã luôn sống với tư tưởng rằng\N cảm xúc của mọi người dành cho mình bằng 0.
Dialogue: 0,0:21:17.05,0:21:20.30,Default,,0,0,0,,Nhưng vẫn có người\N luôn giữ hình bóng của em trong tim,
Dialogue: 0,0:21:20.30,0:21:22.64,Default,,0,0,0,,qua đó, lại nảy sinh thêm nhiều cung bậc cảm xúc.
Dialogue: 0,0:21:23.35,0:21:26.26,Default,,0,0,0,,Một lẽ tự nhiên mà đến bây giờ\N em mới phần nào cảm nhận được.
Dialogue: 0,0:21:28.77,0:21:30.98,Default,,0,0,0,,Cũng là lần đầu tiên em hiểu ra...
Dialogue: 0,0:21:32.06,0:21:35.94,Default,,0,0,0,,Rằng cảm xúc mà mọi người dành cho em...\N không phải bằng 0.
Dialogue: 0,0:21:37.57,0:21:39.15,Default,,0,0,0,,Chỉ vậy thôi á?
Dialogue: 0,0:21:39.15,0:21:42.36,Default,,0,0,0,,Từ 0 lên 1 cũng có thể xem là bước tiến lớn rồi,
Dialogue: 0,0:21:42.66,0:21:47.83,Default,,0,0,0,,nhưng đừng nói là 0, có người còn dành cho em\N hẳn 100 nữa kìa, nên hãy mau nhận ra đi!
Dialogue: 0,0:21:54.25,0:21:55.00,Default,,0,0,0,,Chà...
Dialogue: 0,0:21:59.30,0:22:01.84,Default,,0,0,0,,Chụp được tấm đẹp quá còn gì.
Dialogue: 0,0:22:22.36,0:22:25.32,Default,,0,0,0,,Noa, sắp trễ học rồi kìa!
Dialogue: 0,0:22:44.34,0:22:46.05,Default,,0,0,0,,Nonopi!
Dialogue: 0,0:22:46.68,0:22:47.93,Default,,0,0,0,,Tụi mình đi chung đi!
Dialogue: 0,0:22:54.19,0:22:57.90,Default,,0,0,0,,Ái chà, lúc nào cũng hăng hái nhỉ.\N Nhớ cố gắng lên nhé.
Dialogue: 0,0:22:57.90,0:22:58.77,Default,,0,0,0,,Vâng.
Dialogue: 0,0:23:05.53,0:23:07.74,Default,,0,0,0,,Nonopi, hôm nay rủ cả nhóm ăn tối chung đi.
Dialogue: 0,0:23:07.74,0:23:08.28,Default,,0,0,0,,OK.
Dialogue: 0,0:23:08.28,0:23:11.16,Default,,0,0,0,,Aria, Nonoa!
Dialogue: 0,0:23:11.66,0:23:12.79,Default,,0,0,0,,Lại học phụ đạo à.
Dialogue: 0,0:23:14.50,0:23:16.58,Default,,0,0,0,,Anh ơi, tụi em đến đông đủ rồi nè.
Dialogue: 0,0:23:16.88,0:23:18.04,Default,,0,0,0,,Tôi chờ nãy giờ đó.
Dialogue: 0,0:23:18.04,0:23:20.25,Default,,0,0,0,,Ô hô, chính là cái này sao?
Dialogue: 0,0:23:20.25,0:23:21.30,Default,,0,0,0,,Gì thế?
Dialogue: 0,0:23:21.30,0:23:24.26,Default,,0,0,0,,Ngoại truyện Liliel \Nphiên bản rút ngắn của Okumura.
Dialogue: 0,0:23:24.72,0:23:26.68,Default,,0,0,0,,Okumura tự làm hả?
Dialogue: 0,0:23:26.68,0:23:29.97,Default,,0,0,0,,Thiết nghĩ sẽ có ích cho câu lạc bộ về sau,\N nên tôi đã biên tập lại đó.
Dialogue: 0,0:23:30.39,0:23:32.39,Default,,0,0,0,,Em muốn xem lắm rồi.
Dialogue: 0,0:23:39.06,0:23:39.73,Default,,0,0,0,,Tới rồi đó.
Dialogue: 0,0:23:45.78,0:23:47.49,Default,,0,0,0,,Ể, cả tôi nữa hả...
Dialogue: 0,0:23:49.49,0:23:50.99,Default,,0,0,0,,Hai, ba...
Dialogue: 0,0:23:51.33,0:23:56.33,Default,,0,0,0,,LILIEL!!!
