[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:13:55.97,0:13:58.67,Kakeru,,0,0,0,, À mà... nhà cậu ở hướng nào vậy?
Dialogue: 0,0:16:50.93,0:16:53.14,Sora,,0,0,0,,"Ba ơi con cho con \Nchìa khóa trọ dự phòng của Nii-nii đi mà!"
Dialogue: 0,0:13:33.19,0:13:36.03,Naruse,,0,0,0,,"Tụi mình gặp nhau ở cổng trường sau giờ học nhé."
Dialogue: 0,0:10:07.86,0:10:09.78,Kakeru,,0,0,0,,Ai để quên cái này ở đây à?
Dialogue: 0,0:22:34.18,0:22:35.99,Kakeru,,0,0,0,,Alo, Sora à?
Dialogue: 0,0:17:10.78,0:17:12.07,Sora,,0,0,0,,Anh bị điên à? Mở cửa ra mau lên!
Dialogue: 0,0:06:31.97,0:06:33.81,Sora,,0,0,0,,Anh quen chị Coser ấy à?
Dialogue: 0,0:23:19.78,0:23:20.91,Kakeru,,0,0,0,,Anh tới ngay đây!
Dialogue: 0,0:23:17.73,0:23:19.78,Sora,,0,0,0,,Anh ơi, cứu em với!
Dialogue: 0,0:23:16.19,0:23:17.73,Sora,,0,0,0,,Anh ơi, em phải làm sao đây?
Dialogue: 0,0:18:01.04,0:18:03.79,Normal,,0,0,0,,Ba mẹ tớ hôm nay về nhà rất muộn...
Dialogue: 0,0:17:28.47,0:17:30.72,Kakeru,,0,0,0,,Ba mẹ đúng là quá nuông chiều nó rồi...
Dialogue: 0,0:04:56.34,0:04:58.47,Kakeru,,0,0,0,,Biết thế vừa nãy không táy máy.
Dialogue: 0,0:18:49.17,0:18:52.13,Yoichi,,0,0,0,,Biết đâu cả phần dưới váy \Ncũng được điêu khắc chi tiết thì sao?
Dialogue: 0,0:19:07.59,0:19:08.98,Yoichi,,0,0,0,,Biết đâu nhìn dưới góc độ nghệ thuật...
Dialogue: 0,0:07:31.78,0:07:33.08,Sora,,0,0,0,,Bye, bye.
Dialogue: 0,0:21:20.91,0:21:23.16,Kujou,,0,0,0,,Báo cảnh sát xong tình hình thế nào rồi?
Dialogue: 0,0:20:42.24,0:20:43.49,Kakeru,,0,0,0,,Bình tĩnh lại nào.
Dialogue: 0,0:13:15.04,0:13:16.47,Naruse,,0,0,0,,Bệnh tật bắt nguồn từ "khí".
Dialogue: 0,0:20:53.54,0:20:54.33,Yoichi,,0,0,0,,Bỏ chạy nhé?
Dialogue: 0,0:12:17.82,0:12:18.53,Yoichi,,0,0,0,,Bỏ mẹ...
Dialogue: 0,0:14:15.23,0:14:18.61,Kakeru,,0,0,0,,Bố mẹ tớ chiều em gái lắm.
Dialogue: 0,0:11:31.57,0:11:33.40,Yoichi,,0,0,0,,Bộ cosplay này này.
Dialogue: 0,0:10:51.44,0:10:52.97,Kakeru,,0,0,0,,Bộ em không có bạn à?
Dialogue: 0,0:18:29.90,0:18:32.15,Yoichi,,0,0,0,,Bức tượng đá của một cô gái...
Dialogue: 0,0:19:08.98,0:19:11.03,Yoichi,,0,0,0,,Bức tượng đó rất có giá trị thì sao?
Dialogue: 0,0:20:36.24,0:20:39.28,Kakeru,,0,0,0,,C-Chắc là mực hay gì đó thôi...
Dialogue: 0,0:08:05.62,0:08:07.95,Kakeru,,0,0,0,,Cho mình một phần bò chiên xù kèm cơm trắng.
Dialogue: 0,0:19:12.44,0:19:14.78,Kujou,,0,0,0,,Cho tớ đi cùng được không?
Dialogue: 0,0:12:25.50,0:12:26.54,Kakeru,,0,0,0,,Chuyện gì vậy ạ?
Dialogue: 0,0:03:09.07,0:03:15.87,Kujou,,0,0,0,,Chào mừng mọi người đã đến với sự kiện hợp tác giữa \Nthành phố Shiromitsugawa và bộ anime yêu thích của chúng ta.
Dialogue: 0,0:07:47.22,0:07:48.89,Kujou,,0,0,0,,Chào mừng quý khách.
Dialogue: 0,0:10:21.70,0:10:22.83,Kakeru,,0,0,0,,Chào nhé.
Dialogue: 0,0:03:15.87,0:03:17.99,Kujou,,0,0,0,,Chúc mọi người có một khoảng thời gian vui vẻ.
Dialogue: 0,0:08:19.04,0:08:20.86,Kujou,,0,0,0,,Chúng mình có thể nói chuyện chút được không?
Dialogue: 0,0:14:40.51,0:14:42.34,Kujou,,0,0,0,,Chúng mình học cùng lớp đúng không?
Dialogue: 0,0:14:37.42,0:14:39.67,Kujou,,0,0,0,,Chắc Niimi-kun chưa từng nhận ra nhỉ?
Dialogue: 0,0:11:27.02,0:11:28.94,Yoichi,,0,0,0,,Chắc chắn là phải thấy rồi chứ?
Dialogue: 0,0:20:54.33,0:20:56.55,Kakeru,,0,0,0,,Chắc chỉ là trò đùa của ai đó thôi...
Dialogue: 0,0:15:21.05,0:15:24.13,Kakeru,,0,0,0,,Chắc là do món hamburger steak ở quán ngon kinh khủng...
Dialogue: 0,0:05:14.10,0:05:15.95,Naruse,,0,0,0,,Chắc là không đâu.
Dialogue: 0,0:06:49.99,0:06:53.33,Kakeru,,0,0,0,,Chẳng phải họ vừa ra mắt bộ anime Mobius gì đó sao?
Dialogue: 0,0:16:00.63,0:16:02.75,Kakeru,,0,0,0,,Chỉ là ấn tượng cá nhân của tớ thôi.
Dialogue: 0,0:08:11.07,0:08:12.74,Kujou,,0,0,0,,Chỉ thế thôi đúng không ạ?
Dialogue: 0,0:20:10.42,0:20:12.04,Yoichi,,0,0,0,,Chỗ này không phải đá.
Dialogue: 0,0:09:29.53,0:09:32.15,Kujou,,0,0,0,,Coi như là lời cảm ơn của tớ.
Dialogue: 0,0:06:36.53,0:06:39.13,Kakeru,,0,0,0,,Con gái chủ tịch tập đoàn Corona.
Dialogue: 0,0:21:54.48,0:21:57.20,Kakeru,,0,0,0,,Con người... thật sự có thể bị biến thành đá sao?
Dialogue: 0,0:20:07.25,0:20:08.59,Yoichi,,0,0,0,,Các cậu có thấy chỗ này kỳ lạ không?
Dialogue: 0,0:04:15.99,0:04:18.05,Kujou,,0,0,0,,Các nhân viên sẽ sớm thực hiện việc kiểm tra an toàn.
Dialogue: 0,0:06:39.15,0:06:41.55,Sora,,0,0,0,,Cái công ty bán \Nnước ngọt và nước thể thao đó á?
Dialogue: 0,0:04:28.15,0:04:30.52,Kakeru,,0,0,0,,Cái cục này chắc đắt lắm đây.
Dialogue: 0,0:18:28.65,0:18:29.90,Kakeru,,0,0,0,,Cái gì ngồi trên ghế dài cơ?
Dialogue: 0,0:18:18.60,0:18:20.14,Kakeru,,0,0,0,,Cái gì nữa vậy?
Dialogue: 0,0:19:52.86,0:19:55.48,Kakeru,,0,0,0,,Cái này còn hơn cả tưởng tượng nữa...
Dialogue: 0,0:14:25.41,0:14:27.16,Kakeru,,0,0,0,,Cái đó phiền lắm.
Dialogue: 0,0:07:24.44,0:07:26.58,Sora,,0,0,0,,Câu chuyện của thế giới nào vậy?
Dialogue: 0,0:14:34.62,0:14:37.22,Kujou,,0,0,0,,Còn chuyện lãi lời thì có lẽ ông chưa bao giờ nghĩ đến.
Dialogue: 0,0:03:24.33,0:03:27.33,Kujou,,0,0,0,,Còn nếu muốn thử qua món tráng miệng đặc biệt nhân dịp\N sự kiện hợp tác thì cũng có thể thưởng thức ngay tại chỗ.
Dialogue: 0,0:11:33.98,0:11:35.53,Kakeru,,0,0,0,,Có ai chụp lén đăng lên mạng à?
Dialogue: 0,0:22:43.65,0:22:46.95,Sora,,0,0,0,,Có ai đó đã phóng hỏa trong lớp học!
Dialogue: 0,0:05:25.21,0:05:28.87,Naruse,,0,0,0,,Có khi chính vì mình tổ chức cái sự kiện này,\N nên mới bị trời phạt đấy.
Dialogue: 0,0:21:34.04,0:21:38.22,Kujou,,0,0,0,,Có khi nào bức tượng đó vốn là người thật...
Dialogue: 0,0:23:31.49,0:23:33.99,Kujou,,0,0,0,,Có lẽ tớ có thể giúp được gì đó!
Dialogue: 0,0:20:20.72,0:20:22.39,Yoichi,,0,0,0,,Có mỗi chỗ này là thật thôi.
Dialogue: 0,0:22:01.74,0:22:03.61,Kakeru,,0,0,0,,Có phải vì thánh tích bị phá hủy,
Dialogue: 0,0:05:20.53,0:05:21.78,Kakeru,,0,0,0,,Có được không vậy trời?
Dialogue: 0,0:05:22.15,0:05:25.21,Naruse,,0,0,0,,Cô còn chẳng biết tổ chức cái sự kiện này có thật sự là \Nđể phực hưng thành phố hay không nữa...
Dialogue: 0,0:10:53.94,0:10:57.95,Sora,,0,0,0,,Cô em gái chu đáo này thấy Onii-sama\N ngày nào cũng lủi thủi đi học một mình,
Dialogue: 0,0:15:36.48,0:15:39.19,Kakeru,,0,0,0,,Cô gái đó, hôm nay tại đến để ăn parfait nữa kìa.
Dialogue: 0,0:13:11.75,0:13:15.04,Kakeru,,0,0,0,,Cô xuất thân từ đền thờ mà nói vậy có ổn không?
Dialogue: 0,0:06:34.22,0:06:36.15,Kakeru,,0,0,0,,Cô ấy là Kujou, bạn cùng lớp của anh.
Dialogue: 0,0:16:32.28,0:16:34.95,Kakeru,,0,0,0,,Cô ấy lễ phép quá.
Dialogue: 0,0:13:39.95,0:13:41.49,Kakeru,,0,0,0,,Cô ấy thi thoảng cứ tự ý như vậy á.
Dialogue: 0,0:16:09.22,0:16:10.43,Kakeru,,0,0,0,,Cũng dùng chút chút thôi.
Dialogue: 0,0:05:08.23,0:05:10.27,Kakeru,,0,0,0,,Cũng không có gì to tát lắm.
Dialogue: 0,0:05:03.01,0:05:04.01,Naruse,,0,0,0,,Cả em nữa, Sora-chan.
Dialogue: 0,0:22:46.95,0:22:49.16,Sora,,0,0,0,,Cả hành lang cũng cháy luôn rồi!
Dialogue: 0,0:15:25.60,0:15:27.01,Kujou,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:19:34.38,0:19:36.81,Kujou,,0,0,0,,Cảm ơn cậu, vậy sau giờ học gặp nhé!
Dialogue: 0,0:16:26.20,0:16:27.57,Kujou,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:21:19.11,0:21:20.91,Kujou,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:09:42.37,0:09:43.83,Kakeru,,0,0,0,,Cảm ơn cậu...
Dialogue: 0,0:04:54.71,0:04:56.34,Kakeru,,0,0,0,,Cảm ơn em.
Dialogue: 0,0:08:13.74,0:08:15.46,Kujou,,0,0,0,,Cảm ơn quý khách ạ.
Dialogue: 0,0:09:17.19,0:09:18.98,Kujou,,0,0,0,,Cảm ơn vì đã đợi.
Dialogue: 0,0:14:23.94,0:14:25.41,Kujou,,0,0,0,,Cậu có nấu ăn không?
Dialogue: 0,0:06:13.91,0:06:15.01,Kakeru,,0,0,0,,Cậu có sao không?
Dialogue: 0,0:09:43.83,0:09:45.51,Kujou,,0,0,0,,Cậu cứ từ từ thưởng thức nhé.
Dialogue: 0,0:15:18.30,0:15:20.30,Kujou,,0,0,0,,Cậu không biết sao?
Dialogue: 0,0:14:49.85,0:14:54.81,Kujou,,0,0,0,,Cậu không nhận ra nhân viên ở Nine Ball là tớ sao?
Dialogue: 0,0:21:00.55,0:21:02.55,Kakeru,,0,0,0,,Cậu nói đúng, cứ làm vậy đi.
Dialogue: 0,0:08:22.46,0:08:24.96,Kujou,,0,0,0,,Cậu đã từng nhìn thấy cái này chưa?
Dialogue: 0,0:17:59.29,0:18:01.04,Normal,,0,0,0,,Cậu ở lại được đến mấy giờ?
Dialogue: 0,0:04:53.25,0:04:54.71,Sora,,0,0,0,,Của anh đây, băng gạt.
Dialogue: 0,0:13:31.81,0:13:33.19,Naruse,,0,0,0,,Cứ nghe cô bảo đi.
Dialogue: 0,0:07:19.40,0:07:21.55,Kakeru,,0,0,0,,Do em liên tục lèo nhèo đòi một căn phòng riêng,
Dialogue: 0,0:12:43.89,0:12:45.31,Kujou,,0,0,0,,Dù có để trong phòng khác...
Dialogue: 0,0:20:28.27,0:20:31.40,Yoichi,,0,0,0,,Dùng keo dán hay gì đó dán lại là được nhỉ?
Dialogue: 0,0:16:49.64,0:16:50.93,Sora,,0,0,0,,Em năn nỉ ba...
Dialogue: 0,0:05:00.51,0:05:03.01,Naruse,,0,0,0,,Em đã vất cả rồi, Kakeru-kun.
Dialogue: 0,0:12:37.93,0:12:39.97,Naruse,,0,0,0,,Em ấy bảo cái này có thể bị nguyền rủa.
Dialogue: 0,0:14:27.16,0:14:28.66,Kakeru,,0,0,0,,Giá cả và khẩu phần ở Nine Ball...
Dialogue: 0,0:19:57.41,0:19:59.70,Yoichi,,0,0,0,,Giống người đau khổ thì đúng hơn?
Dialogue: 0,0:10:05.02,0:10:06.32,Kakeru,,0,0,0,,Gì đây?
Dialogue: 0,0:11:02.37,0:11:05.92,Sora,,0,0,0,,Gì đấy? Gì đấy? Đừng có mà thở dài chứ!
Dialogue: 0,0:05:28.87,0:05:29.79,Sora,,0,0,0,,Gắt vậy...
Dialogue: 0,0:09:01.12,0:09:02.42,Kujou,,0,0,0,,Gọi là làm thêm cũng không đúng,
Dialogue: 0,0:18:57.85,0:19:00.22,Yoichi,,0,0,0,,Hay là mày không muốn nhìn quần lót?
Dialogue: 0,0:13:16.47,0:13:18.55,Naruse,,0,0,0,,Hiện tượng tâm linh cũng bắt nguồn từ "khí".
Dialogue: 0,0:05:16.49,0:05:20.53,Naruse,,0,0,0,,Hiện tại thì cứ làm tạm một bản sao bằng giấy má\N rồi nhét vào chỗ cũ vậy.
Dialogue: 0,0:16:19.52,0:16:20.92,Kujou,,0,0,0,,Hãy lập tức liên lạc với tớ nhé.
Dialogue: 0,0:21:28.50,0:21:31.21,Kakeru,,0,0,0,,Hình như cảnh sát cũng đem bức tượng đi rồi.
Dialogue: 0,0:20:12.88,0:20:15.46,Yoichi,,0,0,0,,Hình như là móng tay thật ấy.
Dialogue: 0,0:06:18.26,0:06:20.67,Kakeru,,0,0,0,,Hôm nay cậu vất vả rồi,\N tớ đi về trước đây. Chào cậu nhé.
Dialogue: 0,0:13:59.76,0:14:01.51,Kujou,,0,0,0,,Hôm nay tớ phải đi làm thêm.
Dialogue: 0,0:15:43.02,0:15:46.16,Kujou,,0,0,0,,Hôm nay... tớ không phải đi làm thêm.
Dialogue: 0,0:11:19.68,0:11:22.14,Yoichi,,0,0,0,,Hôm qua thế nào, cái ấy ấy ấy?
Dialogue: 0,0:22:19.72,0:22:22.88,Yoichi,,0,0,0,,Hôm qua về đến nhà, tao chợt nhớ ra một chuyện...
Dialogue: 0,0:13:23.05,0:13:24.13,Kakeru,,0,0,0,,Hả!?
Dialogue: 0,0:09:27.99,0:09:29.53,Kakeru,,0,0,0,,Hể? Tớ có gọi món này đâu.
Dialogue: 0,0:21:23.82,0:21:25.32,Kakeru,,0,0,0,,Họ hỏi tớ rất nhiều thứ.
Dialogue: 0,0:13:49.33,0:13:50.71,Kakeru,,0,0,0,,Họ quen biết nhau từ lâu rồi.
Dialogue: 0,0:06:53.62,0:06:56.30,Kakeru,,0,0,0,,Họ định phục hưng thành phố, nhưng không thành.
Dialogue: 0,0:22:38.82,0:22:39.90,Normal,,0,0,0,,Hỏa hoạn?
Dialogue: 0,0:08:30.97,0:08:33.43,Kakeru,,0,0,0,,Hừm, chắc là tớ không biết rồi.
Dialogue: 0,0:11:17.60,0:11:19.06,Yoichi,,0,0,0,,Kakeru!
Dialogue: 0,0:18:08.51,0:18:10.38,Yoichi,,0,0,0,,Kakeru, mày có nghe không đấy?
Dialogue: 0,0:18:54.38,0:18:56.10,Yoichi,,0,0,0,,Kakeru, mày cũng tò mò lắm đúng không?
Dialogue: 0,0:05:30.50,0:05:32.46,Naruse,,0,0,0,,Kakeru-kun, em có thể về rồi đấy.
Dialogue: 0,0:12:52.73,0:12:56.20,Kujou,,0,0,0,,Khi biết chuyện hôm qua ở đền có một món đồ quý bị vỡ...
Dialogue: 0,0:15:12.54,0:15:13.58,Kujou,,0,0,0,,Khi cậu ăn...
Dialogue: 0,0:12:30.96,0:12:32.67,Kakeru,,0,0,0,,Không có gì mấy.
Dialogue: 0,0:23:12.43,0:23:13.64,Sora,,0,0,0,,Không có!
Dialogue: 0,0:15:20.30,0:15:21.05,Kujou,,0,0,0,,Không hề.
Dialogue: 0,0:17:54.99,0:17:58.33,Normal,,0,0,0,,Không ngờ cậu lại liên lạc với tớ...
Dialogue: 0,0:07:14.26,0:07:15.94,Kakeru,,0,0,0,,Không thể. Chật lắm.
Dialogue: 0,0:14:54.81,0:14:57.15,Kakeru,,0,0,0,,Không đâu, thật ra tớ nhận ra ngay từ đầu rồi.
Dialogue: 0,0:18:11.38,0:18:12.63,Kakeru,,0,0,0,,Không, chẳng nghe gì hết trơn.
Dialogue: 0,0:22:08.00,0:22:10.08,Sophi,,0,0,0,,Không, cậu nói đúng rồi đó.
Dialogue: 0,0:07:11.39,0:07:14.26,Sora,,0,0,0,,Không, em muốn ở lại chỗ Nii-yan cơ.
Dialogue: 0,0:08:47.28,0:08:48.45,Kakeru,,0,0,0,,Không, không.
Dialogue: 0,0:17:36.56,0:17:37.35,Kakeru,,0,0,0,,Không...
Dialogue: 0,0:22:25.80,0:22:26.77,Kakeru,,0,0,0,,Kiểm tra cái gì?
Dialogue: 0,0:12:34.00,0:12:37.93,Naruse,,0,0,0,,Kujou muốn nhờ nhà cô trừ tà.
Dialogue: 0,0:15:49.58,0:15:51.83,Kakeru,,0,0,0,,Kujou mà cũng có thể mắc lỗi như vậy à?
Dialogue: 0,0:23:25.73,0:23:26.83,Kakeru,,0,0,0,,Kujou!
Dialogue: 0,0:19:14.78,0:19:17.54,Yoichi,,0,0,0,,Kujou-san cũng muốn xem quần lót à?
Dialogue: 0,0:11:35.53,0:11:38.24,Yoichi,,0,0,0,,Là Ma Nhãn Iris, đúng chứ?
Dialogue: 0,0:18:56.10,0:18:57.85,Yoichi,,0,0,0,,Là con trai thì ai chả tò mò.
Dialogue: 0,0:20:15.93,0:20:17.22,Kujou,,0,0,0,,Là móng tay của người sống hả?
Dialogue: 0,0:20:25.60,0:20:26.81,Yoichi,,0,0,0,,Làm sao bây giờ? Làm sao bây giờ?
Dialogue: 0,0:11:24.68,0:11:26.27,Yoichi,,0,0,0,,Lễ Hội Mobius.
Dialogue: 0,0:03:17.99,0:03:20.24,Kujou,,0,0,0,,Lễ hội Mobius được tổ chức hằng năm.
Dialogue: 0,0:23:14.22,0:23:16.19,Sora,,0,0,0,,Lửa lan tới chỗ cửa rồi...
Dialogue: 0,0:04:18.05,0:04:20.30,Kujou,,0,0,0,,Mong mọi người hãy kiên nhẫn ạ!
Dialogue: 0,0:18:46.38,0:18:47.92,Yoichi,,0,0,0,,Muốn xem thử không?
Dialogue: 0,0:05:10.69,0:05:14.10,Kakeru,,0,0,0,,Mà cái món thánh tích đó, \Ncó sửa được không ạ?
Dialogue: 0,0:08:34.01,0:08:35.35,Kakeru,,0,0,0,,Mà nói thật thì,
Dialogue: 0,0:19:00.22,0:19:03.31,Kakeru,,0,0,0,,Mày bé cái mồm lại hộ tao cái!
Dialogue: 0,0:11:54.42,0:11:56.35,Yoichi,,0,0,0,,Mày cũng cùng suy nghĩ với tao, đúng không?
Dialogue: 0,0:21:03.68,0:21:05.22,Yoichi,,0,0,0,,Mày lo phần gọi điện nhé.
Dialogue: 0,0:18:32.15,0:18:34.78,Kakeru,,0,0,0,,Mày suốt ngày chỉ toàn nói mấy chuyện linh tinh.
Dialogue: 0,0:22:28.98,0:22:31.06,Kakeru,,0,0,0,,Mày thực sự...
Dialogue: 0,0:18:15.12,0:18:17.48,Yoichi,,0,0,0,,Mày tệ thật đấy.\N Hóa ra mày chỉ đùa giỡn với cảm xúc của tao sao!?
Dialogue: 0,0:16:47.55,0:16:49.64,Kakeru,,0,0,0,,Mày... mày vào đây kiểu gì đấy?
Dialogue: 0,0:09:52.63,0:09:55.18,Kakeru,,0,0,0,,Mình cứ tưởng Kujou là người cứng nhắc,
Dialogue: 0,0:06:06.95,0:06:09.12,Kakeru,,0,0,0,,Mọi người chuẩn bị đồ đạc ra về sớm đi ạ.
Dialogue: 0,0:05:43.01,0:05:45.81,Kujou,,0,0,0,,Mọi người về nhớ cẩn thận dư chấn\N từ trận động đất nhé.
Dialogue: 0,0:05:48.43,0:05:50.52,Kujou,,0,0,0,,Mọi người xin đừng chụp ảnh nữa.
Dialogue: 0,0:03:27.71,0:03:30.17,Kujou,,0,0,0,,Mọi người... đừng bỏ lỡ nhé.
Dialogue: 0,0:08:08.32,0:08:11.07,Kujou,,0,0,0,,Một phần bò chiên xù kèm cơm trắng.
Dialogue: 0,0:11:06.34,0:11:09.00,Kakeru,,0,0,0,,Mới sáng ra đã phải đối phó với em,\N mệt chết đi được.
Dialogue: 0,0:10:36.27,0:10:38.72,Normal,,0,0,0,,Mới sáng sớm mà cậu đã xinh đẹp như tiên rồi.
Dialogue: 0,0:16:45.72,0:16:47.55,Sora,,0,0,0,,Mừng anh về nhà, Nii-nii!
Dialogue: 0,0:06:56.30,0:06:59.88,Kakeru,,0,0,0,,Nghe nói Kujou cảm thấy có trách nhiệm \Nvì nhà mình là nhà tài trợ,
Dialogue: 0,0:18:34.78,0:18:37.33,Yoichi,,0,0,0,,Nghe nói bức tượng đó làm cực kỳ thật.
Dialogue: 0,0:19:03.31,0:19:05.43,Yoichi,,0,0,0,,Nghe nói bức tượng đó,
Dialogue: 0,0:18:25.60,0:18:28.65,Yoichi,,0,0,0,,Nghe nói nó ngồi ngay trên ghế dài ở công viên.
Dialogue: 0,0:19:18.29,0:19:19.37,Kakeru,,0,0,0,,Ngu này!
Dialogue: 0,0:12:40.39,0:12:41.68,Kakeru,,0,0,0,,Nguyền rủa?
Dialogue: 0,0:05:06.56,0:05:08.23,Naruse,,0,0,0,,Ngón tay em có sao không?
Dialogue: 0,0:18:17.48,0:18:18.60,Kakeru,,0,0,0,,Ngậm miệng hộ cái!
Dialogue: 0,0:06:42.03,0:06:43.78,Kakeru,,0,0,0,,Nhiều người biết đến lắm đó.
Dialogue: 0,0:14:04.67,0:14:07.10,Kujou,,0,0,0,,Nhà của Niimi-kun có gần đây không?
Dialogue: 0,0:11:38.53,0:11:41.49,Yoichi,,0,0,0,,Nhân vật ăn mặc mát mẻ nhất Mobius.
Dialogue: 0,0:08:39.40,0:08:41.85,Kujou,,0,0,0,,Nhưng chẳng phải hôm nay \Ncậu đi sự kiện cùng bạn gái sao?
Dialogue: 0,0:20:18.85,0:20:20.26,Yoichi,,0,0,0,,Nhưng mà nhìn giống thật...
Dialogue: 0,0:14:18.61,0:14:20.39,Kakeru,,0,0,0,,Nhưng mà ở một mình tớ cũng thấy thoải mái hơn.
Dialogue: 0,0:08:54.99,0:08:56.96,Kakeru,,0,0,0,,Nhưng mà, cậu cũng cực quá ha...
Dialogue: 0,0:20:39.28,0:20:42.24,Yoichi,,0,0,0,,Nhưng nhìn thật lắm...
Dialogue: 0,0:16:17.31,0:16:19.52,Kujou,,0,0,0,,Nhưng nếu chẳng may lời nguyền ảnh hưởng đến cậu...
Dialogue: 0,0:11:48.92,0:11:52.29,Yoichi,,0,0,0,,Nhưng tao rất thích con gái mặc đồ táo bạo.
Dialogue: 0,0:08:48.45,0:08:49.91,Kakeru,,0,0,0,,Nhỏ đó là em gái tớ.
Dialogue: 0,0:07:27.99,0:07:29.74,Kakeru,,0,0,0,,Nhớ đi thẳng về nhà đấy.
Dialogue: 0,0:21:08.60,0:21:11.10,Kakeru,,0,0,0,,Nhờ mày nhé, lát nữa tao sẽ liên lạc lại.
Dialogue: 0,0:07:37.29,0:07:39.75,Sora,,0,0,0,,Nii-yan là đồ ngốc!
Dialogue: 0,0:05:36.26,0:05:37.38,Sora,,0,0,0,,Nii-yan, mình về thôi.
Dialogue: 0,0:07:08.06,0:07:09.97,Sora,,0,0,0,,Nii-yan, nhà anh hướng kia mà?
Dialogue: 0,0:12:16.24,0:12:17.82,Naruse,,0,0,0,,Niimi-kun!
Dialogue: 0,0:16:05.93,0:16:07.93,Kujou,,0,0,0,,Niimi-kun, cậu có dùng LING không?
Dialogue: 0,0:13:43.32,0:13:47.12,Kujou,,0,0,0,,Niimi-kun, cậu thân với Naruse-sensei ghê ha.
Dialogue: 0,0:12:26.54,0:12:30.75,Naruse,,0,0,0,,Niimi-kun, từ hôm qua đến giờ \Nem có thấy hiện tượng gì kỳ lạ không?
Dialogue: 0,0:23:22.61,0:23:24.19,Kujou,,0,0,0,,Niimi-kun, đợi đã!
Dialogue: 0,0:09:24.98,0:09:27.36,Kujou,,0,0,0,,Niimi-kun... của cậu đây.
Dialogue: 0,0:20:08.59,0:20:10.42,Kakeru,,0,0,0,,Nào, đừng đụng vào.
Dialogue: 0,0:20:51.83,0:20:53.54,Yoichi,,0,0,0,,Nè, giờ phải làm sao đây?
Dialogue: 0,0:19:27.80,0:19:28.96,Kujou,,0,0,0,,Nên tớ rất tò mò...
Dialogue: 0,0:12:41.68,0:12:43.89,Kujou,,0,0,0,,Nó cứ xuất hiện bên cạnh tớ.
Dialogue: 0,0:19:55.52,0:19:57.41,Yoichi,,0,0,0,,Nó không giống "Người suy tư" chút nào...
Dialogue: 0,0:12:47.23,0:12:48.96,Kujou,,0,0,0,,Nó vẫn sẽ xuất hiện trở lại mà không biết bằng cách nào.
Dialogue: 0,0:21:25.32,0:21:27.87,Kakeru,,0,0,0,,Nói chung chắc tụi mình không bị trách mắng đâu.
Dialogue: 0,0:11:09.00,0:11:10.59,Sora,,0,0,0,,Nói thế em đau lòng lắm ấy!
Dialogue: 0,0:14:10.02,0:14:12.93,Kakeru,,0,0,0,,Nơi tớ thuê trọ cách đây khoảng 10 phút đi bộ.
Dialogue: 0,0:17:17.87,0:17:22.71,Sora,,0,0,0,,Nếu anh không mở cửa, em sẽ đứng đây kể hết \Nmấy chuyện xấu hổ của anh cho cả xóm làng nghe thấy đó!
Dialogue: 0,0:16:10.43,0:16:12.30,Kujou,,0,0,0,,Nếu cậu không ngại thì...
Dialogue: 0,0:03:20.78,0:03:22.45,Kujou,,0,0,0,,Nếu muốn mua các sản phẩm liên quan đến anime,
Dialogue: 0,0:12:58.57,0:12:59.99,Naruse,,0,0,0,,Nếu nguyên nhân là do thánh tích thật...
Dialogue: 0,0:11:58.35,0:12:00.89,Yoichi,,0,0,0,,Nếu tao có thể nắm rõ \Nđường cong cơ thể của Kujou-san...
Dialogue: 0,0:15:27.01,0:15:28.89,Kujou,,0,0,0,,Nếu được thì cậu ghé qua tiệm nhé.
Dialogue: 0,0:10:14.15,0:10:17.00,Kakeru,,0,0,0,,Nếu để ở đây thì người khác đi lên sẽ bị vướng.
Dialogue: 0,0:22:41.90,0:22:43.65,Sora,,0,0,0,,Onii-chan, nguy rồi!
Dialogue: 0,0:21:11.10,0:21:12.52,Kujou,,0,0,0,,Phiền cậu rồi.
Dialogue: 0,0:14:07.43,0:14:10.02,Kakeru,,0,0,0,,Phòng tớ bị em gái chiếm mất rồi, nên tớ bị đuổi ra ngoài ở.
Dialogue: 0,0:12:18.91,0:12:19.91,Naruse,,0,0,0,,Qua đây.
Dialogue: 0,0:13:36.03,0:13:37.03,Naruse,,0,0,0,,Quyết định vậy đi.
Dialogue: 0,0:08:02.69,0:08:04.44,Kujou,,0,0,0,,Quý khách muốn gọi món gì ạ?
Dialogue: 0,0:22:26.77,0:22:28.02,Yoichi,,0,0,0,,Quần lót.
Dialogue: 0,0:19:17.54,0:19:18.29,Kujou,,0,0,0,,Quần lót...
Dialogue: 0,0:14:12.93,0:14:14.02,Kujou,,0,0,0,,Ra là vậy...
Dialogue: 0,0:03:53.61,0:03:55.03,Normal,,0,0,0,,Rung mạnh quá...
Dialogue: 0,0:18:45.58,0:18:46.38,Kakeru,,0,0,0,,Rồi sao?
Dialogue: 0,0:22:06.37,0:22:08.00,Kakeru,,0,0,0,,Sao có thể như vậy được?
Dialogue: 0,0:12:32.67,0:12:34.00,Kakeru,,0,0,0,,Sao cô hỏi vậy ạ?
Dialogue: 0,0:17:22.96,0:17:24.71,Kakeru,,0,0,0,,Sao cũng được, đi về đi!
Dialogue: 0,0:15:41.98,0:15:43.02,Kakeru,,0,0,0,,Sao thế?
Dialogue: 0,0:22:23.30,0:22:25.80,Yoichi,,0,0,0,,Sau cùng thì vẫn không kiểm tra được.
Dialogue: 0,0:13:19.80,0:13:20.80,Naruse,,0,0,0,,Sau giờ học hôm nay...
Dialogue: 0,0:14:42.34,0:14:44.27,Kujou,,0,0,0,,Sau này mong được cậu giúp đỡ nhé.
Dialogue: 0,0:05:04.01,0:05:06.19,Kakeru,,0,0,0,,Sensei, nãy giờ cô đi đâu mất tiêu vậy?
Dialogue: 0,0:07:03.05,0:07:06.35,Kakeru,,0,0,0,,So bì làm sao được, \Nđẳng cấp người ta khác mình mà.
Dialogue: 0,0:17:34.59,0:17:35.98,Kakeru,,0,0,0,,Sora tha nó về đây à?
Dialogue: 0,0:23:10.14,0:23:12.43,Kakeru,,0,0,0,,Sora, em có cách nào thoát ra được không?
Dialogue: 0,0:05:54.18,0:05:56.40,Kakeru,,0,0,0,,Sora, đợi anh chút.
Dialogue: 0,0:05:32.46,0:05:34.97,Naruse,,0,0,0,,Sora-chan, giúp cô gửi lời hỏi thăm ba mẹ em nhé.
Dialogue: 0,0:11:57.47,0:11:58.35,Kakeru,,0,0,0,,Suy nghĩ gì?
Dialogue: 0,0:16:22.90,0:16:24.02,Kakeru,,0,0,0,,Sẽ không có gì xảy ra đâu.
Dialogue: 0,0:05:40.26,0:05:42.72,Kujou,,0,0,0,,Sự kiện hôm nay tạm dừng tại đây ạ.
Dialogue: 0,0:06:05.16,0:06:06.95,Kakeru,,0,0,0,,Sự kiện hôm nay đã tạm dừng rồi.
Dialogue: 0,0:08:56.96,0:08:59.29,Kakeru,,0,0,0,,Sự kiện vừa kết thúc đã đi làm thêm luôn rồi.
Dialogue: 0,0:11:47.04,0:11:48.92,Yoichi,,0,0,0,,Tao không hứng thú với cosplay.
Dialogue: 0,0:11:44.37,0:11:47.04,Kakeru,,0,0,0,,Tao không ngờ mày thích cosplay đấy.
Dialogue: 0,0:21:06.10,0:21:08.60,Yoichi,,0,0,0,,Tao sẽ đưa Kujou-san về nhà.
Dialogue: 0,0:17:42.35,0:17:44.14,Kakeru,,0,0,0,,Tha cho tôi đi mà...
Dialogue: 0,0:14:58.82,0:15:00.15,Kakeru,,0,0,0,,Thành thật xin lỗi.
Dialogue: 0,0:20:44.87,0:20:47.88,Kujou,,0,0,0,,Thánh Tích...
Dialogue: 0,0:12:03.51,0:12:05.97,Yoichi,,0,0,0,,Thân hình gợi cảm của Kujou-san...
Dialogue: 0,0:12:00.89,0:12:03.51,Yoichi,,0,0,0,,Thì có thể tưởng tượng ra \Nlúc cô ấy khỏa thân sẽ thế nào rồi.
Dialogue: 0,0:12:59.99,0:13:04.11,Naruse,,0,0,0,,Thì người làm vỡ nó là Niimi-kun sẽ bị nguyền đầu tiên.
Dialogue: 0,0:13:06.67,0:13:09.21,Naruse,,0,0,0,,Thôi thì để cô xem qua cho.
Dialogue: 0,0:15:17.13,0:15:18.30,Kakeru,,0,0,0,,Thật hay đùa vậy?
Dialogue: 0,0:14:57.15,0:14:58.82,Kujou,,0,0,0,,Thật hả?
Dialogue: 0,0:17:27.34,0:17:28.47,Kakeru,,0,0,0,,Thật là...
Dialogue: 0,0:19:26.09,0:19:27.80,Kujou,,0,0,0,,Thật sự quá kỳ lạ luôn.
Dialogue: 0,0:18:37.33,0:18:39.50,Yoichi,,0,0,0,,Thật đến mức sắp cử động luôn ấy!
Dialogue: 0,0:12:13.77,0:12:16.24,Kakeru,,0,0,0,,Thằng điên này, mày la hét cái gì đấy?
Dialogue: 0,0:07:09.97,0:07:11.39,Kakeru,,0,0,0,,Thế em không về à?
Dialogue: 0,0:08:41.85,0:08:44.60,Kujou,,0,0,0,,Thế nên tớ mới nghĩ có lẽ là của cô ấy.
Dialogue: 0,0:21:02.55,0:21:03.68,Yoichi,,0,0,0,,Thế thì... Kakeru...
Dialogue: 0,0:14:01.51,0:14:03.37,Kakeru,,0,0,0,,Thế tớ đưa cậu đến Nine Ball nhé?
Dialogue: 0,0:08:38.06,0:08:39.40,Kujou,,0,0,0,,Thế á...
Dialogue: 0,0:15:14.66,0:15:16.25,Kujou,,0,0,0,,Thỉnh thoảng cậu có cười một chút.
Dialogue: 0,0:18:40.12,0:18:43.87,Yoichi,,0,0,0,,Tin đồn là sáng nay tự nhiên nó xuất hiện trên ghế dài.
Dialogue: 0,0:06:43.78,0:06:46.37,Kakeru,,0,0,0,,Tiểu thư nhà đó \Nhọc cùng trường với chúng mình.
Dialogue: 0,0:14:31.79,0:14:34.62,Kujou,,0,0,0,,Tiệm đó ông tớ mở ra chỉ vì sở thích thôi.
Dialogue: 0,0:22:36.94,0:22:38.82,Normal,,0,0,0,,Trong đó có chuyện gì vậy?
Dialogue: 0,0:04:46.83,0:04:48.37,Sora,,0,0,0,,Trông đau ác.
Dialogue: 0,0:11:41.91,0:11:44.37,Yoichi,,0,0,0,,Trời, tao cũng muốn thấy tận mắt quá...
Dialogue: 0,0:07:01.80,0:07:03.05,Sora,,0,0,0,,Tuyệt thật...
Dialogue: 0,0:10:38.72,0:10:42.18,Normal,,0,0,0,,Tình cờ gặp cậu, tớ cảm thấy mình thật may mắn.
Dialogue: 0,0:13:18.55,0:13:19.80,Naruse,,0,0,0,,Tóm lại là này, Niimi-kun...
Dialogue: 0,0:12:06.19,0:12:07.94,Yoichi,,0,0,0,,Tưởng tượng hóa!
Dialogue: 0,0:20:43.49,0:20:44.87,Kakeru,,0,0,0,,Tượng thì làm sao chảy máu được?
Dialogue: 0,0:06:46.74,0:06:49.54,Sora,,0,0,0,,Tại sao con gái của chủ tịch tập đoàn\N lại đi cosplay vậy trời?
Dialogue: 0,0:19:59.70,0:20:01.49,Kakeru,,0,0,0,,Tại sao lại đặt nó ở đây chứ?
Dialogue: 0,0:09:32.15,0:09:35.58,Kujou,,0,0,0,,Tớ chưa quen việc bị người khác chụp hình\N nên có hơi ngại ngùng.
Dialogue: 0,0:09:02.42,0:09:05.63,Kujou,,0,0,0,,Tớ chỉ đang phụ giúp tiệm của ông nội thôi.
Dialogue: 0,0:19:31.59,0:19:32.84,Kakeru,,0,0,0,,Tớ cũng đi cùng luôn.
Dialogue: 0,0:19:32.84,0:19:33.96,Kakeru,,0,0,0,,Tớ cảm thấy khá lo lắng.
Dialogue: 0,0:09:38.54,0:09:40.25,Kujou,,0,0,0,,Tớ hạnh phúc lắm.
Dialogue: 0,0:15:06.49,0:15:08.95,Kakeru,,0,0,0,,Tớ không ngờ là Kujou lại nhớ tớ là ai.
Dialogue: 0,0:09:06.13,0:09:08.28,Kujou,,0,0,0,,Tớ mới là người phải cảm ơn Niimi-kun mới đúng,
Dialogue: 0,0:15:04.90,0:15:06.49,Kakeru,,0,0,0,,Tớ mới là người phải xin lỗi.
Dialogue: 0,0:20:57.76,0:20:59.93,Kujou,,0,0,0,,Tớ nghĩ bọn mình nên báo cảnh sát.
Dialogue: 0,0:16:15.18,0:16:17.31,Kujou,,0,0,0,,Tớ nghĩ cậu chắc sẽ không sao đâu...
Dialogue: 0,0:08:27.22,0:08:30.34,Kujou,,0,0,0,,Tớ nhặt được nó trên sân đền sau sự kiện.
Dialogue: 0,0:15:28.89,0:15:31.56,Kujou,,0,0,0,,Tớ sẽ mời cậu một ly nước để cảm ơn đàng hoàng.
Dialogue: 0,0:08:59.29,0:09:00.89,Kakeru,,0,0,0,,Tớ thấy cậu làm hơi quá sức rồi đó.
Dialogue: 0,0:19:23.33,0:19:26.09,Kujou,,0,0,0,,Tớ thấy việc bức tượng đó đột nhiên xuất hiện...
Dialogue: 0,0:15:56.79,0:15:59.54,Kujou,,0,0,0,,Tớ trông hoàn hảo đến vậy hả?
Dialogue: 0,0:08:17.25,0:08:19.04,Kujou,,0,0,0,,Tớ xin lỗi, Niimi-kun.
Dialogue: 0,0:21:32.37,0:21:33.71,Kujou,,0,0,0,,Tớ đang nghĩ...
Dialogue: 0,0:15:46.16,0:15:47.87,Kujou,,0,0,0,,Tớ đã nhầm lịch làm việc...
Dialogue: 0,0:14:45.77,0:14:47.64,Kujou,,0,0,0,,Tớ đã phải lấy hết can đảm để nói ra đấy.
Dialogue: 0,0:12:56.20,0:12:58.24,Kujou,,0,0,0,,Tớ đột nhiên cảm thấy rất sợ hãi...
Dialogue: 0,0:15:54.87,0:15:56.13,Kujou,,0,0,0,,Tớ...
Dialogue: 0,0:16:53.14,0:16:55.01,Sora,,0,0,0,,Và kết quả đây...
Dialogue: 0,0:05:34.97,0:05:35.76,Sora,,0,0,0,,Vâng ạ.
Dialogue: 0,0:07:29.74,0:07:31.78,Sora,,0,0,0,,Vâng, vâng. Tôi biết rồi.
Dialogue: 0,0:13:47.12,0:13:49.33,Kakeru,,0,0,0,,Vì ba mẹ tụi tớ là bạn thân mà.
Dialogue: 0,0:15:10.20,0:15:11.87,Kakeru,,0,0,0,,Vì tớ đâu có gì nổi bật đâu.
Dialogue: 0,0:06:00.70,0:06:03.90,Kakeru,,0,0,0,,Vì đây là trường hợp khẩn cấp,\N nên mọi người có thể làm theo hướng dẫn di tản được không ạ?
Dialogue: 0,0:18:12.63,0:18:15.07,Yoichi,,0,0,0,,Vậy là mày đã chán tao rồi sao...
Dialogue: 0,0:14:47.64,0:14:49.10,Kujou,,0,0,0,,Vậy mà lúc đó cậu cứ ngây ra.
Dialogue: 0,0:14:20.53,0:14:23.03,Kujou,,0,0,0,,Vậy nên cậu mới hay ăn một mình hả?
Dialogue: 0,0:09:36.50,0:09:38.54,Kujou,,0,0,0,,Vậy nên khi Niimi-kun giải cứu tớ\N khỏi tình huống ấy...
Dialogue: 0,0:04:43.91,0:04:46.50,Sora,,0,0,0,,Vết cắt của anh sâu phết nhỉ?
Dialogue: 0,0:17:13.45,0:17:14.61,Kakeru,,0,0,0,,Về hộ anh mày cái.
Dialogue: 0,0:13:09.21,0:13:11.75,Naruse,,0,0,0,,Với lại mấy chuyện nguyền rủa đó đa phần là lừa gạt thôi.
Dialogue: 0,0:07:15.94,0:07:19.40,Sora,,0,0,0,,Với lại, sao tự dưng anh đòi ra ở riêng vậy?
Dialogue: 0,0:05:46.31,0:05:48.23,Kujou,,0,0,0,,X-Xin lỗi ạ.
Dialogue: 0,0:16:02.75,0:16:03.71,Kakeru,,0,0,0,,Xin lỗi nha.
Dialogue: 0,0:08:51.61,0:08:54.74,Kujou,,0,0,0,,Xin lỗi nhé, tớ hiểu lầm rồi...
Dialogue: 0,0:13:38.36,0:13:39.95,Kakeru,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:05:59.24,0:06:00.53,Kakeru,,0,0,0,,Xin lỗi vì đã làm phiền!
Dialogue: 0,0:19:19.37,0:19:22.03,Yoichi,,0,0,0,,Xin lỗi xin lỗi, cậu muốn xem bức tượng đúng không?
Dialogue: 0,0:21:39.72,0:21:41.26,Kujou,,0,0,0,,Xin lỗi, tớ chỉ đùa thôi.
Dialogue: 0,0:15:01.48,0:15:04.11,Kujou,,0,0,0,,Xin lỗi, tớ cố tình trêu cậu một chút thôi.
Dialogue: 0,0:04:13.38,0:04:15.80,Kujou,,0,0,0,,Xin mọi người hãy giữ bình tĩnh!
Dialogue: 0,0:11:22.14,0:11:24.68,Kakeru,,0,0,0,,Yoichi, cái ấy là cái gì?
Dialogue: 0,0:02:59.18,0:03:06.65,Normal,,0,0,0,,[Chúa Nhẫn Mobius, Vòng Lặp của Sự Luân Hồi]
Dialogue: 0,0:07:45.22,0:07:46.76,Normal,,0,0,0,,[Nine Ball]
Dialogue: 0,0:21:48.23,0:21:51.31,Normal,,0,0,0,,[Nữ sinh mất tích ở thành phố Shiromitsugawa.]
Dialogue: 0,0:07:21.55,0:07:24.44,Kakeru,,0,0,0,,cho nên người bố thân yêu của chúng ta \Nđã sút anh ra khỏi nhà đấy.
Dialogue: 0,0:08:35.35,0:08:38.06,Kakeru,,0,0,0,,cái này giống như của Kujou thì hơn đấy.
Dialogue: 0,0:09:08.28,0:09:10.18,Kujou,,0,0,0,,cảm ơn cậu vì đã luôn là khách quen của tiệm.
Dialogue: 0,0:19:05.43,0:19:07.50,Yoichi,,0,0,0,,giống như người thật bị biến thành tượng đá vậy.
Dialogue: 0,0:12:45.31,0:12:47.23,Kujou,,0,0,0,,hay cất vào ngăn kéo hoặc chỗ nào đó...
Dialogue: 0,0:03:22.45,0:03:24.33,Kujou,,0,0,0,,mọi người có thể đến khu đối diện sân khấu để chọn mua.
Dialogue: 0,0:09:55.18,0:09:57.78,Kakeru,,0,0,0,,nhưng ai ngờ nói chuyện lại rất dễ gần.
Dialogue: 0,0:13:20.80,0:13:23.05,Naruse,,0,0,0,,nhờ em đưa Kujou-san về nhà nhé.
Dialogue: 0,0:22:03.61,0:22:05.65,Kakeru,,0,0,0,,nên lời nguyền mới giáng xuống Shiromitsugawa?
Dialogue: 0,0:10:57.95,0:11:00.66,Sora,,0,0,0,,nên mới bầu bạn cùng \Nđể anh không thấy cô đơn ấy chứ!
Dialogue: 0,0:06:59.88,0:07:01.80,Kakeru,,0,0,0,,nên đã đứng ra gánh vác\N mấy việc cực khổ ấy.
Dialogue: 0,0:02:21.35,0:02:24.78,Normal - Copy,,0,0,150,,{\4a&HB0&}Agastya ấy thuộc một vòng nhẫn khác.
Dialogue: 0,0:00:52.38,0:00:54.31,Normal - Copy,,0,0,150,,{\4a&HB0&}Bọn ta là Những Chiếc Lá của Agastya.
Dialogue: 0,0:02:24.78,0:02:27.69,Normal - Copy,,0,0,150,,{\4a&HB0&}Chính là vòng nhẫn Mobius, thứ 13.
Dialogue: 0,0:02:14.77,0:02:17.56,Normal - Copy,,0,0,150,,{\4a&HB0&}Chẳng phải Agastya đã bị xóa sổ rồi sao?
Dialogue: 0,0:00:44.42,0:00:47.76,Normal - Copy,,0,0,150,,{\4a&HB0&}Cánh cổng đó kết nối thế giới hiện tại của chúng ta\N tới một thế giới hoàn toàn khác.
Dialogue: 0,0:00:43.04,0:00:44.42,Normal - Copy,,0,0,150,,{\4a&HB0&}Cánh cổng?
Dialogue: 0,0:01:12.49,0:01:15.29,Normal - Copy,,0,0,150,,{\4a&HB0&}Cậu cũng đã được ban cho sức mạnh.
Dialogue: 0,0:01:23.96,0:01:24.97,Normal - Copy,,0,0,150,,{\4a&HB0&}Hay lắm!
Dialogue: 0,0:01:06.40,0:01:09.03,Normal - Copy,,0,0,150,,{\4a&HB0&}Khi cánh cổng dẫn tới thế giới khác hé mở,
Dialogue: 0,0:02:29.36,0:02:31.78,Normal - Copy,,0,0,150,,{\4a&HB0&}Không lẽ ngươi thuộc Project Zero sao?
Dialogue: 0,0:02:32.07,0:02:35.33,Normal - Copy,,0,0,150,,{\4a&HB0&}Không một ai có thể thoát khỏi ma nhãn của ta.
Dialogue: 0,0:01:31.38,0:01:33.05,Normal - Copy,,0,0,150,,{\4a&HB0&}Không thể nào...
Dialogue: 0,0:02:27.69,0:02:29.36,Normal - Copy,,0,0,150,,{\4a&HB0&}Khắc Ấn đó...
Dialogue: 0,0:02:09.92,0:02:11.67,Normal - Copy,,0,0,150,,{\4a&HB0&}Ma Nhãn Iris!
Dialogue: 0,0:01:34.30,0:01:36.18,Normal - Copy,,0,0,150,,{\4a&HB0&}Mình đã giết người!
Dialogue: 0,0:01:33.05,0:01:34.30,Normal - Copy,,0,0,150,,{\4a&HB0&}Mình...
Dialogue: 0,0:01:43.48,0:01:46.78,Normal - Copy,,0,0,150,,{\4a&HB0&}Nghe ta nói đây, hỡi những kẻ mang sức mạnh\N được Khải Huyền lựa chọn...
Dialogue: 0,0:02:17.81,0:02:21.35,Normal - Copy,,0,0,150,,{\4a&HB0&}Người đã tái cơ cấu Agastya, \Nchính là ta chứ chẳng phải ai khác.
Dialogue: 0,0:02:51.55,0:02:54.67,Normal - Copy,,0,0,150,,{\4a&HB0&}Ta là Ma Nhãn Iris.
Dialogue: 0,0:02:45.30,0:02:47.00,Normal - Copy,,0,0,150,,{\4a&HB0&}Ta sẽ sửa chữa thế giới này,
Dialogue: 0,0:01:00.23,0:01:02.10,Normal - Copy,,0,0,150,,{\4a&HB0&}Thánh Tích?
Dialogue: 0,0:01:46.78,0:01:49.86,Normal - Copy,,0,0,150,,{\4a&HB0&}Thế giới cũ của các ngươi giờ đã đến hồi kết,
Dialogue: 0,0:02:11.92,0:02:14.30,Normal - Copy,,0,0,150,,{\4a&HB0&}Tại sao nhà ngươi lại ở đây!?
Dialogue: 0,0:00:47.76,0:00:50.63,Normal - Copy,,0,0,150,,{\4a&HB0&}Vậy nên bọn ta đã thành lập một tổ chức
Dialogue: 0,0:01:09.03,0:01:11.82,Normal - Copy,,0,0,150,,{\4a&HB0&}cũng là lúc một luồng sức mạnh bí ẩn\N sẽ tràn vào khắp thế giới của chúng ta.
Dialogue: 0,0:01:49.86,0:01:53.03,Normal - Copy,,0,0,150,,{\4a&HB0&}hãy nguyện theo lời tiên tri của Nadi đi!
Dialogue: 0,0:00:57.14,0:01:00.23,Normal - Copy,,0,0,150,,{\4a&HB0&}không thể thiếu sức mạnh từ Thánh Tích.
Dialogue: 0,0:00:50.63,0:00:52.38,Normal - Copy,,0,0,150,,{\4a&HB0&}nhằm bảo vệ thế giới khỏi thế lực bên ngoài xâm lược.
Dialogue: 0,0:02:47.00,0:02:49.42,Normal - Copy,,0,0,150,,{\4a&HB0&}và đưa nó trở lại quỹ đạo ban đầu.
Dialogue: 0,0:01:58.91,0:02:01.12,Normal - Copy,,0,0,150,,{\4a&HB0&}Ánh sáng đó... là gì vậy?
Dialogue: 0,0:00:40.00,0:00:41.50,Normal - Copy,,0,0,150,,{\4a&HB0&}Đi theo tôi.
Dialogue: 0,0:01:24.97,0:01:26.70,Normal - Copy,,0,0,150,,{\4a&HB0&}Đây chính là sức mạnh của Thánh Tích!
Dialogue: 0,0:01:16.62,0:01:18.00,Normal - Copy,,0,0,150,,{\4a&HB0&}Đây là...
Dialogue: 0,0:01:30.13,0:01:31.38,Normal - Copy,,0,0,150,,{\4a&HB0&}Đùa nhau à...
Dialogue: 0,0:01:02.10,0:01:03.27,Normal - Copy,,0,0,150,,{\4a&HB0&}Đúng vậy.
Dialogue: 0,0:00:55.35,0:00:57.14,Normal - Copy,,0,0,150,,{\4a&HB0&}Để giành thắng lợi trong trận chiến cam go phía trước,
Dialogue: 0,0:16:31.45,0:16:34.95,Kujou,,0,0,0,,{\an8}(Mong được cậu giúp đỡ trong thời gian tới)
Dialogue: 0,0:23:36.98,0:23:39.96,Default,,0,0,0,,{\an9\fscx100\fscy100\pos(1890,16)}Vietsub by Nine Translation.
Dialogue: 0,0:23:36.98,0:23:39.96,Default1,,0,0,0,,{\pos(960,820)\fscx100\fscy100\b1}Nhánh 01
Dialogue: 0,0:13:51.83,0:13:53.87,Kujou,,0,0,0,,À, vì vậy nên hôm qua cậu mới tham gia sự kiện à?
Dialogue: 0,0:08:20.96,0:08:22.46,Kakeru,,0,0,0,,À... ừ.
Dialogue: 0,0:16:21.02,0:16:22.90,Kakeru,,0,0,0,,À... ừ.
Dialogue: 0,0:10:49.48,0:10:50.48,Kakeru,,0,0,0,,Ê này...
Dialogue: 0,0:06:25.14,0:06:27.31,Sora,,0,0,0,,Ông anh tôi nay ngầu phết đấy nhỉ?
Dialogue: 0,0:12:49.15,0:12:51.02,Kakeru,,0,0,0,,Ý cậu là... nó có thể tự di chuyển?
Dialogue: 0,0:04:31.94,0:04:32.94,Kakeru,,0,0,0,,Đau!
Dialogue: 0,0:04:49.67,0:04:50.96,Kakeru,,0,0,0,,Đau!
Dialogue: 0,0:03:34.76,0:03:37.26,Kakeru,,0,0,0,,Đi vào chút nữa \Nlà tới chính điện rồi đúng không nhỉ?
Dialogue: 0,0:18:52.84,0:18:54.38,Yoichi,,0,0,0,,Đi xem thử đi mà.
Dialogue: 0,0:19:11.03,0:19:12.44,Yoichi,,0,0,0,,Đi xem đi mà!
Dialogue: 0,0:16:13.10,0:16:14.60,Kujou,,0,0,0,,Đây là tài khoản của tớ.
Dialogue: 0,0:13:04.11,0:13:05.96,Kakeru,,0,0,0,,Đã bảo là em không làm vỡ nó mà!
Dialogue: 0,0:20:26.81,0:20:28.27,Kakeru,,0,0,0,,Đã bảo là đừng động vào mà!
Dialogue: 0,0:21:51.31,0:21:53.35,Kakeru,,0,0,0,,Đã phát hiện thi thể ở trạng thái hóa đá.
Dialogue: 0,0:19:29.42,0:19:31.59,Yoichi,,0,0,0,,Được đấy, cùng đi thôi!
Dialogue: 0,0:13:24.13,0:13:28.60,Naruse,,0,0,0,,Để một cô gái đang lo lắng bất an\N tự đi về nhà thì quá đáng lắm đó!
Dialogue: 0,0:10:42.18,0:10:44.47,Normal,,0,0,0,,Để tớ giúp cậu cầm đồ nhé.
Dialogue: 0,0:14:28.66,0:14:30.20,Kakeru,,0,0,0,,Đối với tớ thì quá lý tưởng rồi.
Dialogue: 0,0:20:32.02,0:20:33.15,Kujou,,0,0,0,,Đợi đã!
Dialogue: 0,0:20:17.22,0:20:18.85,Kakeru,,0,0,0,,Đừng có nói mấy thứ đáng sợ như thế...
Dialogue: 0,0:16:24.02,0:16:26.20,Kakeru,,0,0,0,,Đừng lo lắng quá.
Dialogue: 0,0:13:28.60,0:13:31.81,Kujou,,0,0,0,,Ơ... thật ra em không sao đâu mà...
Dialogue: 0,0:22:32.64,0:22:34.18,Yoichi,,0,0,0,,Ể? Cái gì vậy?
Dialogue: 0,0:17:12.07,0:17:13.45,Kakeru,,0,0,0,,Ồn ào vậy sẽ làm phiền hàng xóm đó.
Dialogue: 0,0:23:26.83,0:23:29.43,Kakeru,,0,0,0,,Ở đây nguy hiểm lắm, cậu mau quay về lớp đi!
Dialogue: 0,0:17:31.80,0:17:33.97,Kakeru,,0,0,0,,Ủa, cái này là...?
Dialogue: 0,0:13:53.87,0:13:55.51,Kakeru,,0,0,0,,Ừ, tớ đến để phụ giúp thôi.
Dialogue: 0,0:06:15.96,0:06:18.26,Kujou,,0,0,0,,Ừ-Ừm... Cảm ơn cậu.
Dialogue: 0,0:05:37.38,0:05:39.76,Kakeru,,0,0,0,,Ừm, Sensei bảo thế thì đành về sớm vậy.
Dialogue: 0,0:08:12.74,0:08:13.74,Kakeru,,0,0,0,,Ừm.
