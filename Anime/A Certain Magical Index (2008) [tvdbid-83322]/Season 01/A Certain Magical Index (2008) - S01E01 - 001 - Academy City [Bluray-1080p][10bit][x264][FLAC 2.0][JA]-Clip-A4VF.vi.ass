Dialogue: 0,0:00:26.59,0:00:29.71,Default,Touma,0,0,0,,Đang phải trải qua một cuộc đời...
Dialogue: 0,0:00:29.71,0:00:31.72,Default,Touma,0,0,0,,...đầy rẫy những điều xui xẻo.\N
Dialogue: 0,0:02:03.35,0:02:05.88,Default,Touma,0,0,0,,Đúng, đó là ngày 19 tháng 6
Dialogue: 0,0:02:06.36,0:02:10.21,Default,Touma,0,0,0,,Tôi hí hửng bước vào một quan ăn gia đình để chào mừng kì nghỉ hè đã tới...
Dialogue: 0,0:02:10.58,0:02:13.72,Default,Touma,0,0,0,,Đang tính gọi mấy món như kiểu dưa đắng hay ốc xào chua ngọt.
Dialogue: 0,0:02:13.92,0:02:15.61,Default,Touma,0,0,0,,Và mọi chuyện bắt đầu.
Dialogue: 0,0:02:17.56,0:02:20.10,Default,Touma,0,0,0,,Thấy một cô gái bị mấy thằng đầu gấu dụ dỗ,
Dialogue: 0,0:02:20.10,0:02:23.94,Default,Touma,0,0,0,,Tôi định ra vẻ anh hùng chút, nhưng sự việc lại thành ra thế này đây.
Dialogue: 0,0:02:24.65,0:02:26.23,Default,mob,0,0,0,,Nào, đi nhé?
Dialogue: 0,0:02:26.23,0:02:27.31,Default,Touma,0,0,0,,Này anh ơi.
Dialogue: 0,0:02:30.24,0:02:32.60,Default,Touma,0,0,0,,Tôi nghĩ cô ấy không thích đâu.
Dialogue: 0,0:02:32.60,0:02:34.37,Default,mob,0,0,0,,Ahh, thật thoải mái.
Dialogue: 0,0:02:34.37,0:02:35.64,Default,mob,0,0,0,,Đúng thế, đúng thế!
Dialogue: 0,0:02:37.33,0:02:38.92,Default,mob,0,0,0,,Thằng này muốn gì?
Dialogue: 0,0:02:38.92,0:02:40.77,Default,mob,0,0,0,,Dám ý kiến hả?
Dialogue: 0,0:02:41.73,0:02:45.40,Default,Touma,0,0,0,,Ôi chúa ơi, sao ông trù con dữ vậy?!
Dialogue: 0,0:02:57.75,0:03:00.11,Default,Touma,0,0,0,,Phù, thoát rùi.
Dialogue: 0,0:03:00.38,0:03:01.50,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:03:02.11,0:03:04.09,Default,Mikoto,0,0,0,,Tôi không hiểu trong đầu anh nghĩ gì...
Dialogue: 0,0:03:04.50,0:03:07.39,Default,Mikoto,0,0,0,,Mà đi bảo vệ mấy thằng đầu gấu đó.
Dialogue: 0,0:03:07.74,0:03:09.30,Default,Mikoto,0,0,0,,Muốn làm công dân gương mẫu hả?
Dialogue: 0,0:03:10.51,0:03:12.88,Default,Touma,0,0,0,,Vậy ra họ không bám theo tôi nữa là vì...
Dialogue: 0,0:03:12.88,0:03:16.34,Default,Mikoto,0,0,0,,Ừ, vì bị tôi giải quyết hết trơn rồi.
Dialogue: 0,0:03:17.97,0:03:19.65,Default,Touma,0,0,0,,Thiệt tình...
Dialogue: 0,0:03:20.66,0:03:23.43,Default,Mikoto,0,0,0,,Nè, biết Railgun là gì không?
Dialogue: 0,0:03:24.14,0:03:25.60,Default,Touma,0,0,0,,Railgun?
Dialogue: 0,0:03:25.60,0:03:27.71,Default,Mikoto,0,0,0,,Còn được gọi là súng siêu điện từ.
Dialogue: 0,0:03:28.11,0:03:33.86,Default,Mikoto,0,0,0,,Bằng cách sử dụng nhiệt động lượng,\N chúng có thể được bắn đi như đạn pháo
Dialogue: 0,0:03:36.11,0:03:38.82,Default,Mikoto,0,0,0,,Đại khái là như thế này nè!
Dialogue: 0,0:03:44.56,0:03:47.95,Default,Mikoto,0,0,0,,Một đồng xu nhỏ nếu được bắn đi với 3 lần vận tốc âm thanh,
Dialogue: 0,0:03:47.95,0:03:50.29,Default,Mikoto,0,0,0,,Có thể tạo ra sức công phá như vậy đó.
Dialogue: 0,0:03:50.29,0:03:53.26,Default,Touma,0,0,0,,Không lẽ cô vừa xài cái này với bọn họ hả?
Dialogue: 0,0:03:53.88,0:03:54.92,Default,Mikoto,0,0,0,,Đừng ngốc thế.
Dialogue: 0,0:03:55.44,0:03:59.94,Default,Mikoto,0,0,0,,Mấy tên Level 0 có cách riêng của nó, và tôi là chuyên gia.
Dialogue: 0,0:03:59.94,0:04:04.03,Default,Touma,0,0,0,,Ừ, người tôi định cứu không phải cô ta.
Dialogue: 0,0:04:04.03,0:04:07.94,Default,Touma,0,0,0,,Mà là mấy thằng ngu không biết mình đang dây vào một con cọp cái.
Dialogue: 0,0:04:08.82,0:04:14.94,Default,Touma,0,0,0,,Tôi biết cô là một trong bảy Siêu năng lực gia level 5 của Thành phố Học viện.
Dialogue: 0,0:04:15.76,0:04:19.58,Default,Touma,0,0,0,,Nhưng cũng nên bỏ cái thói đánh người tùy tiện ấy đi, thật lòng đấy.
Dialogue: 0,0:04:20.78,0:04:23.74,Default,Mikoto,0,0,0,,Thiệt tình, lũ yếu đuối sẽ không nói thế.
Dialogue: 0,0:04:24.19,0:04:25.44,Default,Touma,0,0,0,,Oi, oi, oi.
Dialogue: 0,0:04:25.44,0:04:26.87,Default,Touma,0,0,0,,Tôi cũng mới Level 0 mà!
Dialogue: 0,0:04:46.72,0:04:53.77,Default,Mikoto,0,0,0,,Thế... sao một level 0 như anh, vẫn vô sự sau chiêu vừa rồi.
Dialogue: 0,0:04:56.51,0:04:57.77,Default,Touma,0,0,0,,Phải nói sao nhỉ?
Dialogue: 0,0:04:58.06,0:04:59.69,Default,Touma,0,0,0,,Xui xẻo?
Dialogue: 0,0:04:59.69,0:05:01.24,Default,Touma,0,0,0,,Không may?
Dialogue: 0,0:05:01.71,0:05:04.66,Default,Touma,0,0,0,,Vận may của cô hết thật rồi đó.
Dialogue: 0,0:05:27.05,0:05:29.96,Default,Touma,0,0,0,,Nhờ cái đống sấm sét của con ả hôm qua,
Dialogue: 0,0:05:29.96,0:05:33.20,Default,Touma,0,0,0,,Mà khu tôi được một ngày sống không có điện.
Dialogue: 0,0:05:33.79,0:05:34.60,Default,Touma,0,0,0,,Nóng quá...
Dialogue: 0,0:05:40.43,0:05:44.59,Default,Touma,0,0,0,,Và thế là mấy thứ tôi để trong tủ lạnh đã thành Shit hết rồi.
Dialogue: 0,0:05:46.88,0:05:50.62,Default,Touma,0,0,0,,Nguồn lương thực cuối cùng là hộp Yakisoba cũng bị tôi lỡ tay làm đổ.
Dialogue: 0,0:05:51.19,0:05:54.58,Default,Touma,0,0,0,,Khi đang kiếm cái ví, tôi dẫm hỏng luôn cái thẻ trả sau.
Dialogue: 0,0:05:55.46,0:06:00.59,Default,Touma,0,0,0,,Mụ giáo thì nói :"Kamiyo-chan, chiều đi học thêm cho đỡ ngốc nghe chưa", qua điện thoại.
Dialogue: 0,0:06:02.53,0:06:04.03,Default,Touma,0,0,0,,Xui xẻo.
Dialogue: 0,0:06:04.50,0:06:07.27,Default,Touma,0,0,0,,Thôi kệ... hôm nay trời đẹp quá.
Dialogue: 0,0:06:07.27,0:06:10.29,Default,Touma,0,0,0,,Đi phơi đệm cho thay đổi không khí nào.
Dialogue: 0,0:06:18.06,0:06:22.96,Default,Touma,0,0,0,,Bầu trời luôn trong xanh, mà sao tương lai ta tăm tối.
Dialogue: 0,0:06:24.56,0:06:28.14,Default,Touma,0,0,0,,Ông trời, đừng có tắm ngay lúc này nha.
Dialogue: 0,0:06:30.19,0:06:34.66,Default,Touma,0,0,0,,Ủa, mình phơi cái gì nhỉ?
Dialogue: 0,0:06:43.42,0:06:45.88,Default,Touma,0,0,0,,Một bé gái?
Dialogue: 0,0:06:45.88,0:06:47.59,Default,Touma,0,0,0,,Sao nó lại nằm đây?
Dialogue: 0,0:06:47.84,0:06:50.80,Default,Touma,0,0,0,,Bộ đồ này... nữ tu hả?
Dialogue: 0,0:06:52.09,0:06:54.67,Default,Touma,0,0,0,,Chắc là người nước ngoài...
Dialogue: 0,0:06:57.68,0:06:58.39,Default,Index,0,0,0,,Đói...
Dialogue: 0,0:06:59.55,0:07:01.31,Default,Index,0,0,0,,Em đói quá.
Dialogue: 0,0:07:02.61,0:07:04.16,Default,Index,0,0,0,,Em đói quá.
Dialogue: 0,0:07:04.65,0:07:05.81,Default,Touma,0,0,0,,Gì cơ?
Dialogue: 0,0:07:05.81,0:07:06.78,Default,Index,0,0,0,,Em đói quá.
Dialogue: 0,0:07:08.10,0:07:09.60,Default,Touma,0,0,0,,Tiếng nhật luôn?
Dialogue: 0,0:07:12.40,0:07:14.37,Default,Index,0,0,0,,Em đang kêu đói anh nghe không?
Dialogue: 0,0:07:14.58,0:07:22.35,Default,Touma,0,0,0,,Xem nào... ý em là em giống mấy gã lang thang đang sắp chết đói ngoài đường hả?
Dialogue: 0,0:07:22.35,0:07:23.84,Default,Index,0,0,0,,Và sắp té chết luôn rồi đây.
Dialogue: 0,0:07:25.11,0:07:29.84,Default,Index,0,0,0,,Nè, em sẽ biết ơn anh lắm đấy được ăn no.
Dialogue: 0,0:07:30.73,0:07:34.56,Default,Touma,0,0,0,,Có nên cho con bé xuống suối hưởng phúc sớm chút không nhỉ?
Dialogue: 0,0:07:39.89,0:07:41.95,Default,Touma,0,0,0,,Thế ăn tạm cái này được không?
Dialogue: 0,0:07:42.86,0:07:43.90,Default,Index,0,0,0,,Cám ơn anh!
Dialogue: 0,0:07:43.90,0:07:45.30,Default,Index,0,0,0,,Em ăn liền đây.
Dialogue: 0,0:07:52.03,0:07:53.28,Default,Index,0,0,0,,Ngon quá.
Dialogue: 0,0:07:53.28,0:07:54.56,Default,Index,0,0,0,,Ngon thiệt đấy.
Dialogue: 0,0:07:54.94,0:07:56.84,Default,Touma,0,0,0,,V-Vậy à...
Dialogue: 0,0:07:57.23,0:08:02.47,Default,Touma,0,0,0,,Đó là thành phẩm của một mớ rau héo trộn với vài món quá đát trong tủ lạnh mà...
Dialogue: 0,0:08:02.47,0:08:03.54,Default,Index,0,0,0,,Cái vị này...
Dialogue: 0,0:08:03.54,0:08:05.34,Default,Index,0,0,0,,Chắc muốn giúp em hồi phục nhanh hơn,
Dialogue: 0,0:08:05.55,0:08:08.41,Default,Index,0,0,0,,Nên anh làm nó chua chua phải không.
Dialogue: 0,0:08:08.98,0:08:09.80,Default,Touma,0,0,0,,Chua?
Dialogue: 0,0:08:10.12,0:08:12.18,Default,Touma,0,0,0,,Không cần ăn cố đâu...
Dialogue: 0,0:08:12.18,0:08:14.21,Default,Touma,0,0,0,,Đàn ông nấu ăn tệ lắm...
Dialogue: 0,0:08:14.21,0:08:16.35,Default,Index,0,0,0,,Tệ sao được.
Dialogue: 0,0:08:16.35,0:08:19.48,Default,Index,0,0,0,,Anh đã bỏ công nấu không cho em.
Dialogue: 0,0:08:19.48,0:08:21.39,Default,Index,0,0,0,,Nên dù thế nào nó cũng sẽ ngon.
Dialogue: 0,0:08:27.22,0:08:29.09,Default,Touma,0,0,0,,Kẻ xuống địa ngục phải là anh mới đúng.
Dialogue: 0,0:08:40.54,0:08:41.16,Default,Touma,0,0,0,,Thế....
Dialogue: 0,0:08:41.45,0:08:44.23,Default,Touma,0,0,0,,Sao tự dưng em lại nằm trên ban công nhà anh?
Dialogue: 0,0:08:44.23,0:08:45.59,Default,Index,0,0,0,,Bị ngã.
Dialogue: 0,0:08:45.59,0:08:48.97,Default,Index,0,0,0,,Lúc đầu em định nhảy sang mái nhà bên cạnh kìa.
Dialogue: 0,0:08:50.24,0:08:51.63,Default,Touma,0,0,0,,Nhà này 8 tầng mà?
Dialogue: 0,0:08:51.88,0:08:53.81,Default,Index,0,0,0,,Tình thế bắt buộc thôi.
Dialogue: 0,0:08:53.81,0:08:55.16,Default,Index,0,0,0,,Tại người ta rượt dữ quá.
Dialogue: 0,0:08:55.86,0:08:58.14,Default,Index,0,0,0,,À đúng rồi, em quên chưa giới thiệu,
Dialogue: 0,0:08:58.63,0:09:01.27,Default,Index,0,0,0,,Em tên Index.
Dialogue: 0,0:09:01.99,0:09:03.10,Default,Touma,0,0,0,,Index?
Dialogue: 0,0:09:03.54,0:09:05.98,Default,Touma,0,0,0,,Nè, tên thiệt hay biệt hiệu vậy?
Dialogue: 0,0:09:05.98,0:09:08.12,Default,Touma,0,0,0,,Index là cái gì? Mục lục hả?
Dialogue: 0,0:09:08.90,0:09:11.45,Default,Index,0,0,0,,Là bản danh sách cho những tài liệu cấm.
Dialogue: 0,0:09:12.04,0:09:15.16,Default,Index,0,0,0,,Em còn pháp hiệu nữa, Dedicatus545.
Dialogue: 0,0:09:15.16,0:09:19.74,Default,Index,0,0,0,,Có nghĩa là con chiên tận tụy bảo vệ kho tàng tri thức của nhân loại.
Dialogue: 0,0:09:19.74,0:09:23.06,Default,Touma,0,0,0,,Thế sao Index-san à? ...Lại bị truy đuổi?
Dialogue: 0,0:09:23.06,0:09:27.31,Default,Index,0,0,0,,Có lẽ họ muốn sở hữu 10 vạn 3 ngàn cuốn sách ma thuật em đang nắm giữ.
Dialogue: 0,0:09:28.07,0:09:28.80,Default,Touma,0,0,0,,Sách ma thuật?
Dialogue: 0,0:09:29.55,0:09:30.32,Default,Index,0,0,0,,Ừ.
Dialogue: 0,0:09:30.92,0:09:32.06,Default,Index,0,0,0,,Sách Eibon
Dialogue: 0,0:09:32.06,0:09:33.04,Default,Index,0,0,0,,Lemegeton
Dialogue: 0,0:09:33.48,0:09:34.63,Default,Index,0,0,0,,Sách thần chết
Dialogue: 0,0:09:35.10,0:09:37.46,Default,Index,0,0,0,,Cuốn nào cũng quý cả.
Dialogue: 0,0:09:37.83,0:09:39.41,Default,Touma,0,0,0,,Trong người em thì chưa biết...
Dialogue: 0,0:09:39.41,0:09:41.43,Default,Touma,0,0,0,,Nhưng trên tay em cũng chưa thấy cuốn nào cả.
Dialogue: 0,0:09:41.60,0:09:43.11,Default,Index,0,0,0,,Em có thật mà.
Dialogue: 0,0:09:43.11,0:09:44.31,Default,Index,0,0,0,,10 Vạn 3 Ngàn cuốn sách.
Dialogue: 0,0:09:45.27,0:09:47.86,Default,Touma,0,0,0,,10 Vạn 3 Ngàn cuốn sách...
Dialogue: 0,0:09:47.86,0:09:49.82,Default,Touma,0,0,0,,Bộ em giữ chìa khóa của một nhà kho khổng lồ hả?
Dialogue: 0,0:09:50.55,0:09:51.57,Default,Index,0,0,0,,
Dialogue: 0,0:09:51.57,0:09:56.11,Default,Touma,0,0,0,,Chẳng lẽ... đó là thứ mấy thằng ngu không thể nhìn thấy?
Dialogue: 0,0:09:56.11,0:09:58.13,Default,Index,0,0,0,,Dù anh không ngu cũng không thấy được đâu.
Dialogue: 0,0:09:58.13,0:10:00.41,Default,Index,0,0,0,,Nếu ai cũng thấy được thì đâu gọi là sách quý?
Dialogue: 0,0:10:01.24,0:10:03.83,Default,Touma,0,0,0,,Thế? Ai đuổi theo em?
Dialogue: 0,0:10:04.00,0:10:05.29,Default,Index,0,0,0,,Hội ma thuật.
Dialogue: 0,0:10:06.63,0:10:07.29,Default,Touma,0,0,0,,Ma Thuật?
Dialogue: 0,0:10:07.49,0:10:10.22,Default,Index,0,0,0,,Eh? Tiếng Nhật của em có vấn đề hả?
Dialogue: 0,0:10:10.22,0:10:11.38,Default,Index,0,0,0,,Magic đó.
Dialogue: 0,0:10:11.38,0:10:12.57,Default,Index,0,0,0,,Magic Cabal.
Dialogue: 0,0:10:12.57,0:10:15.58,Default,Touma,0,0,0,,Đó là tên một tôn giáo mới hả?
Dialogue: 0,0:10:15.58,0:10:17.79,Default,Index,0,0,0,,Anh không hiểu hay cố tình trêu em đấy?
Dialogue: 0,0:10:18.71,0:10:20.97,Default,Index,0,0,0,,Anh không hiểu hay cố tình trêu em đấy?
Dialogue: 0,0:10:21.73,0:10:23.43,Default,Touma,0,0,0,,Xin lỗi, vô lý.
Dialogue: 0,0:10:25.52,0:10:28.86,Default,Touma,0,0,0,,Siêu năng lực thì anh thấy nhiều rồi.
Dialogue: 0,0:10:28.86,0:10:30.02,Default,Touma,0,0,0,,Nhưng ma thuật thì vô lý.
Dialogue: 0,0:10:30.94,0:10:35.31,Default,Touma,0,0,0,,Trong cái Thành phố Học viện này siêu năng lực gia đầy đường.
Dialogue: 0,0:10:35.81,0:10:38.79,Default,Touma,0,0,0,,Ít ra chúng đã được khoa học chứng minh.
Dialogue: 0,0:10:38.79,0:10:43.68,Default,Index,0,0,0,,Siêu năng lực thì tin được, sao ma thuật lại không tin?
Dialogue: 0,0:10:43.68,0:10:46.41,Default,Touma,0,0,0,,Thế? Ma thuật là gì nào?
Dialogue: 0,0:10:46.41,0:10:47.75,Default,Touma,0,0,0,,Làm thử anh coi đi.
Dialogue: 0,0:10:47.95,0:10:50.59,Default,Index,0,0,0,,Em không có ma lực, không làm được.
Dialogue: 0,0:10:52.18,0:10:55.95,Default,Touma,0,0,0,,Cả em cũng không làm được thì sao dám nói ma thuật có thật hay không?
Dialogue: 0,0:10:55.95,0:10:56.76,Default,Index,0,0,0,,Thật mà!
Dialogue: 0,0:10:57.29,0:10:58.63,Default,Index,0,0,0,,Ma thuật có thật mà.
Dialogue: 0,0:11:01.21,0:11:05.60,Default,Touma,0,0,0,,À, nhắc đến khả năng đặc biệt thì anh cũng có đấy.
Dialogue: 0,0:11:06.31,0:11:07.79,Default,Index,0,0,0,,Khả năng gì vậy?
Dialogue: 0,0:11:07.79,0:11:11.51,Default,Touma,0,0,0,,Cánh tay này có thể vô hiệu hóa các siêu năng lực khác.
Dialogue: 0,0:11:11.51,0:11:13.44,Default,Touma,0,0,0,,Dù là Railgun hay sét giật cũng vậy.
Dialogue: 0,0:11:14.50,0:11:17.69,Default,Touma,0,0,0,,Có khi cả phép thuật của chúa nữa đấy.
Dialogue: 0,0:11:17.69,0:11:18.32,Default,Touma,0,0,0,,Đúng thế.
Dialogue: 0,0:11:20.30,0:11:23.57,Default,Touma,0,0,0,,Sao cái mặt em như muốn chốt ngay một chữ "XẠO" vô mặt anh là sao?!
Dialogue: 0,0:11:23.57,0:11:24.83,Default,Index,0,0,0,,Thì...
Dialogue: 0,0:11:24.83,0:11:27.95,Default,Index,0,0,0,,Một người thậm chí còn không tin vào chúa..
Dialogue: 0,0:11:27.95,0:11:31.42,Default,Index,0,0,0,,Lại đang nói mình có khả năng xóa bỏ phép thuật của ông ta.
Dialogue: 0,0:11:32.48,0:11:33.93,Default,Touma,0,0,0,,Chọc tao hả!?
Dialogue: 0,0:11:33.93,0:11:36.92,Default,Touma,0,0,0,,Một con pháp sư lởm mà cũng bày đặt dạy khôn!
Dialogue: 0,0:11:37.08,0:11:38.87,Default,Index,0,0,0,,Em không có lởm!
Dialogue: 0,0:11:38.87,0:11:40.52,Default,Touma,0,0,0,,Thế thì làm phép đi.
Dialogue: 0,0:11:40.52,0:11:42.42,Default,Touma,0,0,0,,Nếu anh hóa giải được nó,
Dialogue: 0,0:11:42.42,0:11:44.52,Default,Touma,0,0,0,,Thì em cũng phải tin anh thôi.
Dialogue: 0,0:11:44.52,0:11:45.79,Default,Index,0,0,0,,Được rồi!
Dialogue: 0,0:11:45.79,0:11:47.54,Default,Index,0,0,0,,Em sẽ cho anh coi!
Dialogue: 0,0:11:47.54,0:11:48.19,Default,Index,0,0,0,,Đây!
Dialogue: 0,0:11:48.19,0:11:49.24,Default,Index,0,0,0,,Bộ đồ này.
Dialogue: 0,0:11:49.24,0:11:53.15,Default,Index,0,0,0,,Đây là bộ "Aruku Kyoukai", được bảo vệ bởi kết giới cực kỳ vững chắc.
Dialogue: 0,0:11:53.15,0:11:54.62,Default,Touma,0,0,0,,Cái qué gì thế?!
Dialogue: 0,0:11:54.62,0:11:58.62,Default,Touma,0,0,0,,Toàn ném ra mấy từ chỉ một mình em hiểu.
Dialogue: 0,0:11:58.62,0:11:59.65,Default,Touma,0,0,0,,Chả hiểu cái gì hết.
Dialogue: 0,0:12:04.08,0:12:06.14,Default,Index,0,0,0,,Giải thích với anh thật phí lời.
Dialogue: 0,0:12:06.14,0:12:08.20,Default,Index,0,0,0,,Thử xài dao đâm em một nhát đi!
Dialogue: 0,0:12:08.20,0:12:09.62,Default,Touma,0,0,0,,T-Tại sao chứ...
Dialogue: 0,0:12:09.94,0:12:16.34,Default,Index,0,0,0,,Đây chính là dạng thu nhỏ của một nhà thờ, nó hội đủ các yếu tố mà một nhà thờ cần có.
Dialogue: 0,0:12:16.60,0:12:20.62,Default,Index,0,0,0,,Con dao thái thịt bé xíu này đâm vô sẽ chẳng làm gì được nó hết.
Dialogue: 0,0:12:21.07,0:12:23.48,Default,Touma,0,0,0,,Vậy... Anh đâm thử phát nhé.
Dialogue: 0,0:12:23.48,0:12:25.27,Default,Touma,0,0,0,,Nghe sao lố bịch quá.
Dialogue: 0,0:12:25.27,0:12:27.01,Default,Index,0,0,0,,Anh rõ ràng vẫn trêu em mà!
Dialogue: 0,0:12:27.01,0:12:30.42,Default,Index,0,0,0,,Đây là bản Copy của Vải liệm thánh Turin
Dialogue: 0,0:12:30.42,0:12:32.13,Default,Index,0,0,0,,Có sức phòng thủ tuyệt đối.
Dialogue: 0,0:12:32.13,0:12:35.41,Default,Index,0,0,0,,Có thể ngăn được mọi ma thuật hay siêu năng lực.
Dialogue: 0,0:12:35.41,0:12:37.14,Default,Index,0,0,0,,Và hấp thụ chúng luôn.
Dialogue: 0,0:12:37.94,0:12:39.37,Default,Touma,0,0,0,,Nói thế thì...
Dialogue: 0,0:12:39.37,0:12:42.33,Default,Touma,0,0,0,,Nếu nó đúng là cái gì đó như em nói...
Dialogue: 0,0:12:42.33,0:12:45.70,Default,Touma,0,0,0,,Vậy để anh chạm thử một cái là biết ngay à.
Dialogue: 0,0:12:47.19,0:12:49.87,Default,Index,0,0,0,,Nếu như khả năng của anh là-có-thiệt.
Dialogue: 0,0:12:51.86,0:12:53.42,Default,Touma,0,0,0,,Được rồi nhóc con...
Dialogue: 0,0:12:53.64,0:12:55.00,Default,Touma,0,0,0,,Chính mày thách anh...
Dialogue: 0,0:12:55.17,0:12:57.34,Default,Touma,0,0,0,,Nên đừng hối tiếc đó!
Dialogue: 0,0:13:07.30,0:13:08.06,Default,Touma,0,0,0,,À lế?
Dialogue: 0,0:13:09.76,0:13:11.56,Default,Index,0,0,0,,Chẳng thấy gì xảy ra hết.
Dialogue: 0,0:13:20.26,0:13:20.74,Default,Index,0,0,0,,Sao thế?
Dialogue: 0,0:13:21.24,0:13:22.78,Default,Touma,0,0,0,,À thì...
Dialogue: 0,0:13:39.45,0:13:40.59,Default,Touma,0,0,0,,Thiệt tình...
Dialogue: 0,0:13:40.59,0:13:42.82,Default,Touma,0,0,0,,Cắn đau dữ vậy...
Dialogue: 0,0:13:42.82,0:13:45.62,Default,Touma,0,0,0,,Em là cái giống gì thế hả?
Dialogue: 0,0:13:49.12,0:13:51.59,Default,Touma,0,0,0,,Cho anh xin lỗi vụ lúc nãy.
Dialogue: 0,0:13:51.59,0:13:52.10,Default,Touma,0,0,0,,Thế nên...
Dialogue: 0,0:13:53.59,0:13:58.06,Default,Index,0,0,0,,Vừa mới lạm dụng người ta xong, sao anh còn dám nói lời xin lỗi?
Dialogue: 0,0:13:58.25,0:14:03.26,Default,Touma,0,0,0,,Ai za... Tại anh hơi mất bình tĩnh...
Dialogue: 0,0:14:03.26,0:14:04.28,Default,Touma,0,0,0,,Nói sao nhỉ...
Dialogue: 0,0:14:04.48,0:14:05.61,Default,Index,0,0,0,,Trêu em nữa hả?
Dialogue: 0,0:14:05.61,0:14:06.24,Default,Index,0,0,0,,Mồ!
Dialogue: 0,0:14:10.57,0:14:11.98,Default,Touma,0,0,0,,Bộ đồ nữ tu...
Dialogue: 0,0:14:12.48,0:14:18.70,Default,Touma,0,0,0,,Tay mình có thể phá hủy nó, vậy những gì con bé nói vừa rồi là thật.
Dialogue: 0,0:14:18.70,0:14:19.50,Default,Index,0,0,0,,Xong rồi!
Dialogue: 0,0:14:25.45,0:14:28.18,Default,Touma,0,0,0,,Gì đây... Iron Maiden hả?
Dialogue: 0,0:14:28.18,0:14:30.53,Default,Index,0,0,0,,Trong tiếng Nhật gọi là kim băng đó.
Dialogue: 0,0:14:33.43,0:14:34.81,Default,Touma,0,0,0,,Chết rồi, học thêm!
Dialogue: 0,0:14:34.19,0:14:34.81,Default,Touma,0,0,0,,
Dialogue: 0,0:14:35.72,0:14:39.19,Default,Touma,0,0,0,,Xin lỗi, chiều nay anh phải đến trường.
Dialogue: 0,0:14:39.19,0:14:40.27,Default,Touma,0,0,0,,Giờ em muốn sao?
Dialogue: 0,0:14:40.58,0:14:42.70,Default,Touma,0,0,0,,Nếu cần ở lại thì anh sẽ đưa chìa khóa.
Dialogue: 0,0:14:43.48,0:14:44.17,Default,Index,0,0,0,,Thôi.
Dialogue: 0,0:14:44.17,0:14:45.25,Default,Index,0,0,0,,Để em đi.
Dialogue: 0,0:14:46.37,0:14:49.68,Default,Index,0,0,0,,Cứ ở yên một chỗ thì dễ bị phát hiện lắm.
Dialogue: 0,0:14:49.68,0:14:52.87,Default,Index,0,0,0,,Chắc anh không muốn chỗ này bị chọi bom đâu nhỉ?
Dialogue: 0,0:14:52.87,0:14:53.77,Default,Touma,0,0,0,,Oi!
Dialogue: 0,0:14:54.49,0:14:55.49,Default,Touma,0,0,0,,Đợi đã!
Dialogue: 0,0:15:04.00,0:15:05.27,Default,Index,0,0,0,,Cánh tay phải của anh...
Dialogue: 0,0:15:05.97,0:15:12.17,Default,Index,0,0,0,,Vận may của anh, phước lành của chúa, em nghĩ hai điều này đều bị nó xóa bỏ.
Dialogue: 0,0:15:12.85,0:15:15.43,Default,Index,0,0,0,,Nói cách khác thì chỉ cần còn vung vẩy cánh tay,
Dialogue: 0,0:15:15.43,0:15:17.47,Default,Index,0,0,0,,Là anh sẽ còn gặp xui dài dài.
Dialogue: 0,0:15:20.48,0:15:21.70,Default,Touma,0,0,0,,Xui xẻo...
Dialogue: 0,0:15:21.70,0:15:27.11,Default,Index,0,0,0,,Nếu anh hỏi em thì, được sinh ra với khả năng đó đã là xui rồi.
Dialogue: 0,0:15:27.84,0:15:28.86,Default,Touma,0,0,0,,Em...
Dialogue: 0,0:15:29.57,0:15:32.78,Default,Touma,0,0,0,,Em định đi đâu, sau khi rời khỏi đây?
Dialogue: 0,0:15:33.91,0:15:36.03,Default,Index,0,0,0,,Nếu em ở lại, kẻ thù sẽ đến.
Dialogue: 0,0:15:36.33,0:15:37.38,Default,Touma,0,0,0,,Kẻ thù?
Dialogue: 0,0:15:37.38,0:15:40.21,Default,Index,0,0,0,,Bộ đồ này được vận hành bằng ma lực.
Dialogue: 0,0:15:40.21,0:15:42.85,Default,Index,0,0,0,,Chúng có thể theo đó mà tìm đến.
Dialogue: 0,0:15:43.38,0:15:44.63,Default,Index,0,0,0,,Nhưng đừng lo.
Dialogue: 0,0:15:44.63,0:15:47.41,Default,Index,0,0,0,,Nếu về được giáo hội, họ sẽ bảo vệ em.
Dialogue: 0,0:15:47.84,0:15:49.20,Default,Touma,0,0,0,,Chờ chút.
Dialogue: 0,0:15:49.20,0:15:51.21,Default,Touma,0,0,0,,Em phải về tận đó một mình sao?
Dialogue: 0,0:15:52.46,0:15:56.47,Default,Index,0,0,0,,Thế... Anh có muốn theo em xuống 18 tầng địa ngục không.
Dialogue: 0,0:15:59.64,0:16:00.68,Default,Index,0,0,0,,Vậy nhé.
Dialogue: 0,0:16:03.97,0:16:06.48,Default,Touma,0,0,0,,Có bề gì thì nhớ quay lại đây nhé!
Dialogue: 0,0:16:06.87,0:16:09.37,Default,Index,0,0,0,,Ừ, khi nào đói em sẽ quay lại.
Dialogue: 0,0:16:10.04,0:16:11.88,Default,Index,0,0,0,,Cái gì đây? Agathions?
Dialogue: 0,0:16:16.73,0:16:17.55,Default,Touma,0,0,0,,Chết cha!
Dialogue: 0,0:16:17.55,0:16:18.35,Default,Touma,0,0,0,,Học thêm!
Dialogue: 0,0:16:21.29,0:16:22.57,Default,Touma,0,0,0,,Thành phố Thành phố Học viện.
Dialogue: 0,0:16:23.24,0:16:26.72,Default,Touma,0,0,0,,Có cả núi đại học, cao đẳng, trung học, tiểu học nơi đây.
Dialogue: 0,0:16:26.72,0:16:28.27,Default,Touma,0,0,0,,Toàn là trường học.
Dialogue: 0,0:16:29.19,0:16:31.81,Default,Touma,0,0,0,,Rộng gần bằng 1/3 Tokyo.
Dialogue: 0,0:16:31.81,0:16:33.56,Default,Touma,0,0,0,,Dân số vào khoảng 2.3 triệu
Dialogue: 0,0:16:34.47,0:16:35.88,Default,Touma,0,0,0,,80% là học sinh
Dialogue: 0,0:16:36.40,0:16:38.08,Default,Touma,0,0,0,,Chủ yếu sống trong nội thành.
Dialogue: 0,0:16:38.92,0:16:44.56,Default,Touma,0,0,0,,Và là một thành phố kì lạ với những con robot vệ sinh ở khắp nơi.
Dialogue: 0,0:16:45.25,0:16:49.06,Default,Komoe,0,0,0,,Nào, buổi học thêm của chúng ta bắt đầu.
Dialogue: 0,0:16:49.45,0:16:52.64,Default,Komoe,0,0,0,,Sensei đã bỏ rất nhiều tâm huyết vào đề kiểm tra này.
Dialogue: 0,0:16:52.64,0:16:54.06,Default,Komoe,0,0,0,,Thế nên phải cố làm cho tốt nhé.
Dialogue: 0,0:16:54.31,0:16:56.17,Default,Komoe,0,0,0,,Nếu ai bị điểm kém...
Dialogue: 0,0:16:56.17,0:16:58.61,Default,Komoe,0,0,0,,Thì sẽ phải chơi tsuketsuke mirumiru đấy.
Dialogue: 0,0:17:01.13,0:17:05.20,Default,dudeA,0,0,0,,Tsuketsuke Mirumiru à? Phải cái trò bịt mắt chơi bài không?
Dialogue: 0,0:17:05.20,0:17:09.44,Default,dudeB,0,0,0,,Và cậu không thể về nhà khi chưa thắng đủ 10 lần.
Dialogue: 0,0:17:09.44,0:17:10.81,Default,dudeA,0,0,0,,Ái chà chà.
Dialogue: 0,0:17:10.81,0:17:13.77,Default,dudeA,0,0,0,,Hôm trước tớ bị ép ở lại tới sáng lận.
Dialogue: 0,0:17:14.88,0:17:16.26,Default,Komoe,0,0,0,,Kamijou-chan,
Dialogue: 0,0:17:16.26,0:17:18.41,Default,Komoe,0,0,0,,Nếu em chưa thông minh hơn lần trước...
Dialogue: 0,0:17:18.41,0:17:20.47,Default,Komoe,0,0,0,,Thì sẽ lại phải chơi tsuketsuke mirumiru thôi.
Dialogue: 0,0:17:21.88,0:17:25.42,Default,dudeB,0,0,0,,Komoe-chan yêu Kami-yan quá ha?
Dialogue: 0,0:17:25.42,0:17:26.61,Default,Touma,0,0,0,,Aogami...
Dialogue: 0,0:17:26.61,0:17:29.31,Default,Touma,0,0,0,,Không thấy mụ ta đang trù tôi hả?
Dialogue: 0,0:17:29.48,0:17:32.40,Default,dudeB,0,0,0,,Bị một đứa bé quở trách suốt ngày...
Dialogue: 0,0:17:32.40,0:17:34.19,Default,dudeB,0,0,0,,Kami-yan, kinh nghiệm lắm rồi đấy.
Dialogue: 0,0:17:34.56,0:17:36.74,Default,Touma,0,0,0,,Đã Lolicon rồi giờ thêm "M" nữa hả?
Dialogue: 0,0:17:34.56,0:17:37.90,Note,Touma,0,0,0,,{\u1}Chú ý : {\u0}"M" là cách viết tắt của "Masochist - Khổ dâm"
Dialogue: 0,0:17:36.74,0:17:37.90,Default,Touma,0,0,0,,Ông hết thuốc rồi.
Dialogue: 0,0:17:39.88,0:17:42.11,Default,dudeB,0,0,0,,Không phải "tớ có thích Lolis"
Dialogue: 0,0:17:42.11,0:17:44.12,Default,dudeB,0,0,0,,Mà là "tớ cũng thích Lolis"
Dialogue: 0,0:17:44.12,0:17:45.11,Default,Touma,0,0,0,,Thôi đi nhé.
Dialogue: 0,0:17:45.59,0:17:47.09,Default,Komoe,0,0,0,,Này, các em.
Dialogue: 0,0:17:47.09,0:17:49.72,Default,Komoe,0,0,0,,Còn luyên thuyên một từ nào nữa...
Dialogue: 0,0:17:49.72,0:17:51.41,Default,Komoe,0,0,0,,Thì sẽ xơi trứng Columbus đấy.
Dialogue: 0,0:17:51.84,0:17:53.33,Default,Komoe,0,0,0,,Hiểu ý cô không?
Dialogue: 0,0:17:56.07,0:17:57.17,Default,Touma,0,0,0,,Xui xẻo.
Dialogue: 0,0:17:58.41,0:18:00.53,Default,Touma,0,0,0,,Con bé sao rồi nhỉ?
Dialogue: 0,0:18:01.13,0:18:03.10,Default,Touma,0,0,0,,Tự dưng bỏ quên cái khăn trùm đầu ở chỗ mình.
Dialogue: 0,0:18:04.12,0:18:06.25,Default,Touma,0,0,0,,Nhưng mà... chuyện là thế nào?
Dialogue: 0,0:18:06.72,0:18:09.13,Default,Touma,0,0,0,,10 Vạn 3 Ngàn cuốn sách ma thuật?
Dialogue: 0,0:18:09.49,0:18:11.35,Default,Touma,0,0,0,,Con bé lấy chúng ở đâu?
Dialogue: 0,0:18:12.07,0:18:14.81,Default,Touma,0,0,0,,Và còn nói chúng ở "ngay đây"...
Dialogue: 0,0:18:21.73,0:18:24.68,Default,Touma,0,0,0,,Đằng nào con bé cũng sẽ quay lại lấy thứ bị bỏ quên thôi.
Dialogue: 0,0:18:24.68,0:18:25.61,Default,dudeB,0,0,0,,Sensei~
Dialogue: 0,0:18:25.61,0:18:30.03,Default,dudeB,0,0,0,,Kamijou-kun đang ngắm mấy bạn nữ trong đội tenis kìa!
Dialogue: 0,0:18:35.25,0:18:36.38,Default,all,0,0,0,,Làm cô khóc...
Dialogue: 0,0:18:36.38,0:18:37.63,Default,all,0,0,0,,Làm cô khóc...
Dialogue: 0,0:18:37.63,0:18:39.40,Default,all,0,0,0,,Làm cô khóc...
Dialogue: 0,0:18:42.71,0:18:45.16,Default-alt,voice,0,0,0,,{\an8}Tiết học cuối cùng đã kết thúc.
Dialogue: 0,0:18:45.16,0:18:48.39,Default-alt,voice,0,0,0,,{\an8}Tất cả học sinh hãy nhanh chóng trở về nhà.
Dialogue: 0,0:18:48.90,0:18:51.05,Default-alt,voice,0,0,0,,{\an8}Tiết học cuối cùng đã kết thúc
Dialogue: 0,0:18:51.05,0:18:54.23,Default-alt,voice,0,0,0,,{\an8}Tất cả học sinh hãy nhanh chóng trở về nhà.
Dialogue: 0,0:18:50.34,0:18:53.41,Default,Touma,0,0,0,,Vậy mà mình vẫn bị ép tới trường.
Dialogue: 0,0:18:53.46,0:18:54.56,Default,Touma,0,0,0,,Xui xẻo.
Dialogue: 0,0:18:55.47,0:18:56.95,Default,Mikoto,0,0,0,,Đây rồi!
Dialogue: 0,0:18:56.95,0:18:58.68,Default,Mikoto,0,0,0,,Tìm thấy anh rồi, lần này nhất định...
Dialogue: 0,0:18:59.14,0:19:00.69,Default,Mikoto,0,0,0,,Đ-Đợi đã!
Dialogue: 0,0:19:00.69,0:19:02.59,Default,Mikoto,0,0,0,,Anh đó! Anh đó!
Dialogue: 0,0:19:03.09,0:19:04.53,Default,Mikoto,0,0,0,,Tôi bảo anh đứng lại!
Dialogue: 0,0:19:05.28,0:19:07.89,Default,Touma,0,0,0,,À, là ả nữ sinh biribiri hả?
Dialogue: 0,0:19:08.62,0:19:09.70,Default,Mikoto,0,0,0,,Biribiri cái búa!
Dialogue: 0,0:19:09.97,0:19:13.69,Default,Mikoto,0,0,0,,Tôi có tên đàng hoàng là Misaka Mikoto à nha.
Dialogue: 0,0:19:15.58,0:19:19.50,Default,Mikoto,0,0,0,,Anh đó, từ giờ không được gọi tôi là Biribiri nữa nghe chưa
Dialogue: 0,0:19:19.67,0:19:21.45,Default,Touma,0,0,0,,Rồi, biribiri.
Dialogue: 0,0:19:21.45,0:19:22.59,Default,Touma,0,0,0,,Cũng đi học thêm hả?
Dialogue: 0,0:19:22.83,0:19:24.29,Default,Mikoto,0,0,0,,Im đi!
Dialogue: 0,0:19:24.29,0:19:28.09,Default,Mikoto,0,0,0,,Tin tôi làm cả người anh co giật như đùi ếch không?
Dialogue: 0,0:19:28.09,0:19:30.88,Default,Mikoto,0,0,0,,Chuẩn bị về viết di chúc đi là vừa!
Dialogue: 0,0:19:31.43,0:19:31.97,Default,Touma,0,0,0,,Không đấy.
Dialogue: 0,0:19:32.44,0:19:34.68,Default,Mikoto,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:19:41.61,0:19:42.68,Default,Mikoto,0,0,0,,Sao hả?
Dialogue: 0,0:19:42.68,0:19:45.11,Default,Mikoto,0,0,0,,Đủ làm cái đầu thối nát anh sáng ra chưa?
Dialogue: 0,0:19:45.11,0:19:46.52,Default,Touma,0,0,0,,Sư bố cô chứ!
Dialogue: 0,0:19:46.52,0:19:49.17,Default,Touma,0,0,0,,Nhờ cái đống sấm sét cô thả xuống hôm qua đó!
Dialogue: 0,0:19:49.17,0:19:52.33,Default,Touma,0,0,0,,Mà bao nhiêu đồ điện và thức ăn của tôi thành Shit hết rồi!
Dialogue: 0,0:19:52.33,0:19:54.08,Default,Mikoto,0,0,0,,Ai biểu anh chọc tôi tức cơ!
Dialogue: 0,0:19:54.28,0:19:57.27,Default,Touma,0,0,0,,T-Tôi chọc tức cô bao giờ?
Dialogue: 0,0:19:57.27,0:20:00.46,Default,Touma,0,0,0,,Tôi còn chưa đụng một ngón tay vào cô nữa!
Dialogue: 0,0:20:00.46,0:20:01.66,Default,Mikoto,0,0,0,,Ừ đúng.
Dialogue: 0,0:20:01.66,0:20:03.61,Default,Mikoto,0,0,0,,Tôi cũng chưa đánh trúng anh phát nào!
Dialogue: 0,0:20:03.61,0:20:06.51,Default,Mikoto,0,0,0,,Vậy coi như hai ta đang hòa đúng không?
Dialogue: 0,0:20:07.49,0:20:09.94,Default,Touma,0,0,0,,Không quan tâm, cô thắng đi cũng được.
Dialogue: 0,0:20:09.94,0:20:11.24,Default,Mikoto,0,0,0,,Đợi đã, cái anh này!
Dialogue: 0,0:20:11.24,0:20:13.12,Default,Mikoto,0,0,0,,Nghiêm túc chút coi.
Dialogue: 0,0:20:13.12,0:20:15.31,Default,Touma,0,0,0,,Thế? Nếu tôi nghiêm túc thì sao?
Dialogue: 0,0:20:16.96,0:20:18.80,Default,Touma,0,0,0,,Sáng ra thì gặp con pháp sư lởm,
Dialogue: 0,0:20:18.80,0:20:21.52,Default,Touma,0,0,0,,Chiều về thì gặp ả biribiri siêu năng lực gia.
Dialogue: 0,0:20:21.99,0:20:23.57,Default,Mikoto,0,0,0,,Pháp sư?
Dialogue: 0,0:20:23.57,0:20:25.52,Default,voice,0,0,0,,Messenge, Messenge.
Dialogue: 0,0:20:25.52,0:20:28.79,Default,voice,0,0,0,,Phát hiện sử dụng sóng điện từ trái phép.
Dialogue: 0,0:20:28.79,0:20:30.92,Default,voice,0,0,0,,Xin phép chuyển sang chế độ tự vệ.
Dialogue: 0,0:20:35.21,0:20:36.45,Default,Touma,0,0,0,,Thấy ngu chưa?!
Dialogue: 0,0:20:36.45,0:20:38.00,Default,Touma,0,0,0,,Tại cô biribiri chúng nó đấy!
Dialogue: 0,0:20:38.19,0:20:39.29,Default,Mikoto,0,0,0,,Im đi!
Dialogue: 0,0:20:39.86,0:20:42.36,Default,Mikoto,0,0,0,,Lo mà chạy lẹ lên!
Dialogue: 0,0:21:00.60,0:21:02.72,Default,Touma,0,0,0,,Lũ Robot lau dọn?
Dialogue: 0,0:21:03.71,0:21:04.91,Default,Touma,0,0,0,,Thiệt tình...
Dialogue: 0,0:21:04.91,0:21:07.70,Default,Touma,0,0,0,,Trước phòng mình thì có gì mà quét.
Dialogue: 0,0:21:15.63,0:21:16.96,Default,Touma,0,0,0,,Nói sao đây nhỉ?
Dialogue: 0,0:21:16.96,0:21:17.54,Default,Touma,0,0,0,,Xui xẻo.
Dialogue: 0,0:21:18.24,0:21:19.76,Default,Touma,0,0,0,,Oi, Index.
Dialogue: 0,0:21:19.76,0:21:21.67,Default,Touma,0,0,0,,Sao phải nằm giữa đường thế này?
Dialogue: 0,0:21:22.49,0:21:24.23,Default,Touma,0,0,0,,Dễ bị cảm lắm đó....
Dialogue: 0,0:21:26.65,0:21:28.65,Default,Touma,0,0,0,,Đây là...
Dialogue: 0,0:21:30.97,0:21:33.04,Default,Touma,0,0,0,,Tỉnh lại đi, Index!
Dialogue: 0,0:21:33.97,0:21:35.52,Default,Touma,0,0,0,,Sao lại thế này?!
Dialogue: 0,0:21:35.52,0:21:38.18,Default,Touma,0,0,0,,Kẻ nào nỡ làm thế với em?!
Dialogue: 0,0:21:47.94,0:21:50.07,Default,Stiyl,0,0,0,,Là bọn pháp sư này làm đấy.
Dialogue: 0,0:23:26.00,0:23:27.27,Default,Touma,0,0,0,,Stiyl Magnus,
Dialogue: 0,0:23:27.27,0:23:29.29,Default,Touma,0,0,0,,Đó là tên của thằng pháp sư khốn kiếp đó.
Dialogue: 0,0:23:29.46,0:23:31.09,Default,Touma,0,0,0,,Bảo vệ Index?
Dialogue: 0,0:23:31.24,0:23:32.34,Default,Touma,0,0,0,,Thế là ý gì?
Dialogue: 0,0:23:33.18,0:23:34.67,Default,Touma,0,0,0,,Kì tới :"Innocentius"
Dialogue: 0,0:23:35.47,0:23:37.09,Default,Touma,0,0,0,,Khi khoa học và ma thuật gặp nhau,
Dialogue: 0,0:23:37.25,0:23:38.86,Default,Touma,0,0,0,,Bản anh hùng ca sẽ bắt đầu.
