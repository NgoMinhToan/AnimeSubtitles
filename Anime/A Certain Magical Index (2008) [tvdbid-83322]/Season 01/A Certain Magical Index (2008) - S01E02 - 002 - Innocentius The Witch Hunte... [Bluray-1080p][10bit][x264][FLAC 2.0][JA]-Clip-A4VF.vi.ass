Dialogue: 0,0:17:06.25,0:17:09.94,Default,Touma,0,0,0,,Vào bệnh viện không cẩn thận là bị lộ ngay.{ukkari ni byouin nanka shitara ato ima ni jouhou moreru}
Dialogue: 0,0:17:11.61,0:17:14.87,Default,Touma,0,0,0,,Nhưng cũng không thể để con bé một mình.{kedo kono mama hotteoku wake ni mo kane- shi na-}
Dialogue: 0,0:17:14.87,0:17:15.84,Default,Index,0,0,0,,Touma?
Dialogue: 0,0:17:17.68,0:17:18.97,Default,Index,0,0,0,,Anh sao vậy?
Dialogue: 0,0:17:18.97,0:17:20.42,Default,Index,0,0,0,,Sắc mặt anh xấu quá.{kao-iro warui kedo}
Dialogue: 0,0:17:20.42,0:17:22.22,Default,Touma,0,0,0,,Vẫn còn lo cho người khác được hả?{hito no shinpai shiteru baai ka?}
Dialogue: 0,0:17:22.22,0:17:24.34,Default,Touma,0,0,0,,Phải mau chóng chữa trị vết thương đã...{hayaku sono ke ga nantoka shine- to}
Dialogue: 0,0:17:25.45,0:17:27.34,Default,Index,0,0,0,,Em ổn mà...
Dialogue: 0,0:17:27.72,0:17:30.94,Default,Index,0,0,0,,Dù sao thì... chỉ cần cầm được máu là...{tonikaku, chi wo... tomeru koto ga dekireba-}
Dialogue: 0,0:17:31.52,0:17:32.96,Default,Touma,0,0,0,,Này... Này!
Dialogue: 0,0:17:34.27,0:17:39.72,Default,Touma,0,0,0,,Chẳng nhẽ 10 vạn 3 ngàn cuốn sách ma thuật của em không nói đến phép trị thương sao?{omae no motteru juuman sanzen satsu no naka ni kizu wo naosu you na majutsu wa ne- no ka yo}
Dialogue: 0,0:17:39.72,0:17:41.35,Default,Index,0,0,0,,Có, nhưng mà...
Dialogue: 0,0:17:41.35,0:17:42.23,Default,Touma,0,0,0,,Vậy thì...
Dialogue: 0,0:17:42.23,0:17:43.74,Default,Index,0,0,0,,Anh không dùng được.{kimi ni wa... muri, tớ thích cái chữ muri :))}{lol}
Dialogue: 0,0:17:43.99,0:17:47.09,Default,Index,0,0,0,,Dù anh biết được câu thần chú...{tatoe watashi ga jutsushiki (術式) wo oshiete}
Dialogue: 0,0:17:47.09,0:17:51.23,Default,Index,0,0,0,,Và bắt chước hoàn toàn những gì em nói thì cánh tay đó...{kimi ga kanzen ni sore wo mane shita tokoro de kimi no chikara ga}
Dialogue: 0,0:17:51.23,0:17:52.59,Default,Index,0,0,0,,Cũng làm hỏng cả thôi...{kitto jamaou suru}
Dialogue: 0,0:17:52.59,0:17:55.27,Default,Touma,0,0,0,,Khốn kiếp... Lại tại cái này sao?
Dialogue: 0,0:17:55.27,0:17:58.00,Default,Touma,0,0,0,,Lại là lỗi của cánh tay này nữa sao?{mata kono migite ga warui no kai yo?}
Dialogue: 0,0:17:58.17,0:18:00.56,Default,Index,0,0,0,,Không phải tại cánh tay anh...{kimi no migite ja nakute}
Dialogue: 0,0:18:00.56,0:18:04.04,Default,Index,0,0,0,,...mà tại cái được gọi là siêu năng lực.{chou nouryoku-tte iu no ga mo dame nano}
Dialogue: 0,0:18:05.62,0:18:12.00,Default,Index,0,0,0,,Ma thuật được tạo ra không phải để phục vụ những người đã sở hữu siêu năng lực.{majutsu-tte iu no wa... kimitachi mitai ni sainoumaru ningen ga tsukau tame no mono ja nai n'da yo}
Dialogue: 0,0:18:12.52,0:18:18.67,Default,Index,0,0,0,,Có những người không được sinh ra với khả năng đó nhưng vẫn muốn sở hữu sức mạnh.{sainou nai ningen ga, soredemo, sainou no aru ningen to onaji koto ga shitai kara}
Dialogue: 0,0:18:18.67,0:18:20.52,Default,Index,0,0,0,,Thế nên họ đã nghiên cứu ma thuật.{umida sareta no ka... majutsu}\N
Dialogue: 0,0:18:21.35,0:18:25.59,Default,Touma,0,0,0,,Nói vậy... Nếu toàn bộ học sinh quanh đây đều sơ hữu siêu năng lực thì...{nara nouryoku kaiha sono kareki na mo uketeru kono machi no gakusei ni wa}
Dialogue: 0,0:18:25.59,0:18:27.95,Default,Index,0,0,0,,Ừ, họ không thể sử dụng ma thuật.{majutsu wa tsukaenai}
Dialogue: 0,0:18:27.95,0:18:30.12,Default,Touma,0,0,0,,Chết tiệt... lại còn thế nữa...{chikushou... sonna mon-tte aru kai yo}
Dialogue: 0,0:18:30.53,0:18:33.58,Default,Touma,0,0,0,,Tại sao... Tại sao...
Dialogue: 0,0:18:33.94,0:18:36.14,Default,Touma,0,0,0,,Đây là thành phố của học sinh...{koko wa gakusei no machi nan da zo}
Dialogue: 0,0:18:36.14,0:18:38.12,Default,Touma,0,0,0,,Vậy mà học sinh thì...{nano ni gakusei ni wa}
Dialogue: 0,0:18:39.61,0:18:40.54,Default,Touma,0,0,0,,Học sinh thì...
Dialogue: 0,0:18:41.58,0:18:46.03,Default,Touma,0,0,0,,Oy, những ai không sở hữu siêu năng lực đều xài ma thuật được đúng không?{oi, majutsu-tte no wa sainou no nai ningen nara dare mo tsukaerun datta na-}
Dialogue: 0,0:18:55.70,0:19:00.80,Default,Touma,0,0,0,,Đừng bảo mụ đi ngủ rồi nhé?! Đã thế...{kono jikan de mou nemuteru nante iwane- darou na, yoshi}
Dialogue: 0,0:19:02.96,0:19:04.85,Default,Komoe,0,0,0,,Vâng, vâng, vâng.
Dialogue: 0,0:19:04.85,0:19:08.70,Default,Komoe,0,0,0,,Cửa vừa được gia cố để đối phó với mấy gã bán báo đó mà.{daishinbun'ya saiyou ni dou dake wa tanjou nan desu}
Dialogue: 0,0:19:08.70,0:19:10.58,Default,Komoe,0,0,0,,Tôi ra ngay đây.{ima akemasu yo}\N
Dialogue: 0,0:19:13.73,0:19:15.33,Default,Komoe,0,0,0,,A, Kamijou-chan!
Dialogue: 0,0:19:16.05,0:19:19.10,Default,Komoe,0,0,0,,Em mới búc việc làm thêm ở tòa soạn hả?{shinbun'ya san naru BAITO demo hajimetan desu ka}
Dialogue: 0,0:19:19.54,0:19:23.29,Default,Touma,0,0,0,,Có thằng rao báo nào lại đi cõng một cô sơ trên lưng không?{sister seotte kanyuu suru shinbun'ya ga doko ni iru}
Dialogue: 0,0:19:23.74,0:19:25.51,Default,Touma,0,0,0,,Em đang vướng chút chuyện.{chotto iroiro komatterun'de}\N
Dialogue: 0,0:19:25.51,0:19:27.09,Default,Touma,0,0,0,,Cho vào cái nha, sensei.{hairimasu ne, sensei}
Dialogue: 0,0:19:27.09,0:19:28.84,Default,Touma,0,0,0,,Vâng, làm phiên cô.
Dialogue: 0,0:19:28.84,0:19:30.48,Default,Komoe,0,0,0,,Ch-Ch-Ch-Ch-Ch-Chờ đã...
Dialogue: 0,0:19:30.48,0:19:31.80,Default,Komoe,0,0,0,,Thế này là phiền cho cô lắm!{sensei komarimasu}
Dialogue: 0,0:19:37.76,0:19:40.23,Default,Komoe,0,0,0,,Nói ra thì hơi kì nhưng...{konna joukyou de iu no nan desu kedo}
Dialogue: 0,0:19:40.41,0:19:43.76,Default,Komoe,0,0,0,,Chắc em không thích phụ nữ biết hút thuốc đâu nhỉ?{TABAKO-su onna no hito wa kirai nan desu}
Dialogue: 0,0:19:48.06,0:19:51.23,Default,Komoe,0,0,0,,X-Xảy ra chuyện gì... vậy nè?
Dialogue: 0,0:19:51.63,0:19:53.74,Default,Touma,0,0,0,,Sensei, thật ra là...
Dialogue: 0,0:19:57.78,0:19:58.66,Default,Touma,0,0,0,,Index!
Dialogue: 0,0:19:59.13,0:20:02.15,Default,Index,0,0,0,,Cảnh báo : chương 2, đoạn 6.{keikoku dai ni jou dai roku setsu (警告第二章第六節)}
Dialogue: 0,0:20:02.15,0:20:06.07,Default,Index,0,0,0,,Thiếu hụt sinh lực trầm trọng do mất máu quá ngưỡng cho phép.{shukketsu (xuat huyet) ni yoru seimeiryoku (sinh menh luc) no ryuushutsu (流出) ga itteiryou (一定量) wo koeta tame}
Dialogue: 0,0:20:06.07,0:20:09.51,Default,Index,0,0,0,,Cưỡng bức khởi động chế độ "Bút của Jouhane" {nghe mãi mà chỉ nghe ra jouhane, chả hiểu quái nào mà lại thành John được - vl; bọn Eclipse nó ghi thế chứ tớ nghe là Johanne, đọc manga thì ghi là YOHANE - del}{kyouseiteki (強制的) ni "YOHANE no PEN" de mezamemasu}
Dialogue: 0,0:20:09.51,0:20:11.20,Default,Index,0,0,0,,Theo tình trạng hiện tại,{genjou wo iji sureba (現状を維持すれば)}
Dialogue: 0,0:20:11.20,0:20:15.47,Default,Index,0,0,0,,{\fscx97}dựa theo giờ chuẩn quốc tế ghi trên tháp đồng hồ tại London,{RONDON ni tokei TO- ga shimesu kokusai hyoujun jikan ni kansan shite}
Dialogue: 0,0:20:15.47,0:20:17.10,Default,Index,0,0,0,,trong khoảng 15 phút nữa...{oyoso juugo fungo ni}
Dialogue: 0,0:20:17.10,0:20:21.48,Default,Index,0,0,0,,...sinh lực cần thiết để duy trì cơ thể tôi sẽ hết...{watashi no karada wa hitsuyou saiteigen no seimeiryoku wo ushinai}
Dialogue: 0,0:20:21.48,0:20:22.47,Default,Index,0,0,0,,...và tôi sẽ mất mạng.{zetsumei shimasu}
Dialogue: 0,0:20:22.96,0:20:25.27,Default,Index,0,0,0,,Từ bây giờ nếu các vị làm theo lời tôi...{kore kara watashi no shinji ni shitagatte}
Dialogue: 0,0:20:25.27,0:20:28.68,Default,Index,0,0,0,,Để tôi nhận được sự trị liều thích hợp thì sẽ vô cùng cảm kích.{hơi dài nên cũng hơi khó dịch - vl; to dich lai roi. may cau cua con Index luc no o auto mode can chu y 1 chut - del}{tekisetsu na shochi wo hodoko shite itadakereba saiwai desu}
Dialogue: 0,0:20:28.68,0:20:32.07,Default,Touma,0,0,0,,Sensei, em đi gọi xe cứu thương đây.{sensei, ore kyuukyuusha wo yonde kimasu}
Dialogue: 0,0:20:32.07,0:20:34.49,Default,Touma,0,0,0,,Sensei cố làm theo lời con bé nhé!{sensei wa kono ko no hanashi wo kiite}
Dialogue: 0,0:20:34.49,0:20:35.74,Default,Touma,0,0,0,,Xin cô đấy!{onegai yo kiite}\N
Dialogue: 0,0:20:35.74,0:20:38.45,Default,Touma,0,0,0,,Tóm lại là tuyệt đối không để con bé bất tỉnh!{tonikaku, zettai ishiki ga tobanai you ni}
Dialogue: 0,0:20:38.78,0:20:41.49,Default,Touma,0,0,0,,Cô thấy đấy, con bé là người theo đạo.{ko hiểu lắm, dịch theo shinsen do nghe thấy "konoko, kounotori(?)...", tự nhiên cò kiếc j ở đây nhỉ-vl, tớ check thì thấy bọn Eclipse dịch 95% là chính xác, mấy đoạn ko nghe ra thì trans theo nó là được rồi - del}{kono ko kono toori shuukyou yatterun'de}
Dialogue: 0,0:20:41.49,0:20:42.50,Default,Touma,0,0,0,,Mong cô giúp co!
Dialogue: 0,0:20:42.50,0:20:44.29,Default,Komoe,0,0,0,,Ưm, ưm.
Dialogue: 0,0:20:45.55,0:20:46.69,Default,Touma,0,0,0,,Này, Index.
Dialogue: 0,0:20:47.11,0:20:49.20,Default,Touma,0,0,0,,Anh không giúp gì được sao?{nanka ore ni areru koto-tte nai no ka}
Dialogue: 0,0:20:49.20,0:20:50.41,Default,Index,0,0,0,,Không.
Dialogue: 0,0:20:50.41,0:20:55.05,Default,Index,0,0,0,,Trong tình huống này... lựa chọn thích hợp nhất đối với anh là tránh càng xa nơi này càng tốt...{kono (ban?) ryoukei sairyou no sentakushi wa anata ga koko kara taku saru koto desu}
Dialogue: 0,0:20:55.53,0:20:57.52,Default,Index,0,0,0,,Chỉ cần anh có mặt trong căn phòng này,{anata wa kono heya ni areba}
Dialogue: 0,0:20:57.52,0:21:00.91,Default,Index,0,0,0,,ma thuật trị liệu sẽ bị anh làm tan biến.{sore dake de kaifuku majutsu wa utsuke sarete shimaimasu}
Dialogue: 0,0:21:05.01,0:21:07.12,Default,Komoe,0,0,0,,Ka-Kamijou-chan...
Dialogue: 0,0:21:07.12,0:21:11.24,Default,Komoe,0,0,0,,Cô sơ này vừa nhắc đến ma thuật gì đó...{ima kono sister-chan majutsu ga dou shita toka}{ima cung co nghia la "vừa mới"}
Dialogue: 0,0:21:11.24,0:21:14.96,Default,Touma,0,0,0,,Sensei, xin hãy chăm sóc cô ấy.{sensei, kono ko no koto onegai shimasu}
Dialogue: 0,0:21:14.96,0:21:16.81,Default,Komoe,0,0,0,,Khoan đã, Kamijou-chan!
Dialogue: 0,0:21:16.81,0:21:18.61,Default,Komoe,0,0,0,,Điện thoại ở ngay đằng kia...{denwa nara soko ni}
Dialogue: 0,0:21:28.52,0:21:33.28,Default,Index,0,0,0,,Trong tình huống này... lựa chọn thích hợp nhất đối với anh là tránh càng xa nơi này càng tốt...
Dialogue: 0,0:21:34.71,0:21:36.60,Default,Index,0,0,0,,Chỉ cần anh có mặt trong căn phòng này,
Dialogue: 0,0:21:36.85,0:21:40.00,Default,Index,0,0,0,,ma thuật trị liệu sẽ bị anh làm hỏng.
Dialogue: 0,0:23:25.75,0:23:27.71,Default,Touma,0,0,0,,Sử dụng ma thuật để gọi thiên thần á?{majutsu wo tsukatte tenshi wo koui}
Dialogue: 0,0:23:28.19,0:23:31.71,Default,Touma,0,0,0,,Đợi chút đã... Làm thế có chữa lành được vết thương của Index không?{chotto matte, sonnan'de Index no keiga ga naoru no kai yo?}
Dialogue: 0,0:23:32.67,0:23:34.05,Default,Touma,0,0,0,,Tập tiếp theo : "Necessarius".
Dialogue: 0,0:23:34.89,0:23:36.72,Default,Touma,0,0,0,,Khi khoa học và ma thuật chạm trán
Dialogue: 0,0:23:36.72,0:23:38.25,Default,Touma,0,0,0,,sẽ có chuyện lớn xảy ra!
