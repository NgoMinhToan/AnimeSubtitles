Dialogue: 0,0:00:13.86,0:00:15.69,Default,Touma,0,0,0,,...và thứ đầu tiên tôi thấy là...
Dialogue: 0,0:00:16.30,0:00:18.42,Default,Stiyl,0,0,0,,Đây là một xác chết.
Dialogue: 0,0:01:52.09,0:01:56.63,Typeset,,0,0,0,,{\bord2\fad(500,700)\pos(1564,780)}Deep Blood
Dialogue: 0,0:01:56.27,0:01:57.22,Default,Touma,0,0,0,,Xác chết?!
Dialogue: 0,0:01:57.99,0:02:01.37,Default,Stiyl,0,0,0,,1 trong 13 Chiến Binh của Roman Giáo Hội.
Dialogue: 0,0:02:01.72,0:02:03.79,Default,Stiyl,0,0,0,,Chắc vừa mới bị giết thôi.
Dialogue: 0,0:02:04.25,0:02:05.35,Default,Touma,0,0,0,,Tại sao?
Dialogue: 0,0:02:05.74,0:02:07.36,Default,Stiyl,0,0,0,,Đây là chiến trường.
Dialogue: 0,0:02:07.36,0:02:10.63,Default,Stiyl,0,0,0,,Có 1, 2 người nằm xuống cũng đâu có gì lạ.
Dialogue: 0,0:02:11.09,0:02:13.47,Default,Touma,0,0,0,,Nhưng sao không thấy ai hoảng sợ?
Dialogue: 0,0:02:14.93,0:02:16.43,Default,girl,0,0,0,,Megumi, lâu ngày quá.
Dialogue: 0,0:02:18.22,0:02:19.66,Default,Touma,0,0,0,,Vừa rồi là gì thế?
Dialogue: 0,0:02:21.09,0:02:23.52,Default,Stiyl,0,0,0,,Sự khác biệt giữa bên trong và bên ngoài, là vậy đó.
Dialogue: 0,0:02:23.91,0:02:26.76,Default,Stiyl,0,0,0,,Cũng như họ khi đang đứng bên ngoài đồng xu này...
Dialogue: 0,0:02:28.90,0:02:32.61,Default,Stiyl,0,0,0,,Sẽ không thể nhìn thấy chúng ta, \Nhiện đang đứng bên trong đồng xu.
Dialogue: 0,0:02:33.38,0:02:36.45,Default,Stiyl,0,0,0,,Chúng ta cũng không thể can thiệp vào hoạt động của họ.
Dialogue: 0,0:02:40.73,0:02:41.70,Default,Stiyl,0,0,0,,Không cần thử.
Dialogue: 0,0:02:41.70,0:02:45.94,Default,Stiyl,0,0,0,,Phong ấn sẽ không thể bị giải trừ, cho đến khi trái tim của ma thuật bị phá hủy.
Dialogue: 0,0:02:46.34,0:02:49.56,Default,Stiyl,0,0,0,,Ta nghĩ cái đó chỉ ở quanh đâu đây thôi.
Dialogue: 0,0:02:55.81,0:02:58.02,Default,Stiyl,0,0,0,,Và ta đã có thêm một lý do để chiến đấu...
Dialogue: 0,0:03:07.18,0:03:10.42,Default,Touma,0,0,0,,Nè, sao không xài thang máy lên cho lẹ?
Dialogue: 0,0:03:11.03,0:03:12.95,Default,Stiyl,0,0,0,,Chúng ta đang đứng bên trong đồng xu.
Dialogue: 0,0:03:12.95,0:03:15.49,Default,Stiyl,0,0,0,,Không thể chạm vào công tắc bên ngoài đồng xu.
Dialogue: 0,0:03:17.06,0:03:18.89,Default,Touma,0,0,0,,Thế, gọi điện thì sao?
Dialogue: 0,0:03:20.20,0:03:25.49,Default,Touma,0,0,0,,À, ta muốn thử xem từ bên trong đồng xu có thể gọi ra bên ngoài đồng xu không đó mà.
Dialogue: 0,0:03:26.99,0:03:28.58,Default,Stiyl,0,0,0,,Thích thì cứ thử đi.
Dialogue: 0,0:03:29.56,0:03:30.71,Default,Touma,0,0,0,,Làm thiệt nè.
Dialogue: 0,0:03:37.22,0:03:40.71,Default,Index,0,0,0,,Vâng, đây là... dạ... Index Libro-
Dialogue: 0,0:03:40.71,0:03:42.51,Default,Index,0,0,0,,Không phải, Kamijou ạ.
Dialogue: 0,0:03:42.51,0:03:43.52,Default,Index,0,0,0,,À, vâng.
Dialogue: 0,0:03:44.01,0:03:48.24,Default,Touma,0,0,0,,Nhóc này, trả lời điện thoại kiểu gì vậy, bộ lần đầu tiên hả?
Dialogue: 0,0:03:49.63,0:03:51.82,Default,Index,0,0,0,,Ủa, Touma đó hả?
Dialogue: 0,0:03:51.97,0:03:56.77,Default,Index,0,0,0,,Touma, sao anh lại xài một thứ vướng víu, nặng nề, khó sử dụng,
Dialogue: 0,0:03:56.77,0:03:59.07,Default,Index,0,0,0,,và thiếu thân thiện như điện thoại, có chuyện gì vậy?
Dialogue: 0,0:03:59.07,0:04:00.82,Default,Touma,0,0,0,,À, không có gì.
Dialogue: 0,0:04:00.82,0:04:04.52,Default,Index,0,0,0,,Có 2 cái bánh kem để trên bàn...
Dialogue: 0,0:04:04.52,0:04:05.55,Default,Index,0,0,0,,Liệu có phải...
Dialogue: 0,0:04:05.55,0:04:06.83,Default,Touma,0,0,0,,Em ăn rồi hả?
Dialogue: 0,0:04:06.83,0:04:10.04,Default,Index,0,0,0,,À, còn cái pudding trong tủ lạnh nữa...
Dialogue: 0,0:04:10.04,0:04:12.50,Default,Touma,0,0,0,,Cái gì... không lẽ...
Dialogue: 0,0:04:12.83,0:04:13.92,Default,Touma,0,0,0,,Em ăn rồi hả?
Dialogue: 0,0:04:13.92,0:04:14.82,Default,Touma,0,0,0,,Ăn rồi phải không?!
Dialogue: 0,0:04:14.82,0:04:15.86,Default,Touma,0,0,0,,Ăn rồi chứ gì?!
Dialogue: 0,0:04:16.82,0:04:18.03,Default,Touma,0,0,0,,Thôi không sao.
Dialogue: 0,0:04:18.88,0:04:21.02,Default,Touma,0,0,0,,Dù gì thì anh cũng gọi được cho em.
Dialogue: 0,0:04:21.49,0:04:22.37,Default,Touma,0,0,0,,Cúp máy đây.
Dialogue: 0,0:04:23.60,0:04:24.68,Default,Touma,0,0,0,,À, đúng rồi.
Dialogue: 0,0:04:24.68,0:04:27.97,Default,Touma,0,0,0,,Tuổi thọ của em sẽ bị rút ngắn từng ngày cho mỗi phút em nghe điện thoại đấy.
Dialogue: 0,0:04:34.38,0:04:36.14,Default,Touma,0,0,0,,G-Gì thế?
Dialogue: 0,0:04:36.14,0:04:37.38,Default,Stiyl,0,0,0,,Không có gì.
Dialogue: 0,0:04:37.38,0:04:39.72,Default,Stiyl,0,0,0,,Ta chỉ tự hỏi tại sao chú lại bình tĩnh thế.
Dialogue: 0,0:04:40.28,0:04:45.31,Default,Stiyl,0,0,0,,Đây là chiến trường phải không nhỉ? Vậy mà chú vẫn thản nhiên tán dóc với một cô gái.
Dialogue: 0,0:04:45.31,0:04:49.24,Default,Stiyl,0,0,0,,Ta không biết đâu nếu chú phải bỏ mạng.
Dialogue: 0,0:04:49.24,0:04:51.67,Default,Stiyl,0,0,0,,Có khi còn sướng điên lên nữa kìa.
Dialogue: 0,0:04:51.67,0:04:54.74,Default,Stiyl,0,0,0,,Nhưng đừng vì thế mà cản trở công việc của ta nhé.
Dialogue: 0,0:04:55.27,0:04:55.92,Default,Touma,0,0,0,,Ngươi ghen hả?
Dialogue: 0,0:04:59.14,0:05:00.63,Default,Stiyl,0,0,0,,Đừng linh tinh.
Dialogue: 0,0:05:00.63,0:05:04.14,Default,Stiyl,0,0,0,,Con bé không phải đối tượng để yêu đương.
Dialogue: 0,0:05:04.96,0:05:06.39,Default,Stiyl,0,0,0,,Chú phải hiểu được điều này.
Dialogue: 0,0:05:07.74,0:05:13.73,Default,Stiyl,0,0,0,,Tính mạng của con bé cho đến nay, vẫn luôn bị đe dọa dù có xóa đi 1 năm trí nhớ hay không.
Dialogue: 0,0:05:14.65,0:05:18.69,Default,Stiyl,0,0,0,,Vị trí của chú bây giờ, đã từng có rất nhiều người đứng vào.
Dialogue: 0,0:05:19.25,0:05:22.97,Default,Stiyl,0,0,0,,Một người cha, một người anh em, một người thầy...
Dialogue: 0,0:05:23.49,0:05:25.91,Default,Stiyl,0,0,0,,Họ đều muốn trở thành cái gì đó với con bé.
Dialogue: 0,0:05:27.14,0:05:30.83,Default,Stiyl,0,0,0,,Chú đã làm được điều mà ta không thể trong quá khứ.
Dialogue: 0,0:05:32.17,0:05:33.39,Default,Stiyl,0,0,0,,Vậy thôi.
Dialogue: 0,0:05:35.15,0:05:37.75,Default,Stiyl,0,0,0,,Đó là điểm khác biệt duy nhất giữa ta và chú.
Dialogue: 0,0:05:40.72,0:05:41.73,Default,Touma,0,0,0,,Phải rồi...
Dialogue: 0,0:05:42.43,0:05:44.72,Default,Touma,0,0,0,,Người đã cứu không phải là tôi.
Dialogue: 0,0:05:45.69,0:05:47.71,Default,Touma,0,0,0,,Người trong lòng Index là...
Dialogue: 0,0:05:49.41,0:05:51.70,Default,Touma,0,0,0,,...Tôi, trước khi mất trí nhớ.
Dialogue: 0,0:06:00.31,0:06:02.16,Default,girl,0,0,0,,Thế thì kì quá nhỉ?
Dialogue: 0,0:06:02.16,0:06:03.28,Default,girl,0,0,0,,Đúng đó.
Dialogue: 0,0:06:11.16,0:06:13.63,Default,Stiyl,0,0,0,,Lần đầu tiên ta thấy những người theo đạo khoa học đấy.
Dialogue: 0,0:06:13.63,0:06:14.83,Default,Stiyl,0,0,0,,Trông bình thường quá nhỉ.
Dialogue: 0,0:06:15.89,0:06:19.59,Default,Stiyl,0,0,0,,Ta cứ nghĩ họ phải đeo linh vật hoặc biểu tượng của tín ngưỡng.
Dialogue: 0,0:06:20.94,0:06:23.37,Default,Touma,0,0,0,,Hình như không có gì bất thường.
Dialogue: 0,0:06:26.70,0:06:28.06,Default,Stiyl,0,0,0,,Thôi chết cha rồi...
Dialogue: 0,0:06:30.24,0:06:31.64,Default,Stiyl,0,0,0,,Để ý chút đi.
Dialogue: 0,0:06:31.64,0:06:35.85,Default,Stiyl,0,0,0,,Bên trong đồng xu không thể nhìn thấy những gì bên ngoài đồng xu.
Dialogue: 0,0:06:35.85,0:06:38.34,Default,students,0,0,0,,{\an8}Đôi cánh nhà trời tỏa sáng trên cao.
Dialogue: 0,0:06:38.77,0:06:41.78,Default,students,0,0,0,,{\an8}Ánh sáng trên cao thanh tẩy tội lỗi bằng màu trắng trong.
Dialogue: 0,0:06:42.24,0:06:44.24,Default,students,0,0,0,,{\an8}Màu trắng trong là biểu tượng của sự thuần khiết.
Dialogue: 0,0:06:44.46,0:06:46.63,Default,students,0,0,0,,{\an8}Sự thuần khiết là kết quả của một hành động.
Dialogue: 0,0:06:46.63,0:06:48.10,Default,students,0,0,0,,{\an8}Một hành động sẽ tạo ra tương lai.
Dialogue: 0,0:06:48.10,0:06:49.20,Default,students,0,0,0,,{\an8}Tương lai là thời gian.
Dialogue: 0,0:06:49.69,0:06:51.40,Default,students,0,0,0,,{\an8}Thời gian là sự đồng nhất.
Dialogue: 0,0:06:50.25,0:06:51.95,Default-alt,Stiyl,0,0,0,,Tự động cảnh báo à...
Dialogue: 0,0:06:53.35,0:06:55.96,Default-alt,Stiyl,0,0,0,,Những học sinh đúng ra phải ở bên trong đông xu...
Dialogue: 0,0:06:56.49,0:06:58.69,Default-alt,Stiyl,0,0,0,,...đã được đặt vào bên ngoài đông xu.
Dialogue: 0,0:06:51.95,0:06:53.35,Default,students,0,0,0,,{\an8}Sự đồng nhất là vạn vật.
Dialogue: 0,0:06:53.89,0:06:55.96,Default,students,0,0,0,,{\an8}Vạn vật tạo bởi quá khứ.
Dialogue: 0,0:06:55.96,0:06:57.32,Default,students,0,0,0,,{\an8}Quá khứ là cội nguồn.
Dialogue: 0,0:06:57.32,0:06:58.95,Default,students,0,0,0,,{\an8}Cội nguồn là duy nhất.
Dialogue: 0,0:06:58.95,0:07:00.37,Default,students,0,0,0,,{\an8}Duy nhất là tội lỗi.
Dialogue: 0,0:07:00.37,0:07:01.59,Default,students,0,0,0,,{\an8}Tội lỗi là nhân loại.
Dialogue: 0,0:07:01.59,0:07:04.55,Default,students,0,0,0,,{\an8}Nhân loại biết sợ hãi, sợ hãi là tâm hồn.
Dialogue: 0,0:07:04.87,0:07:07.01,Default,students,0,0,0,,{\an8}Tâm hồn ngụ trong một cá thể.
Dialogue: 0,0:07:07.01,0:07:11.07,Default,students,0,0,0,,{\an8}Nếu nó bị lấp đầy bởi dục vọng,
Dialogue: 0,0:07:11.07,0:07:14.86,Default,students,0,0,0,,{\an8}Đôi cánh nhà trời sẽ phát hiện ra tội lỗi,
Dialogue: 0,0:07:14.86,0:07:17.27,Default,students,0,0,0,,{\an8}và hủy diệt nó.
Dialogue: 0,0:07:20.77,0:07:22.84,Default,Stiyl,0,0,0,,Này, Imagine Breaker.
Dialogue: 0,0:07:22.84,0:07:24.07,Default,Stiyl,0,0,0,,Nhường cho chú đấy!
Dialogue: 0,0:07:24.49,0:07:25.78,Default,Touma,0,0,0,,Oi!
Dialogue: 0,0:07:26.55,0:07:27.55,Default,Touma,0,0,0,,Thiệt tình....
Dialogue: 0,0:07:35.65,0:07:36.76,Default,Stiyl,0,0,0,,Ê, đừng có chạy.
Dialogue: 0,0:07:37.21,0:07:40.57,Default,Stiyl,0,0,0,,Cánh tay đó có thể hóa giải cả "Dragon Breath" cơ mà?
Dialogue: 0,0:07:40.57,0:07:43.96,Default,Stiyl,0,0,0,,Việc quái gì phải sợ mấy viên lăn tăn này!
Dialogue: 0,0:07:43.96,0:07:46.18,Default,Touma,0,0,0,,Đừng hòng dụ tui ra làm bia đỡ đạn!
Dialogue: 0,0:07:46.56,0:07:47.95,Default,Touma,0,0,0,,Có cả trăm viên như thế!
Dialogue: 0,0:07:47.95,0:07:50.50,Default,Touma,0,0,0,,Mỗi một tay bố ai mà che hết được!
Dialogue: 0,0:07:52.25,0:07:52.97,Default,Stiyl,0,0,0,,Coi bộ...
Dialogue: 0,0:07:53.32,0:07:56.90,Default,Stiyl,0,0,0,,Cái này là Replica được sao chép bởi dàn đồng ca Gregorio...
Dialogue: 0,0:07:56.90,0:07:59.31,Default,Touma,0,0,0,,Cái gì mà dàn đồng ca Gregorio thế?!
Dialogue: 0,0:08:00.53,0:08:07.36,Default,Stiyl,0,0,0,,Về cơ bản, đó là một loại ma thuật cấp cao được triệu hồi từ lời cầu nguyện của 3.333 tu sĩ.
Dialogue: 0,0:08:08.13,0:08:10.74,Default,Touma,0,0,0,,Vậy tức là ta không hóa giải được đúng không?
Dialogue: 0,0:08:10.74,0:08:16.29,Default,Stiyl,0,0,0,,Không, dàn đồng ca Gregorio cần có sự thống nhất mới điều khiển được tâm trí con người.
Dialogue: 0,0:08:16.63,0:08:19.75,Default,Stiyl,0,0,0,,Ta chỉ cần phá hủy được mối liên kết là xong.
Dialogue: 0,0:08:27.60,0:08:30.65,Default,Stiyl,0,0,0,,Giờ ta có một kế hoạch.
Dialogue: 0,0:08:30.65,0:08:32.41,Default,Touma,0,0,0,,Có thì làm lẹ đi!
Dialogue: 0,0:08:32.41,0:08:33.43,Default,Stiyl,0,0,0,,Được thôi!
Dialogue: 0,0:08:36.87,0:08:38.27,Default,Touma,0,0,0,,Ngươi làm cái gì thế?!
Dialogue: 0,0:08:38.96,0:08:41.15,Default,Stiyl,0,0,0,,{\an8}Xui xẻo nhé, bù nhìn
Dialogue: 0,0:08:38.96,0:08:41.15,Default,Stiyl,0,0,0,,Bad luck, scarecrow.
Dialogue: 0,0:08:49.11,0:08:51.33,Default,girl,0,0,0,,{\an8}Tội ác bị trừng phạt bởi lửa thiêng.
Dialogue: 0,0:08:51.33,0:08:53.74,Default,girl,0,0,0,,{\an8}Lửa thiêng tạo ra khổ đau.
Dialogue: 0,0:08:54.15,0:08:56.99,Default,girl,0,0,0,,{\an8}Khổ đau từ việc thiêu cháy tội lỗi.
Dialogue: 0,0:08:57.27,0:09:00.12,Default,girl,0,0,0,,{\an8}và là sự trừng phạt duy nhất của chúa.
Dialogue: 0,0:09:02.12,0:09:04.36,Default,girl,0,0,0,,{\an8}Sự trừng phạt được biết đến như cái chết.
Dialogue: 0,0:09:04.88,0:09:06.76,Default,girl,0,0,0,,{\an8}Biết đến là nhận ra,
Dialogue: 0,0:09:06.76,0:09:07.51,Default-alt,Touma,0,0,0,,Dừng lại đi!
Dialogue: 0,0:09:08.07,0:09:10.72,Default-alt,Touma,0,0,0,,Coi cơ thể cô đang bị làm sao kìa!
Dialogue: 0,0:09:07.51,0:09:09.58,Default,girl,0,0,0,,{\an8}Nhận ra phần còn lại của con người,
Dialogue: 0,0:09:09.58,0:09:10.72,Default,girl,0,0,0,,{\an8}Trên toàn bộ thế giới.
Dialogue: 0,0:09:11.41,0:09:14.51,Default,girl,0,0,0,,{\an8}Hãy kết nối con người bên trong với thế giới bên ngoài.
Dialogue: 0,0:09:32.39,0:09:33.45,Default,Touma,0,0,0,,S-Sao lại...
Dialogue: 0,0:09:55.72,0:09:57.70,Default,Touma,0,0,0,,Cái gì thế này...
Dialogue: 0,0:10:24.17,0:10:25.33,Default,Stiyl,0,0,0,,Nhưng mà...
Dialogue: 0,0:10:25.92,0:10:28.41,Default,Stiyl,0,0,0,,Gã nhà giả kim này thật quá đáng...
Dialogue: 0,0:10:28.41,0:10:32.63,Default,Stiyl,0,0,0,,Khi chiến đấu phải sử dụng sức mạnh của chính mình, không phải lũ trẻ.
Dialogue: 0,0:10:33.06,0:10:42.31,Default,Aureolus,0,0,0,,Hiển nhiên, sử dụng Gregorio Replica sẽ dẫn cậu đến với trái tim bất kể nó được giấu ở đâu.
Dialogue: 0,0:10:42.75,0:10:46.32,Default,Aureolus,0,0,0,,Đúng ra, có đến hai người đã đột nhập vào đây.
Dialogue: 0,0:10:46.32,0:10:50.19,Default,Aureolus,0,0,0,,Tuy nhiên, cậu đã lạc mất đồng đội khi chạy trốn khỏi Gregorio Repilica?
Dialogue: 0,0:10:51.47,0:10:54.32,Default,Styil,0,0,0,,Đáng tiếc là một mình ta cũng đủ rồi.
Dialogue: 0,0:10:55.72,0:10:56.62,Default,Styil,0,0,0,,Sao?
Dialogue: 0,0:10:56.98,0:10:59.45,Default,Styil,0,0,0,,Dụ ta đến đây làm gì?
Dialogue: 0,0:11:00.15,0:11:03.36,Default,Styil,0,0,0,,Nhà giả kim lừng danh, Aureolus Izzard.
Dialogue: 0,0:11:06.18,0:11:07.91,Default,Himegami,0,0,0,,Chuẩn bị điều trị.
Dialogue: 0,0:11:08.93,0:11:10.09,Default,Touma,0,0,0,,Nhưng mà...
Dialogue: 0,0:11:10.09,0:11:14.42,Default,Himegami,0,0,0,,Rách da quá nhiều và mao mạch bị tổn thương.
Dialogue: 0,0:11:14.42,0:11:17.39,Default,Himegami,0,0,0,,Nếu bị đứt động mạch thì còn tệ hơn.
Dialogue: 0,0:11:17.76,0:11:20.00,Default,Touma,0,0,0,,Cô đâu phải bác sĩ?
Dialogue: 0,0:11:20.00,0:11:23.27,Default,Himegami,0,0,0,,Tôi biết về các loại mạch máu trên cơ thể nhiều hơn người khác.
Dialogue: 0,0:11:23.52,0:11:24.81,Default,Himegami,0,0,0,,Làm cùng tôi.
Dialogue: 0,0:11:32.54,0:11:33.69,Default,Touma,0,0,0,,Đợi đã...
Dialogue: 0,0:11:33.69,0:11:34.53,Default,Himegami,0,0,0,,Không được sợ.
Dialogue: 0,0:11:34.98,0:11:36.31,Default,Himegami,0,0,0,,Đó là thiếu tôn trọng người bệnh.
Dialogue: 0,0:11:41.72,0:11:43.21,Default,Index,0,0,0,,Nè, Sphinx.
Dialogue: 0,0:11:43.66,0:11:45.50,Default,Index,0,0,0,,Touma đi đâu được nhỉ?
Dialogue: 0,0:11:45.70,0:11:48.48,Default,Index,0,0,0,,{\i1}Còn cái pudding trong tủ lạnh nữa...{\i0}
Dialogue: 0,0:11:48.48,0:11:50.96,Default,Touma,0,0,0,,{\i1}Cái gì... không lẽ...{\i0}
Dialogue: 0,0:11:50.96,0:11:51.93,Default,Touma,0,0,0,,{\i1}Em ăn rồi hả?{\i0}
Dialogue: 0,0:11:51.93,0:11:52.87,Default,Touma,0,0,0,,{\i1}Ăn rồi phải không?!{\i0}
Dialogue: 0,0:11:52.87,0:11:53.94,Default,Touma,0,0,0,,{\i1}Ăn rồi chứ gì?!{\i0}
Dialogue: 0,0:11:54.90,0:11:56.12,Default,Touma,0,0,0,,{\i1}Thôi không sao.{\i0}
Dialogue: 0,0:11:57.66,0:11:58.76,Default,Index,0,0,0,,Lạ lắm.
Dialogue: 0,0:11:58.76,0:12:03.89,Default,Index,0,0,0,,Touma sẽ không nói "thôi không sao" khi cái pudding của anh ấy bị người ta ăn mất.
Dialogue: 0,0:12:16.65,0:12:18.28,Default,Index,0,0,0,,Biểu tượng Rune?!
Dialogue: 0,0:12:21.15,0:12:22.68,Default,Himegami,0,0,0,,Sơ cứu xong.
Dialogue: 0,0:12:24.14,0:12:26.54,Default,Touma,0,0,0,,Coi bộ... cô giỏi ghê ha...
Dialogue: 0,0:12:26.75,0:12:29.76,Default,Touma,0,0,0,,Chắc cô là một bác sĩ không bằng cấp hả?
Dialogue: 0,0:12:29.76,0:12:30.95,Default,Himegami,0,0,0,,Không phải bác sĩ.
Dialogue: 0,0:12:31.56,0:12:32.80,Default,Touma,0,0,0,,Thế là gì?
Dialogue: 0,0:12:33.54,0:12:35.05,Default,Himegami,0,0,0,,Tôi là pháp sư.
Dialogue: 0,0:12:36.71,0:12:39.78,Default,Touma,0,0,0,,Cơ mà... cô giống pháp sư ở điểm nào?
Dialogue: 0,0:12:40.30,0:12:41.72,Default,Himegami,0,0,0,,Tôi có cái này.
Dialogue: 0,0:12:45.32,0:12:46.09,Default,Himegami,0,0,0,,Đây.
Dialogue: 0,0:12:47.50,0:12:48.68,Default,Himegami,0,0,0,,Gậy phép.
Dialogue: 0,0:12:49.26,0:12:51.27,Default,Touma,0,0,0,,Ê, đó là dùi cui điện!
Dialogue: 0,0:12:52.00,0:12:53.00,Default,Himegami,0,0,0,,Úmbala.
Dialogue: 0,0:12:53.00,0:12:54.15,Default,Touma,0,0,0,,Đừng có đùa!
Dialogue: 0,0:12:55.50,0:12:56.98,Default,Touma,0,0,0,,Chúng ta phải gọi cứu thương gấp.
Dialogue: 0,0:12:57.63,0:12:58.92,Default,Himegami,0,0,0,,Ý kiến hay.
Dialogue: 0,0:12:58.92,0:13:01.37,Default,Touma,0,0,0,,Đừng có nói kiểu đó.
Dialogue: 0,0:13:01.37,0:13:02.70,Default,Touma,0,0,0,,Cô cũng phải về nhà mà.
Dialogue: 0,0:13:06.34,0:13:10.33,Default,Touma,0,0,0,,Thế nên đừng có nhìn tôi nữa, ra khỏi đây thôi.
Dialogue: 0,0:13:10.98,0:13:12.96,Default,Himegami,0,0,0,,Tôi có mục đích riêng của mình.
Dialogue: 0,0:13:13.68,0:13:15.98,Default,Himegami,0,0,0,,Một mục đích không cho phép tôi rời khỏi đây.
Dialogue: 0,0:13:15.98,0:13:18.19,Default,Himegami,0,0,0,,Một mục đích tôi chỉ có thể hoàn thành nơi đây.
Dialogue: 0,0:13:18.71,0:13:19.90,Default,Himegami,0,0,0,,Không...
Dialogue: 0,0:13:20.58,0:13:24.43,Default,Himegami,0,0,0,,Đúng hơn là nếu không có nhà giả kim, mục đích này sẽ không thể hoàn thành.
Dialogue: 0,0:13:24.85,0:13:28.75,Default,Touma,0,0,0,,Nhưng mà, nếu là bạn thì hắn đâu có giữ cô đúng không?
Dialogue: 0,0:13:29.60,0:13:32.06,Default,Himegami,0,0,0,,Đó là chuyện trước khi Aureolus đến đây.\N
Dialogue: 0,0:13:33.50,0:13:37.18,Default,Himegami,0,0,0,,Tôi không muốn ra ngoài khi không cần thiết.
Dialogue: 0,0:13:38.05,0:13:40.97,Default,Himegami,0,0,0,,Ra ngoài bừa bãi sẽ thu hút bọn họ.
Dialogue: 0,0:13:41.73,0:13:47.95,Default,Touma,0,0,0,,Thế ra cô... trốn trong đây vì không muốn thu hút Ma cà rồng?
Dialogue: 0,0:13:48.97,0:13:50.10,Default,Himegami,0,0,0,,Ma cà rồng...
Dialogue: 0,0:13:50.59,0:13:52.42,Default,Himegami,0,0,0,,Họ là những sinh vật như thế nào?
Dialogue: 0,0:13:53.96,0:13:55.02,Default,Himegami,0,0,0,,Không có khác biệt.
Dialogue: 0,0:13:56.26,0:13:58.63,Default,Himegami,0,0,0,,Không có khác biệt giữa họ và chúng ta.
Dialogue: 0,0:13:59.70,0:14:02.76,Default,Himegami,0,0,0,,Họ có thể hy sinh vì nhau, cười với nhau.
Dialogue: 0,0:14:02.76,0:14:04.26,Default,Himegami,0,0,0,,Họ là như vậy.
Dialogue: 0,0:14:04.59,0:14:08.88,Default,Himegami,0,0,0,,Mùi thơm từ dòng máu của tôi thu hút họ.
Dialogue: 0,0:14:09.59,0:14:12.22,Default,Himegami,0,0,0,,Họ đến, tụ tập lại, rồi bị giết.
Dialogue: 0,0:14:12.96,0:14:14.02,Default,Himegami,0,0,0,,Luôn luôn như thế.
Dialogue: 0,0:14:14.92,0:14:18.31,Default,Himegami,0,0,0,,Tôi giết hết bọn họ, không hề có ngoại lệ.
Dialogue: 0,0:14:21.12,0:14:24.14,Default,Himegami,0,0,0,,Gakuen là một thành phố tiên tiến.
Dialogue: 0,0:14:24.14,0:14:26.39,Default,Himegami,0,0,0,,Có lẽ bí mật của tôi đã được họ biết đến.
Dialogue: 0,0:14:26.84,0:14:30.32,Default,Himegami,0,0,0,,Nếu họ giải mã được bí mật, cũng có nghĩa là tìm ra cách giải quyết.
Dialogue: 0,0:14:32.17,0:14:34.59,Default,Himegami,0,0,0,,Nhưng bí mật vẫn chưa được giải mã.
Dialogue: 0,0:14:35.39,0:14:37.31,Default,Himegami,0,0,0,,Tôi không muốn giết ai nữa.
Dialogue: 0,0:14:37.68,0:14:42.37,Default,Himegami,0,0,0,,Nếu trong hoàn cảnh bất đắc dĩ, tôi phải giết một người thì đó chính là tôi.
Dialogue: 0,0:14:42.93,0:14:45.18,Default,Touma,0,0,0,,Có một điều tôi muốn hỏi.
Dialogue: 0,0:14:46.46,0:14:48.69,Default,Touma,0,0,0,,Nếu cô không muốn thu hút Ma cà rồng,
Dialogue: 0,0:14:48.69,0:14:50.85,Default,Touma,0,0,0,,Vậy tại sao lại đến quán ăn đó?
Dialogue: 0,0:14:51.09,0:14:52.12,Default,Himegami,0,0,0,,Đơn giản.
Dialogue: 0,0:14:52.48,0:14:56.64,Default,Himegami,0,0,0,,Aureolus cần tôi vì anh ấy cần Ma cà rồng.
Dialogue: 0,0:14:58.41,0:15:02.69,Default,Himegami,0,0,0,,Nếu cứ ở mãi trong phong ấn, tôi không thể thu hút Ma cà rồng.
Dialogue: 0,0:15:03.21,0:15:04.12,Default,Touma,0,0,0,,Nhưng mà...
Dialogue: 0,0:15:04.45,0:15:07.13,Default,Touma,0,0,0,,Không phải điều đó trái với mục đích của cô sao?
Dialogue: 0,0:15:07.13,0:15:09.20,Default,Himegami,0,0,0,,Aureolus đã hứa...
Dialogue: 0,0:15:09.20,0:15:11.54,Default,Himegami,0,0,0,,...anh ấy sẽ không làm hại Ma cà rồng.
Dialogue: 0,0:15:11.97,0:15:13.76,Default,Himegami,0,0,0,,Aureolus nói...
Dialogue: 0,0:15:13.76,0:15:15.70,Default,Himegami,0,0,0,,...có một người anh ấy muốn cứu...
Dialogue: 0,0:15:15.70,0:15:18.20,Default,Himegami,0,0,0,,...anh ấy cần sức mạnh của Ma cà rồng.
Dialogue: 0,0:15:18.20,0:15:20.00,Default,Himegami,0,0,0,,Thế nên thỏa thuận đã được lập.
Dialogue: 0,0:15:20.00,0:15:23.01,Default,Himegami,0,0,0,,Sử dụng sức mạnh này, không phải để giết chóc,
Dialogue: 0,0:15:23.01,0:15:24.67,Default,Himegami,0,0,0,,Mà là để cứu người.
Dialogue: 0,0:15:26.29,0:15:27.63,Default,Touma,0,0,0,,Sai lầm.
Dialogue: 0,0:15:28.74,0:15:35.52,Default,Touma,0,0,0,,Cho dù hắn đúng là con người như cô nói, thì nhất định hắn đang phạm sai lầm.
Dialogue: 0,0:15:36.37,0:15:41.04,Default,Touma,0,0,0,,Nếu tôi không ngăn cản hắn, thì đây sẽ là một sai lầm không thể cứu vãn.
Dialogue: 0,0:15:43.04,0:15:47.80,Default,Aureolus,0,0,0,,Hiển nhiên, nếu ta bảo cậu nói nó thực sự không thể cứu vãn thì sao?\N
Dialogue: 0,0:15:48.47,0:15:49.73,Default,Touma,0,0,0,,Hắn...
Dialogue: 0,0:15:50.95,0:15:52.95,Default,Aureolus,0,0,0,,Tuy nhiên, không quan trọng.
Dialogue: 0,0:15:52.95,0:15:54.87,Default,Aureolus,0,0,0,,Ta đã đến gặp cậu.
Dialogue: 0,0:15:57.25,0:16:01.04,Default,Aureolus,0,0,0,,Đơn giản, vì cậu có câu hỏi ta không cần trả lời.
Dialogue: 0,0:16:02.52,0:16:03.75,Default,Touma,0,0,0,,Ngươi...
Dialogue: 0,0:16:03.93,0:16:06.42,Default,Aureolus,0,0,0,,Cậu không đến gần ta được đâu.
Dialogue: 0,0:16:09.87,0:16:10.76,Default,Touma,0,0,0,,Đồ...
Dialogue: 0,0:16:13.22,0:16:15.39,Default,Touma,0,0,0,,T-Tại sao...
Dialogue: 0,0:16:15.39,0:16:18.31,Default,Aureolus,0,0,0,,Thất vọng, chán cậu quá chàng trai.
Dialogue: 0,0:16:18.94,0:16:19.56,Default,Aureolus,0,0,0,,Biến mất đ-
Dialogue: 0,0:16:19.56,0:16:20.40,Default,Himegami,0,0,0,,Đợi đã!
Dialogue: 0,0:16:21.61,0:16:23.46,Default,Touma,0,0,0,,Đ-Đồ ngốc!
Dialogue: 0,0:16:25.19,0:16:28.30,Default,Touma,0,0,0,,Deep Blood có đủ sức mạnh để tiêu diệt Ma cà rồng...
Dialogue: 0,0:16:28.30,0:16:29.45,Default,Touma,0,0,0,,Tức là...
Dialogue: 0,0:16:30.57,0:16:36.33,Default,Aureolus,0,0,0,,Rốt cuộc thì, cậu cũng chỉ tìm cách lợi dụng, dựa dẫm vào Deep Blood, và cầu nguyện.
Dialogue: 0,0:16:36.66,0:16:39.00,Default,Aureolus,0,0,0,,Cậu và ta có gì khác nhau nào?
Dialogue: 0,0:16:40.09,0:16:41.42,Default,Himegami,0,0,0,,Không đúng.
Dialogue: 0,0:16:41.42,0:16:44.30,Default,Himegami,0,0,0,,Cậu ta vốn không biết gì về Deep Blood.
Dialogue: 0,0:16:44.30,0:16:48.30,Default,Himegami,0,0,0,,Mãi tới khi đến đây cứu người cậu ta mới tình cờ biết được.
Dialogue: 0,0:16:48.66,0:16:51.68,Default,Himegami,0,0,0,,Aureolus Izzard, mục đích của anh là gì?
Dialogue: 0,0:16:53.78,0:16:57.65,Default,Himegami,0,0,0,,Anh giết cả những người không liên quan và thấy thỏa mãn vì điều đó?
Dialogue: 0,0:16:58.77,0:17:01.41,Default,Himegami,0,0,0,,Nếu vậy thì mục đích của anh thật vô nghĩa,
Dialogue: 0,0:17:01.41,0:17:02.98,Default,Himegami,0,0,0,,Tôi không làm nữa.
Dialogue: 0,0:17:03.60,0:17:07.99,Default,Himegami,0,0,0,,Tôi có thể cắn luỡi tự sát bất kì lúc nào.
Dialogue: 0,0:17:09.61,0:17:13.32,Default,Aureolus,0,0,0,,Đúng ra, không cần phí thời gian ở đây.
Dialogue: 0,0:17:15.35,0:17:17.27,Default,Aureolus,0,0,0,,Chàng trai, đừng lo.
Dialogue: 0,0:17:17.27,0:17:18.39,Default,Aureolus,0,0,0,,Ta không giết cậu.
Dialogue: 0,0:17:23.56,0:17:26.19,Default,Aureolus,0,0,0,,Hãy quên hết những gì vừa xảy ra!
Dialogue: 0,0:17:33.00,0:17:34.26,Default,Index,0,0,0,,Chỗ này à?
Dialogue: 0,0:17:34.26,0:17:38.37,Default,Index,0,0,0,,Nguồn ma lực cung cấp cho các Rune \Nquanh phòng Touma bị cắt đứt tại đây.
Dialogue: 0,0:17:42.92,0:17:44.02,Default,Touma,0,0,0,,Đây là đâu?
Dialogue: 0,0:17:44.53,0:17:47.74,Default,Stiyl,0,0,0,,Có chú ở đây tức là chúng ta vẫn đang ở Nhật Bản.
Dialogue: 0,0:17:48.90,0:17:52.30,Default,Stiyl,0,0,0,,Hình như ta vừa quên mất cái gì đó.
Dialogue: 0,0:17:52.30,0:17:53.37,Default,Stiyl,0,0,0,,Đúng không nhỉ?
Dialogue: 0,0:17:57.03,0:18:01.58,Default,Stiyl,0,0,0,,Thôi, cũng có thể mấy cái đó không quan trọng.
Dialogue: 0,0:18:02.97,0:18:04.33,Default,Touma,0,0,0,,Thế hả?
Dialogue: 0,0:18:06.67,0:18:08.34,Default,Aureolus,0,0,0,,Quên hết những gì vừa xảy ra!
Dialogue: 0,0:18:20.95,0:18:25.19,Default,Touma,0,0,0,,Để ta dạy ngươi một mẹo nhỏ để xóa bỏ nghi ngờ nhé.
Dialogue: 0,0:18:25.98,0:18:28.59,Default,Stiyl,0,0,0,,Mấy cái đó Kanzaki rành lắm.
Dialogue: 0,0:18:28.59,0:18:30.00,Default,Stiyl,0,0,0,,Ta sẽ hỏi cô ấy.
Dialogue: 0,0:18:30.00,0:18:32.67,Default,Touma,0,0,0,,Không cần, chỉ việc nhắm mắt lại và lè lưỡi ra thôi.
Dialogue: 0,0:18:38.65,0:18:42.58,Default,Touma,0,0,0,,Và đây là quà khuyến mãi cho một gã dám dùng tôi làm mồi câu và một mình chạy trốn!
Dialogue: 0,0:18:54.99,0:18:59.16,Default,Index,0,0,0,,Phong ấn được lập nên để kẻ xâm nhập không thể thoát ra.
Dialogue: 0,0:18:59.76,0:19:01.48,Default,Aureolus,0,0,0,,Hmm, lâu ngày quá.
Dialogue: 0,0:19:02.31,0:19:03.44,Default,Index,0,0,0,,Ai vậy?
Dialogue: 0,0:19:03.44,0:19:04.94,Default,Aureolus,0,0,0,,Em không nhớ ta?
Dialogue: 0,0:19:04.94,0:19:09.44,Default,Aureolus,0,0,0,,Chính xác hơn, em không nhớ một người mang tên Aureolus Izzard?
Dialogue: 0,0:19:09.44,0:19:13.28,Default,Aureolus,0,0,0,,Không, có lẽ như vậy sẽ tốt hơn.
Dialogue: 0,0:19:13.28,0:19:14.13,Default,Aureolus,0,0,0,,Ngủ đi.
Dialogue: 0,0:19:21.83,0:19:24.55,Default,Touma,0,0,0,,Oi, cái gã nằm trước cửa lúc nãy...
Dialogue: 0,0:19:25.43,0:19:27.99,Default,Stiyl,0,0,0,,Phần còn lại của 13 Chiến Binh.
Dialogue: 0,0:19:28.54,0:19:30.46,Default,13,0,0,0,,Bắt đầu tấn công!
Dialogue: 0,0:19:32.45,0:19:34.38,Default,Stiyl,0,0,0,,Gregorio Kuwaia...
Dialogue: 0,0:19:35.50,0:19:38.54,Default,Stiyl,0,0,0,,Đây chính là dàn đồng ca Gregorio thực sự.
Dialogue: 0,0:19:39.38,0:19:44.11,Default,Touma,0,0,0,,Không phải ngươi nói... cái trò Gregorio này cần nhiều người lắm sao?
Dialogue: 0,0:19:44.85,0:19:51.96,Default,Stiyl,0,0,0,,Rất có thể 3.333 tu sĩ đang cầu nguyện tại nhà thờ thánh Peter.
Dialogue: 0,0:19:53.81,0:19:57.72,Default,13,0,0,0,,Hồi 8, chương 7 trong kinh thánh.
Dialogue: 0,0:19:57.72,0:20:02.88,Default,13,0,0,0,,"Khi tiếng kèn cất lên, lửa và mưa sẽ hòa với máu và rơi xuống trái đất"
Dialogue: 0,0:20:06.04,0:20:08.21,Default,Touma,0,0,0,,Họ tính làm cái quái gì thế?
Dialogue: 0,0:20:08.21,0:20:10.17,Default,Stiyl,0,0,0,,Pháo kích thánh pháp.
Dialogue: 0,0:20:10.17,0:20:11.00,Default,Touma,0,0,0,,Pháo kích?
Dialogue: 0,0:20:11.61,0:20:14.94,Default,Touma,0,0,0,,Hinegami và những học sinh khác vẫn còn trong đó!
Dialogue: 0,0:20:32.12,0:20:33.11,Default,Stiyl,0,0,0,,Tòa nhà sắp sập!
Dialogue: 0,0:20:43.76,0:20:44.98,Default,Touma,0,0,0,,Trở lại như cũ?
Dialogue: 0,0:20:47.57,0:20:48.96,Default,Stiyl,0,0,0,,Ars Magna.
Dialogue: 0,0:20:49.69,0:20:50.94,Default,Touma,0,0,0,,Ars Magna?
Dialogue: 0,0:20:52.78,0:20:54.87,Default,Stiyl,0,0,0,,Đó là đối thủ của chúng ta...
Dialogue: 0,0:20:54.87,0:20:57.21,Default,Stiyl,0,0,0,,Sức mạnh thật sự của Aureolus Izzard.
Dialogue: 0,0:21:16.99,0:21:18.30,Default,Touma,0,0,0,,Sphinx?!
Dialogue: 0,0:21:20.39,0:21:21.11,Default,Touma,0,0,0,,Không lẽ...
Dialogue: 0,0:21:21.61,0:21:23.92,Default,Touma,0,0,0,,...Cái này... Index...
Dialogue: 0,0:23:25.14,0:23:27.91,Default,Touma,0,0,0,,Những tranh chấp xung quanh Index.
Dialogue: 0,0:23:27.91,0:23:30.89,Default,Touma,0,0,0,,Thời điểm gã nhà giả kim bộc lộ dã tính và chống lại số phận.
Dialogue: 0,0:23:30.89,0:23:32.95,Default,Touma,0,0,0,,Tiếng cười và tiếng khóc trong trường luyện thi Masawa.
Dialogue: 0,0:23:33.54,0:23:35.08,Default,Touma,0,0,0,,Kì tới, "Deep Blood".
Dialogue: 0,0:23:35.59,0:23:37.42,Default,Touma,0,0,0,,Khi ma thuật và khoa học gặp nhau,
Dialogue: 0,0:23:37.42,0:23:38.77,Default,Touma,0,0,0,,Bản anh hùng ca sẽ bắt đầu.
