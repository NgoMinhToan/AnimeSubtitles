Comment: 0,0:08:16.10,0:08:17.18,Default,Touya,0,0,0,,Oi!
Comment: 0,0:19:56.54,0:19:57.79,Default,Touma,0,0,0,,You know...
Dialogue: 0,0:00:00.25,0:00:05.90,Default,Touma,0,0,0,,Để hóa giải Angel Fall, chúng tôi phải phá hủy tế đàn, hoặc chính người đã sử dụng ma thuật.
Dialogue: 0,0:00:06.80,0:00:08.90,Default,Touma,0,0,0,,Tìm hiểu hành vi đáng ngờ của Misha,
Dialogue: 0,0:00:08.90,0:00:14.12,Default,Touma,0,0,0,,Tôi và Tsuchimikado đã tìm đến khu nhà mới của họ Kamijou, nói cách khác, là nhà tôi.
Dialogue: 0,0:00:15.12,0:00:18.53,Default,Touma,0,0,0,,Nhưng điều đang đợi chúng tôi là...
Dialogue: 0,0:01:50.54,0:01:55.09,Note,,0,0,0,,{\bord2\fs50\fad(500,700)\pos(480,782)}Quyền năng của Chúa
Dialogue: 0,0:01:50.54,0:01:55.09,Note,,0,0,0,,{\bord2\fs45\fad(500,700)\pos(480,742)}Thánh Grabiel
Dialogue: 0,0:01:53.44,0:01:54.30,Default,Touma,0,0,0,,Ba.
Dialogue: 0,0:01:56.76,0:01:58.26,Default,Touya,0,0,0,,Về rồi à?
Dialogue: 0,0:01:58.26,0:01:59.92,Default,Touya,0,0,0,,Mẹ có về cùng con không?
Dialogue: 0,0:02:02.58,0:02:04.79,Default,Touya,0,0,0,,Thấy nhà mới của mình thế nào?
Dialogue: 0,0:02:05.24,0:02:08.43,Default,Touya,0,0,0,,Hmph? Sao thế? Làm mặt nghiệm trọng rứa?
Dialogue: 0,0:02:08.43,0:02:10.20,Default,Touya,0,0,0,,Chắc vừa cãi nhau với mẹ chứ gì...
Dialogue: 0,0:02:10.20,0:02:11.25,Default,Touma,0,0,0,,Tại sao...
Dialogue: 0,0:02:12.08,0:02:14.97,Default,Touma,0,0,0,,Tại sao ba lại nhúng tay vào những điều huyền bí?
Dialogue: 0,0:02:14.97,0:02:16.41,Default,Touya,0,0,0,,Oi Oi, thiệt ra con -
Dialogue: 0,0:02:16.41,0:02:17.78,Default,Touma,0,0,0,,Đừng giả đò nữa!
Dialogue: 0,0:02:18.54,0:02:21.39,Default,Touma,0,0,0,,Tại sao ba lại nhúng tay vào những việc của giới pháp sư?!
Dialogue: 0,0:02:26.06,0:02:27.29,Default,Touya,0,0,0,,Ra vậy...
Dialogue: 0,0:02:27.80,0:02:30.00,Default,Touya,0,0,0,,Coi nào, nên bắt đầu từ đâu nhỉ?
Dialogue: 0,0:02:31.87,0:02:38.11,Default,Touya,0,0,0,,Touma, hồi nhỏ mọi người gọi con là gì, còn nhớ không?
Dialogue: 0,0:02:40.48,0:02:42.08,Default,Touya,0,0,0,,"Kẻ mang bệnh dịch".
Dialogue: 0,0:02:45.04,0:02:49.75,Default,Touya,0,0,0,,Không hiểu sao, từ khi mới sinh ra con đã luôn gặp những chuyện không may.
Dialogue: 0,0:02:50.17,0:02:54.80,Default,Touya,0,0,0,,Không chỉ bạn bè, mà cả những người lớn xung quanh cũng muốn tránh xa con.
Dialogue: 0,0:02:57.19,0:03:00.71,Default,Touya,0,0,0,,Ba để con sống trong Thành phố Học viện cũng là vì thế.
Dialogue: 0,0:03:01.56,0:03:02.96,Default,Touya,0,0,0,,Ba sợ...
Dialogue: 0,0:03:02.96,0:03:05.67,Default,Touya,0,0,0,,Sợ những con người mê tín dị đoan ấy.
Dialogue: 0,0:03:06.64,0:03:10.91,Default,Touya,0,0,0,,Thế nên ba muốn đưa con vào một thế giới, nơi tôn giáo không tồn tại.
Dialogue: 0,0:03:14.21,0:03:20.31,Default,Touya,0,0,0,,Nhưng, dù là thành phố khoa học, họ vẫn đối xử với con như một người mang đến vận xui.
Dialogue: 0,0:03:20.89,0:03:25.78,Default,Touya,0,0,0,,Làm thế nào để vận xui của con, điều mà cả giới khoa học cũng không thể chấp nhận, được xóa bỏ?
Dialogue: 0,0:03:27.13,0:03:29.98,Default,Touya,0,0,0,,Và ba đã tìm đến phần huyền bí của thế giới.
Dialogue: 0,0:03:32.32,0:03:33.65,Default,Touya,0,0,0,,Nực cười quá phải không?
Dialogue: 0,0:03:33.65,0:03:38.30,Default,Touya,0,0,0,,Ba không muốn con người ta mê tín, nhưng giờ đây chính ba lại mê tín.
Dialogue: 0,0:03:38.91,0:03:40.43,Default,Touma,0,0,0,,Đồ ngốc...
Dialogue: 0,0:03:40.90,0:03:43.23,Default,Touma,0,0,0,,Ờ, con xui xẻo!
Dialogue: 0,0:03:43.23,0:03:46.89,Default,Touma,0,0,0,,Nhưng con đã bao giờ hối hận chưa?
Dialogue: 0,0:03:47.29,0:03:48.39,Default,Touma,0,0,0,,Thật nhảm nhí.
Dialogue: 0,0:03:48.81,0:03:50.28,Default,Touma,0,0,0,,Dù vận xui có ở ngay trước mắt,
Dialogue: 0,0:03:50.28,0:03:51.94,Default,Touma,0,0,0,,Thì đó cũng là con đường dành cho con!
Dialogue: 0,0:03:55.92,0:03:58.19,Default,Touya,0,0,0,,Con thấy vui?
Dialogue: 0,0:04:00.96,0:04:02.76,Default,Touya,0,0,0,,Ba thật ngốc.
Dialogue: 0,0:04:03.98,0:04:07.32,Default,Touya,0,0,0,,Ba đã định lấy đi niềm vui của con.
Dialogue: 0,0:04:07.82,0:04:11.18,Default,Touya,0,0,0,,Dù sao thì... chúng cũng chỉ là mấy món hàng lưu niệm...
Dialogue: 0,0:04:11.18,0:04:14.40,Default,Touya,0,0,0,,Chẳng có gì to tát cả.
Dialogue: 0,0:04:16.00,0:04:17.30,Default,Touma,0,0,0,,Hàng lưu niệm?
Dialogue: 0,0:04:17.30,0:04:20.84,Default,Touya,0,0,0,,Ừ, ba định từ bỏ mấy thứ đó.
Dialogue: 0,0:04:21.08,0:04:22.98,Default,Touma,0,0,0,,Đ-Đợi đã!
Dialogue: 0,0:04:22.98,0:04:25.98,Default,Touma,0,0,0,,Không phải chính ba đã tạo ra Angel Fall?
Dialogue: 0,0:04:26.57,0:04:28.09,Default,Touya,0,0,0,,Angel Fall?
Dialogue: 0,0:04:28.09,0:04:29.81,Default,Touya,0,0,0,,Hàng lưu niệm của nước nào vậy?
Dialogue: 0,0:04:32.75,0:04:33.86,Default,Touma,0,0,0,,Một câu hỏi.
Dialogue: 0,0:04:34.49,0:04:36.57,Default,Touma,0,0,0,,Ba có biết mẹ đang ở đâu không?
Dialogue: 0,0:04:37.05,0:04:39.71,Default,Touya,0,0,0,,Chính con đòi đi theo mẹ mà.
Dialogue: 0,0:04:40.10,0:04:41.95,Default,Touya,0,0,0,,Chắc con phải rõ hơn chứ?
Dialogue: 0,0:04:42.92,0:04:44.80,Default,Touma,0,0,0,,Ba không nhận ra sự thay đổi hình dạng?
Dialogue: 0,0:04:45.20,0:04:48.35,Default,Touma,0,0,0,,Vậy tức là ba cũng bị Angel Fall tác động...
Dialogue: 0,0:04:48.35,0:04:49.58,Default,Touya,0,0,0,,Yo, Misha-chan.
Dialogue: 0,0:04:53.15,0:04:57.30,Default,Touya,0,0,0,,Cám ơn đã đưa bà xã tôi về nhà.
Dialogue: 0,0:04:57.30,0:04:58.85,Default,Touma,0,0,0,,Đợi đã, Misha.
Dialogue: 0,0:04:59.47,0:05:02.15,Default,Touma,0,0,0,,Đúng là ba tôi không bị thay đổi hình dạng.
Dialogue: 0,0:05:02.51,0:05:05.98,Default,Touma,0,0,0,,Nhưng ông ấy cũng không nhận ra sự thay đổi của người khác.
Dialogue: 0,0:05:06.31,0:05:07.51,Default,Touma,0,0,0,,Tức là-
Dialogue: 0,0:05:07.75,0:05:10.35,Default,Misha,0,0,0,,Câu trả lời thứ nhất - Đó là câu trả lời.
Dialogue: 0,0:05:12.24,0:05:14.56,Default,Misha,0,0,0,,Mục tiêu đã được xác định.
Dialogue: 0,0:05:14.86,0:05:17.86,Default,Misha,0,0,0,,Nhận xét thứ nhất - Đó là lời giải thích mơ hồ.
Dialogue: 0,0:05:18.60,0:05:19.62,Default,Touma,0,0,0,,Misha...
Dialogue: 0,0:05:20.57,0:05:23.50,Default,Kaori,0,0,0,,Con chiên không giết người khi Chúa chưa cho phép.
Dialogue: 0,0:05:24.48,0:05:26.20,Default,Kaori,0,0,0,,Cô đã quên rồi sao?
Dialogue: 0,0:05:27.22,0:05:28.86,Default,Kaori,0,0,0,,Để tôi giải quyết.
Dialogue: 0,0:05:29.55,0:05:33.74,Default,Kaori,0,0,0,,Cậu và Touya-san hãy rời khỏi đây ngay lập tức.
Dialogue: 0,0:05:33.74,0:05:35.53,Default,Touma,0,0,0,,Misha chỉ hiểu lầm thôi.
Dialogue: 0,0:05:35.86,0:05:36.87,Default,Touma,0,0,0,,Ba-
Dialogue: 0,0:05:36.87,0:05:39.24,Default,Kaori,0,0,0,,Tên cô ta không phải Misha.
Dialogue: 0,0:05:40.85,0:05:42.87,Default,Kaori,0,0,0,,Tôi vừa liên lạc với Chính Thống Nga Giáo Hội.
Dialogue: 0,0:05:43.53,0:05:46.76,Default,Kaori,0,0,0,,Chỉ có một thành viên mang tên "Sasha Kreuzhev".
Dialogue: 0,0:05:47.51,0:05:50.72,Default,Kaori,0,0,0,,Đây có lẽ là vẻ ngoài được mượn từ người đó.
Dialogue: 0,0:05:51.26,0:05:52.68,Default,Touma,0,0,0,,Vậy tức là sao?
Dialogue: 0,0:05:52.68,0:05:55.19,Default,Touma,0,0,0,,Nếu Misha không phải là thành viên của Giáo Hội Nga...
Dialogue: 0,0:05:56.05,0:06:02.90,Default,Kaori,0,0,0,,Theo truyền thuyết, thế giới này tồn tại một thực thể không phải nam, cũng không phải nữ...
Dialogue: 0,0:06:03.67,0:06:08.80,Default,Kaori,0,0,0,,Một thực thể với cái tên tượng trưng cho nhiệm vụ Chúa giao cho.
Dialogue: 0,0:06:09.24,0:06:11.66,Default,Kaori,0,0,0,,Một cái tên không dễ gì thay đổi.
Dialogue: 0,0:06:12.05,0:06:14.00,Default,Kaori,0,0,0,,Đợi đã, rốt cuộc thì-
Dialogue: 0,0:06:14.20,0:06:15.75,Default,Kaori,0,0,0,,Phải chăng cậu đã quên?
Dialogue: 0,0:06:15.75,0:06:18.88,Default,Kaori,0,0,0,,Tên của loại đại ma thuật này?
Dialogue: 0,0:06:28.78,0:06:30.46,Default,Touya,0,0,0,,Cái gì thế?
Dialogue: 0,0:06:30.46,0:06:31.76,Default,Kaori,0,0,0,,Hiểu rồi.
Dialogue: 0,0:06:31.76,0:06:34.31,Default,Kaori,0,0,0,,Cô ta tạo ra màn đêm là thuộc tính tương thích của mình.
Dialogue: 0,0:06:35.29,0:06:37.74,Default,Kaori,0,0,0,,Biểu tượng của nước, kẻ thống trị màu xanh,
Dialogue: 0,0:06:38.62,0:06:41.30,Default,Kaori,0,0,0,,Đại hộ pháp của mặt trăng và là người bảo vệ hậu phương.
Dialogue: 0,0:06:41.72,0:06:44.40,Default,Kaori,0,0,0,,Được biết đến với cái tên... Quyền năng của Chúa!
Dialogue: 0,0:06:55.79,0:06:56.68,Default,Kaori,0,0,0,,Lưới phép?
Dialogue: 0,0:06:57.20,0:07:01.12,Default,Kaori,0,0,0,,Cơn mưa sao băng đã từng hủy diệt cả một nền văn minh do tội lỗi mà họ gây ra?
Dialogue: 0,0:07:02.50,0:07:05.38,Default,Kaori,0,0,0,,Chỉ vì muốn thỏa mong ước là trở lại thiên đường,
Dialogue: 0,0:07:05.60,0:07:08.11,Default,Kaori,0,0,0,,Mà cô định hủy diệt cả thế giới?
Dialogue: 0,0:07:09.14,0:07:10.80,Default,Touma,0,0,0,,Đáng chết.
Dialogue: 0,0:07:10.80,0:07:12.00,Default,Kaori,0,0,0,,Cậu định làm gì đó?
Dialogue: 0,0:07:13.31,0:07:15.44,Default,Touma,0,0,0,,Cô ta không chạm vào tay tôi.
Dialogue: 0,0:07:16.07,0:07:20.16,Default,Touma,0,0,0,,Chứng tỏ Imagine Breaker có tác dụng với Thiên thần.
Dialogue: 0,0:07:20.49,0:07:21.24,Default,Kaori,0,0,0,,Không.
Dialogue: 0,0:07:22.01,0:07:24.67,Default,Kaori,0,0,0,,Từ bây giờ, đây không còn là trận chiến của con người.
Dialogue: 0,0:07:25.34,0:07:28.74,Default,Kaori,0,0,0,,Có việc khác đang chờ cậu làm.
Dialogue: 0,0:07:29.27,0:07:31.99,Default,Kaori,0,0,0,,Hãy cùng Touya-san đi xóa bỏ Angel Fall.
Dialogue: 0,0:07:32.47,0:07:35.80,Default,Kaori,0,0,0,,Như vậy, "Quyền năng của Chúa" sẽ không đuổi giết ông ta nữa,
Dialogue: 0,0:07:35.80,0:07:38.12,Default,Kaori,0,0,0,,Và cũng không cần sử dụng "lưới phép" nữa.
Dialogue: 0,0:07:38.28,0:07:39.33,Default,Kaori,0,0,0,,Không còn nhiều thời gian đâu.
Dialogue: 0,0:07:39.64,0:07:42.42,Default,Kaori,0,0,0,,Nhanh lên đi trước khi ma thuật này hoàn thiện.
Dialogue: 0,0:07:43.25,0:07:44.13,Default,Touma,0,0,0,,Kanzaki...
Dialogue: 0,0:07:45.02,0:07:48.23,Default,Kaori,0,0,0,,Tôi không định vong mạng nơi đây đâu.
Dialogue: 0,0:07:49.48,0:07:52.47,Default,Kaori,0,0,0,,Như đã từng cứu con bé trước đây,
Dialogue: 0,0:07:52.47,0:07:55.85,Default,Kaori,0,0,0,,Hy vọng lần này cậu sẽ cứu đựơc tôi.
Dialogue: 0,0:08:01.35,0:08:03.48,Default,Touya,0,0,0,,Touma, rốt cuộc...
Dialogue: 0,0:08:03.48,0:08:05.38,Default,Touma,0,0,0,,Trông cậy vào chị, Kanzaki!
Dialogue: 0,0:08:10.98,0:08:13.52,Default,Kaori,0,0,0,,Đối thủ của cô chính là tôi!
Dialogue: 0,0:08:35.18,0:08:38.35,Default,Kaori,0,0,0,,Được rồi, đã đến lúc Yuisen khẳng định sức mạnh...
Dialogue: 0,0:08:38.59,0:08:40.69,Default,Kaori,0,0,0,,Salvare000!!!
Dialogue: 0,0:08:46.04,0:08:49.45,Default,Tsuchi,0,0,0,,Ai cha, coi bộ không xong rồi.
Dialogue: 0,0:08:49.45,0:08:51.32,Default,Tsuchi,0,0,0,,Xin lỗi nhé, Kami-yan.
Dialogue: 0,0:08:52.81,0:08:55.43,Default,Tsuchi,0,0,0,,Nếu để tớ tự tay giải quyết vấn đề...
Dialogue: 0,0:08:55.43,0:08:58.71,Default,Tsuchi,0,0,0,,Thì sẽ có người phải hy sinh đấy.
Dialogue: 0,0:09:03.08,0:09:05.39,Default,Kaori,0,0,0,,Mình nghĩ gì thế nhỉ?
Dialogue: 0,0:09:05.39,0:09:11.40,Default,Kaori,0,0,0,,Là một người Cơ Đốc, mình có thể đánh bại một thiên thần của Cơ Đốc Giáo sao?
Dialogue: 0,0:09:12.98,0:09:13.68,Default,Kaori,0,0,0,,Tuy nhiên!
Dialogue: 0,0:09:17.65,0:09:21.43,Default,Kaori,0,0,0,,Tuy nhiên, tôi không đơn thuần là một người Cơ Đốc.
Dialogue: 0,0:09:21.89,0:09:24.48,Default,Kaori,0,0,0,,Ma thuật của tôi học từ Amakusa-shiki Cơ Đốc Giáo Hội,
Dialogue: 0,0:09:24.48,0:09:29.50,Default,Kaori,0,0,0,,Một thể độc nhất do những người Cơ Đốc bị đàn áp \Ntại Nhật Bản sáng tạo ra từ thời Edo.
Dialogue: 0,0:09:31.11,0:09:34.28,Default,Kaori,0,0,0,,Đó chính là... phong cách đa tôn giáo!
Dialogue: 0,0:09:35.09,0:09:41.00,Default,Kaori,0,0,0,,Để chống lại sự đàn áp, nó đã dung hợp hai phong cách chính tông là Shinto và Butsu (Phật).
Dialogue: 0,0:09:42.46,0:09:45.33,Default,Kaori,0,0,0,,Nói cách khác, nếu người Cơ Đốc không thể tiêu diệt Thiên thần,
Dialogue: 0,0:09:45.68,0:09:47.59,Default,Kaori,0,0,0,,Vậy thì với sức mạnh của đạo Shinto Nhật Bản-
Dialogue: 0,0:09:53.07,0:09:58.05,Default,Kaori,0,0,0,,Trong sự đa tôn giáo của đạo Shinto, cũng tồn tại những ma thuật chống Thiên thần.
Dialogue: 0,0:09:59.06,0:10:03.69,Default,Kaori,0,0,0,,Có một điều răn, rằng chúng tôi không được làm hại Chúa.
Dialogue: 0,0:10:03.96,0:10:08.82,Default,Kaori,0,0,0,,Nhưng mà... tại sao lại có một điều răn như vậy?
Dialogue: 0,0:10:22.20,0:10:26.35,Default,Kaori,0,0,0,,Đối đầu trực diện với "Quyền năng của Chúa" coi bộ không thể tránh khỏi bị thương.
Dialogue: 0,0:10:33.20,0:10:35.80,Default,Kaori,0,0,0,,Trân chiến này đang dần biến thành một trò chơi đuổi và giết không lối thoát.
Dialogue: 0,0:10:37.37,0:10:39.47,Default,Kaori,0,0,0,,Trong lúc tôi còn có thể cầm cự...
Dialogue: 0,0:10:40.48,0:10:42.81,Default,Kaori,0,0,0,,Làm ơn đi, Kamijou Touma...
Dialogue: 0,0:10:43.47,0:10:45.88,Default,Kaori,0,0,0,,Phải dừng Angel Fall lại bằng mọi giá.
Dialogue: 0,0:10:56.76,0:10:57.71,Default,Touma,0,0,0,,Sao thế?
Dialogue: 0,0:10:57.71,0:10:58.84,Default,Touma,0,0,0,,Tỉnh lại đi!
Dialogue: 0,0:11:00.16,0:11:02.19,Default,Touma,0,0,0,,Họ bị chuốc thuốc mê?
Dialogue: 0,0:11:02.19,0:11:04.55,Default,Touya,0,0,0,,Thật ra ai đã làm vậy?
Dialogue: 0,0:11:05.74,0:11:06.33,Default,Touya,0,0,0,,Touma!
Dialogue: 0,0:11:11.78,0:11:13.20,Default,Touya,0,0,0,,Giải thích đi.
Dialogue: 0,0:11:13.20,0:11:14.92,Default,Touya,0,0,0,,Thật ra chuyện này là thế nào?
Dialogue: 0,0:11:16.66,0:11:17.83,Default,Touma,0,0,0,,Nghe nè, ba.
Dialogue: 0,0:11:18.18,0:11:20.07,Default,Touma,0,0,0,,Cứ thế này thì mọi người sẽ chết hết.
Dialogue: 0,0:11:20.56,0:11:23.47,Default,Touma,0,0,0,,Để ngăn chặn điều đó, chúng ta phải hóa giải Angel Fall.
Dialogue: 0,0:11:24.02,0:11:26.21,Default,Touya,0,0,0,,Thế nó là cái gì... Angel F-
Dialogue: 0,0:11:26.21,0:11:27.70,Default,Touma,0,0,0,,Đừng giả dò như ba không biết.
Dialogue: 0,0:11:28.69,0:11:30.75,Default,Touma,0,0,0,,Ít nhất cũng khai ra vị trí của tế đàn đi!
Dialogue: 0,0:11:30.75,0:11:32.77,Default,Tsuchi,0,0,0,,Thôi nào, Kami-yan.
Dialogue: 0,0:11:32.97,0:11:33.97,Default,Touma,0,0,0,,Tsuchimikado?
Dialogue: 0,0:11:34.43,0:11:36.82,Default,Tsuchi,0,0,0,,Vẫn chưa nhận ra sự thật hả?
Dialogue: 0,0:11:38.53,0:11:40.15,Default,Tsuchi,0,0,0,,Mà cũng đúng thôi.
Dialogue: 0,0:11:40.15,0:11:43.76,Default,Tsuchi,0,0,0,,Kami-yan còn gà lắm khi nói về ma thuật.
Dialogue: 0,0:11:43.76,0:11:45.60,Default,Touma,0,0,0,,Cái gì cơ? Sự thật?
Dialogue: 0,0:11:47.34,0:11:51.04,Default,Touma,0,0,0,,Vậy người đã thi triển Angel Fall không phải ba tớ mà là...
Dialogue: 0,0:11:51.04,0:11:55.05,Default,Tsuchi,0,0,0,,Không, thủ phạm chính xác là Kamijou Touya.
Dialogue: 0,0:11:55.36,0:11:58.05,Default,Tsuchi,0,0,0,,Chỉ là chính ông ấy cũng không biết thôi.
Dialogue: 0,0:11:59.12,0:12:00.67,Default,Touma,0,0,0,,Ý cậu là gì?
Dialogue: 0,0:12:01.19,0:12:05.64,Default,Touma,0,0,0,,Để thi triển Angel Fall, người ta cần dựng nên một tế đàn cực lớn đúng không?
Dialogue: 0,0:12:05.64,0:12:06.47,Default,Tsuchi,0,0,0,,Đúng.
Dialogue: 0,0:12:06.98,0:12:08.58,Default,Tsuchi,0,0,0,,Có một tế đàn.
Dialogue: 0,0:12:08.58,0:12:10.17,Default,Tsuchi,0,0,0,,Ngay trong nhà cậu, Kami-yan.
Dialogue: 0,0:12:10.72,0:12:13.84,Default,Tsuchi,0,0,0,,Bùa phép, vật tượng trưng, bản sao thần linh,
Dialogue: 0,0:12:14.18,0:12:16.74,Default,Tsuchi,0,0,0,,Nếu để riêng thì chúng chẳng có ý nghĩa gì.
Dialogue: 0,0:12:16.74,0:12:20.74,Default,Tsuchi,0,0,0,,Nhưng nếu được sắp xếp đúng theo thuật phong thủy,
Dialogue: 0,0:12:21.36,0:12:23.73,Default,Tsuchi,0,0,0,,Giữa chúng sẽ hình thành mối liên kết,
Dialogue: 0,0:12:23.73,0:12:26.08,Default,Tsuchi,0,0,0,,Và trở thành nguồn sức mạnh vô biên.
Dialogue: 0,0:12:26.71,0:12:29.28,Default,Tsuchi,0,0,0,,Có một hộp, thứ đặt ngay lối của vào đúng không?
Dialogue: 0,0:12:29.58,0:12:31.56,Default,Tsuchi,0,0,0,,Nó tượng trung cho hỏa thần phương nam
Dialogue: 0,0:12:31.91,0:12:34.76,Note,Tsuchi,0,0,0,,Kame: Huyền Vũ.
Dialogue: 0,0:12:31.91,0:12:34.76,Default,Tsuchi,0,0,0,,Con rùa gần bồn tắm tượng trưng cho thủy thần Kame.
Dialogue: 0,0:12:34.76,0:12:38.26,Note,Tsuchi,0,0,0,,Byakko: Bạch Hổ.
Dialogue: 0,0:12:34.76,0:12:38.26,Default,Tsuchi,0,0,0,,Con báo trong nhà bếp tượng trưng cho kim thần Byakko.
Dialogue: 0,0:12:38.58,0:12:41.71,Default,Tsuchi,0,0,0,,Cùng với gần 3000 vật thể còn lại,
Dialogue: 0,0:12:41.71,0:12:44.60,Default,Tsuchi,0,0,0,,Căn nhà đó đã trở thành một đền thờ.
Dialogue: 0,0:12:45.33,0:12:48.54,Default,Tsuchi,0,0,0,,Thời điểm cánh cửa phía Bắc được ông ta mở ra khi đến đây,
Dialogue: 0,0:12:48.54,0:12:51.71,Default,Tsuchi,0,0,0,,Tế đàn đã hoàn thiện và tự kích hoạt.
Dialogue: 0,0:12:52.09,0:12:53.56,Default,Touma,0,0,0,,Trùng hợp đến thế sao?
Dialogue: 0,0:12:53.80,0:12:56.00,Default,Tsuchi,0,0,0,,Đúng, rất trùng hợp.
Dialogue: 0,0:12:56.50,0:13:01.27,Default,Tsuchi,0,0,0,,Angel Fall vốn là ma thuật được tạo ra từ sự trùng hợp.
Dialogue: 0,0:13:01.27,0:13:06.16,Default,Tsuchi,0,0,0,,Nếu chúng ta cố tình thay đổi, có thế sẽ lại tạo ra một loại ma thuật dở hơi nào đó thôi.
Dialogue: 0,0:13:07.27,0:13:09.49,Default,Tsuchi,0,0,0,,Để xóa bỏ công thức của ma thuật,
Dialogue: 0,0:13:09.49,0:13:11.82,Default,Tsuchi,0,0,0,,Phải phá hủy hoàn toàn tế đàn.
Dialogue: 0,0:13:12.28,0:13:13.58,Default,Tsuchi,0,0,0,,Bằng không...
Dialogue: 0,0:13:14.12,0:13:16.56,Default,Touma,0,0,0,,...phải tiêu diệt "Chủ ma thuật"?
Dialogue: 0,0:13:17.46,0:13:19.46,Default,Tsuchi,0,0,0,,Nhưng phiền phức rồi nha.
Dialogue: 0,0:13:19.46,0:13:22.18,Default,Tsuchi,0,0,0,,Thời gian thì không còn nhiều mà tớ thì không thể sử dụng ma thuật.
Dialogue: 0,0:13:22.66,0:13:26.40,Default,Tsuchi,0,0,0,,Thiệt tình, phải làm việc trong tình trạng thế này,
Dialogue: 0,0:13:26.40,0:13:28.76,Default,Tsuchi,0,0,0,,Giáo hội thật biết cách làm khó người ta.
Dialogue: 0,0:13:28.95,0:13:30.41,Default,Touma,0,0,0,,Đừng có hòng.
Dialogue: 0,0:13:30.41,0:13:32.14,Default,Tsuchi,0,0,0,,Bỏ đi, Kami-yan.
Dialogue: 0,0:13:32.14,0:13:33.49,Default,Tsuchi,0,0,0,,Cậu chỉ tự làm hại mình thôi.
Dialogue: 0,0:13:33.87,0:13:34.75,Default,Touya,0,0,0,,Touma!
Dialogue: 0,0:13:34.75,0:13:35.86,Default,Touma,0,0,0,,Lùi lại!
Dialogue: 0,0:13:36.38,0:13:37.42,Default,Touma,0,0,0,,Tớ không chấp nhận.
Dialogue: 0,0:13:37.95,0:13:41.97,Default,Touma,0,0,0,,Nếu trên thế giới có điều luật yêu cầu người ta phải hy sinh,
Dialogue: 0,0:13:41.97,0:13:44.30,Default,Touma,0,0,0,,Vậy hãy để tớ loại bỏ sự bất công ấy trước!
Dialogue: 0,0:13:52.31,0:13:53.29,Default,Touya,0,0,0,,Touma!
Dialogue: 0,0:13:53.29,0:13:55.08,Default,Tsuchi,0,0,0,,Nằm đó đi, con gà!
Dialogue: 0,0:13:55.08,0:13:58.25,Default,Touya,0,0,0,,Nếu cậu cần mạng tôi thì cứ đến láy đi.
Dialogue: 0,0:13:58.25,0:14:00.34,Default,Touya,0,0,0,,Touma không liên quan gì hết.
Dialogue: 0,0:14:02.48,0:14:07.14,Default,Touya,0,0,0,,Tôi không để cậu làm hại Touma nữa đâu.
Dialogue: 0,0:14:07.14,0:14:08.55,Default,Tsuchi,0,0,0,,Đừng làm tôi tức cười,
Dialogue: 0,0:14:08.55,0:14:10.89,Default,Tsuchi,0,0,0,,Bộ ông đánh lại tôi sao?
Dialogue: 0,0:14:11.08,0:14:12.16,Default,Touya,0,0,0,,Có lẽ là không.
Dialogue: 0,0:14:12.95,0:14:15.66,Default,Touya,0,0,0,,Nhưng nếu cậu làm hại Touma,
Dialogue: 0,0:14:15.66,0:14:17.65,Default,Touya,0,0,0,,Thì tôi quyết không bỏ qua đâu!
Dialogue: 0,0:14:18.25,0:14:19.57,Default,Touya,0,0,0,,Biết tại sao không?
Dialogue: 0,0:14:19.96,0:14:22.90,Default,Touya,0,0,0,,Vì tôi là Ba của Kamijou Touma!
Dialogue: 0,0:14:23.61,0:14:24.52,Default,Touma,0,0,0,,Ba...
Dialogue: 0,0:14:26.14,0:14:27.51,Default,Touya,0,0,0,,Dừng lại đi, Touma!
Dialogue: 0,0:14:27.51,0:14:31.59,Default,Touya,0,0,0,,Cứu một mình ba sẽ chả giúp được gì cho ai cả.
Dialogue: 0,0:14:31.59,0:14:33.41,Default,Touma,0,0,0,,Nhảm nhí.
Dialogue: 0,0:14:33.96,0:14:36.19,Default,Touma,0,0,0,,Người đang đứng đây.
Dialogue: 0,0:14:36.68,0:14:38.63,Default,Touma,0,0,0,,Là con trai Kamijou Touya!
Dialogue: 0,0:14:39.48,0:14:40.50,Default,Touya,0,0,0,,Touma...
Dialogue: 0,0:14:41.47,0:14:43.62,Default,Tsuchi,0,0,0,,Cũng dám nói thế cơ à?
Dialogue: 0,0:14:43.62,0:14:45.38,Default,Tsuchi,0,0,0,,Được thôi, xin ghi nhận...
Dialogue: 0,0:14:46.02,0:14:49.72,Default,Tsuchi,0,0,0,,...rằng Kamijou Touma giờ đây là\N kẻ thù của Tsuchimikado Motoharu...
Dialogue: 0,0:14:57.11,0:14:59.27,Default,Tsuchi,0,0,0,,Nào nào, Knock Out rồi sao?
Dialogue: 0,0:15:06.29,0:15:07.11,Default,Touya,0,0,0,,Touma!
Dialogue: 0,0:15:16.20,0:15:17.71,Default,Touma,0,0,0,,Ba...
Dialogue: 0,0:15:17.90,0:15:19.25,Default,Tsuchi,0,0,0,,Giờ thì...
Dialogue: 0,0:15:20.81,0:15:22.46,Default,Tsuchi,0,0,0,,Kính thưa tất cả quý ông quý bà...
Dialogue: 0,0:15:23.83,0:15:27.22,Default,Tsuchi,0,0,0,,Hãy chứng kiến một màn ảo thuật tinh vi và bí ẩn...
Dialogue: 0,0:15:27.64,0:15:29.68,Default,Tsuchi,0,0,0,,Để chia tay buổi biểu diễn ngày hôm nay.
Dialogue: 0,0:15:30.17,0:15:33.18,Default,Tsuchi,0,0,0,,Bắt đầu bằng một vài chuẩn bị phiền phức.
Dialogue: 0,0:15:35.52,0:15:39.44,Default,Tsuchi,0,0,0,,Xin giới thiệu những người bạn diễn của tôi.
Dialogue: 0,0:15:39.92,0:15:41.80,Default,Tsuchi,0,0,0,,Làm việc đi, đồ ngu.
Dialogue: 0,0:15:41.80,0:15:42.66,Default,Tsuchi,0,0,0,,Suzaku.
Dialogue: 0,0:15:44.29,0:15:45.18,Default,Tsuchi,0,0,0,,Seiryu.
Dialogue: 0,0:15:46.54,0:15:47.37,Default,Tsuchi,0,0,0,,Genbu.
Dialogue: 0,0:15:49.29,0:15:50.33,Default,Tsuchi,0,0,0,,Byakko.
Dialogue: 0,0:15:53.77,0:15:55.90,Default,Tsuchi,0,0,0,,Súng đã sẵn sàng.
Dialogue: 0,0:15:55.90,0:15:58.21,Default,Tsuchi,0,0,0,,Bắt đầu nạp đạn.
Dialogue: 0,0:15:59.04,0:16:00.37,Default,Touma,0,0,0,,Ma thuật?
Dialogue: 0,0:16:01.23,0:16:05.61,Default,Tsuchi,0,0,0,,Nó sẽ mang một sức mạnh tàn bạo đến nực cười.
Dialogue: 0,0:16:06.06,0:16:07.88,Default,Tsuchi,0,0,0,,Một phong ấn sẽ gán vào cây súng.
Dialogue: 0,0:16:08.18,0:16:10.34,Default,Tsuchi,0,0,0,,Một thần chết sẽ đi theo viên đạn.
Dialogue: 0,0:16:10.80,0:16:12.09,Default,Touma,0,0,0,,Đợi chút...
Dialogue: 0,0:16:12.09,0:16:15.31,Default,Touma,0,0,0,,Tsuchimikado không được sử dụng ma thuật mà?
Dialogue: 0,0:16:15.31,0:16:17.43,Default,Tsuchi,0,0,0,,Ngón tay kéo cò sẽ...
Dialogue: 0,0:16:24.27,0:16:26.19,Default,Tsuchi,0,0,0,,Nói cậu rồi đó, Kami-yan.
Dialogue: 0,0:16:28.42,0:16:31.44,Default,Tsuchi,0,0,0,,Có hai cách để dừng Angel Fall.
Dialogue: 0,0:16:31.99,0:16:34.05,Default,Tsuchi,0,0,0,,Giết "Chủ ma thuật"...
Dialogue: 0,0:16:34.05,0:16:35.95,Default,Tsuchi,0,0,0,,Hoặc phá hủy phong ấn ma thuật.
Dialogue: 0,0:16:36.49,0:16:37.39,Default,Touma,0,0,0,,Dừng lại đi...
Dialogue: 0,0:16:38.53,0:16:42.45,Default,Tsuchi,0,0,0,,Kami-yan, cậu thật giống Kanzaki.
Dialogue: 0,0:16:42.45,0:16:44.75,Default,Tsuchi,0,0,0,,Nếu biết tớ sắp sử dụng phương án này.
Dialogue: 0,0:16:44.75,0:16:46.87,Default,Tsuchi,0,0,0,,Chị ấy sẽ làm tất để tớ phải dừng lại.
Dialogue: 0,0:16:46.87,0:16:47.84,Default,Tsuchi,0,0,0,,Đứng không?
Dialogue: 0,0:16:48.46,0:16:50.67,Default,Tsuchi,0,0,0,,Nhưng đây là cách duy nhất để bảo vệ mọi người.
Dialogue: 0,0:16:51.30,0:16:53.45,Default,Tsuchi,0,0,0,,Xin lỗi đã đánh cậu nhé.
Dialogue: 0,0:16:53.80,0:16:59.02,Default,Tsuchi,0,0,0,,Và... tại vị trí của tế đàn, tớ sẽ dùng ma thuật của mình để -
Dialogue: 0,0:16:59.95,0:17:01.94,Default,Touma,0,0,0,,Dừng lại đi, Tsuchimikado...
Dialogue: 0,0:17:02.23,0:17:05.02,Default,Tsuchi,0,0,0,,Câu nói đó không đến được tai tớ rồi.
Dialogue: 0,0:17:07.33,0:17:11.95,Default,Tsuchi,0,0,0,,Kami-yan, thật ra tớ... là một kẻ nói dối...
Dialogue: 0,0:18:01.21,0:18:05.44,Default,Kaori,0,0,0,,Xem ra tôi lại nợ cậu nữa rồi, Kamijou Touma.
Dialogue: 0,0:18:22.77,0:18:24.71,Default,Touma,0,0,0,,Ba, tỉnh lại đi.
Dialogue: 0,0:18:24.71,0:18:25.27,Default,Touma,0,0,0,,Ba!
Dialogue: 0,0:18:31.82,0:18:33.05,Default,Touma,0,0,0,,Tsuchimikado...
Dialogue: 0,0:18:38.68,0:18:41.30,Note,,0,0,0,,{\an1\bord0\c&H000000&\i1\frx10\fry350\pos(656,510)\org(589,704)\frz342.7}Mừng cậu quay lại
Dialogue: 0,0:18:38.68,0:18:41.30,Note,,0,0,0,,{\an1\bord0\c&H000000&\i1\frx10\fry350\frz343.1\pos(666,582)\org(763,708)}Để tôi đoán nhé?{\i0}
Dialogue: 0,0:18:38.68,0:18:41.30,Note,,0,0,0,,{\an1\bord0\c&H000000&\i1\frx10\fry350\frz344.2\pos(652,602)\org(640,673)}Kamijou Touma-kun?{\i0}
Dialogue: 0,0:18:50.87,0:18:52.93,Default,Touma,0,0,0,,Tại sao? Chết tiệt...
Dialogue: 0,0:18:53.66,0:18:56.47,Default,Touma,0,0,0,,Việc này có ý nghĩa gì khi cậu không còn?!
Dialogue: 0,0:18:57.56,0:19:00.13,Default,Tsuchi,0,0,0,,Lâu quá không gặp ha, Kami-yan!
Dialogue: 0,0:19:00.13,0:19:01.90,Default,Tsuchi,0,0,0,,Đã khỏe lại chưa?
Dialogue: 0,0:19:03.54,0:19:07.15,Default,Tsuchi,0,0,0,,Sao thế, với khuôn mặt "Má ơi! Có ma" đó?
Dialogue: 0,0:19:07.15,0:19:10.94,Default,Touma,0,0,0,,À... Tớ tưởng cậu xài ma thuật quá liều và teo rồi cơ mà?
Dialogue: 0,0:19:10.94,0:19:12.83,Default,Tsuchi,0,0,0,,À, xạo đó!
Dialogue: 0,0:19:14.56,0:19:19.06,Note,Tsuchi,0,0,0,,Note: Siêu năng lực của Tsuchimikado Motoharu sau khi bị cải tạo ở Thành phố Học viện là 'Recovery' nghĩa là 'Hồi phục'.
Dialogue: 0,0:19:14.56,0:19:16.62,Default,Tsuchi,0,0,0,,Năng lực của tớ tuy yếu...
Dialogue: 0,0:19:16.62,0:19:19.06,Default,Tsuchi,0,0,0,,Nhưng nó có tên là "Tự Hồi Sinh".
Dialogue: 0,0:19:19.06,0:19:23.12,Default,Tsuchi,0,0,0,,Và tớ muốn xài bao nhiêu lần cũng được.
Dialogue: 0,0:19:23.72,0:19:26.31,Default,Tsuchi,0,0,0,,Giờ giải thích ra thì dài dòng lắm.
Dialogue: 0,0:19:26.31,0:19:27.78,Default,Touma,0,0,0,,Dài dòng á?
Dialogue: 0,0:19:27.78,0:19:31.14,Default,Tsuchi,0,0,0,,Tsuchimikado-san vốn là một kẻ nói dối.
Dialogue: 0,0:19:31.50,0:19:34.99,Default,Tsuchi,0,0,0,,Vụ tớ làm Spy cho phe ma thuật tại Thành phố Học viện này... là nói dối.
Dialogue: 0,0:19:34.99,0:19:39.34,Default,Tsuchi,0,0,0,,Thật ra tớ cố tình tìm cách liên minh với \NThuần Anh Giáo Hội để tìm ra bí mật của họ!
Dialogue: 0,0:19:39.66,0:19:42.42,Default,Tsuchi,0,0,0,,Nhưng đó cũng là nói dối!
Dialogue: 0,0:19:42.42,0:19:46.64,Default,Tsuchi,0,0,0,,Thân phận thật của tớ là một tên Spy đa tổ chức.
Dialogue: 0,0:19:48.34,0:19:51.07,Default,Tsuchi,0,0,0,,Mà dù sao thì mọi chuyện cũng ổn rồi.
Dialogue: 0,0:19:51.07,0:19:54.48,Default,Tsuchi,0,0,0,,Để bày tỏ chút lòng thành, tớ đã đưa họ tới đây.
Dialogue: 0,0:19:54.48,0:19:58.74,Default,Shiina,0,0,0,,Thiệt đó, Hitotsui Hajime đã đến nhà chúng ta thiệt đó!
Dialogue: 0,0:19:59.25,0:20:01.66,Default,Touma,0,0,0,,Mẹ...?
Dialogue: 0,0:20:04.56,0:20:06.64,Default,Shiina,0,0,0,,Con sao rồi, Touma-san?
Dialogue: 0,0:20:07.62,0:20:12.00,Default,Touma,0,0,0,,Ahh... Umm, con quen rồi...
Dialogue: 0,0:20:12.25,0:20:16.94,Default,Shiina,0,0,0,,Ai cha, quên với việc phải chăm sóc vết thương trong bệnh viện là không tốt đâu nha.
Dialogue: 0,0:20:17.58,0:20:20.05,Default,Touya,0,0,0,,Touma, con khỏe lại là tốt quá rồi.
Dialogue: 0,0:20:21.25,0:20:23.51,Default,Touma,0,0,0,,Vâng, ba cũng vậy.
Dialogue: 0,0:20:24.31,0:20:26.37,Default,Touya,0,0,0,,Căn nhà đã trở thành dĩ vãng,
Dialogue: 0,0:20:26.37,0:20:28.60,Default,Touya,0,0,0,,Nhưng chả lì gì nếu con được an toàn.
Dialogue: 0,0:20:28.85,0:20:31.82,Default,Touma,0,0,0,,Hả, căn nhà? Bị làm sao?
Dialogue: 0,0:20:32.26,0:20:38.59,Default,Shiina,0,0,0,,Căn nhà mới của chúng ta đã bị phá hủy do một vụ nổ chưa rõ nguyên nhân.
Dialogue: 0,0:20:41.56,0:20:42.83,Default,Touma,0,0,0,,Tsuchimikado?
Dialogue: 0,0:20:42.83,0:20:44.60,Default,Touya,0,0,0,,Thôi, biết làm sao được.
Dialogue: 0,0:20:45.08,0:20:46.57,Default,Touya,0,0,0,,Từ giờ đến lúc nó được xây lại,
Dialogue: 0,0:20:46.57,0:20:49.23,Default,Touya,0,0,0,,Ba mẹ sẽ sống tại căn nhà cũ.
Dialogue: 0,0:20:49.23,0:20:50.55,Default,Touma,0,0,0,,Nhà cũ?
Dialogue: 0,0:20:50.96,0:20:54.54,Default,Touya,0,0,0,,Đúng, căn nhà ba mẹ thuê.
Dialogue: 0,0:20:54.54,0:20:56.38,Default,Touya,0,0,0,,Vẫn còn xài được mà.
Dialogue: 0,0:20:56.57,0:20:59.33,Default,Shiina,0,0,0,,Căn nhà nơi ba mẹ cưới nhau và sinh ra con,
Dialogue: 0,0:20:59.33,0:21:01.68,Default,Shiina,0,0,0,,Nơi chúng ta sống chung cho đến khi chuyển đi.
Dialogue: 0,0:21:02.45,0:21:05.64,Default,Shiina,0,0,0,,Nơi suốt ngày bị con chê là nhỏ đó.
Dialogue: 0,0:21:06.25,0:21:07.30,Default,Touma,0,0,0,,Ra vậy.
Dialogue: 0,0:21:08.20,0:21:09.25,Default,Index,0,0,0,,Touma.
Dialogue: 0,0:21:14.26,0:21:16.31,Default,Touma,0,0,0,,Sao thế, Index?
Dialogue: 0,0:21:16.31,0:21:18.48,Default,Touma,0,0,0,,Làm gì mà rụt rè rứa?
Dialogue: 0,0:21:19.98,0:21:22.99,Default,Index,0,0,0,,Touma tóm cổ em nhấc lên trời.
Dialogue: 0,0:21:27.86,0:21:30.25,Default,Index,0,0,0,,Touma chôn sống em trên bãi cát.
Dialogue: 0,0:21:30.40,0:21:33.46,Default,Touma,0,0,0,,Ah, cái này nói ra thì dài lắm-
Dialogue: 0,0:21:33.46,0:21:35.71,Default,Index,0,0,0,,Touma đẩy cửa đập vào mặt em!
Dialogue: 0,0:21:36.02,0:21:37.46,Default,Touma,0,0,0,,Cái đó không phải anh!
Dialogue: 0,0:21:37.46,0:21:40.38,Default,Index,0,0,0,,Và bỏ mặc em nằm chết ngất trên đất!
Dialogue: 0,0:21:41.41,0:21:42.76,Default,Touma,0,0,0,,Cái đó đúng là anh...
Dialogue: 0,0:21:42.76,0:21:45.22,Default,Touma,0,0,0,,À, không... ý anh là...
Dialogue: 0,0:21:47.88,0:21:51.01,Default,Touma,0,0,0,,XUI QUÁ!!!
Dialogue: 0,0:23:25.28,0:23:27.47,Default,Touma,0,0,0,,Người liên tục làm phiền Misaka Mikoto, Unabara Mitsuki.
Dialogue: 0,0:23:27.85,0:23:31.02,Default,Touma,0,0,0,,Để chấm dứt điều đó, chúng tôi đã đóng giả tình nhân.
Dialogue: 0,0:23:31.41,0:23:33.66,Default,Touma,0,0,0,,Hả? Hẹn hò với Biribiri?
Dialogue: 0,0:23:33.95,0:23:35.38,Default,Touma,0,0,0,,Kì tới, "Replica".
Dialogue: 0,0:23:35.72,0:23:37.48,Default,Touma,0,0,0,,Khi khoa học và ma thuật gặp nhau,
Dialogue: 0,0:23:37.48,0:23:38.69,Default,Touma,0,0,0,,Bản anh hùng ca sẽ bắt đầu.
