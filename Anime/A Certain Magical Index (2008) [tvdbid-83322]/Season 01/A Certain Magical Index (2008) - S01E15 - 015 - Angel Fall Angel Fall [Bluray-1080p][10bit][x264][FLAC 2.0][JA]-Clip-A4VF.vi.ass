Comment: 0,0:11:41.33,0:11:42.37,Default,!MIS.,0,0,0,,...huh?
Comment: 0,0:12:54.04,0:12:55.90,Default-alt,$%@$,0,0,0,,I can't breathe!\N
Comment: 0,0:13:30.99,0:13:31.53,Default,Touya,0,0,0,,See?
Comment: 0,0:13:32.20,0:13:32.93,Default,Touya,0,0,0,,See?
Comment: 0,0:13:32.93,0:13:33.45,Default,Touya,0,0,0,,See?
Comment: 0,0:13:37.56,0:13:38.54,Default,Shiina,0,0,0,,My, my.\N
Comment: 0,0:20:31.65,0:20:32.56,Default,Touma,0,0,0,,Bàn tay của chúa =))
Dialogue: 0,0:00:35.74,0:00:37.72,Default,Index,0,0,0,,Touma!
Dialogue: 0,0:00:38.11,0:00:40.88,Default,Index,0,0,0,,Tou~ma!
Dialogue: 0,0:00:45.48,0:00:50.84,Default,Touma,0,0,0,,Tôi lúc này đây... đã rời khỏi Thành phố Học viện, đang giết thời gian với Index trên bãi biển này.
Dialogue: 0,0:00:51.20,0:00:53.89,Default,Touma,0,0,0,,Tất nhiên không tôi có tự nguyện.
Dialogue: 0,0:00:54.28,0:00:56.32,Default,Touma,0,0,0,,Rời khỏi thành phố ngay lập tức?
Dialogue: 0,0:00:56.65,0:00:59.91,Default,Komoe,0,0,0,,Mấy vị bề trên đang sốt ruột dữ lắm.
Dialogue: 0,0:00:59.91,0:01:03.99,Default,Komoe,0,0,0,,Cứ tình hình này... Kamijou-chan sẽ gặp nguy hiểm đấy.
Dialogue: 0,0:01:03.99,0:01:05.99,Default,Komoe,0,0,0,,Thư mời đã được gửi đến rồi...
Dialogue: 0,0:01:06.32,0:01:08.41,Default,Komoe,0,0,0,,Họ muốn gặp em càng sớm càng tốt.
Dialogue: 0,0:01:08.83,0:01:13.07,Default,Komoe,0,0,0,,Thế nên, nơi em phải đến là... Xem nào...
Dialogue: 0,0:01:13.07,0:01:14.71,Default,Komoe,0,0,0,,À, đây rồi.
Dialogue: 0,0:01:14.71,0:01:16.84,Default,Komoe,0,0,0,,Một bãi biển đẹp đấy chứ?
Dialogue: 0,0:01:17.56,0:01:18.30,Default,Index,0,0,0,,Em sẽ đi!
Dialogue: 0,0:01:18.30,0:01:20.55,Default,Index,0,0,0,,Em sẽ đi với anh, Touma!
Dialogue: 0,0:01:20.55,0:01:23.27,Default,Index,0,0,0,,Đây sẽ là lần đầu tiên em đi biển!
Dialogue: 0,0:01:23.52,0:01:25.73,Default,Touma,0,0,0,,Không là không!
Dialogue: 0,0:01:25.73,0:01:30.54,Default,Touma,0,0,0,,Mà một con quái vật như em cũng làm gì có ID Card.
Dialogue: 0,0:01:30.54,0:01:34.28,Default,Touma,0,0,0,,Có bám theo anh thì đến cửa khẩu cũng bị người ta giữ lại thôi.
Dialogue: 0,0:01:39.22,0:01:39.95,Default,guy,0,0,0,,Đi đi.
Dialogue: 0,0:01:42.35,0:01:46.10,Default,Touma,0,0,0,,Cửa khẩu hôm nay làm ăn kiểu gì thế này?!
Dialogue: 0,0:01:48.14,0:01:49.83,Default,Touma,0,0,0,,Chuyện là như thế đó,
Dialogue: 0,0:01:49.83,0:01:52.27,Default,Touma,0,0,0,,Tôi có mặt ở đây vì một số lý do dở hơi.
Dialogue: 0,0:01:53.04,0:01:58.50,Default,Touma,0,0,0,,Và chẳng hiểu sao mình có linh cảm xấu với cái tên của bãi biển này quá...
Dialogue: 0,0:01:53.04,0:01:58.50,Note,Touma,0,0,0,,Tên bãi biển này là Oowarai, nghĩa là "Trò cười"
Dialogue: 0,0:01:58.50,0:02:00.02,Default,Index,0,0,0,,Tou~ma!
Dialogue: 0,0:02:00.74,0:02:04.64,Default,Index,0,0,0,,Em vừa tìm thấy một cái mũ dễ thương lắm, coi như là quà dành cho Touma nhé.
Dialogue: 0,0:02:05.49,0:02:07.23,Default,Touma,0,0,0,,Ơ... Ừ...
Dialogue: 0,0:02:07.23,0:02:08.31,Default,Index,0,0,0,,Đây.
Dialogue: 0,0:02:09.15,0:02:10.97,Default,,0,0,0,,{\bord0\fscx150\c&H7C92D6&\pos(754,770)}Sứa khổng lồ {\c&H5C6C5D&}vào bờ
Dialogue: 0,0:02:09.15,0:02:10.97,Default,,0,0,0,,{\bord0\frz27\fscx80\c&HF0F1FB&\fnUVN Chim Bien Nang\pos(522,232)}Nguy Hiểm
Dialogue: 0,0:03:42.24,0:03:46.78,Note,,0,0,0,,{\bord2\fs40\fad(500,700)\pos(1564,732)}Angel Fall
Dialogue: 0,0:03:42.24,0:03:46.78,Note,,0,0,0,,{\bord2\fs40\fscy150\fad(500,700)\pos(1564,762)}Thiên thần hạ cánh
Dialogue: 0,0:03:42.27,0:03:45.16,Default,woman,0,0,0,,Vừa đến đây đã bị thế này, công nhận cậu xui thật đấy.
Dialogue: 0,0:03:45.44,0:03:48.98,Default,woman,0,0,0,,Năm nay lũ sứa cũng vào bờ sớm quá.
Dialogue: 0,0:03:49.60,0:03:52.44,Default,woman,0,0,0,,Nhờ đó mà chúng tôi chẳng có mống khách nào.
Dialogue: 0,0:03:52.44,0:03:54.12,Default,Index,0,0,0,,Xin lỗi nha, Touma.
Dialogue: 0,0:03:54.12,0:03:58.29,Default,Index,0,0,0,,Đây là lần đầu tiên em thấy sứa, thiệt đó.
Dialogue: 0,0:03:58.29,0:03:59.49,Default,woman,0,0,0,,Thôi thì...
Dialogue: 0,0:03:59.49,0:04:01.59,Default,woman,0,0,0,,Tôi sẽ quay lại lấy hộp sơ cứu sau.
Dialogue: 0,0:04:01.59,0:04:03.18,Default,Touma,0,0,0,,Vâng, cám ơn.
Dialogue: 0,0:04:03.18,0:04:04.92,Default,man,0,0,0,,Xin lỗi...
Dialogue: 0,0:04:08.08,0:04:11.34,Default,man,0,0,0,,Người thân của cậu vừa gọi điện...
Dialogue: 0,0:04:12.37,0:04:14.79,Default,man,0,0,0,,Họ nói do có việc đột xuất...
Dialogue: 0,0:04:14.79,0:04:16.90,Default,man,0,0,0,,Nên phải sáng mai mới đến đây.
Dialogue: 0,0:04:18.06,0:04:20.46,Default,Index,0,0,0,,Cháu muốn gặp họ bây giờ cơ!
Dialogue: 0,0:04:20.46,0:04:21.70,Default,Index,0,0,0,,Touma...
Dialogue: 0,0:04:20.46,0:04:21.70,Default-alt,Touma,0,0,0,,Hiểu rồi ạ.
Dialogue: 0,0:04:21.70,0:04:22.99,Default-alt,Touma,0,0,0,,Cám ơn bác nhiều.
Dialogue: 0,0:04:22.99,0:04:24.56,Default,man,0,0,0,,Tôi xin phép.
Dialogue: 0,0:04:24.56,0:04:26.13,Default,woman,0,0,0,,Xin phép.
Dialogue: 0,0:04:29.92,0:04:31.85,Default,Index,0,0,0,,Chán quá à!
Dialogue: 0,0:04:33.69,0:04:36.59,Default,Touma,0,0,0,,Phải, tôi và họ định gặp nhau ở đây.
Dialogue: 0,0:04:40.41,0:04:43.16,Default,Touma,0,0,0,,Kamijou Touya, Kamijou Shiina.
Dialogue: 0,0:04:43.71,0:04:45.29,Default,Touma,0,0,0,,Hai người đã sinh ra tôi.
Dialogue: 0,0:04:45.99,0:04:47.35,Default,Index,0,0,0,,Touma.
Dialogue: 0,0:04:49.89,0:04:51.81,Default,Index,0,0,0,,Đi tắm thôi.
Dialogue: 0,0:04:56.00,0:04:59.98,Default,Touma,0,0,0,,Có lẽ do không liên lạc được với tôi nên họ phải nhờ Komoe-sensei báo lại.
Dialogue: 0,0:05:00.49,0:05:02.74,Default,Touma,0,0,0,,Và hình như cô em gái con ông bác tôi cũng đến.
Dialogue: 0,0:05:06.52,0:05:08.27,Default,Index,0,0,0,,Nè, Touma.
Dialogue: 0,0:05:08.27,0:05:09.23,Default,Touma,0,0,0,,Hả?
Dialogue: 0,0:05:09.23,0:05:11.66,Default,Index,0,0,0,,Họ là người thế nào?
Dialogue: 0,0:05:11.66,0:05:13.65,Default,Touma,0,0,0,,Thế nào á...?
Dialogue: 0,0:05:13.65,0:05:18.21,Default,Index,0,0,0,,Em rất mong được gặp họ đấy, ba và mẹ của Touma.
Dialogue: 0,0:05:20.37,0:05:22.64,Default,Index,0,0,0,,Nè, Touma, anh nghe không đó?!
Dialogue: 0,0:05:22.64,0:05:23.75,Default,Touma,0,0,0,,Vẫn đang nghe nè.
Dialogue: 0,0:05:23.75,0:05:25.53,Default,Touma,0,0,0,,Đợi đến mai là biết thôi đúng không?
Dialogue: 0,0:05:26.24,0:05:29.16,Default,Index,0,0,0,,Ahh... Anh lại keo kiệt nữa rồi!
Dialogue: 0,0:05:29.16,0:05:31.10,Default,Index,0,0,0,,Kể luôn cho em thì có mất gì nào?!
Dialogue: 0,0:05:31.10,0:05:35.80,Default,Index,0,0,0,,Lúc nào cũng thế, Touma lạnh lùng, độc ác, khó ưa,
Dialogue: 0,0:05:35.80,0:05:38.08,Default,Index,0,0,0,,Xấu xa, cộc căn, bủn xỉn,
Dialogue: 0,0:05:38.08,0:05:41.24,Default,Index,0,0,0,,Khó bảo, khó nhai...
Dialogue: 0,0:05:39.30,0:05:41.85,Default-alt,Touma,0,0,0,,Ừ, đến mai tôi sẽ biết.
Dialogue: 0,0:05:44.06,0:05:48.20,Default,Touma,0,0,0,,Tôi bị mất trí nhớ, lẽ tất nhiên sẽ chả nhớ ba mẹ tôi là ai.
Dialogue: 0,0:05:51.45,0:05:54.61,Default,Touma,0,0,0,,Họ là người thế nào, tôi là đứa con ra sao?
Dialogue: 0,0:05:55.19,0:05:56.96,Default,Touma,0,0,0,,Liệu ngày mai tôi có tỏ ra tự nhiên được hay không?
Dialogue: 0,0:06:00.24,0:06:03.61,Default,Shiz,0,0,0,,Khách mời đặc biệt của chúng tôi, Hitotsu Hajime-san!
Dialogue: 0,0:06:04.99,0:06:06.52,Default,guy,0,0,0,,Chào buổi tối!
Dialogue: 0,0:06:08.55,0:06:14.34,Default,Touma,0,0,0,,Đến tận lúc lên giường, tôi vẫn chằn chọc không yên.
Dialogue: 0,0:06:15.74,0:06:18.69,Default,Touma,0,0,0,,Chết tiệt, lỡ họ biết được thì sao nhỉ?
Dialogue: 0,0:06:20.25,0:06:22.81,Default,Touma,0,0,0,,Thôi kệ, giờ có lo quá cũng chẳng ích gì.
Dialogue: 0,0:06:23.27,0:06:26.20,Default,Touma,0,0,0,,Để ngày mai tùy cơ ứng biến.
Dialogue: 0,0:06:37.36,0:06:38.29,Default,Touma,0,0,0,,Vâng?
Dialogue: 0,0:06:39.83,0:06:41.89,Default,man,0,0,0,,Cậu dậy rồi ạ?
Dialogue: 0,0:06:41.89,0:06:44.39,Default,man,0,0,0,,Người nhà của cậu vừa gọi điện đến.
Dialogue: 0,0:06:44.87,0:06:47.57,Default,man,0,0,0,,Họ vừa xuống tàu và chuẩn bị lên đây.
Dialogue: 0,0:06:48.06,0:06:49.65,Default,Touma,0,0,0,,À, vâng!
Dialogue: 0,0:07:27.08,0:07:27.84,Default,Touya,0,0,0,,Touma!
Dialogue: 0,0:07:33.28,0:07:34.77,Default,Touya,0,0,0,,Trông được đấy.
Dialogue: 0,0:07:34.77,0:07:35.82,Default,Touya,0,0,0,,Khỏe không?
Dialogue: 0,0:07:37.19,0:07:38.46,Default,Touma,0,0,0,,Ba nữa...
Dialogue: 0,0:07:38.46,0:07:41.68,Default,Touya,0,0,0,,Phải rồi, có cái này...
Dialogue: 0,0:07:41.68,0:07:44.18,Default,Touya,0,0,0,,Hàng lưu niệm trong chuyến công tác Ấn độ.
Dialogue: 0,0:07:44.55,0:07:49.10,Default,Touya,0,0,0,,Ba quên tên mất rồi, nhưng nó là một vị thần của người Indu đấy.
Dialogue: 0,0:07:51.41,0:07:52.12,Default,Touma,0,0,0,,Cám ơn.
Dialogue: 0,0:07:53.56,0:07:54.32,Default,Touya,0,0,0,,Sao thế?
Dialogue: 0,0:07:54.32,0:07:56.85,Default,Touya,0,0,0,,Bộ lần đầu tiên con gặp ba hả?
Dialogue: 0,0:07:56.85,0:07:58.44,Default,Touma,0,0,0,,Eh, ah - không.
Dialogue: 0,0:07:58.44,0:08:00.19,Default,Touma,0,0,0,,À, đưa túi con xách cho.
Dialogue: 0,0:08:00.19,0:08:02.47,Default,Touya,0,0,0,,Còn mẹ con và Otohime-chan nữa.
Dialogue: 0,0:08:02.47,0:08:03.71,Default,Touya,0,0,0,,Họ sắp lên rồi.
Dialogue: 0,0:08:03.71,0:08:04.83,Default,Touya,0,0,0,,Đứng đợi ở đây thôi.
Dialogue: 0,0:08:10.19,0:08:12.31,Default,Touma,0,0,0,,Vậy ra đây là ba mình.
Dialogue: 0,0:08:12.69,0:08:14.58,Default,Touya,0,0,0,,À, xin lỗi nha.
Dialogue: 0,0:08:14.58,0:08:17.26,Default,Touya,0,0,0,,Thật ra ba định đến đây từ tối qua.
Dialogue: 0,0:08:17.26,0:08:20.64,Default,Touya,0,0,0,,Nhưng con biết đấy, do mới chuyển nhà nên còn bừa bộn quá.
Dialogue: 0,0:08:20.97,0:08:21.99,Default,Touma,0,0,0,,Chuyển nhà?
Dialogue: 0,0:08:21.99,0:08:23.06,Default,Touya,0,0,0,,Quên rồi hả?
Dialogue: 0,0:08:23.06,0:08:24.60,Default,Touya,0,0,0,,Ba mới gọi về tháng trước mà?
Dialogue: 0,0:08:24.60,0:08:25.79,Default,Touma,0,0,0,,À, vâng.
Dialogue: 0,0:08:27.79,0:08:29.00,Default,Touma,0,0,0,,Ra vậy.
Dialogue: 0,0:08:29.00,0:08:31.78,Default,Touma,0,0,0,,Mình còn chẳng nhớ mình sinh ra ở đâu nữa.
Dialogue: 0,0:08:32.35,0:08:33.71,Default,Touma,0,0,0,,Thôi, tính sau...
Dialogue: 0,0:08:34.10,0:08:35.91,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:08:36.64,0:08:37.41,Default,Touya,0,0,0,,Đến kìa.
Dialogue: 0,0:08:37.61,0:08:39.29,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:08:40.92,0:08:42.25,Default,Touma,0,0,0,,Kia là em họ mình.
Dialogue: 0,0:08:42.44,0:08:44.70,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:08:45.34,0:08:48.18,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:08:51.20,0:08:55.18,Default,Oto,0,0,0,,Ahh, Touma-oniichan! Em nhớ anh quá!
Dialogue: 0,0:08:56.63,0:08:57.91,Default,Oto,0,0,0,,Nè, Touma-oniichan!
Dialogue: 0,0:08:57.91,0:09:00.42,Default,Oto,0,0,0,,Lát nữa dẫn em ra biển nhé! Biển đó!
Dialogue: 0,0:09:00.42,0:09:02.48,Default,Oto,0,0,0,,Nè, được không?
Dialogue: 0,0:09:02.81,0:09:04.81,Default,Touma,0,0,0,,Đợi đó!
Dialogue: 0,0:09:05.22,0:09:06.55,Default,Oto,0,0,0,,Sao thế, Onii-chan?
Dialogue: 0,0:09:06.55,0:09:07.83,Default,Touma,0,0,0,,"Sao thế" cái búa á!
Dialogue: 0,0:09:07.83,0:09:09.35,Default,Touma,0,0,0,,Cô làm cái quái gì ở đây?
Dialogue: 0,0:09:09.35,0:09:11.95,Default,Touma,0,0,0,,Lại còn dở hơi đi đóng giả em gái tôi nữa!
Dialogue: 0,0:09:11.94,0:09:14.28,Default,Touma,0,0,0,,{\fs100\bord0\c&H000000&\fnUVN But Long 1\pos(572,88)}Em gái hay em dâu
Dialogue: 0,0:09:11.94,0:09:14.28,Default,Touma,0,0,0,,{\fs100\bord0\c&H000000&\fnUVN But Long 1\pos(1486,1006)}Đó là vấn đề cần giải quyết
Dialogue: 0,0:09:13.50,0:09:14.28,Default,Oto,0,0,0,,Cái gì cơ?
Dialogue: 0,0:09:14.49,0:09:15.43,Default,Touma,0,0,0,,Ba!
Dialogue: 0,0:09:15.43,0:09:17.70,Default,Touma,0,0,0,,Ba móc đâu ra con nhỏ này thế?
Dialogue: 0,0:09:17.70,0:09:19.41,Default,Touma,0,0,0,,Mà hai người quen nhau từ bao giờ?
Dialogue: 0,0:09:19.41,0:09:21.13,Default,Touya,0,0,0,,Cái gì mà "móc đâu ra"?
Dialogue: 0,0:09:21.13,0:09:22.43,Default,Touya,0,0,0,,Cái gì mà "từ bao giờ"?
Dialogue: 0,0:09:22.43,0:09:24.63,Default,Touya,0,0,0,,Đây là em gái con, Otohime-chan mà.
Dialogue: 0,0:09:28.49,0:09:29.71,Default,Touma,0,0,0,,Ngốc quá, Oi, tránh ra!
Dialogue: 0,0:09:29.71,0:09:30.35,Default,Touma,0,0,0,,Không đuợc đâu.
Dialogue: 0,0:09:30.35,0:09:30.95,Default,Touma,0,0,0,,Lưng tôi...
Dialogue: 0,0:09:30.95,0:09:32.07,Default,Touma,0,0,0,,Lưng đôi đang chạm vào...
Dialogue: 0,0:09:33.93,0:09:39.56,Default,Shiina,0,0,0,,{\fscx99}Touma-san thấy xấu hổ khi lâu ngày không được Otohime-chan ôm ấp kìa.{Touma-san, is being hugged by Otohime-chan embarrassing because you haven't experienced it in some time?}
Dialogue: 0,0:09:40.37,0:09:42.76,Default,Touma,0,0,0,,Nhóc con, mày làm gì ở đây?
Dialogue: 0,0:09:44.01,0:09:45.74,Default,Shiina,0,0,0,,Touma-san dạo này đúng là...
Dialogue: 0,0:09:45.04,0:09:47.91,Default-alt,Touma,0,0,0,,Là anh vừa thấy mày ngủ như con heo trong nhà trọ mà?!
Dialogue: 0,0:09:47.91,0:09:51.83,Default-alt,Touma,0,0,0,,Thay quần áo lẹ thế và biết xài Teleport, mày là ai, Shirai Kuroko hả?
Dialogue: 0,0:09:51.83,0:09:56.03,Default-alt,Touma,0,0,0,,Đã thế! Kiểu gì đấy! Ăn mặc và nói năng như bà già là sao?!
Dialogue: 0,0:09:56.03,0:09:57.04,Default,Touya,0,0,0,,Thôi ngay, Touma.
Dialogue: 0,0:09:57.73,0:09:59.11,Default,Touya,0,0,0,,Con làm gì đó?
Dialogue: 0,0:09:59.11,0:10:01.25,Default,Touya,0,0,0,,Ăn nói với mẹ con như thế à?
Dialogue: 0,0:10:03.09,0:10:06.69,Default,Touya,0,0,0,,Ba hỏi tại sao con dám ăn nói với mẹ con như thế?
Dialogue: 0,0:10:16.50,0:10:18.72,Default,Touma,0,0,0,,Ba... ba vừa nói...
Dialogue: 0,0:10:19.09,0:10:22.78,Default,Touma,0,0,0,,...rằng đứa nhóc với vẻ ngoài chưa đến 15 này...
Dialogue: 0,0:10:22.78,0:10:24.41,Default,Touma,0,0,0,,...là mẹ của con á?
Dialogue: 0,0:10:25.81,0:10:29.72,Default,Shiina,0,0,0,,Touma-san khen mẹ trẻ quá so với tuổi kìa.
Dialogue: 0,0:10:29.72,0:10:32.97,Default,Touma,0,0,0,,Nếu vậy thì... cái mụ biribiri ồn ào này...
Dialogue: 0,0:10:32.97,0:10:34.33,Default,Touma,0,0,0,,...là em của con á?
Dialogue: 0,0:10:34.33,0:10:36.21,Default,Shiina,0,0,0,,Biribiri là cái gì?
Dialogue: 0,0:10:36.21,0:10:39.07,Default,Touya,0,0,0,,Tất nhiên, họ là mẹ con và Otohime-chan.
Dialogue: 0,0:10:39.53,0:10:41.33,Default,Touya,0,0,0,,Rốt cuộc con bị làm sao, Touma?
Dialogue: 0,0:10:50.35,0:10:52.80,Default,Touma,0,0,0,,Các người điên hết rồi à?!
Dialogue: 0,0:10:53.43,0:10:55.01,Default,Touma,0,0,0,,Trò này là thế nào?!
Dialogue: 0,0:10:55.23,0:10:57.39,Default,Touma,0,0,0,,Cái bảng "Bạn đã bị lừa" của các người đâu?!
Dialogue: 0,0:10:57.39,0:11:00.89,Default,Touma,0,0,0,,Trà đạp lên tâm hồn một thằng con trai trong sáng như vầy!
Dialogue: 0,0:11:00.89,0:11:04.71,Default,Touma,0,0,0,,Tôi đã làm gì sai mà bị các người trừng phạt?!
Dialogue: 0,0:11:04.71,0:11:06.79,Default,Touya,0,0,0,,Đ-Đợi đã, bình tĩnh chút, Touma.
Dialogue: 0,0:11:06.79,0:11:08.40,Default,Touya,0,0,0,,Đây, nhìn nè.
Dialogue: 0,0:11:08.40,0:11:10.88,Default,Touya,0,0,0,,Cây bút nước hình cô gái mặc áo tắm.
Dialogue: 0,0:11:10.88,0:11:11.82,Default,Touya,0,0,0,,Xoay nó lại và...
Dialogue: 0,0:11:12.22,0:11:13.04,Default,Touma,0,0,0,,Vĩnh biệt!
Dialogue: 0,0:11:13.04,0:11:14.29,Default,Touya,0,0,0,,Đ-Đợi đã, Touma.
Dialogue: 0,0:11:14.29,0:11:16.00,Default,Touya,0,0,0,,Đang họp gia đình mà con định đi đâu?
Dialogue: 0,0:11:16.00,0:11:17.85,Default,Oto,0,0,0,,Đợi đã, Onii~chan!
Dialogue: 0,0:11:17.85,0:11:18.91,Default,Shiina,0,0,0,,Touma-san?
Dialogue: 0,0:11:19.23,0:11:20.75,Default,Touma,0,0,0,,Thích đùa zai hả?
Dialogue: 0,0:11:20.75,0:11:23.21,Default,Touma,0,0,0,,Thật không ngờ mình lại có một thằng bố dở hơi.
Dialogue: 0,0:11:23.59,0:11:25.21,Default,!MIS.,0,0,0,,Chào mừng.
Dialogue: 0,0:11:26.15,0:11:27.92,Default,!MIS.,0,0,0,,Chúng tôi đang đợi các vị.
Dialogue: 0,0:11:27.92,0:11:29.98,Default,!MIS.,0,0,0,,Nào, mời vào.
Dialogue: 0,0:11:31.00,0:11:32.90,Default,Touya,0,0,0,,Vâng, làm phiền cô.
Dialogue: 0,0:11:33.81,0:11:34.90,Default,Touya,0,0,0,,Sao thế, Touma?
Dialogue: 0,0:11:34.90,0:11:37.74,Default,Touma,0,0,0,,C-Cả cô cũng tham gia nữa hả, Em gái Misaka...?
Dialogue: 0,0:11:38.27,0:11:40.53,Default,Touma,0,0,0,,Rốt cuộc cô lẻn vào đây từ bao giờ?!
Dialogue: 0,0:11:42.37,0:11:45.04,Default,Touya,0,0,0,,À, xin đừng bận tâm.
Dialogue: 0,0:11:45.04,0:11:48.67,Default,Touya,0,0,0,,Thằng bé lâu ngày không gặp chúng tôi nên vui quá đó mà.
Dialogue: 0,0:11:48.67,0:11:51.39,Default,!Stiyl,0,0,0,,Cám ơn các vị đã chiếu cố đến cái nhà trọ tồi tàn này.
Dialogue: 0,0:11:52.63,0:11:54.61,Default,!Stiyl,0,0,0,,Tôi sẽ đưa các vị lên phòng.
Dialogue: 0,0:11:57.74,0:12:00.39,Default,!Stiyl,0,0,0,,Nào nào, mời theo lối này.
Dialogue: 0,0:12:01.82,0:12:05.37,Default,!Stiyl,0,0,0,,Oh, bạn của các vị cũng vừa dậy rồi nè.
Dialogue: 0,0:12:11.42,0:12:14.17,Default,$%@$,0,0,0,,Ah, chào buổi sáng, Touma.
Dialogue: 0,0:12:14.17,0:12:16.17,Default,$%@$,0,0,0,,Mau đi ăn sáng nào.
Dialogue: 0,0:12:16.17,0:12:19.65,Default,Touma,0,0,0,,AHHHHHHHHHHHHH---
Dialogue: 0,0:12:36.52,0:12:38.72,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:12:38.72,0:12:40.77,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:12:43.30,0:12:44.86,Default,Touma,0,0,0,,Tôi, giờ đây,
Dialogue: 0,0:12:45.51,0:12:49.32,Default,Touma,0,0,0,,Đang giết thời gian với "Cô em gái" Misaka Mikoto trong bộ đồ bơi của học sinh tiểu học kia.
Dialogue: 0,0:12:49.65,0:12:52.70,Default,Touma,0,0,0,,Tất nhiên không phải tôi tự nguyện.
Dialogue: 0,0:12:52.70,0:12:54.04,Default,Touma,0,0,0,,Qué gì thế?!
Dialogue: 0,0:12:54.04,0:12:55.01,Default,,0,0,0,,{\alpha&HFF&}PLACEHOLDER
Dialogue: 0,0:12:55.01,0:12:57.04,Default,Touma,0,0,0,,Má mày, trêu tao hả?
Dialogue: 0,0:12:57.03,0:12:58.38,Default,Touya,0,0,0,,Đợi đã, bình tĩnh, Touma!
Dialogue: 0,0:12:58.38,0:13:00.10,Default,Stiyl,0,0,0,,Quý khách, làm ơn bình tĩnh.
Dialogue: 0,0:13:00.66,0:13:04.84,Default,Oto,0,0,0,,Những dịp thế này đừng làm mọi người mất vui chứ, Oniichan.
Dialogue: 0,0:13:04.84,0:13:07.20,Default,Touya,0,0,0,,Chúng ta sẽ cùng nhau vượt quá nhé.
Dialogue: 0,0:13:12.00,0:13:13.12,Default,Touma,0,0,0,,Xui xẻo.
Dialogue: 0,0:13:13.72,0:13:17.01,Default,Touma,0,0,0,,Rốt cuộc họ định làm trò hề này đến bao giờ?
Dialogue: 0,0:13:17.35,0:13:19.42,Default,Touma,0,0,0,,Đây chẳng thể gọi là "đùa" được nữa rồi.
Dialogue: 0,0:13:19.42,0:13:20.96,Default,Touya,0,0,0,,Bình tĩnh lại chưa, Touma?
Dialogue: 0,0:13:22.90,0:13:25.13,Default,Touya,0,0,0,,Tuy không biết con đang lo chuyện gì, nhưng mà...
Dialogue: 0,0:13:26.30,0:13:27.89,Default,Touya,0,0,0,,Đây, cho con đó.
Dialogue: 0,0:13:27.89,0:13:30.33,Default,Touya,0,0,0,,Quà lưu niệm trong chuyến công tác Nga.
Dialogue: 0,0:13:34.18,0:13:35.72,Default,Touya,0,0,0,,Đó, hay không?
Dialogue: 0,0:13:35.72,0:13:37.56,Default,Touma,0,0,0,,Chẳng thấy hay chỗ nào hết á.
Dialogue: 0,0:13:41.00,0:13:44.84,Default,Shiina,0,0,0,,Khẩu vị của Touma-san coi bộ không hợp với khẩu vị của ông xã rồi.
Dialogue: 0,0:13:45.04,0:13:46.93,Default,Touma,0,0,0,,B-Bà già... cái này...
Dialogue: 0,0:13:46.93,0:13:48.29,Default,Touya,0,0,0,,Ôi, bà xã...
Dialogue: 0,0:13:48.29,0:13:50.23,Default,Touya,0,0,0,,Trông hợp với em quá.
Dialogue: 0,0:13:50.23,0:13:52.43,Default,Touya,0,0,0,,Ông xã thật sáng suốt khi đã chọn bộ này.
Dialogue: 0,0:13:53.22,0:13:55.25,Default,Touma,0,0,0,,Đây là bikini ông mua hả?!
Dialogue: 0,0:13:55.25,0:13:56.98,Default,Touma,0,0,0,,Đây là khẩu vị của ông hả?!
Dialogue: 0,0:13:56.98,0:13:57.74,Default,Touya,0,0,0,,Uhm!
Dialogue: 0,0:13:57.74,0:13:59.64,Default,Touya,0,0,0,,Khi đi công tác nhiều,
Dialogue: 0,0:13:59.64,0:14:02.65,Default,Touya,0,0,0,,Con sẽ thấy phụ nữ Nhật Bản cần cái gì thật tinh tế như...
Dialogue: 0,0:14:02.65,0:14:04.69,Default,Touya,0,0,0,,Con làm gì thế, Touma?
Dialogue: 0,0:14:04.90,0:14:06.69,Default,Touma,0,0,0,,Giờ thì tôi đã rõ!
Dialogue: 0,0:14:06.69,0:14:08.75,Default,Touma,0,0,0,,Ông già tôi là một kẻ thất bại!
Dialogue: 0,0:14:08.75,0:14:11.03,Default,Touma,0,0,0,,Là một gã biến thái đáng khinh!
Dialogue: 0,0:14:19.19,0:14:20.67,Default,Touya,0,0,0,,À, đến rồi kìa.
Dialogue: 0,0:14:20.67,0:14:22.26,Default,Touya,0,0,0,,Bạn con...
Dialogue: 0,0:14:22.26,0:14:24.09,Default,$%@$,0,0,0,,Tou~ma!
Dialogue: 0,0:14:26.02,0:14:28.08,Default,$%@$,0,0,0,,Touma!
Dialogue: 0,0:14:28.08,0:14:30.64,Default,Oto,0,0,0,,Onii-chan, anh đi đâu thế?
Dialogue: 0,0:14:30.64,0:14:31.80,Default,Shiina,0,0,0,,Touma-san!
Dialogue: 0,0:14:31.80,0:14:32.72,Default,Touma,0,0,0,,Im mồm!
Dialogue: 0,0:14:36.30,0:14:37.69,Default,tv,0,0,0,,Tin tiếp theo.
Dialogue: 0,0:14:37.69,0:14:40.06,Default,tv,0,0,0,,Vụ bê bối chính trị vừa rồi đã làm rung chuyển cả Nhà Trắng,
Dialogue: 0,0:14:40.23,0:14:45.13,Default,tv,0,0,0,,Ngài Tổng Thống sẽ chủ trì cuộc tọa đàm để công khai giải thích vấn đề này.
Dialogue: 0,0:14:44.10,0:14:46.42,Default-alt,Touma,0,0,0,,Ông bác sĩ làm gì thế kia?
Dialogue: 0,0:14:46.56,0:14:48.17,Default,Komori,0,0,0,,Trực tiếp từ Washington, phóng viên Komori.
Dialogue: 0,0:14:49.05,0:14:50.60,Default,Komori,0,0,0,,Rất nhiều phóng viên đã có mặt tại quảng trường....
Dialogue: 0,0:14:50.60,0:14:53.24,Default,Komori,0,0,0,,Để nghe lời phân trần của ngài Tổng Thống...\N
Dialogue: 0,0:14:53.24,0:14:56.61,Default,Komori,0,0,0,,Liệu chúng ta có nhận được câu trả lời thích đáng không?
Dialogue: 0,0:14:55.73,0:14:57.48,Default-alt,Touma,0,0,0,,Cô làm cái quái gì thế, Sensei?!
Dialogue: 0,0:14:57.82,0:14:59.66,Default-alt,!Mis,0,0,0,,Nè, tôi không xem được.
Dialogue: 0,0:14:58.50,0:14:59.77,Default,Komori,0,0,0,,Ngài Tổng Thống đang bước ra.
Dialogue: 0,0:15:00.26,0:15:02.03,Default,Komori,0,0,0,,Với một vẻ mặt đầy tự tin.
Dialogue: 0,0:15:02.89,0:15:05.63,Default,!Kuro,0,0,0,,Yes, we can!
Dialogue: 0,0:15:06.36,0:15:08.38,Default,Touma,0,0,0,,Qué gì thế kia... Shirai Kuroko?!
Dialogue: 0,0:15:08.38,0:15:09.64,Default,Touma,0,0,0,,Đợi đã...
Dialogue: 0,0:15:09.64,0:15:11.62,Default,Touma,0,0,0,,Rõ ràng có gì đó không ổn.
Dialogue: 0,0:15:11.62,0:15:13.80,Default,Touma,0,0,0,,Một trò đùa không thể được chuẩn bị công phu thế này.
Dialogue: 0,0:15:13.80,0:15:16.89,Default,Touma,0,0,0,,Hơn nữa, nước Mĩ cách đây những mấy vạn dặm.
Dialogue: 0,0:15:17.37,0:15:19.01,Default,Touma,0,0,0,,Nhưng nếu không phải đùa...
Dialogue: 0,0:15:20.33,0:15:21.87,Default,men,0,0,0,,Xin hãy ghé thăm...
Dialogue: 0,0:15:21.87,0:15:23.06,Default,men,0,0,0,,Xin hãy ghé thăm...
Dialogue: 0,0:15:23.32,0:15:26.38,Default,police,0,0,0,,Chỗ đó hả, bác đi thẳng đường này cho đến khi gặp một...
Dialogue: 0,0:15:26.38,0:15:27.86,Default,oldota,0,0,0,,Shana-tan, moe...
Dialogue: 0,0:15:28.10,0:15:29.85,Default,oldho,0,0,0,,Lũ người này ồn ào quá.
Dialogue: 0,0:15:29.85,0:15:31.53,Default,...,0,0,0,,Không thích thì đừng để ý.
Dialogue: 0,0:15:31.53,0:15:32.74,Default,Touma,0,0,0,,Sao lại thế này?
Dialogue: 0,0:15:32.74,0:15:34.39,Default,Touma,0,0,0,,Rốt cuộc đang xảy ra chuyện gì?
Dialogue: 0,0:15:34.77,0:15:36.55,Default,Oto,0,0,0,,Onii~chan!
Dialogue: 0,0:15:36.55,0:15:37.77,Default,Touma,0,0,0,,Oi...
Dialogue: 0,0:15:37.77,0:15:39.10,Default,Oto,0,0,0,,Nè, nhìn đi.
Dialogue: 0,0:15:39.10,0:15:40.95,Default,Oto,0,0,0,,Tấm hình ta chụp chung tết năm ngoái đó.
Dialogue: 0,0:15:41.23,0:15:44.71,Default,Oto,0,0,0,,Vậy đã đủ làm anh nhớ ra em chưa, Touma-oniichan?
Dialogue: 0,0:15:45.84,0:15:47.41,Default,Oto,0,0,0,,Sao thế?
Dialogue: 0,0:15:47.41,0:15:49.83,Default,Oto,0,0,0,,Hôm nay Onii-chan lạ quá à.
Dialogue: 0,0:15:49.83,0:15:51.30,Default,Touma,0,0,0,,Em nói gì cơ?
Dialogue: 0,0:15:51.30,0:15:53.47,Default,Touma,0,0,0,,Con nhóc này là em gái anh á?
Dialogue: 0,0:15:53.75,0:15:55.13,Default,Oto,0,0,0,,Đúng, chính là em!
Dialogue: 0,0:15:55.13,0:15:56.99,Default,Oto,0,0,0,,Tatsugami Otohime!
Dialogue: 0,0:15:56.99,0:16:01.04,Default,Touma,0,0,0,,Con bé không nhận ra sự khác giữa mình và bức ảnh sao?
Dialogue: 0,0:16:03.85,0:16:05.31,Default,Touma,0,0,0,,Thế này là thế nào?
Dialogue: 0,0:16:05.31,0:16:08.70,Default,Touma,0,0,0,,Vẻ ngoài của mọi người bị tráo đổi tùm lum hết trơn.
Dialogue: 0,0:16:09.29,0:16:11.88,Default,Touma,0,0,0,,Và hình như chẳng ai nhận ra cả.
Dialogue: 0,0:16:12.25,0:16:13.47,Default,Touma,0,0,0,,Tại sao?
Dialogue: 0,0:16:24.43,0:16:26.29,Default,Touma,0,0,0,,Kamijou Touma biết.
Dialogue: 0,0:16:26.29,0:16:28.20,Default,Touma,0,0,0,,Anh ta biết qua kinh nghiệm của mình.
Dialogue: 0,0:16:28.20,0:16:29.65,Default,Touma,0,0,0,,Tuy không nhớ, nhưng mà...
Dialogue: 0,0:16:29.65,0:16:34.17,Default,Touma,0,0,0,,Những nguời mặc cosplay dở hơi giữa đuờng thế này luôn luôn là người quen của anh ta.
Dialogue: 0,0:16:34.49,0:16:35.99,Default,Touma,0,0,0,,Và trong trường hợp này...
Dialogue: 0,0:16:35.99,0:16:37.83,Default,Touma,0,0,0,,Thái độ của anh ta sẽ là...
Dialogue: 0,0:16:38.49,0:16:39.39,Default,Touma,0,0,0,,Yô, lâu quá không gặp...
Dialogue: 0,0:16:39.63,0:16:40.17,Default,Touma,0,0,0,,Í...
Dialogue: 0,0:16:40.75,0:16:42.77,Default,Misha,0,0,0,,Câu hỏi 1 - Cậu là "Chủ ma thuật"?
Dialogue: 0,0:16:44.01,0:16:45.14,Default,Misha,0,0,0,,Lặp lại câu hỏi 1.
Dialogue: 0,0:16:45.84,0:16:46.94,Default,Misha,0,0,0,,Cậu là "Chủ ma thuật"?
Dialogue: 0,0:16:49.05,0:16:50.30,Default,Kaori,0,0,0,,Đợi đã.
Dialogue: 0,0:16:50.30,0:16:52.53,Default,Kaori,0,0,0,,Còn quá sớm để nói chàng trai đó là thủ phạm.
Dialogue: 0,0:16:53.68,0:16:56.86,Default,Tsuchi,0,0,0,,Hô, may mà chúng ta đến kịp.
Dialogue: 0,0:16:56.86,0:16:58.33,Default,Touma,0,0,0,,Tsuchimikado!
Dialogue: 0,0:16:58.66,0:17:02.60,Default,Tsuchi,0,0,0,,Trong mắt cậu ấy tôi vẫn là Tsuchimikado Motoharu kìa.
Dialogue: 0,0:17:02.60,0:17:03.41,Default,Kaori,0,0,0,,Ừ.
Dialogue: 0,0:17:03.41,0:17:07.41,Default,Kaori,0,0,0,,Nhưng mà... cậu ấy nhận ra cậu tức là...
Dialogue: 0,0:17:07.41,0:17:08.74,Default,Tsuchi,0,0,0,,Không, không, Neechin.
Dialogue: 0,0:17:08.74,0:17:11.75,Default,Tsuchi,0,0,0,,Trên người Kami-yan làm gì có dấu phong ấn nào.
Dialogue: 0,0:17:12.58,0:17:15.56,Default,Kaori,0,0,0,,Cậu ấy cũng giống chúng ta, những người không bị ma thuật tác động.
Dialogue: 0,0:17:16.37,0:17:19.71,Default,Kaori,0,0,0,,Tôi là pháp sư của Thuần Anh Giáo Hội - Necessarius,
Dialogue: 0,0:17:19.71,0:17:20.72,Default,Kaori,0,0,0,,Kanzaki Kaori.
Dialogue: 0,0:17:21.87,0:17:23.99,Default,Kaori,0,0,0,,Mục đích của tôi cũng như cô.
Dialogue: 0,0:17:23.99,0:17:26.05,Default,Kaori,0,0,0,,Đến tìm hiểu nguyên nhân của sự cố này.
Dialogue: 0,0:17:26.05,0:17:29.16,Default,Kaori,0,0,0,,Tuy nhiên thật vô lý khi lập tức khẳng định cậu ta là thủ phạm.
Dialogue: 0,0:17:32.96,0:17:35.70,Default,Misha,0,0,0,,Pháp sư của Chính Thống Nga Giáo Hội - Annihilatus,
Dialogue: 0,0:17:35.70,0:17:36.69,Default,Misha,0,0,0,,Misha Kreuzhev. {anyone know russian names?}
Dialogue: 0,0:17:36.96,0:17:42.30,Default,Tsuchi,0,0,0,,Wow, chúng ta có một pháp sư của Annihilatus ở đây kìa!
Dialogue: 0,0:17:42.30,0:17:45.86,Default,Misha,0,0,0,,Câu hỏi 1 - Có gì chứng tỏ cậu ta không phải "Chủ ma thuật"?
Dialogue: 0,0:17:45.86,0:17:49.21,Default,Misha,0,0,0,,Câu hỏi 2 - Nếu không phải cậu ta, vậy là ai?
Dialogue: 0,0:17:49.39,0:17:52.07,Default,Touma,0,0,0,,Nãy giờ tôi không hiểu gì hết trơn á!
Dialogue: 0,0:17:52.07,0:17:54.42,Default,Touma,0,0,0,,Mà còn nữa, sao Tsuchimikado lại ở đây?!
Dialogue: 0,0:17:55.13,0:17:58.12,Default,Kaori,0,0,0,,Chàng trai đó không phải pháp sư, mà là siêu năng lực gia.
Dialogue: 0,0:17:58.12,0:17:59.58,Default,Kaori,0,0,0,,Hơn nữa Level của cậu ta là...
Dialogue: 0,0:17:59.58,0:18:02.68,Default,Touma,0,0,0,,Này các người, cố tình làm ngơ cái gã vừa suýt bị giết như tôi hả?
Dialogue: 0,0:18:02.68,0:18:03.74,Default,Touma,0,0,0,,Cố tình làm ngơ hả?
Dialogue: 0,0:18:04.57,0:18:05.95,Default,Kaori,0,0,0,,Thật nhức đầu.
Dialogue: 0,0:18:05.95,0:18:08.99,Default,Kaori,0,0,0,,Vẫn cái kiểu ăn nói thỗ lỗ thiếu suy nghĩ.
Dialogue: 0,0:18:08.99,0:18:10.98,Default,Kaori,0,0,0,,Cậu chẳng trưởng thành lên tí nào.
Dialogue: 0,0:18:12.18,0:18:13.95,Default,Touma,0,0,0,,Đúng là cô ấy có quen mình.
Dialogue: 0,0:18:14.81,0:18:16.55,Default,Touma,0,0,0,,Vậy thì diễn kịch tiếp nào.
Dialogue: 0,0:18:16.98,0:18:20.88,Default,Touma,0,0,0,,Ít nhất cũng cho tôi biết chuyện này là thế nào chứ,
Dialogue: 0,0:18:20.88,0:18:22.61,Default,Touma,0,0,0,,Hế? Kanzaki?
Dialogue: 0,0:18:22.61,0:18:23.73,Default,Kaori,0,0,0,,Được thôi.
Dialogue: 0,0:18:24.12,0:18:26.59,Default,Kaori,0,0,0,,Cho những người liên quan biết là cách tốt nhất,
Dialogue: 0,0:18:26.59,0:18:28.04,Default,Kaori,0,0,0,,Bằng không sẽ rất khó làm việc.
Dialogue: 0,0:18:28.24,0:18:29.54,Default,Touma,0,0,0,,Người liên quan?
Dialogue: 0,0:18:29.54,0:18:30.40,Default,Touma,0,0,0,,Tôi á?
Dialogue: 0,0:18:32.28,0:18:35.75,Default,Kaori,0,0,0,,Gần đây, thế giới bỗng bị bao phủ bởi một loại ma thuật lạ...
Dialogue: 0,0:18:36.07,0:18:38.15,Default,Kaori,0,0,0,,Với công thức và ngôn ngữ chưa xác định.
Dialogue: 0,0:18:38.77,0:18:42.81,Default,Kaori,0,0,0,,Để tiện thảo luận, chúng tôi gọi nó là Angel Fall.
Dialogue: 0,0:18:42.81,0:18:44.26,Default,Touma,0,0,0,,Angel Fall?
Dialogue: 0,0:18:44.26,0:18:47.22,Default,Kaori,0,0,0,,Đã từng nghe "Sephiroth Tree" bao giờ chưa?
Dialogue: 0,0:18:47.96,0:18:51.45,Default,Kaori,0,0,0,,Đó là biểu đồ phân cấp sinh linh...
Dialogue: 0,0:18:51.45,0:18:53.75,Default,Kaori,0,0,0,,...Từ Đấng tối cao, Thiên thần cho đến con người.
Dialogue: 0,0:18:54.41,0:18:57.67,Default,Kaori,0,0,0,,Theo lẽ thường, con người không thể trở thành Thiên thần.
Dialogue: 0,0:18:57.67,0:18:59.74,Default,Kaori,0,0,0,,Và Thiên thần cũng không thể làm điều tương tự.
Dialogue: 0,0:19:00.03,0:19:03.20,Default,Tsuchi,0,0,0,,Nói cách khác thì tất cả cấp độ đều đã được cố định.
Dialogue: 0,0:19:03.49,0:19:06.74,Default,Kaori,0,0,0,,Tuy nhiên, nếu Thiên thần rớt xuống cấp độ con người thì...
Dialogue: 0,0:19:06.74,0:19:07.66,Default,Touma,0,0,0,,Time out!
Dialogue: 0,0:19:07.83,0:19:09.36,Default,Touma,0,0,0,,Time out chút đã!
Dialogue: 0,0:19:09.69,0:19:12.17,Default,Kaori,0,0,0,,Biết ngay mà, không hiểu hả?
Dialogue: 0,0:19:12.17,0:19:16.40,Default,Touma,0,0,0,,Ai ya, nhưng mà... rốt cuộc Thiên thần là thế nào?
Dialogue: 0,0:19:16.40,0:19:20.88,Default,Tsuchi,0,0,0,,Cậu cũng thấy rồi đó Kami-yan, kết quả của loại ma thuật này.
Dialogue: 0,0:19:20.88,0:19:21.51,Default,Touma,0,0,0,,Kết quả?
Dialogue: 0,0:19:22.71,0:19:24.76,Default,Tsuchi,0,0,0,,Thì là tráo đổi hình dạng.
Dialogue: 0,0:19:25.04,0:19:27.64,Default,Tsuchi,0,0,0,,Nó đang làm cả thế giới điên đảo.
Dialogue: 0,0:19:27.64,0:19:29.87,Default,Tsuchi,0,0,0,,Tác động do Thiên thần gây ra...
Dialogue: 0,0:19:29.87,0:19:33.62,Default,Tsuchi,0,0,0,,Khiến "bên ngoài" lẫn "bên trong" của mọi người trên thế giới bị tráo đổi tùm tum.
Dialogue: 0,0:19:33.62,0:19:36.48,Default,Tsuchi,0,0,0,,Cũng như Game "cướp ghế" dựa trên nguyên tắc "Đến trước được trước".
Dialogue: 0,0:19:36.48,0:19:39.46,Default,Tsuchi,0,0,0,,"Bên ngoài" sẽ nhanh chóng thế chỗ "Bên trong"
Dialogue: 0,0:19:39.46,0:19:40.15,Default,Tsuchi,0,0,0,,Đó là kết quả.
Dialogue: 0,0:19:40.37,0:19:43.04,Default,Touma,0,0,0,,Vậy... mọi người đều bị thay đổi "bên ngoài" tức là...
Dialogue: 0,0:19:43.04,0:19:47.81,Default,Tsuchi,0,0,0,,Khi chưa biết ai đã làm phép và với lý do gì,
Dialogue: 0,0:19:47.81,0:19:51.18,Default,Tsuchi,0,0,0,,Cái quan trọng nhất là phải tìm ra trung tâm của vấn đề.
Dialogue: 0,0:19:51.18,0:19:53.22,Default,Tsuchi,0,0,0,,Kami-yan, chính là cậu.
Dialogue: 0,0:19:54.47,0:19:57.58,Default,Kaori,0,0,0,,Cậu là đối tượng đáng nghi nhất của sự cố Angel Fall.
Dialogue: 0,0:19:57.91,0:20:00.11,Default,Kaori,0,0,0,,Cậu không bị ma thuật tác động.
Dialogue: 0,0:20:00.11,0:20:02.41,Default,Kaori,0,0,0,,Với những người trong giới ma thuật...
Dialogue: 0,0:20:02.41,0:20:04.38,Default,Kaori,0,0,0,,Họ sẽ nhắm vô cậu trước tiên.
Dialogue: 0,0:20:04.38,0:20:09.14,Default,Kaori,0,0,0,,Nhưng tôi đã nói, Kamijou Touma không thể là thủ phạm.
Dialogue: 0,0:20:09.14,0:20:12.19,Default,Kaori,0,0,0,,Thứ nhất, cậu ta không biết ma thuật.
Dialogue: 0,0:20:12.19,0:20:18.88,Default,Kaori,0,0,0,,Thứ hai, trên người cậu ta không có dấu vết của phong ấn giúp siêu năng lực gia sử dụng ma thuật.
Dialogue: 0,0:20:19.80,0:20:23.61,Default,Misha,0,0,0,,Phản biện 1 - Tại sao cậu ta không bị ma thuật tác động?
Dialogue: 0,0:20:23.80,0:20:30.74,Default,Tsuchi,0,0,0,,Nói sao nhỉ, Kamiyan là Imagine Breaker, với cánh tay phải có thể xóa bỏ mọi loại sức mạnh bất thường trên thế giới.
Dialogue: 0,0:20:30.74,0:20:31.65,Default,Touma,0,0,0,,Ra vậy...
Dialogue: 0,0:20:31.65,0:20:32.56,Default,Touma,0,0,0,,Thảo nào...
Dialogue: 0,0:20:34.01,0:20:37.00,Default,Touma,0,0,0,,Tsuchimikado, làm sao cậu biết?
Dialogue: 0,0:20:37.24,0:20:41.05,Default,Misha,0,0,0,,Giá trị - 40, 9, 30, 7.
Dialogue: 0,0:20:41.05,0:20:42.50,Default,Misha,0,0,0,,Công thức số 86.
Dialogue: 0,0:20:44.01,0:20:48.05,Default,Misha,0,0,0,,Tương đương - "Nước O' hóa thân thành mãng xà và lướt đi như thanh kiếm."
Dialogue: 0,0:20:54.83,0:20:55.86,Default,Misha,0,0,0,,Chính xác.
Dialogue: 0,0:20:55.86,0:20:59.55,Default,Misha,0,0,0,,Tôi công nhận đây là bằng chứng ngoại phạm hoàn hảo.
Dialogue: 0,0:20:59.55,0:21:04.37,Default,Misha,0,0,0,,Chàng trai, xin lỗi đã chĩa kiếm vào cậu khi chưa tìm hiểu kỹ vẫn đề.
Dialogue: 0,0:21:06.27,0:21:07.46,Default,Tsuchi,0,0,0,,Nào nào.
Dialogue: 0,0:21:07.46,0:21:08.74,Default,Tsuchi,0,0,0,,Tuy không phải thủ phạm,
Dialogue: 0,0:21:08.74,0:21:12.53,Default,Tsuchi,0,0,0,,Nhưng Kami-yan vẫn là trung tâm của vụ Angel Fall.
Dialogue: 0,0:21:12.53,0:21:15.25,Default,Tsuchi,0,0,0,,Rất có thể "Chủ ma thuật" đang ở ngay cạnh Kami-yan thôi.
Dialogue: 0,0:21:15.57,0:21:19.58,Default,Kaori,0,0,0,,Một cá nhân không thể tạo ra một vùng ma thuật lớn như vậy.
Dialogue: 0,0:21:19.94,0:21:23.78,Default,Kaori,0,0,0,,Nhiều khả năng hắn đã sử dụng kết giới hoặc tế đàn.
Dialogue: 0,0:21:23.78,0:21:25.57,Default,Tsuchi,0,0,0,,Chúng ta cần phá hủy tế đàn...
Dialogue: 0,0:21:25.57,0:21:27.90,Default,Tsuchi,0,0,0,,Hoặc tiêu diệt "Chủ ma thuật".
Dialogue: 0,0:21:27.90,0:21:31.08,Default,Tsuchi,0,0,0,,Đó là 2 cách để vô hiệu hóa Angel Fall.
Dialogue: 0,0:21:31.08,0:21:32.51,Default,Touma,0,0,0,,Đợi đã...
Dialogue: 0,0:21:33.14,0:21:35.43,Default,Touma,0,0,0,,Cậu là ai, Tsuchimikado?!
Dialogue: 0,0:21:35.43,0:21:37.40,Default,Touma,0,0,0,,Cậu thuộc phe nào trên thế giới này?!
Dialogue: 0,0:21:37.40,0:21:39.47,Default,Touma,0,0,0,,Tại sao cậu biết về cánh tay của tớ?!
Dialogue: 0,0:21:39.47,0:21:41.00,Default,Touma,0,0,0,,Trả lời đi, Tsuchimikado.
Dialogue: 0,0:21:43.10,0:21:45.16,Default,Tsuchi,0,0,0,,Chậm hiểu quá, Kami-yan.
Dialogue: 0,0:21:45.69,0:21:48.20,Default,Tsuchi,0,0,0,,Tớ cũng là một thành viên của Necessarius.
Dialogue: 0,0:23:25.42,0:23:27.92,Default,Touma,0,0,0,,Tìm kiếm người đã gây ra Angel Fall,
Dialogue: 0,0:23:27.92,0:23:30.26,Default,Touma,0,0,0,,Tôi và Tsuchimikado đã đến chỗ ba.
Dialogue: 0,0:23:30.26,0:23:32.13,Default,Touma,0,0,0,,Và điều chúng tôi tìm ra là...
Dialogue: 0,0:23:33.13,0:23:34.86,Default,Touma,0,0,0,,Kì tới, "Kamijou Touya".
Dialogue: 0,0:23:35.32,0:23:37.18,Default,Touma,0,0,0,,Khi khoa học và ma thuật gặp nhau,
Dialogue: 0,0:23:37.18,0:23:38.22,Default,Touma,0,0,0,,Bản anh hùng ca sẽ bắt đầu!
