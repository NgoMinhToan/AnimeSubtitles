Dialogue: 0,0:00:00.70,0:00:04.98,Default,Touma,0,0,0,,Index đang sở hữu 10 vạn 3 ngàn cuốn sách ma thuật?
Dialogue: 0,0:00:04.98,0:00:07.52,Default,Touma,0,0,0,,Tôi đã xử lý xong tên Pháp sư.
Dialogue: 0,0:00:07.52,0:00:09.07,Default,Touma,0,0,0,,Nhưng Index đang bị thương rất nặng.
Dialogue: 0,0:00:09.78,0:00:12.40,Default,Touma,0,0,0,,Vết thương có thể chữa khỏi bằng ma thuật.
Dialogue: 0,0:00:12.40,0:00:15.36,Default,Touma,0,0,0,,Nhưng học sinh tại Thành phố Học viện lại không thể sử dụng ma thuật.
Dialogue: 0,0:00:15.90,0:00:19.20,Default,Touma,0,0,0,,Trong trường hợp này, Kamoe-sensei, xin nhờ cô.
Dialogue: 0,0:01:50.38,0:01:55.88,Default,,0,0,0,,{\fad(800,800)\bord3\b0\fs80\fnUVN Van Chuong Nang\c&HE3E3E3&\pos(1492,826)}Necessarius
Dialogue: 0,0:01:51.41,0:01:55.95,Default,Index,0,0,0,,Có thể cho biết giờ chuẩn tại Nhật Bản lúc này không?
Dialogue: 0,0:01:56.68,0:01:59.02,Default,Index,0,0,0,,Xin đừng quên ngày tháng.
Dialogue: 0,0:01:59.34,0:02:02.80,Default,Komoe,0,0,0,,Ngày 20 tháng 7, 8 giờ 30 tối.
Dialogue: 0,0:02:04.93,0:02:06.85,Default,Index,0,0,0,,Tôi chưa thấy cô nhìn đồng hồ.
Dialogue: 0,0:02:07.16,0:02:09.22,Default,Index,0,0,0,,Có thể cho biết nguồn gốc của thông tin đó không?
Dialogue: 0,0:02:09.22,0:02:12.89,Default,Komoe,0,0,0,,Trước đến giờ cô không có để đồng hồ trong phòng.
Dialogue: 0,0:02:12.89,0:02:17.79,Default,Komoe,0,0,0,,Vì đồng hồ sinh học của cô hoạt động chính xác đến từng giây.
Dialogue: 0,0:02:18.14,0:02:24.22,Default,Komoe,0,0,0,,Loại đồng hồ này được điều chỉnh thông qua lịch tập thể dục và cách ăn kiêng.
Dialogue: 0,0:02:25.06,0:02:27.96,Default,Index,0,0,0,,Dựa vào vị trí của các vì sao và góc độ của mặt trăng...
Dialogue: 0,0:02:27.96,0:02:32.12,Default,Index,0,0,0,,Tương thích với Sao Thiên Cẩu, độ lệch 0.038...
Dialogue: 0,0:02:32.96,0:02:34.55,Default,Index,0,0,0,,Xin xác nhận lại lần cuối.
Dialogue: 0,0:02:34.86,0:02:40.79,Default,Index,0,0,0,,Cô có chắc tại Nhật bản lúc này là ngày 20 tháng 7, 8 giờ 30 phút tối không?
Dialogue: 0,0:02:40.79,0:02:45.39,Default,Komoe,0,0,0,,Vâng, chính xác hơn là 30 phút và 53 giây.
Dialogue: 0,0:02:46.17,0:02:48.38,Default,Komoe,0,0,0,,Đừng ngồi dậy, em đang bị thương mà...
Dialogue: 0,0:02:48.38,0:02:50.43,Default,Index,0,0,0,,Đừng lo, tôi có thể hồi phục.
Dialogue: 0,0:03:01.54,0:03:05.71,Default,Index,0,0,0,,Chu kì cuối của Chòm Cự Giải, từ 8 giờ tối đến 12 giờ đêm.
Dialogue: 0,0:03:05.71,0:03:07.09,Default,Index,0,0,0,,Về hướng Tây.
Dialogue: 0,0:03:07.40,0:03:09.02,Default,Index,0,0,0,,Người bảo vệ của Undine.
Dialogue: 0,0:03:09.02,0:03:10.87,Default,Index,0,0,0,,Thiên thần là Helheim.
Dialogue: 0,0:03:11.17,0:03:12.75,Default,Komoe,0,0,0,,Cái gì vậy?
Dialogue: 0,0:03:12.75,0:03:13.56,Default,Index,0,0,0,,Ma thuật.
Dialogue: 0,0:03:14.04,0:03:18.54,Default,Index,0,0,0,,Những gì tôi cần là bàn tay của cô và cơ thể của cô.
Dialogue: 0,0:03:19.37,0:03:21.41,Default,Index,0,0,0,,Nếu làm theo chỉ dẫn của tôi.
Dialogue: 0,0:03:21.41,0:03:23.33,Default,Index,0,0,0,,Sẽ không có gì đáng tiếc xảy ra.
Dialogue: 0,0:03:23.33,0:03:25.29,Default,Index,0,0,0,,Và cũng không ai ghét cô cả.
Dialogue: 0,0:03:25.29,0:03:28.63,Default,Komoe,0,0,0,,Em cứ nằm xuống nghỉ đi đã, xe cứu thương sắp tới rồi.
Dialogue: 0,0:03:28.63,0:03:31.22,Default,Komoe,0,0,0,,Coi nào... Bông băng... bông băng...
Dialogue: 0,0:03:31.22,0:03:36.16,Default,Index,0,0,0,,Các phương pháp thô sơ không có tác dụng với vết thương của tôi.
Dialogue: 0,0:03:36.16,0:03:38.59,Default,Index,0,0,0,,Tôi cũng không hiểu cụm từ "xe cứu thương".
Dialogue: 0,0:03:38.59,0:03:41.88,Default,Index,0,0,0,,Nhưng nó có thể chữa lành cái này trong 9 phút tới...
Dialogue: 0,0:03:41.88,0:03:46.92,Default,Index,0,0,0,,Đồng thời hồi phục nguồn sinh lực và ma lực đã mất cho tôi không?
Dialogue: 0,0:03:49.95,0:03:52.35,Default,Komoe,0,0,0,,Vậy... cô phải làm gì?
Dialogue: 0,0:03:52.35,0:03:55.12,Default,Komoe,0,0,0,,Cô không biết làm phép đâu.
Dialogue: 0,0:03:55.60,0:03:57.30,Default,Index,0,0,0,,Rất cảm ơn sự hợp tác.
Dialogue: 0,0:04:00.33,0:04:01.34,Default,Index,0,0,0,,Đầu tiên...
Dialogue: 0,0:04:02.72,0:04:05.39,Default,Index,0,0,0,,Kia là gì? Vật màu đen đó.
Dialogue: 0,0:04:07.84,0:04:10.26,Default,Komoe,0,0,0,,Đây là thẻ nhớ của game.
Dialogue: 0,0:04:11.65,0:04:14.42,Default,Index,0,0,0,,Xin hãy đặt nó vào giữa bàn.
Dialogue: 0,0:04:14.42,0:04:16.18,Default,Komoe,0,0,0,,Vào cái bàn ăn này hả?
Dialogue: 0,0:04:19.43,0:04:22.79,Default,Komoe,0,0,0,,Đây là... mô hình thu nhỏ của căn phòng phải không?
Dialogue: 0,0:04:23.11,0:04:24.98,Default,Index,0,0,0,,Chất liệu không quan trọng.
Dialogue: 0,0:04:24.98,0:04:26.94,Default,Index,0,0,0,,Chỉ cần vị trí và hình dạng tương thích,
Dialogue: 0,0:04:26.94,0:04:28.25,Default,Index,0,0,0,,Là có thể tiến hành nghi lễ.
Dialogue: 0,0:04:36.95,0:04:37.99,Default,Komoe,0,0,0,,Đây là?
Dialogue: 0,0:04:38.39,0:04:39.83,Default,Index,0,0,0,,Vị trí của những lon bia.
Dialogue: 0,0:04:40.56,0:04:44.79,Default,Index,0,0,0,,Vậy thì xin cô làm theo chính xác những gì tôi nói.
Dialogue: 0,0:04:44.79,0:04:47.09,Default,Index,0,0,0,,Chỉ cần mắc một sai làm nhỏ thôi...
Dialogue: 0,0:04:47.09,0:04:51.50,Default,Index,0,0,0,,Cũng khiến hệ thần kinh của cô bị hủy hoại.
Dialogue: 0,0:04:52.91,0:04:58.01,Default,Index,0,0,0,,Nói cách khác, cô sẽ nổ đầu mà chết nếu chúng ta thất bại.
Dialogue: 0,0:04:59.09,0:05:01.48,Default,Index,0,0,0,,Bắt đầu triệu hồi thiên thần để tạo vùng cữu rỗi.
Dialogue: 0,0:05:01.48,0:05:04.10,Default,Index,0,0,0,,Hát cùng tôi.
Dialogue: 0,0:05:40.11,0:05:41.27,Default,Index,0,0,0,,Liên kết thành công.
Dialogue: 0,0:05:42.57,0:05:43.60,Default,Komoe,0,0,0,,Liên kết?\N
Dialogue: 0,0:05:44.05,0:05:47.90,Default,Index,0,0,0,,Ngôi đền trên chiếc bàn đã liên kết thành công với căn phòng.
Dialogue: 0,0:05:48.62,0:05:51.44,Default,Index,0,0,0,,Những gì xảy ra với căn phòng sẽ xảy ra với chiếc bàn.
Dialogue: 0,0:05:52.37,0:05:55.48,Default,Index,0,0,0,,Những gì xảy ra với chiếc bàn cũng sẽ xảy ra với căn phòng.
Dialogue: 0,0:05:57.78,0:05:59.08,Default,Index,0,0,0,,Hãy tưởng tượng.
Dialogue: 0,0:05:59.08,0:06:00.66,Default,Komoe,0,0,0,,V-Vâng...
Dialogue: 0,0:06:00.66,0:06:02.12,Default,Index,0,0,0,,Một thiên thần bằng vàng.
Dialogue: 0,0:06:02.12,0:06:03.52,Default,Index,0,0,0,,Mang dáng hình một đứa trẻ.
Dialogue: 0,0:06:03.52,0:06:04.99,Default,Index,0,0,0,,Với đôi cánh trên lưng.
Dialogue: 0,0:06:04.99,0:06:06.93,Default,Index,0,0,0,,Đó là một thiên thần hoàn hảo.
Dialogue: 0,0:06:07.53,0:06:09.11,Default,Komoe,0,0,0,,Thiên thần...
Dialogue: 0,0:06:15.71,0:06:18.87,Default,Komoe,0,0,0,,\NNhưng tự nhiên bắt cô tưởng tượng ra thiên thần thì...
Dialogue: 0,0:06:26.04,0:06:28.94,Default,Index,0,0,0,,Thật ra chúng ta không triệu hồi một thiên thần.
Dialogue: 0,0:06:28.94,0:06:33.27,Default,Index,0,0,0,,Cô phải dùng chính trí tưởng tuợng của mình để tạo ra thiên thần đó.
Dialogue: 0,0:06:33.27,0:06:34.36,Default,Komoe,0,0,0,,V-Vâng!
Dialogue: 0,0:06:35.02,0:06:36.78,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:36.78,0:06:38.44,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:38.78,0:06:40.71,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:40.71,0:06:42.54,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:42.54,0:06:44.22,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:44.75,0:06:46.38,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:06:46.38,0:06:48.04,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:00.72,0:07:04.81,Default,Komoe,0,0,0,,Mình đã triệu hồi được một thiên thần? Phải không nhỉ?
Dialogue: 0,0:07:08.42,0:07:10.48,Default,Index,0,0,0,,Duy trì hình dạng thất bại.
Dialogue: 0,0:07:10.48,0:07:15.30,Default,Index,0,0,0,,Ít nhất, Undine màu xanh phải đủ sức mạnh để duy trì vùng cứu rỗi.
Dialogue: 0,0:07:16.10,0:07:17.01,Default,Index,0,0,0,,Làm lại nào.
Dialogue: 0,0:07:19.13,0:07:21.13,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:21.13,0:07:23.15,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:23.15,0:07:25.06,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:25.06,0:07:26.66,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:26.66,0:07:28.70,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:29.05,0:07:31.17,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:31.17,0:07:32.61,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:32.96,0:07:35.04,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:07:35.04,0:07:36.96,Default,Komoe,0,0,0,,Một thiên thần dễ thương.
Dialogue: 0,0:08:26.25,0:08:28.05,Default,Index,0,0,0,,Ma lực hồi phục thành công.
Dialogue: 0,0:08:28.05,0:08:30.41,Default,Index,0,0,0,,Tính mạng không còn bị đe dọa.
Dialogue: 0,0:08:30.41,0:08:32.44,Default,Index,0,0,0,,"Bút của Jouhana" chuyển về chế độ nghỉ. {ko dịch cái John's Pen Mode à?}
Dialogue: 0,0:08:37.97,0:08:39.46,Default,Komoe,0,0,0,,Có sao không?
Dialogue: 0,0:08:40.00,0:08:43.75,Default,Index,0,0,0,,Chỉ là mất sức trong quá trình chữa thương.
Dialogue: 0,0:08:43.75,0:08:46.45,Default,Index,0,0,0,,Nghỉ ngơi một chút là em sẽ ổn thôi.
Dialogue: 0,0:08:47.53,0:08:51.42,Default,Index,0,0,0,,Tốt quá rồi, em không phải làm phiền anh ấy nữa.
Dialogue: 0,0:08:51.42,0:08:53.50,Default,Komoe,0,0,0,,Làm phiền anh ấy?
Dialogue: 0,0:08:54.10,0:08:56.01,Default,Index,0,0,0,,Nếu em chết.
Dialogue: 0,0:08:56.01,0:08:59.09,Default,Index,0,0,0,,Nhất định anh ấy sẽ tự trách mình.
Dialogue: 0,0:09:00.09,0:09:04.66,Default,Komoe,0,0,0,,Em lo cho Kamijou-chan hơn chính bản thân em sao?
Dialogue: 0,0:09:07.88,0:09:09.02,Default,Index,0,0,0,,Em không biết.
Dialogue: 0,0:09:09.93,0:09:12.35,Default,Index,0,0,0,,Em cũng không hiểu vì sao...
Dialogue: 0,0:09:13.44,0:09:14.29,Default,Index,0,0,0,,Nhưng mà...
Dialogue: 0,0:09:25.63,0:09:26.66,Default,Touma,0,0,0,,Và thế là?
Dialogue: 0,0:09:27.09,0:09:31.22,Default,Touma,0,0,0,,Sao bộ Pajama của một người rượu chè hút sách tùm lum như Komoe-sensei...
Dialogue: 0,0:09:31.62,0:09:33.55,Default,Touma,0,0,0,,Lại vừa với em thế?
Dialogue: 0,0:09:34.00,0:09:36.48,Default,Touma,0,0,0,,Thiệt tình, trông như sinh đôi ý.
Dialogue: 0,0:09:38.19,0:09:40.10,Default,Index,0,0,0,,Đừng có coi thường em.
Dialogue: 0,0:09:40.39,0:09:44.39,Default,Index,0,0,0,,Bộ Pajama này còn hơi chật với ngực em đó nha.
Dialogue: 0,0:09:44.94,0:09:47.60,Default,Komoe,0,0,0,,E-Em sỉ nhục cô hả?
Dialogue: 0,0:09:48.16,0:09:49.46,Default,Index,0,0,0,,Nhưng mà...
Dialogue: 0,0:09:49.46,0:09:51.00,Default,Komoe,0,0,0,,Nhưng cái gì?
Dialogue: 0,0:09:51.00,0:09:52.71,Default,Index,0,0,0,,Không ạ...
Dialogue: 0,0:09:52.71,0:09:55.16,Default,Komoe,0,0,0,,Cô đã là người lớn rồi mà.
Dialogue: 0,0:09:55.83,0:09:57.84,Default,Komoe,0,0,0,,Dù sao thì Kamijou-chan.
Dialogue: 0,0:09:57.84,0:10:01.29,Default,Komoe,0,0,0,,Quan hệ của em với cô ta là gì?
Dialogue: 0,0:10:02.87,0:10:03.59,Default,Touma,0,0,0,,Em gái.
Dialogue: 0,0:10:05.41,0:10:07.10,Default,Komoe,0,0,0,,Đến nước này còn dám nói dối à?!
Dialogue: 0,0:10:07.10,0:10:10.26,Default,Komoe,0,0,0,,Cô ta thậm chí còn chẳng phải người Nhật nữa!
Dialogue: 0,0:10:05.41,0:10:07.80,Default-alt,Touma,0,0,0,,Em xin lỗi, em xin lỗi, em trót dại!
Dialogue: 0,0:10:07.80,0:10:10.26,Default-alt,Touma,0,0,0,,Em đã nói dối! Tha cho em!
Dialogue: 0,0:10:10.36,0:10:11.24,Default,Komoe,0,0,0,,Kamijou-chan!
Dialogue: 0,0:10:13.37,0:10:16.39,Default,Touma,0,0,0,,Sensei, hỏi một câu được không?
Dialogue: 0,0:10:16.81,0:10:17.69,Default,Komoe,0,0,0,,Desu?
Dialogue: 0,0:10:18.15,0:10:23.56,Default,Touma,0,0,0,,Cô hỏi vậy để báo cáo với ban lãnh đạo của Thành phố Học viện hả?
Dialogue: 0,0:10:23.56,0:10:24.36,Default,Komoe,0,0,0,,Tất nhiên.
Dialogue: 0,0:10:24.66,0:10:28.89,Default,Komoe,0,0,0,,Chưa cần biết Kamijou-chan và cô ta đang dính vào chuyện gì.
Dialogue: 0,0:10:28.89,0:10:31.66,Default,Komoe,0,0,0,,Nhưng nó đã xảy ra tại Thành phố Học viện,
Dialogue: 0,0:10:31.66,0:10:33.69,Default,Komoe,0,0,0,,Thì giáo viên phải đứng ra giải quyết.
Dialogue: 0,0:10:33.69,0:10:35.11,Default,Komoe,0,0,0,,Đó là trách nhiệm của người lớn.
Dialogue: 0,0:10:38.31,0:10:44.95,Default,Komoe,0,0,0,,Nếu biết Kamijou-chan và cô ta đang tiến vào chỗ nguy hiểm, Sensei sẽ không nhẫn tâm đứng nhìn đâu.
Dialogue: 0,0:10:45.87,0:10:49.16,Default,Touma,0,0,0,,Nếu Sensei là người lạ thì em cũng chả ngại gì.
Dialogue: 0,0:10:49.16,0:10:51.01,Default,Touma,0,0,0,,Nhưng Sensei đã giúp em quá nhiều.
Dialogue: 0,0:10:51.01,0:10:52.43,Default,Touma,0,0,0,,Đừng tiến sâu thêm nữa.
Dialogue: 0,0:10:54.33,0:10:59.57,Default,Komoe,0,0,0,,Đừng tưởng với mấy câu cool như thế thì sensei sẽ bỏ qua cho nhé.
Dialogue: 0,0:11:00.60,0:11:02.09,Default,Touma,0,0,0,,Ủa, cô đi đâu vậy?
Dialogue: 0,0:11:03.64,0:11:05.49,Default,Komoe,0,0,0,,Cho em thời gian suy nghĩ.
Dialogue: 0,0:11:05.49,0:11:08.77,Default,Komoe,0,0,0,,Sensei sẽ ra siêu thị mua đồ chuẩn bị cho bữa tối.
Dialogue: 0,0:11:09.19,0:11:14.70,Default,Komoe,0,0,0,,Khi trở về cô muốn nghe câu trả lời chính xác của Kamijou-chan.
Dialogue: 0,0:11:14.70,0:11:15.73,Default,Komoe,0,0,0,,Và...
Dialogue: 0,0:11:16.23,0:11:17.09,Default,Touma,0,0,0,,Và?
Dialogue: 0,0:11:17.53,0:11:22.00,Default,Komoe,0,0,0,,Sensei hay mải shopping mà quên chuyện lắm.
Dialogue: 0,0:11:22.44,0:11:27.81,Default,Komoe,0,0,0,,Nếu lúc đó không thấy cô hỏi gì,\N Kamijou-chan cũng phải tự giác khai ra nhé.
Dialogue: 0,0:11:47.96,0:11:49.38,Default,Index,0,0,0,,Cô ấy tốt quá nhỉ?
Dialogue: 0,0:11:50.42,0:11:52.17,Default,Touma,0,0,0,,Komoe-sensei hả?
Dialogue: 0,0:11:52.17,0:11:52.77,Default,Index,0,0,0,,Ừ.
Dialogue: 0,0:11:53.81,0:11:55.77,Default,Touma,0,0,0,,Không nên để sensei bị liên lụy.
Dialogue: 0,0:11:56.48,0:11:59.53,Default,Index,0,0,0,,Đúng, không nên để cô ấy sử dụng ma thuật nữa.
Dialogue: 0,0:12:00.78,0:12:03.19,Default,Index,0,0,0,,Sách ma thuật là thứ rất nguy hiểm.
Dialogue: 0,0:12:03.53,0:12:07.45,Default,Index,0,0,0,,Tuy mang trong mình những thông tin quý giá về quy luật của vạn vật.
Dialogue: 0,0:12:07.78,0:12:13.04,Default,Index,0,0,0,,Nhưng chúng thuộc về một thế giới khác, ở thế giới này, chúng là một liều thuốc độc không hơn không kém.
Dialogue: 0,0:12:13.04,0:12:14.38,Default,Touma,0,0,0,,Thuốc độc?
Dialogue: 0,0:12:15.86,0:12:17.82,Default,Index,0,0,0,,Không giống như các pháp sư,
Dialogue: 0,0:12:17.82,0:12:21.56,Default,Index,0,0,0,,Nếu con người của thế giới này sử dụng tri thức của thế giới khác.
Dialogue: 0,0:12:21.56,0:12:24.13,Default,Index,0,0,0,,Thì tâm trí họ sẽ bị hủy diệt.
Dialogue: 0,0:12:24.13,0:12:25.41,Default,Touma,0,0,0,,Hủy diệt?
Dialogue: 0,0:12:25.75,0:12:28.25,Default,Touma,0,0,0,,Ma thuật nguy hiểm như vậy sao?
Dialogue: 0,0:12:28.25,0:12:29.47,Default,Index,0,0,0,,Anh muốn biết không?
Dialogue: 0,0:12:30.73,0:12:34.02,Default,Index,0,0,0,,Muốn biết về gánh nặng em đang mang không?
Dialogue: 0,0:12:38.01,0:12:39.38,Default,Touma,0,0,0,,Nói sao đây nhỉ?
Dialogue: 0,0:12:39.96,0:12:42.19,Default,Touma,0,0,0,,Thấy anh giống cha sứ lắm hả?
Dialogue: 0,0:12:44.06,0:12:47.41,Default,Index,0,0,0,,Đúng thiệt, như em đang xưng tội với cha sứ vậy.
Dialogue: 0,0:12:50.62,0:12:52.96,Default,Index,0,0,0,,Cơ Đốc giáo vốn là một khối thống nhất.
Dialogue: 0,0:12:52.96,0:12:56.03,Default,Index,0,0,0,,Tại sao họ lại phân li, anh biết không?
Dialogue: 0,0:12:58.79,0:13:00.05,Default,Touma,0,0,0,,Tại vì...
Dialogue: 0,0:13:00.55,0:13:02.87,Default,Index,0,0,0,,Vì họ để chính trị ảnh hưởng đến tôn giáo.
Dialogue: 0,0:13:03.19,0:13:07.50,Default,Index,0,0,0,,Họ phân li, đối địch nhau, rồi đi theo những con đường khác nhau.
Dialogue: 0,0:13:08.39,0:13:10.82,Default,Index,0,0,0,,Dù họ đều có chung một niềm tin vào Chúa.
Dialogue: 0,0:13:10.82,0:13:15.17,Default,Index,0,0,0,,Mỗi chi nhánh phát triển theo một cách riêng và cũng có được những nét riêng.
Dialogue: 0,0:13:15.17,0:13:16.52,Default,Touma,0,0,0,,Nét riêng à?
Dialogue: 0,0:13:16.52,0:13:19.48,Default,Index,0,0,0,,Như em là người của Thuần Anh Giáo Hội.
Dialogue: 0,0:13:21.94,0:13:24.20,Default,Index,0,0,0,,Vì Anh Quốc là đất nước của ma thuật.
Dialogue: 0,0:13:24.20,0:13:26.24,Default,Index,0,0,0,,Nên có cả Phù Thủy lẫn Thập Tự Binh...
Dialogue: 0,0:13:26.24,0:13:30.30,Default,Index,0,0,0,,Họ nhiều lần tìm cách xóa sổ các Pháp Sư.
Dialogue: 0,0:13:30.61,0:13:34.57,Default,Index,0,0,0,,Thế nên, Thuần Anh Giáo Hội đã phát triển một chi nhánh đặc biệt.
Dialogue: 0,0:13:34.57,0:13:38.78,Default,Index,0,0,0,,Họ nghiên cứu ma thuật để chống lại những người sử dụng ma thuật.
Dialogue: 0,0:13:38.78,0:13:41.55,Default,Index,0,0,0,,Tổ chức tội ác cần thiết, Necessarius
Dialogue: 0,0:13:41.55,0:13:43.01,Default,Touma,0,0,0,,Necessarius?
Dialogue: 0,0:13:43.06,0:13:46.90,Default,Index,0,0,0,,Tuy nhiên, để hiểu được sự xấu xa của kẻ thù, trái tim ta phải trở nên xấu xa.
Dialogue: 0,0:13:46.90,0:13:49.54,Default,Index,0,0,0,,Khi tiếp xúc với sự xấu xa của kẻ thù, con người ta cũng trở nên xấu xa.
Dialogue: 0,0:13:49.98,0:13:53.06,Default,Index,0,0,0,,Tổ chức là tập hợp của những điều xấu xa.
Dialogue: 0,0:13:53.06,0:13:54.54,Default,Index,0,0,0,,Và điều xấu xa nhất là...
Dialogue: 0,0:13:56.21,0:13:58.45,Default,Touma,0,0,0,,10 vạn 3 ngàn cuốn sách?
Dialogue: 0,0:13:58.45,0:13:59.09,Default,Index,0,0,0,,Ừ.
Dialogue: 0,0:14:00.20,0:14:03.00,Default,Index,0,0,0,,Ma thuật cũng giống như một công thức.
Dialogue: 0,0:14:03.37,0:14:05.04,Default,Index,0,0,0,,Nếu áp dụng một cách chính xác.
Dialogue: 0,0:14:05.04,0:14:07.92,Default,Index,0,0,0,,Ta có thể hóa giải đòn tấn công của kẻ thù.
Dialogue: 0,0:14:08.49,0:14:10.40,Default,Index,0,0,0,,Biết sử dụng mọi ma thuật trên thế giới,
Dialogue: 0,0:14:10.40,0:14:13.52,Default,Index,0,0,0,,Đồng nghĩa với biết hóa giải mọi ma thuật trên thế giới.
Dialogue: 0,0:14:13.52,0:14:16.17,Default,Index,0,0,0,,Thế nên 10 vạn 3 ngàn cuốn sách ma thuật...
Dialogue: 0,0:14:17.30,0:14:18.42,Default,Touma,0,0,0,,Đã được nhồi vào đầu em?
Dialogue: 0,0:14:21.12,0:14:22.63,Default,Touma,0,0,0,,Nếu chúng nguy hiểm như vậy.
Dialogue: 0,0:14:22.63,0:14:24.46,Default,Touma,0,0,0,,Sao người ta không đốt quách luôn đi?
Dialogue: 0,0:14:25.13,0:14:28.17,Default,Index,0,0,0,,Cái quan trọng không phải cuốn sách mà là kiến thức chúng mang theo.
Dialogue: 0,0:14:28.17,0:14:29.54,Default,Index,0,0,0,,Dù sách bị đốt,
Dialogue: 0,0:14:29.54,0:14:32.32,Default,Index,0,0,0,,Kiến thức vẫn có thể được truyền miệng.
Dialogue: 0,0:14:32.32,0:14:34.95,Default,Index,0,0,0,,Và con người cũng không thể phá hủy bản gốc.
Dialogue: 0,0:14:35.77,0:14:38.77,Default,Index,0,0,0,,Hay chính xác hơn, là không đủ sức làm việc đó.
Dialogue: 0,0:14:39.32,0:14:43.55,Default,Index,0,0,0,,Thế nên phong ấn chúng lại là lựa chọn duy nhất.
Dialogue: 0,0:14:44.23,0:14:49.25,Default,Touma,0,0,0,,Nói cách khác, họ đang theo đuổi quả bom trong đầu em phải không?
Dialogue: 0,0:14:51.33,0:14:56.83,Default,Index,0,0,0,,10 vạn 3 ngàn cuốn sách, quá đủ để họ thôn tính cả thế giới.
Dialogue: 0,0:14:59.51,0:15:00.17,Default,Touma,0,0,0,,Em...
Dialogue: 0,0:15:01.38,0:15:04.65,Default,Touma,0,0,0,,Một chuyện quan trọng như vậy, sao không nói anh ngay từ đầu?!
Dialogue: 0,0:15:05.53,0:15:08.65,Default,Index,0,0,0,,Tại vì, em sợ anh sẽ không tin...
Dialogue: 0,0:15:08.65,0:15:10.37,Default,Index,0,0,0,,Em cũng không muốn dọa anh...
Dialogue: 0,0:15:10.37,0:15:12.00,Default,Index,0,0,0,,Và... Em...
Dialogue: 0,0:15:13.38,0:15:15.19,Default,Index,0,0,0,,Không muốn bị anh ghét...
Dialogue: 0,0:15:15.92,0:15:17.69,Default,Touma,0,0,0,,Vớ vẩn!
Dialogue: 0,0:15:17.69,0:15:19.08,Default,Touma,0,0,0,,Em coi anh là cái gì?
Dialogue: 0,0:15:19.08,0:15:22.15,Default,Touma,0,0,0,,Tổ chức tội ác cần thiết? Necessarius?
Dialogue: 0,0:15:22.15,0:15:24.09,Default,Touma,0,0,0,,10 vạn 3 ngàn cuốn sách ma thuật?
Dialogue: 0,0:15:24.50,0:15:26.11,Default,Touma,0,0,0,,Nghe thật nhảm nhí,
Dialogue: 0,0:15:26.11,0:15:27.80,Default,Touma,0,0,0,,Nói ra thì cũng chẳng ai tin.
Dialogue: 0,0:15:28.58,0:15:29.56,Default,Touma,0,0,0,,Nhưng rồi sao nào?
Dialogue: 0,0:15:30.54,0:15:31.94,Default,Touma,0,0,0,,Chúng đều có thật đúng không?
Dialogue: 0,0:15:36.03,0:15:37.68,Default,Touma,0,0,0,,Đừng coi thường anh.
Dialogue: 0,0:15:38.06,0:15:40.81,Default,Touma,0,0,0,,Chỉ là 10 vạn 3 ngàn cuốn sách thôi.
Dialogue: 0,0:15:40.81,0:15:43.10,Default,Touma,0,0,0,,Tưởng anh sẽ ghét em vì chuyện đó hả?
Dialogue: 0,0:15:44.23,0:15:46.58,Default,Touma,0,0,0,,Tin anh một chút đi.
Dialogue: 0,0:15:47.13,0:15:48.99,Default,Touma,0,0,0,,Đừng phán xét người ta một cách ích kỷ như thế.
Dialogue: 0,0:16:00.20,0:16:02.99,Default,Touma,0,0,0,,Coi nào, anh vẫn còn cánh tay này.
Dialogue: 0,0:16:02.99,0:16:04.76,Default,Touma,0,0,0,,Bọn pháp sư chả là gì hết.
Dialogue: 0,0:16:05.15,0:16:08.96,Default,Index,0,0,0,,Nhưng mà... tại anh nói anh phải học thêm nên...
Dialogue: 0,0:16:09.48,0:16:10.63,Default,Touma,0,0,0,,Có nói hả?
Dialogue: 0,0:16:11.21,0:16:12.14,Default,Index,0,0,0,,Chắc chắn là có.
Dialogue: 0,0:16:14.56,0:16:16.70,Default,Touma,0,0,0,,Quên việc học đi!
Dialogue: 0,0:16:17.18,0:16:20.27,Default,Index,0,0,0,,Thế? Sao anh lại nói anh phải đến trường?
Dialogue: 0,0:16:20.27,0:16:22.31,Default,Index,0,0,0,,Rằng anh có việc rồi.
Dialogue: 0,0:16:23.00,0:16:25.57,Default,Index,0,0,0,,Sự có mặt của em làm anh thấy khó chịu hả?
Dialogue: 0,0:16:25.65,0:16:27.04,Default,Index,0,0,0,,Thấy khó chịu hả?
Dialogue: 0,0:16:38.56,0:16:39.62,Default,Kaori,0,0,0,,Index sao rồi?
Dialogue: 0,0:16:40.18,0:16:41.27,Default,Stiyl,0,0,0,,Vẫn còn sống.
Dialogue: 0,0:16:41.93,0:16:45.46,Default,Kaori,0,0,0,,Tôi vừa đi kiểm tra thông tin về cậu ta.
Dialogue: 0,0:16:45.46,0:16:48.55,Default,Stiyl,0,0,0,,Thế? Cánh tay phải của hắn là gì?
Dialogue: 0,0:16:48.55,0:16:53.29,Default,Kaori,0,0,0,,Ít nhất, đó không phải ma thuật hay siêu năng lực.
Dialogue: 0,0:16:53.29,0:16:54.60,Default,Stiyl,0,0,0,,Gì cơ?
Dialogue: 0,0:16:54.60,0:16:57.98,Default,Stiyl,0,0,0,,Cô muốn nói hắn là một gã học sinh bình thường hả?
Dialogue: 0,0:16:59.64,0:17:00.97,Default,Stiyl,0,0,0,,Làm ơn đi.
Dialogue: 0,0:17:00.97,0:17:07.49,Default,Stiyl,0,0,0,,Ông Trời không thừa hơi tạo ra mấy thằng nghiệp dư chỉ để hóa giải sức mạnh của Innocentius đâu.
Dialogue: 0,0:17:07.98,0:17:09.12,Default,Kaori,0,0,0,,Đúng vậy.
Dialogue: 0,0:17:09.47,0:17:15.48,Default,Kaori,0,0,0,,Vấn đề ở đây là, sức mạnh của cậu ta chỉ được xếp vào mục "những học sinh vô dụng thích đánh nhau"
Dialogue: 0,0:17:16.50,0:17:19.83,Default,Stiyl,0,0,0,,Có lẽ thông tin đã bị làm nhiễu.
Dialogue: 0,0:17:20.21,0:17:23.87,Default,Stiyl,0,0,0,,Và vết thương của Index đã được chữa khỏi bằng ma thuật.
Dialogue: 0,0:17:24.79,0:17:29.87,Default,Stiyl,0,0,0,,Kanzaki, liệu có tổ chức ma thuật nào tại miền Đông xa xôi này không?
Dialogue: 0,0:17:30.58,0:17:32.56,Default,Kaori,0,0,0,,Nếu có trong phạm vi Thành phố Học viện,
Dialogue: 0,0:17:32.56,0:17:35.34,Default,Kaori,0,0,0,,Thì không thể thoát khỏi radar của chúng ta.
Dialogue: 0,0:17:36.65,0:17:38.63,Default,Kaori,0,0,0,,Lực lượng của kẻ thù là chưa rõ.
Dialogue: 0,0:17:38.63,0:17:40.55,Default,Kaori,0,0,0,,Chúng ta lại không được hỗ trợ.
Dialogue: 0,0:17:41.13,0:17:42.49,Default,Stiyl,0,0,0,,Con bé đang vui vẻ.
Dialogue: 0,0:17:43.97,0:17:45.94,Default,Stiyl,0,0,0,,Rất vui vẻ.
Dialogue: 0,0:17:46.59,0:17:48.90,Default,Stiyl,0,0,0,,Bọn trẻ trông lúc nào cũng vui vẻ.
Dialogue: 0,0:17:49.94,0:17:54.67,Default,Stiyl,0,0,0,,Chúng ta phải tiếp tục công việc đầy nước mắt này đến bao giờ đây?
Dialogue: 0,0:17:54.67,0:17:56.64,Default,Kaori,0,0,0,,Mềm lòng rồi hả?
Dialogue: 0,0:17:56.96,0:17:59.16,Default,Kaori,0,0,0,,\NĐó đã từng là vị trí của anh.
Dialogue: 0,0:18:00.95,0:18:02.53,Default,Stiyl,0,0,0,,Tôi đã quen rồi.
Dialogue: 0,0:18:04.54,0:18:08.06,Default,Touma,0,0,0,,Cuối cùng, khi Kamoe-sensei trở về...
Dialogue: 0,0:18:08.58,0:18:12.27,Default,Touma,0,0,0,,Cô không hỏi gì và cho phép chúng tôi ở lại căn hộ.
Dialogue: 0,0:18:13.25,0:18:15.22,Default,Touma,0,0,0,,Vì cô mải shopping mà quên mất...
Dialogue: 0,0:18:15.73,0:18:18.19,Default,Touma,0,0,0,,hay vì cô quyết định quên đi tất cả?
Dialogue: 0,0:18:18.77,0:18:20.15,Default,Touma,0,0,0,,Tôi cũng không muốn hỏi.
Dialogue: 0,0:18:22.29,0:18:24.46,Default,Index,0,0,0,,Đi tắm! Đi tắm!
Dialogue: 0,0:18:24.46,0:18:26.63,Default,Index,0,0,0,,Đi tắm~\N
Dialogue: 0,0:18:26.63,0:18:28.74,Default,Index,0,0,0,,Đi tắm! Đi tắm!
Dialogue: 0,0:18:28.74,0:18:30.77,Default,Index,0,0,0,,Đi tắm~
Dialogue: 0,0:18:36.09,0:18:38.82,Default,Index,0,0,0,,Touma! Touma! Touma!
Dialogue: 0,0:18:39.20,0:18:40.89,Default,Index,0,0,0,,Không có gì!
Dialogue: 0,0:18:40.89,0:18:44.44,Default,Index,0,0,0,,Gọi tên người khác cũng có cái vui của nó.
Dialogue: 0,0:18:44.44,0:18:45.58,Default,Index,0,0,0,,Nee, Touma?
Dialogue: 0,0:18:46.00,0:18:47.65,Default,Index,0,0,0,,Có chuyện này em muốn hỏi.
Dialogue: 0,0:18:48.72,0:18:50.24,Default,Index,0,0,0,,Cô Kamoe nói...
Dialogue: 0,0:18:50.76,0:18:52.62,Default,Komoe,0,0,0,,Trong phòng tắm công cộng của Nhật Bản.
Dialogue: 0,0:18:52.62,0:18:55.01,Default,Komoe,0,0,0,,Có phục vụ một thứ gọi là Café Sữa.
Dialogue: 0,0:18:55.09,0:18:56.05,Default,Komoe,0,0,0,,Thế này,
Dialogue: 0,0:18:56.18,0:18:57.43,Default,Komoe,0,0,0,,Thế này,
Dialogue: 0,0:18:57.51,0:19:00.34,Default,Komoe,0,0,0,,Đặt tay lên hông và uống như thế này! {WTF... mụ này dạy trẻ con kiểu quái gì thế? - That's the way she does. No comment}
Dialogue: 0,0:19:02.97,0:19:04.86,Default,Index,0,0,0,,Café sữa là gì? {ko cần biết đâu em - ok ok...}
Dialogue: 0,0:19:04.86,0:19:06.60,Default,Index,0,0,0,,Giống Capuchino không? {Không giống cả về hương vị lẫn mầu sắc =)) - Nói ko giống cũng ko hẳn, vị cũng ngòn ngọt... }
Dialogue: 0,0:19:06.93,0:19:09.50,Default,Touma,0,0,0,,Chẳng nơi nào phục vụ thứ thanh tao đó đâu.
Dialogue: 0,0:19:10.02,0:19:12.80,Default,Touma,0,0,0,,Nhưng có bất ngờ cho em đấy vì phòng tắm công cộng rộng lắm.
Dialogue: 0,0:19:13.10,0:19:15.99,Default,Touma,0,0,0,,Bên Anh chắc toàn phòng tắm nhỏ thôi phải không?
Dialogue: 0,0:19:17.77,0:19:19.98,Default,Index,0,0,0,,Thật ra thì em không rõ.
Dialogue: 0,0:19:19.98,0:19:20.73,Default,Touma,0,0,0,,Sao vậy?
Dialogue: 0,0:19:21.14,0:19:24.37,Default,Index,0,0,0,,Vì em chỉ biết về Nhật Bản thôi.
Dialogue: 0,0:19:24.37,0:19:27.23,Default,Index,0,0,0,,Mấy chuyện bên Anh em chả rõ lắm.
Dialogue: 0,0:19:28.86,0:19:31.19,Default,Touma,0,0,0,,Thảo nào em nói tiếng Nhật tốt vậy.
Dialogue: 0,0:19:31.19,0:19:33.93,Default,Index,0,0,0,,Không, ý em không phải thế.
Dialogue: 0,0:19:33.93,0:19:39.36,Default,Index,0,0,0,,Em sinh ra tại London và được nhà thờ thánh George nuôi lớn.
Dialogue: 0,0:19:39.71,0:19:43.71,Default,Index,0,0,0,,Có thể em đã đến Nhật 1 năm truớc.
Dialogue: 0,0:19:44.21,0:19:45.21,Default,Touma,0,0,0,,Có thể?
Dialogue: 0,0:19:45.21,0:19:48.02,Default,Index,0,0,0,,Ừ, vì em từng bị mất trí nhớ.
Dialogue: 0,0:19:49.82,0:19:54.20,Default,Index,0,0,0,,Lần đầu tỉnh dậy, em còn chẳng nhớ mình là ai.
Dialogue: 0,0:19:54.69,0:19:57.27,Default,Index,0,0,0,,Cũng chẳng nhớ nổi mình đã ăn gì tối qua...
Dialogue: 0,0:19:57.27,0:20:00.67,Default,Index,0,0,0,,Nhưng Ma thuật, Index, Necessarius...
Dialogue: 0,0:20:00.67,0:20:03.35,Default,Index,0,0,0,,Những thứ đó cứ quanh quẩn trong đầu em.
Dialogue: 0,0:20:03.35,0:20:04.92,Default,Index,0,0,0,,Em thấy rất sợ.
Dialogue: 0,0:20:06.78,0:20:10.22,Default,Touma,0,0,0,,Thế?! Cả lý do mình bị mất trí nhớ em cũng không biết sao?
Dialogue: 0,0:20:11.19,0:20:11.72,Default,Index,0,0,0,,Ừ!
Dialogue: 0,0:20:17.31,0:20:18.05,Default,Index,0,0,0,,Touma?
Dialogue: 0,0:20:18.05,0:20:19.37,Default,Index,0,0,0,,Anh giận gì hả?
Dialogue: 0,0:20:20.27,0:20:22.04,Default,Touma,0,0,0,,Không có giận.
Dialogue: 0,0:20:22.04,0:20:24.87,Default,Index,0,0,0,,Nếu em nói gì sai thì cho xin lỗi.
Dialogue: 0,0:20:24.87,0:20:26.79,Default,Index,0,0,0,,Touma, sao anh lại giận?
Dialogue: 0,0:20:26.79,0:20:27.97,Default,Index,0,0,0,,Vấn đề "dậy thì" hả?
Dialogue: 0,0:20:28.47,0:20:33.48,Default,Touma,0,0,0,,Anh không muốn nghe mấy từ kiểu "dậy thì" từ miệng một con nhóc bé xíu như em, thiệt đó.
Dialogue: 0,0:20:33.48,0:20:35.53,Default,Index,0,0,0,,Nè, nói vậy là ý gì?
Dialogue: 0,0:20:35.53,0:20:38.15,Default,Index,0,0,0,,Rõ ràng em thấy anh đang giận.
Dialogue: 0,0:20:38.15,0:20:39.58,Default,Index,0,0,0,,Hay là?
Dialogue: 0,0:20:39.58,0:20:42.54,Default,Index,0,0,0,,Touma đang giả vờ để trêu chọc em?
Dialogue: 0,0:20:43.12,0:20:45.39,Default,Index,0,0,0,,Em không thích vẻ mặt này của Touma.
Dialogue: 0,0:20:45.39,0:20:46.67,Default,Touma,0,0,0,,Coi nào.
Dialogue: 0,0:20:46.67,0:20:48.28,Default,Touma,0,0,0,,Em vốn đâu có thích anh.
Dialogue: 0,0:20:48.28,0:20:50.72,Default,Touma,0,0,0,,Đừng nói mấy câu kì thế.
Dialogue: 0,0:20:50.72,0:20:56.18,Default,Touma,0,0,0,,Dù gì đi nữa, anh cũng chẳng dám mơ đến mấy cái quan hệ lãng mạn với em đâu.
Dialogue: 0,0:20:58.66,0:20:59.43,Default,Touma,0,0,0,,À lế?
Dialogue: 0,0:20:59.43,0:21:02.98,Default,Touma,0,0,0,,Sao tự nhiên lườm anh ghê thế.
Dialogue: 0,0:21:02.98,0:21:03.98,Default,Touma,0,0,0,,Công chúa?
Dialogue: 0,0:21:05.02,0:21:06.36,Default,Index,0,0,0,,Touma!
Dialogue: 0,0:21:08.57,0:21:10.11,Default,Index,0,0,0,,Em ghét anh!
Dialogue: 0,0:21:17.63,0:21:18.96,Default,Touma,0,0,0,,Thiệt tình...
Dialogue: 0,0:21:18.96,0:21:22.08,Default,Touma,0,0,0,,Cắn người ta đã rồi bỏ đi đằng nào không biết.
Dialogue: 0,0:21:27.54,0:21:28.37,Default,Touma,0,0,0,,Ủa?
Dialogue: 0,0:21:35.05,0:21:37.85,Default,Touma,0,0,0,,Mọi người? Biến mất?!
Dialogue: 0,0:21:41.09,0:21:41.85,Default,Kaori,0,0,0,,Rune.
Dialogue: 0,0:21:44.68,0:21:47.51,Default,Kaori,0,0,0,,Một loại Rune ngăn cản mọi người tiếp cận chúng ta.
Dialogue: 0,0:21:48.14,0:21:49.48,Default,Touma,0,0,0,,Cô là...
Dialogue: 0,0:21:50.42,0:21:53.64,Default,Kaori,0,0,0,,Kanzaki Kaori.
Dialogue: 0,0:23:25.39,0:23:28.00,Default,Touma,0,0,0,,Kanzaki Kaori, một pháp sư khác.
Dialogue: 0,0:23:28.00,0:23:29.92,Default,Touma,0,0,0,,Cô ta là người đã chém Index?
Dialogue: 0,0:23:30.33,0:23:33.06,Default,Touma,0,0,0,,Tại sao cô ta nỡ làm thế?!
Dialogue: 0,0:23:33.59,0:23:35.59,Default,Touma,0,0,0,,Kì tới : "Trí nhớ hoàn hảo"
Dialogue: 0,0:23:35.59,0:23:37.55,Default,Touma,0,0,0,,Khi khoa học và ma thuật gặp nhau,
Dialogue: 0,0:23:37.55,0:23:38.98,Default,Touma,0,0,0,,Bản anh hùng ca sẽ bắt đầu.
