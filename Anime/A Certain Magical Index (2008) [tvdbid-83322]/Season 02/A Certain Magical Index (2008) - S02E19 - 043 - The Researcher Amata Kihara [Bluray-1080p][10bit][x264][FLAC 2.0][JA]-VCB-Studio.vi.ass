Dialogue: 0,0:00:02.61,0:00:06.24,Default,,0,0,0,,"Lời cảnh báo khi đưa Thiên sứ\Nvào cơ thể con người:"
Dialogue: 0,0:00:06.24,0:00:13.21,Default,,0,0,0,,"Telesma mạnh nhất sẽ đến thế giới này\N khi được thụ thai."
Dialogue: 0,0:00:13.21,0:00:15.09,Default,,0,0,0,,"Khi sức mạnh từ đứa con của Chúa...{"Khi mà sức mạnh tối cao từ đứa con của Chúa...}
Dialogue: 0,0:00:15.09,0:00:18.44,Default,,0,0,0,,"Nói cách khác là Telesma đang dẫn lối\N cho thế giới này..."
Dialogue: 0,0:00:18.44,0:00:21.34,Default,,0,0,0,,"...được đặt vào tử cung, người đó sẽ..."
Dialogue: 0,0:00:21.34,0:00:23.30,Default,,0,0,0,,Sasha-chan!
Dialogue: 0,0:00:23.96,0:00:27.13,Default,,0,0,0,,Ôi trời, em lại đọc mấy quyển sách\N mốc meo đó à?
Dialogue: 0,0:00:27.70,0:00:31.64,Default,,0,0,0,,Thì ra em vẫn chưa hiểu được chuyện gì đã xảy ra\N với cơ thể của em lúc đó chứ gì?
Dialogue: 0,0:00:31.64,0:00:34.42,Default,,0,0,0,,Nếu đã vậy, để chị kiểm tra tổng thể \Ncho một lượ...{Nếu đã vậy, để chị kiểm tra tổng thể một lượt cho...}
Dialogue: 0,0:00:36.03,0:00:37.52,Default,,0,0,0,,Sasha-chan thật là...
Dialogue: 0,0:00:37.52,0:00:40.90,Default,,0,0,0,,Lúc nào em cũng mạnh mẽ như thế cả.
Dialogue: 0,0:00:40.90,0:00:46.33,Default,,0,0,0,,Câu hỏi số 1 - Giữa búa và tuốc-nơ-vít, \Nchị thích cái nào?
Dialogue: 0,0:00:46.33,0:00:50.66,Default,,0,0,0,,Em không nên hỏi thế khi vừa mới đánh\N người ta đâu.
Dialogue: 0,0:00:51.23,0:00:55.37,Default,,0,0,0,,Telesma đã nhập vào Sasha-chan lúc đó\N là Gabriel, phải không?
Dialogue: 0,0:00:55.37,0:00:57.17,Default,,0,0,0,,Chị không dám tưởng tượng đến đấy.
Dialogue: 0,0:00:58.25,0:01:01.29,Default,,0,0,0,,Điều đó có khi còn tệ hơn 12 tông đồ của Chúa\N cộng lại nữa.
Dialogue: 0,0:01:03.10,0:01:06.68,Default,,0,0,0,,Câu hỏi số 2 - Thế thì sao?
Dialogue: 0,0:01:06.68,0:01:11.41,Default,,0,0,0,,Sức mạnh của Chúa chẳng qua là sức mạnh của Thiên sứ \Nkhi được thụ thai thôi, phải không.
Dialogue: 0,0:01:11.41,0:01:16.97,Default,,0,0,0,,Và hơn nữa, đặt một sức mạnh lớn hơn cả 12 tông đồ\N vào cơ thể của một cô gái như thế...
Dialogue: 0,0:01:16.97,0:01:19.24,Default,,0,0,0,,Có khi bụng của em sẽ to lê...
Dialogue: 0,0:01:20.73,0:01:23.27,Default,,0,0,0,,Xin lỗi, xin lỗi, phải rồi nhỉ.
Dialogue: 0,0:01:23.27,0:01:27.21,Default,,0,0,0,,Lúc nào cũng mang một bộ đồ nặng trịch \Nnhư thế kia...
Dialogue: 0,0:01:27.21,0:01:30.80,Default,,0,0,0,,Làm sao mà em mang thai được nhỉ.
Dialogue: 0,0:01:31.59,0:01:37.36,Default,,0,0,0,,Câu hỏi số 3 - Còn định báng bổ Chúc thư mới \Nđến bao giờ, đồ khốn?
Dialogue: 0,0:01:37.36,0:01:43.22,Default,,0,0,0,,Mà không phải chính chị đã lạm dụng chức quyền\N để ép tôi mặc cái này hay sao?
Dialogue: 0,0:01:43.22,0:01:46.06,Default,,0,0,0,,Hể? Em không thích à?
Dialogue: 0,0:01:46.06,0:01:48.55,Default,,0,0,0,,Thế thì đổi đồ cho em nhé.
Dialogue: 0,0:01:49.55,0:01:53.07,Default,,0,0,0,,Gần đây, chị đã làm một số nghiên cứu\N ở Đô thị học viện.
Dialogue: 0,0:01:53.55,0:01:56.37,Default,,0,0,0,,Họ có nhiều văn hóa lạ lắm.
Dialogue: 0,0:01:59.60,0:02:01.56,Default,,0,0,0,,Nè, Sasha-chan...
Dialogue: 0,0:02:02.52,0:02:04.77,Default,,0,0,0,,Em có nghe "Cô gái phép thuật Kanamin" bao giờ chưa?
Dialogue: 0,0:02:07.39,0:02:09.81,Default,,0,0,0,,Ôi trời, Sasha-chan thật là...
Dialogue: 0,0:02:11.91,0:02:17.43,OP-TOP,,0,0,0,,{\fad(150,150)\be1}I'm always running after you
Dialogue: 0,0:02:17.43,0:02:20.49,OP-TOP,,0,0,0,,{\fad(150,150)\be1}You're my ideal
Dialogue: 0,0:02:20.49,0:02:23.66,OP-TOP,,0,0,0,,{\fad(150,150)\be1}You are me
Dialogue: 0,0:03:47.14,0:03:51.61,Default,,0,0,0,,"Trời đang mưa!" Misaka Misaka vừa nói vừa ngước lên \Nbầu trời ban đêm.
Dialogue: 0,0:03:51.61,0:03:53.05,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:03:53.05,0:03:55.38,Default,,0,0,0,,Bỏ cái kiểu chạy nhảy gai mắt đó đi.
Dialogue: 0,0:03:55.38,0:04:00.85,Default,,0,0,0,,{\fscx80}"Misaka muốn nhìn thấy mặt trăng, vậy mà..." Misaka tỏ ra hơi buồn\N nhưng vẫn tung tăng nhảy nhót.
Dialogue: 0,0:04:00.85,0:04:01.80,Default,,0,0,0,,Này.
Dialogue: 0,0:04:02.11,0:04:05.27,Default,,0,0,0,,Đã nói là đừng có xoay xoay nữa cơ mà,\N con ranh này.
Dialogue: 0,0:04:05.55,0:04:12.48,Default,,0,0,0,,"Dù anh không quan tâm đến vậy thì Misaka vẫn ổn mà."\N Misaka Misaka thử yêu cầu một chút tự do.
Dialogue: 0,0:04:12.48,0:04:16.38,Default,,0,0,0,,Nhóc mày lảm nhảm cái gì thế?
Dialogue: 0,0:04:16.38,0:04:18.45,Default,,0,0,0,,Mà ai thèm quan tâm đến mày?
Dialogue: 0,0:04:18.45,0:04:19.97,Default,,0,0,0,,"Lại nữa rồi kìa."
Dialogue: 0,0:04:19.97,0:04:25.16,Default,,0,0,0,,"Có gì đâu mà anh phải ngượng." Misaka Misaka \Nvừa nói vừa xoay xoay ngón tay...
Dialogue: 0,0:04:25.16,0:04:34.22,Default,,0,0,0,,"Sao bỗng dưng anh nắm tay chặt thế?" Misaka Misaka cố gắng\N nở một nụ cười để làm nguôi cơn giận của anh.
Dialogue: 0,0:04:39.47,0:04:45.60,Default,,0,0,0,,"Mưa, mưa, rơi, rơi, rơi nữa đi!" Misaka Misaka\N hét vang trong bầu trời đêm.{.}
Dialogue: 0,0:04:46.50,0:04:50.27,Alt,,0,0,0,,"Mưa rơi, mưa rơi, mưa rơi!" {timing check}
Dialogue: 0,0:04:47.10,0:04:50.27,Default,,0,0,0,,Thể hiện thiện ý với người khác \Nkhó đến thế ư?{Thể hiện thiện ý với người khác khó đến thế ư?}
Dialogue: 0,0:04:50.92,0:04:54.61,Default,,0,0,0,,Có vẻ cậu đã chấp nhận thiện ý\N của Last Order.
Dialogue: 0,0:04:54.61,0:04:57.65,Default,,0,0,0,,Nhưng cậu đang ngần ngại khi đáp lại \Nthiện ý đó.{Nhưng cậu lại đang sợ khi đáp lại thiện ý của nó.}
Dialogue: 0,0:04:58.26,0:05:01.83,Default,,0,0,0,,Cậu đang sợ phạm phải sai lầm không thể sửa chữa\N nào nữa ư?
Dialogue: 0,0:05:02.65,0:05:04.58,Default,,0,0,0,,"Ui da!"
Dialogue: 0,0:05:04.95,0:05:10.04,Default,,0,0,0,,"Ngã mất rồi." Misaka Misaka báo cáo lại tình hình\N trong khi đang ngồi trên mặt đất.
Dialogue: 0,0:05:10.04,0:05:11.37,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:05:11.37,0:05:12.59,Default,,0,0,0,,Nhìn là đủ hiểu rồi.
Dialogue: 0,0:05:12.59,0:05:18.30,Default,,0,0,0,,"Có lẽ em cần được sát trùng." Misaka Misaka vừa nói \Nvừa tỏ ra rưng rưng nước mắt.
Dialogue: 0,0:05:21.48,0:05:23.20,Default,,0,0,0,,Sao không cố mà chịu đi?
Dialogue: 0,0:05:23.77,0:05:28.99,Default,,0,0,0,,"Có lẽ em cần được sát trùng." Misaka Misaka \Nlặp lại lời nói.
Dialogue: 0,0:05:28.99,0:05:32.05,Default,,0,0,0,,Tao mặc kệ. Mau về nhà Yomikawa thôi.
Dialogue: 0,0:05:34.14,0:05:38.46,Default,,0,0,0,,"Hiểu rồi." Misaka Misaka xuống giọng.
Dialogue: 0,0:05:39.21,0:05:46.48,Default,,0,0,0,,"Dù rất đau nhưng sẽ cố gắng chịu" Misaka Misaka\N vừa nói vừa đi theo anh.
Comment: 0,0:06:04.97,0:06:05.89,Default,,0,0,0,,"Á!"
Dialogue: 0,0:06:07.70,0:06:09.84,Default,,0,0,0,,Misaka Misaka...
Dialogue: 0,0:06:10.35,0:06:12.30,Default,,0,0,0,,Ngồi đợi ở đây.
Dialogue: 0,0:06:12.30,0:06:15.17,Default,,0,0,0,,Mày mà di chuyển một mét nào \Nlà tao đập chết đấy.
Dialogue: 0,0:06:25.55,0:06:27.19,Default,,0,0,0,,Thật ngớ ngẩn...
Dialogue: 0,0:06:41.35,0:06:43.97,Default,,0,0,0,,Cho dù đau đớn đến mức nào...
Dialogue: 0,0:06:43.97,0:06:45.97,Default,,0,0,0,,...thì chúng ta vẫn phải trả nợ.
Dialogue: 0,0:06:48.65,0:06:49.77,Default,,0,0,0,,Chết tiệt.
Comment: 0,0:07:01.76,0:07:02.86,Default,,0,0,0,,Huh?
Dialogue: 0,0:07:02.86,0:07:05.99,Default,,0,0,0,,Ờ, ta cũng biết mấy kẻ ngốc như ngươi \Nsớm muộn gì cũng đến.
Dialogue: 0,0:07:06.50,0:07:10.79,Default,,0,0,0,,Ngươi có hiềm khích với ta chăng? \NHay là đang muốn lợi dụng ta?
Dialogue: 0,0:07:10.79,0:07:12.42,Default,,0,0,0,,Dù là cái nào đi nữa thì...
Dialogue: 0,0:07:13.35,0:07:15.17,Default,,0,0,0,,...ta vẫn sẽ giết ngươi.
Dialogue: 0,0:07:27.99,0:07:29.55,Default,,0,0,0,,A! Vui quá!
Dialogue: 0,0:07:31.28,0:07:32.32,Default,,0,0,0,,Thật tuyệt vời!
Dialogue: 0,0:07:33.48,0:07:36.88,Default,,0,0,0,,Tụi bay đáng để ta giải trí lắm, lũ chết tiệt!
Dialogue: 0,0:07:51.45,0:07:52.62,Default,,0,0,0,,Nhạt nhẽo thật.
Dialogue: 0,0:07:59.96,0:08:02.60,Default,,0,0,0,,Tuyệt lắm! Cám ơn nhé!
Dialogue: 0,0:08:02.60,0:08:05.72,Default,,0,0,0,,Và hãy cảm ơn ta vì đã cho các ngươi chết\N một cách tuyệt đẹp đi!
Dialogue: 0,0:08:06.70,0:08:09.61,Default,,0,0,0,,Ta đã nói rồi mà.
Dialogue: 0,0:08:09.93,0:08:14.39,Default,,0,0,0,,Muốn hạ thằng nhóc đó mà chỉ có như thế \Nthì không thể nào đâu.
Dialogue: 0,0:08:14.39,0:08:17.21,Default,,0,0,0,,Xem ra ta phải can thiệp rồi.
Dialogue: 0,0:08:19.10,0:08:21.40,Default,,0,0,0,,Chào, Kihara-kun!!
Dialogue: 0,0:08:22.06,0:08:25.62,Default,,0,0,0,,Làm gì mà đứng hiên ngang thế kia?
Dialogue: 0,0:08:25.62,0:08:32.04,Default,,0,0,0,,Thật nực cười rằng ngươi đã từng là một thằng nhóc nhát gan\Ncòn chẳng dám nhìn thẳng vào mắt ai cơ đấy.
Dialogue: 0,0:08:32.04,0:08:36.27,Default,,0,0,0,,Ta cũng đâu có muốn gặp ngươi.
Dialogue: 0,0:08:36.27,0:08:39.17,Default,,0,0,0,,Nhưng đây là mệnh lệnh, thế nên đành chịu vậy.
Dialogue: 0,0:08:39.17,0:08:44.14,Default,,0,0,0,,Và hình như là rất khẩn cấp nên không còn\N nhiều thời gian nữa.
Dialogue: 0,0:08:44.14,0:08:48.85,Default,,0,0,0,,Thế nên... xin lỗi nhé, ta phải giết ngươi rồi.
Dialogue: 0,0:08:48.85,0:08:52.85,Default,,0,0,0,,Mà ngươi nghĩ ai đã ban sức mạnh đó\N cho ngươi kia chứ?
Dialogue: 0,0:08:52.85,0:08:54.60,Default,,0,0,0,,Hả? Cái gì?
Dialogue: 0,0:08:54.60,0:08:55.91,Default,,0,0,0,,Nói gì cơ?
Dialogue: 0,0:08:55.91,0:08:58.69,Default,,0,0,0,,Có phải ta vừa nghe mấy lời đầy tự hào \Ncủa ai đó không?
Dialogue: 0,0:08:58.69,0:09:01.97,Default,,0,0,0,,Đừng nói ngươi đang định bảo ta \Ntrả ơn đấy nhé.
Dialogue: 0,0:09:01.97,0:09:03.86,Default,,0,0,0,,Không. Không được đâu.
Dialogue: 0,0:09:03.86,0:09:04.82,Default,,0,0,0,,Hơn nữa...
Dialogue: 0,0:09:05.67,0:09:08.41,Default,,0,0,0,,Nếu ngươi muốn chết thì chết một mình đi.
Dialogue: 0,0:09:08.41,0:09:13.51,Default,,0,0,0,,Số nghiên cứu gia từng chơi đùa với cái cơ thể này \Nđã chẳng thể đếm hết trên đầu ngón tay rồi.
Dialogue: 0,0:09:14.13,0:09:18.62,Default,,0,0,0,,Ngươi thật sự nghĩ rằng ta sẽ "nhớ công"\N của ngươi sao?
Dialogue: 0,0:09:19.22,0:09:23.07,Default,,0,0,0,,Thiệt tình, ngươi đúng là vẫn đáng ghét\N như ngày nào, đồ nhóc con.
Dialogue: 0,0:09:23.07,0:09:24.82,Default,,0,0,0,,Chà, ta muốn giết ngươi.
Dialogue: 0,0:09:24.82,0:09:26.82,Default,,0,0,0,,Ta muốn giết ngươi quá.
Dialogue: 0,0:09:27.18,0:09:30.51,Default,,0,0,0,,Quả đúng là trước kia ta nên trừ khử ngươi.
Dialogue: 0,0:09:30.51,0:09:32.42,Default,,0,0,0,,Tệ thật, tệ thật.
Dialogue: 0,0:09:32.42,0:09:34.18,Default,,0,0,0,,Ta đã làm cái gì thế này?
Dialogue: 0,0:09:35.46,0:09:38.64,Default,,0,0,0,,Vậy thì bây giờ ta sẽ giết ngươi,\N đồ nhóc con!
Dialogue: 0,0:09:40.90,0:09:43.45,Default,,0,0,0,,Tên ngốc này đang nghĩ gì vậy nhỉ?
Dialogue: 0,0:09:43.45,0:09:44.86,Default,,0,0,0,,Giờ thì ta nên...
Dialogue: 0,0:09:50.14,0:09:52.49,Default,,0,0,0,,Phản hồi không hoạt động ư?
Dialogue: 0,0:09:52.49,0:09:54.31,Default,,0,0,0,,Này, nhóc con.
Dialogue: 0,0:09:54.31,0:09:56.17,Default,,0,0,0,,Để ta nhắc lại một lần nhé.
Dialogue: 0,0:09:56.17,0:10:01.29,Default,,0,0,0,,Ngươi nghĩ ai đã ban cho ngươi \Nsức mạnh đó kia chứ?
Dialogue: 0,0:10:01.29,0:10:03.92,Default,,0,0,0,,Nào, đã nhớ ra chưa?
Dialogue: 0,0:10:09.05,0:10:09.88,Default,,0,0,0,,Hử?
Dialogue: 0,0:10:12.15,0:10:13.86,Default,,0,0,0,,Chẳng giống ngươi chút nào.
Dialogue: 0,0:10:14.47,0:10:17.97,Default,,0,0,0,,Mà cũng đừng lo. Ta sẽ lo cho\N con nhóc đó.
Dialogue: 0,0:10:17.97,0:10:22.40,Default,,0,0,0,,Ngươi cứ yên tâm mà biến thành thịt băm \Ndưới tay ta đi.{Ngươi cứ yên tâm mà biến thành đống thịt vụn \Ndưới tay ta đi.}
Dialogue: 0,0:10:23.23,0:10:26.04,Default,,0,0,0,,Như thế là hợp với ngươi nhất rồi, phải không?
Dialogue: 0,0:10:29.46,0:10:35.59,Default,,0,0,0,,Đừng có coi thường ta, đồ chết tiệt!
Dialogue: 0,0:10:36.24,0:10:37.70,Default,,0,0,0,,Vô ích thôi.
Dialogue: 0,0:11:00.98,0:11:07.05,Default,,0,0,0,,Chẳng lẽ ngươi... tự nâng cấp cơ thể của mình \Nđể có siêu năng lực ư?
Dialogue: 0,0:11:07.85,0:11:08.40,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:11.38,0:11:13.65,Default,,0,0,0,,Không có, không có. Không có đâu.
Dialogue: 0,0:11:14.14,0:11:17.75,Default,,0,0,0,,Ta đâu phải là heo thí nghiệm.
Dialogue: 0,0:11:17.75,0:11:23.75,Default,,0,0,0,,Ta cũng đâu cần cái thứ sức mạnh ngu ngốc đó \N để đấu với một con ruồi như ngươi.
Dialogue: 0,0:11:24.21,0:11:27.54,Default,,0,0,0,,Hôm nay cái này cũng có tác dụng lắm.
Dialogue: 0,0:11:31.29,0:11:35.75,Default,,0,0,0,,Giờ thì ta sẽ giết ngươi!
Dialogue: 0,0:11:36.10,0:11:37.51,Default,,0,0,0,,Hiểu rồi, hiểu rồi.
Dialogue: 0,0:11:37.51,0:11:41.47,Default,,0,0,0,,Ngươi nghĩ đôi găng đó là nguồn sức mạnh\N của ta chứ gì?
Dialogue: 0,0:11:41.74,0:11:43.35,Default,,0,0,0,,Nhưng mà nhầm to rồi nhé.
Dialogue: 0,0:11:47.11,0:11:49.86,Default,,0,0,0,,Đừng có lúc nào cũng nghĩ mình \Nlà kẻ mạnh nhất.
Dialogue: 0,0:11:49.86,0:11:52.53,Default,,0,0,0,,Đồ nhóc con!
Dialogue: 0,0:11:55.55,0:11:58.82,Default,,0,0,0,,Phản hồi của ngươi không phải là \Nvòng bảo vệ tuyệt đối đâu.
Dialogue: 0,0:11:59.13,0:12:03.28,Default,,0,0,0,,Chẳng qua ngươi chỉ là thay đổi chiều\N của các véc-tơ mà thôi.
Dialogue: 0,0:12:03.28,0:12:05.35,Default,,0,0,0,,Thế nên câu trả lời rất đơn giản.
Dialogue: 0,0:12:05.35,0:12:08.83,Default,,0,0,0,,Ta chỉ cần rút nắm đấm lại ngay khi ngươi \Ndùng phản hồi là được.
Dialogue: 0,0:12:09.46,0:12:11.96,Default,,0,0,0,,Tức là dừng lại ngay khi tay ta \Nchạm đến ngươi đó.
Dialogue: 0,0:12:12.51,0:12:17.47,Default,,0,0,0,,Nói cách khác là ngươi đã tự kéo nắm đấm của ta\N về phía ngươi thôi.
Dialogue: 0,0:12:17.47,0:12:20.20,Default,,0,0,0,,Hiểu chưa hả, cậu bé khổ dâm?
Dialogue: 0,0:12:21.19,0:12:24.90,Default,,0,0,0,,Chắc là hơi khó hiểu cho một tên\N óc quả nho, nhỉ?
Dialogue: 0,0:12:26.76,0:12:28.95,Default,,0,0,0,,Cơn gió vừa rồi cũng như vậy.
Dialogue: 0,0:12:28.95,0:12:33.45,Default,,0,0,0,,Sức mạnh của ngươi dựa trên sự cân bằng véc-tơ.
Dialogue: 0,0:12:33.45,0:12:35.93,Default,,0,0,0,,Vậy nên ta đã phát minh ra nó.
Dialogue: 0,0:12:36.95,0:12:41.20,Default,,0,0,0,,Khi sử dụng một sóng âm thanh nhất định, \Nta có thể tạo ra hiệu ứng nhiễu.
Dialogue: 0,0:12:41.20,0:12:46.79,Default,,0,0,0,,Ta biết tính chất của ngươi, sự cân bằng của ngươi,\N personal reality của ngươi, tất cả.
Dialogue: 0,0:12:48.25,0:12:51.92,Default,,0,0,0,,"Nhà phát triển sức mạnh" chẳng phải là\N cái danh hão đâu.
Dialogue: 0,0:12:54.40,0:12:56.53,Default,,0,0,0,,Này, Accelerator.
Dialogue: 0,0:12:56.53,0:12:58.73,Default,,0,0,0,,Thật đáng thương là ngươi lại không hiểu\N ý nghĩa của "nó".
Dialogue: 0,0:12:59.12,0:13:06.60,Default,,0,0,0,,Hơn nữa nhé, ngươi nghĩ vì sao con nhỏ Railgun hạng 3 đó \Nlại được sử dụng cho kế hoạch Radio Noise\N thay vì kẻ hạng nhất như ngươi?
Dialogue: 0,0:13:07.18,0:13:09.23,Default,,0,0,0,,Bởi vì có một lý do.
Dialogue: 0,0:13:09.23,0:13:12.49,Default,,0,0,0,,Một lý do mà ngươi không hề hiểu.
Dialogue: 0,0:13:12.49,0:13:14.31,Default,,0,0,0,,Đồ chết tiệt...
Dialogue: 0,0:13:14.95,0:13:16.76,Default,,0,0,0,,Cảm động thật đấy.
Dialogue: 0,0:13:16.76,0:13:19.32,Default,,0,0,0,,À, chắc con nhỏ nghe thấy cũng vui lắm.
Dialogue: 0,0:13:24.20,0:13:26.87,Default,,0,0,0,,Xem ra đã bắt được nó rồi.
Dialogue: 0,0:13:27.13,0:13:30.88,Default,,0,0,0,,Ái chà, ta bảo là phải bắt sống kia mà.
Dialogue: 0,0:13:30.88,0:13:32.50,Default,,0,0,0,,Con nhỏ còn sống thật không đấy?
Dialogue: 0,0:13:32.50,0:13:35.29,Default,,0,0,0,,Ta không muốn bị đuổi việc đâu nhé.
Dialogue: 0,0:13:36.58,0:13:38.42,Default,,0,0,0,,Con nhóc vẫn còn sống.
Dialogue: 0,0:13:38.78,0:13:43.77,Default,,0,0,0,,Nếu nó chết, hệ thống mạng lưới Sister\N cũng sẽ bị ảnh hưởng.
Dialogue: 0,0:13:43.77,0:13:45.53,Default,,0,0,0,,Mình không kiểm tra được...
Dialogue: 0,0:13:46.61,0:13:51.19,Default,,0,0,0,,Nhưng cứ đà này, con nhóc sẽ không bao giờ...
Dialogue: 0,0:13:52.15,0:13:55.27,Default,,0,0,0,,Last Order!
Dialogue: 0,0:14:09.95,0:14:14.42,Default,,0,0,0,,Nè nè... con nhỏ đâu phải là bóng golf.
Dialogue: 0,0:14:14.42,0:14:16.91,Default,,0,0,0,,Đừng có thổi người ta bay mất \Ncả trăm thước như thế chứ.
Dialogue: 0,0:14:17.21,0:14:18.14,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:14:18.14,0:14:20.85,Default,,0,0,0,,Ai sẽ đi nhặt con nhỏ về đây?
Dialogue: 0,0:14:20.85,0:14:22.66,Default,,0,0,0,,Nói trước là ta không đi đâu nhé.
Dialogue: 0,0:14:22.66,0:14:23.68,Default,,0,0,0,,Phải làm sao ạ?
Dialogue: 0,0:14:23.68,0:14:27.30,Default,,0,0,0,,Thôi được rồi, chia ra làm 3 đội.
Dialogue: 0,0:14:27.30,0:14:31.24,Default,,0,0,0,,Một đội chia ra tìm con nhỏ, hai đội hãy\N ở lại với ta.
Dialogue: 0,0:14:31.24,0:14:34.84,Default,,0,0,0,,Nhưng theo mệnh lệnh thì việc tìm Last Order\N là ưu tiên hàng đầu...
Dialogue: 0,0:14:34.84,0:14:35.70,Default,,0,0,0,,Ồ...
Dialogue: 0,0:14:36.15,0:14:40.03,Default,,0,0,0,,Ngươi là người mới bên Hound Dog,\N phải không?
Dialogue: 0,0:14:40.03,0:14:41.75,Default,,0,0,0,,Ơ, dạ...
Dialogue: 0,0:14:41.75,0:14:46.05,Default,,0,0,0,,Không sao, không sao, không phải ta muốn kiểm tra ngươi hay gì đâu.
Dialogue: 0,0:14:46.05,0:14:49.36,Default,,0,0,0,,Nhưng nếu ngươi chưa biết luật thì để ta\N nói cho mà biết.
Dialogue: 0,0:14:49.90,0:14:52.05,Default,,0,0,0,,Ngươi chỉ là một mẩu rác ở giữa một núi rác.
Dialogue: 0,0:14:52.05,0:14:54.27,Default,,0,0,0,,Ngươi vốn không có quyền con người.
Dialogue: 0,0:14:54.27,0:14:57.12,Default,,0,0,0,,Rác thay thế thì không có thiếu.
Dialogue: 0,0:14:57.12,0:15:00.15,Default,,0,0,0,,Nếu ngươi làm vướng đường trong cái kế hoạch\N hết sức quan trọng này...
Dialogue: 0,0:15:00.15,0:15:02.77,Default,,0,0,0,,Ta chẳng ngại gì mà ném ngươi \Nvào lò xử lý đâu.
Dialogue: 0,0:15:02.77,0:15:06.51,Default,,0,0,0,,Hiểu chưa? Coi như ngươi đã chết rồi ấy.
Dialogue: 0,0:15:06.51,0:15:09.86,Default,,0,0,0,,Giờ thì trả lời xem, đã hiểu chưa?
Dialogue: 0,0:15:11.43,0:15:13.70,Default,,0,0,0,,Tốt! Hiểu là được rồi.
Dialogue: 0,0:15:13.70,0:15:16.43,Default,,0,0,0,,Bờ sông, hồ nước hay đại loại thế.
Dialogue: 0,0:15:16.43,0:15:18.36,Default,,0,0,0,,Cứ tìm chỗ nào gần nước ấy.
Dialogue: 0,0:15:18.74,0:15:23.86,Default,,0,0,0,,Thằng nhóc này không thổi bừa con nhỏ đi chỗ nào \Nmà tiếp đất không an toàn đâu.
Dialogue: 0,0:15:23.86,0:15:26.53,Default,,0,0,0,,Còn cậu ta thì sao? Có bắt luôn không?
Dialogue: 0,0:15:26.53,0:15:27.81,Default,,0,0,0,,Không, ta sẽ giết nó.
Dialogue: 0,0:15:27.81,0:15:29.41,Default,,0,0,0,,Chẳng việc gì phải giữ nó lại cả.
Dialogue: 0,0:15:29.93,0:15:33.94,Default,,0,0,0,,Và nhìn thấy kẻ khác cố gắng như thế \Nlàm ta ngứa ngáy lắm.
Dialogue: 0,0:15:34.30,0:15:40.01,Default,,0,0,0,,Tốt hơn hết là cứ giết quách cái thằng nhóc\N ngạo mạn này đi.
Dialogue: 0,0:15:40.01,0:15:41.42,Default,,0,0,0,,Im mồm.
Dialogue: 0,0:15:42.33,0:15:46.21,Default,,0,0,0,,Tên khốn như ngươi thì hiểu cái gì hả?
Dialogue: 0,0:15:46.68,0:15:48.94,Default,,0,0,0,,Hể? Thế sao?
Dialogue: 0,0:15:49.68,0:15:53.64,Default,,0,0,0,,Thôi, để ta giết ngươi. Nhưng đều là tại ngươi đấy nhé.
Dialogue: 0,0:15:54.59,0:15:57.36,Default,,0,0,0,,Chết tiệt, có ai đó...
Dialogue: 0,0:15:57.36,0:15:59.31,Default,,0,0,0,,Xuất hiện đi, nữ thần may mắn...
Dialogue: 0,0:15:59.31,0:16:01.59,Default,,0,0,0,,Ta sẽ hiến cho bà tất cả.
Dialogue: 0,0:16:01.59,0:16:05.06,Default,,0,0,0,,Bà muốn dẫm đạp ta hay cười vào mặt ta\N cũng được.
Dialogue: 0,0:16:05.81,0:16:08.57,Default,,0,0,0,,Có ai đó... ai cũng được...
Dialogue: 0,0:16:08.57,0:16:10.58,Default,,0,0,0,,Hãy cứu con nhóc...
Dialogue: 0,0:16:11.19,0:16:13.00,Default,,0,0,0,,Mọi người đang làm gì vậy?
Dialogue: 0,0:16:23.09,0:16:25.22,Default,,0,0,0,,Thiệt tình, con nhỏ Index này...
Dialogue: 0,0:16:25.22,0:16:28.43,Default,,0,0,0,,Cứ xểnh ra một cái là lại \Nbiến đi đâu mất tiêu.
Dialogue: 0,0:16:28.85,0:16:31.22,Default,,0,0,0,,Touma, anh chẳng chu đáo chút nào cả.
Dialogue: 0,0:16:31.62,0:16:37.77,Default,,0,0,0,,Cái anh xanh xao em gặp lúc nãy đã chiêu đãi em Hăm-bơ-gơ \Nmà chẳng cần hỏi hoàn cảnh đấy.
Dialogue: 0,0:16:37.77,0:16:41.73,Default,,0,0,0,,Anh cũng nên học cách tốt bụng như thế đi.
Dialogue: 0,0:16:41.73,0:16:43.20,Default,,0,0,0,,Ờ, ờ...
Dialogue: 0,0:16:43.20,0:16:46.05,Default,,0,0,0,,Chắc là anh chưa có phước gặp ai đó\N tốt bụng đến thế.
Dialogue: 0,0:16:46.05,0:16:49.39,Default,,0,0,0,,Mà em đã cảm ơn người ta đàng hoàng chưa đấy?
Dialogue: 0,0:16:49.39,0:16:52.13,Default,,0,0,0,,Lúc nào mà em chẳng cảm ơn đàng hoàng!
Dialogue: 0,0:16:53.45,0:16:54.53,Default,,0,0,0,,Sao vậy?
Dialogue: 0,0:16:54.53,0:16:57.54,Default,,0,0,0,,Nhắc mới nhớ, anh ấy đã cho em mượn cái này.
Dialogue: 0,0:16:57.54,0:16:59.28,Default,,0,0,0,,Chỉ là gói khăn giấy thôi mà.
Dialogue: 0,0:16:59.28,0:17:05.59,Default,,0,0,0,,Nhỡ người đó gặp rắc rối vì thiếu cái\N vật dụng hiện đại này thì sao?
Dialogue: 0,0:17:05.59,0:17:09.05,Default,,0,0,0,,Touma, Em phải đi trả lại cho anh ấy!
Dialogue: 0,0:17:09.05,0:17:12.05,Default,,0,0,0,,Anh thấy em trả lại có khi còn\N phiền người ta hơn...
Dialogue: 0,0:17:12.53,0:17:13.69,Default,,0,0,0,,Này!
Dialogue: 0,0:17:15.43,0:17:16.74,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:17:16.74,0:17:18.39,Default,,0,0,0,,Con nhỏ này lúc nào cũng vậy.
Dialogue: 0,0:17:21.29,0:17:23.44,Default,,0,0,0,,Trời mưa à?
Dialogue: 0,0:17:23.88,0:17:27.34,Default,,0,0,0,,Mà Index cũng không mang theo ô.
Dialogue: 0,0:17:33.36,0:17:36.75,Default,,0,0,0,,Hình như có nhiều Anti-skill hơn \Nbình thường thì phải.
Dialogue: 0,0:17:36.75,0:17:39.73,Default,,0,0,0,,Trước khi có vụ gì xảy ra, mình phải\N mau chóng tìm Index...
Dialogue: 0,0:17:46.93,0:17:48.70,Default,,0,0,0,,Chú sao vậy?
Dialogue: 0,0:17:48.70,0:17:50.46,Default,,0,0,0,,Này chú... Này chú!
Dialogue: 0,0:18:00.62,0:18:02.36,Default,,0,0,0,,Chuyện gì thế này?
Dialogue: 0,0:18:07.15,0:18:09.48,Default,,0,0,0,,Có vẻ họ vẫn còn sống.
Dialogue: 0,0:18:09.48,0:18:12.12,Default,,0,0,0,,Nhưng chuyện gì đang xảy ra thế này?
Dialogue: 0,0:18:15.24,0:18:16.61,Default,,0,0,0,,Có kẻ xâm nhập!
Dialogue: 0,0:18:16.61,0:18:20.89,Default,,0,0,0,,Xin nhắc lại, cổng chính đã bị phá hủy\N bởi một kẻ xâm nhập!
Dialogue: 0,0:18:20.89,0:18:23.15,Default,,0,0,0,,Chúng tôi bị tấn công bởi một loại vũ khí \Nkhông xác định...
Dialogue: 0,0:18:25.14,0:18:26.56,Default,,0,0,0,,Kẻ xâm nhập?
Dialogue: 0,0:18:27.00,0:18:28.05,Default,,0,0,0,,Index?!
Dialogue: 0,0:18:33.34,0:18:34.48,Default,,0,0,0,,E-Em...
Dialogue: 0,0:18:34.93,0:18:35.84,Default,,0,0,0,,"Hãy cứu anh ấy!"
Dialogue: 0,0:18:36.89,0:18:42.59,Default,,0,0,0,,"Em xin anh hãy cứu anh ấy!" Misaka Misaka\N thành khẩn cầu xin!
Dialogue: 0,0:18:57.45,0:18:58.70,Default,,0,0,0,,Hi!
Dialogue: 0,0:18:58.70,0:19:00.33,Default,,0,0,0,,Aleister?
Dialogue: 0,0:19:00.33,0:19:05.79,Default,,0,0,0,,Ta biết ông đang nghe đường dây này mà.
Dialogue: 0,0:19:05.79,0:19:09.51,Default,,0,0,0,,Cũng nên mau mau ra chào hỏi khách\N một tiếng chứ.
Dialogue: 0,0:19:12.90,0:19:14.22,Default,,0,0,0,,Cô đến đây làm gì?
Dialogue: 0,0:19:15.90,0:19:20.14,Default,,0,0,0,,Ta vừa càn quét 3 cơ quan ủy quyền \N của ông đấy.
Dialogue: 0,0:19:20.14,0:19:22.80,Default,,0,0,0,,Vậy mà vẫn chưa đủ để ông trả lời ư?
Dialogue: 0,0:19:22.80,0:19:26.06,Default,,0,0,0,,Bọn chúng không quan trọng,\N muốn bao nhiêu cũng có.
Dialogue: 0,0:19:27.31,0:19:33.06,Default,,0,0,0,,Ta cứ nghĩ những quyết định của ông có cả ý kiến của\N những cơ quan ủy quyền này.
Dialogue: 0,0:19:33.06,0:19:35.35,Default,,0,0,0,,Nhưng xem ra là ta đã lầm.
Dialogue: 0,0:19:35.35,0:19:36.65,Default,,0,0,0,,Thôi, chả sao.
Dialogue: 0,0:19:36.65,0:19:39.23,Default,,0,0,0,,Có biết thân phận của ta không?
Dialogue: 0,0:19:39.85,0:19:40.99,Default,,0,0,0,,Không biết.
Dialogue: 0,0:19:41.60,0:19:43.21,Default,,0,0,0,,Ghế phải của Chúa.{Có phải đang nói đến chiếc ghế bên phải của Chúa không :D}
Dialogue: 0,0:19:43.21,0:19:48.84,Default,,0,0,0,,Ông giả vờ không quan tâm cũng được, \Nnhưng mà đừng có hối tiếc nhé.
Dialogue: 0,0:19:49.62,0:19:52.39,Default,,0,0,0,,Cô đã quá coi thường thành phố này rồi.
Dialogue: 0,0:19:52.39,0:19:56.73,Default,,0,0,0,,Ồ? Ông còn chẳng nắm được tình trạng \Nthành phố của mình nữa sao?
Dialogue: 0,0:19:57.28,0:20:00.08,Default,,0,0,0,,Anti-skill và Judgment, phải không?
Dialogue: 0,0:20:00.08,0:20:04.89,Default,,0,0,0,,Lấy một lũ vô dụng như thế làm lá chắn,\N có ngày ông sẽ mất đầu đấy.
Dialogue: 0,0:20:04.89,0:20:09.04,Default,,0,0,0,,Chắc ông cũng tự nhận ra ngày tận thế của mình \Nsắp đến rồi chứ gì?
Dialogue: 0,0:20:10.33,0:20:18.26,Default,,0,0,0,,{\fscx75}Nếu cô thật sự nghĩ hệ thống phòng thủ của Đô thị học viện chỉ có thế\N thì ngây thơ quá đấy.
Dialogue: 0,0:20:18.26,0:20:22.79,Default,,0,0,0,,Xem ra cô chẳng hề hiểu gì về bản thể\N của thành phố này cả.
Dialogue: 0,0:20:24.19,0:20:28.21,Default,,0,0,0,,Cô chẳng phải là kẻ duy nhất\N có bí mật riêng đâu.
Dialogue: 0,0:20:28.88,0:20:32.51,Default,,0,0,0,,Dù rằng trước khi kịp hiểu được điều đó thì có lẽ\N cô đã chết rồi.
Dialogue: 0,0:20:33.68,0:20:38.73,Default,,0,0,0,,Dù sao đi nữa, ta sẽ thổi bay tất cả những gì\N ngáng đường ta.
Dialogue: 0,0:20:38.73,0:20:41.97,Default,,0,0,0,,Đó là điều ta đã quyết định ngay từ khi \Nđược sinh ra rồi.
Dialogue: 0,0:20:43.11,0:20:45.80,Default,,0,0,0,,Ta là Tiên phong Vento.
Dialogue: 0,0:20:45.80,0:20:50.02,Default,,0,0,0,,Vũ khí tối cao trong số hơn 2 tỉ tín đồ\N của Thánh đạo Roma.
Dialogue: 0,0:20:50.02,0:20:53.20,Default,,0,0,0,,Đêm nay, ta sẽ phá hủy hết tất cả.
Dialogue: 0,0:20:53.20,0:21:00.55,Default,,0,0,0,,Ông, thành phố này, Imagine Breaker, danh sách cấm thư,\N tất cả những thứ đó!
Dialogue: 0,0:21:03.63,0:21:05.01,Default,,0,0,0,,Thú vị lắm.
Dialogue: 0,0:21:05.01,0:21:09.00,Default,,0,0,0,,Thời điểm để sử dụng "nó" cuối cùng đã đến.
Dialogue: 0,0:21:10.54,0:21:17.58,Default,,0,0,0,,Dù rằng hơi sớm hơn dự tính, nhưng nó sẽ là phần thú vị nhất\N của kế hoạch này.
Dialogue: 0,0:21:18.55,0:21:21.32,Default,,0,0,0,,Hound Dog, Kihara Amata.
Dialogue: 0,0:21:22.30,0:21:23.64,Default,,0,0,0,,Kihara đây.
Dialogue: 0,0:21:24.13,0:21:28.69,Default,,0,0,0,,Đây là vùng số ảo, sóng khuếch tán \Ncủa Tổ chức ngũ hành.
Dialogue: 0,0:21:28.69,0:21:34.60,Default,,0,0,0,,Tuy hơi sớm, nhưng hãy sử dụng Fuse Kazakiri \Nđể tiêu diệt chúng.
Dialogue: 0,0:21:34.60,0:21:37.50,Default,,0,0,0,,Ngay khi bắt được 20001,
Dialogue: 0,0:21:37.50,0:21:40.24,Default,,0,0,0,,Hãy đưa nó đến điểm triển khai.
Dialogue: 0,0:21:41.43,0:21:44.10,Default,,0,0,0,,Hãy nhanh lên, nhưng nhẹ nhàng thôi nhé.
Dialogue: 0,0:21:44.10,0:21:44.86,Default,,0,0,0,,Rõ.
Dialogue: 0,0:21:47.10,0:21:48.08,Default,,0,0,0,,Giờ thì...
Dialogue: 0,0:21:49.69,0:21:54.05,Default,,0,0,0,,Cuộc vui ta chờ đợi bấy lâu cuối cùng đã bắt đầu.
Dialogue: 0,0:23:27.01,0:23:29.68,Default,,0,0,0,,Cuộc truy đuổi Last Order đã bắt đầu.
Dialogue: 0,0:23:29.68,0:23:33.48,Default,,0,0,0,,Người đó đã một mình đứng lên để bảo vệ con bé
Dialogue: 0,0:23:34.35,0:23:36.17,Default,,0,0,0,,Kỳ tới: "Hound Dog."
Dialogue: 0,0:23:36.17,0:23:38.92,Default,,0,0,0,,Khi khoa học và ma thuật gặp nhau, \Ncâu chuyện ấy bắt đầu.
