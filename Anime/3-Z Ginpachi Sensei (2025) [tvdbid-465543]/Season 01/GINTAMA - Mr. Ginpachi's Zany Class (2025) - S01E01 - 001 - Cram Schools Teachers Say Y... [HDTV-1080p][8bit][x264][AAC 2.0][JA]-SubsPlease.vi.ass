Dialogue: 0,0:00:01.22,0:00:02.05,Default,,0,0,0,,Dậy đi.
Dialogue: 0,0:00:03.70,0:00:04.42,Default,,0,0,0,,Dậy đi.
Dialogue: 0,0:00:04.91,0:00:06.24,Default,,0,0,0,,Đã bảo là dậy đi!
Dialogue: 0,0:00:09.39,0:00:11.25,Default,,0,0,0,,Này, dậy đi xem nào!
Dialogue: 0,0:00:11.67,0:00:14.88,Default,,0,0,0,,À... KHI XEM GINPACHI-SENSEI NHỚ\NNGỒI PHÒNG SÁNG VÀ XA MÀN HÌNH. HẾT
Dialogue: 0,0:00:16.92,0:00:18.27,Default,,0,0,0,,Chỗ quái nào đây?
Dialogue: 0,0:00:18.66,0:00:20.43,Default,,0,0,0,,Ơ kìa... mình sao?
Dialogue: 0,0:00:20.74,0:00:22.32,Default,,0,0,0,,À, tôi không phải cậu đâu.
Dialogue: 0,0:00:22.57,0:00:23.93,Default,,0,0,0,,Vì tôi là Gin-san mà.
Dialogue: 0,0:00:24.21,0:00:27.29,Default,,0,0,0,,À không, nếu gọi tắt thì\Ncậu cũng là Gin-san.
Dialogue: 0,0:00:27.86,0:00:30.24,Default,,0,0,0,,Ơ, thế thì tôi chính là cậu nhỉ.
Dialogue: 0,0:00:30.27,0:00:32.36,Default,,0,0,0,,Dù không hiểu lắm nhưng tôi hiểu rồi.
Dialogue: 0,0:00:32.51,0:00:33.09,Default,,0,0,0,,Thế nhé.
Dialogue: 0,0:00:33.11,0:00:34.18,Default,,0,0,0,,Này, đủ rồi đấy.
Dialogue: 0,0:00:34.20,0:00:37.52,Default,,0,0,0,,Chiêu quay lại ngủ tiếp trong thế giới\Ntinh thần có từ Gintama cũ rồi nhé!
Dialogue: 0,0:00:38.92,0:00:39.75,Default,,0,0,0,,Nghe này.
Dialogue: 0,0:00:40.21,0:00:43.77,Default,,0,0,0,,Sau đây, nam chính Sakata Gintoki\Ncủa anime Gintama...
Dialogue: 0,0:00:44.62,0:00:48.77,Default,,0,0,0,,sẽ gửi tới nam chính Sakata Ginpachi\Ncủa anime Lớp 3-Z của thầy Ginpachi...
Dialogue: 0,0:00:49.43,0:00:51.92,Default,,0,0,0,,Nghi thức bàn giao vai trò nhân vật chính!
Dialogue: 0,0:00:54.63,0:00:55.80,Default,,0,0,0,,Nghi thức bàn giao?
Dialogue: 0,0:00:56.16,0:00:57.09,Default,,0,0,0,,Cái quái gì đấy?
Dialogue: 0,0:00:57.26,0:00:58.63,Default,,0,0,0,,Thì cái vụ đó chứ gì.
Dialogue: 0,0:00:58.81,0:01:02.52,Default,,0,0,0,,Nhà sản xuất *beep*\Ncủa chương trình này ấy...
Dialogue: 0,0:01:02.74,0:01:04.91,Default,,0,0,0,,"Tôi sẽ làm một bản Gintama mới."
Dialogue: 0,0:01:04.91,0:01:08.80,Default,,0,0,0,,Tất cả bắt đầu từ phát ngôn bừa bãi\Nvới các bên liên quan đó.
Dialogue: 0,0:01:08.80,0:01:10.42,Default,,0,0,0,,Các bên liên quan cái gì!?
Dialogue: 0,0:01:10.48,0:01:14.05,Default,,0,0,0,,Chẳng phải có mỗi mấy chị gái\Nđang tạo quan hệ với tay sản xuất à?
Dialogue: 0,0:01:14.11,0:01:15.78,Default,,0,0,0,,Tôi sẽ làm một bản Gintama mới.
Dialogue: 0,0:01:15.79,0:01:18.80,Default,,0,0,0,,Nhưng nói thẳng ra thì\Nbộ tiểu thuyết Ginpachi-sensei ấy nhé...
Dialogue: 0,0:01:19.11,0:01:24.63,Default,,0,0,0,,Ra đời cũng từ mấy trang omake của\Nnguyên tác Gintama cách đây 20 năm còn gì?
Dialogue: 0,0:01:24.84,0:01:27.80,Default,,0,0,0,,Mà chẳng phải những người\Ntheo chủ nghĩa nguyên tác Gintama
Dialogue: 0,0:01:27.80,0:01:29.40,Default,,0,0,0,,không coi nó là Gintama à?
Dialogue: 0,0:01:29.40,0:01:31.08,Default,,0,0,0,,Còn bị nói là đồ nhái nữa nhỉ?
Dialogue: 0,0:01:31.08,0:01:31.83,Default,,0,0,0,,Quả Ginpachi ấy.
Dialogue: 0,0:01:31.83,0:01:32.56,Default,,0,0,0,,Không ổn đâu!
Dialogue: 0,0:01:32.56,0:01:35.04,Default,,0,0,0,,Mới mở đầu anime đã nói cái quái gì đấy?
Dialogue: 0,0:01:35.84,0:01:37.55,Default,,0,0,0,,Ấy, nói theo nghĩa tốt mà.
Dialogue: 0,0:01:37.80,0:01:39.88,Default,,0,0,0,,Đồ nhái cũng có điểm tốt nhé.
Dialogue: 0,0:01:40.06,0:01:43.74,Default,,0,0,0,,Thực tình thì tôi cũng từng nói\Nnên dừng lại thì hơn nhỉ?
Dialogue: 0,0:01:44.15,0:01:46.16,Default,,0,0,0,,"Gintama đã kết thúc viên mãn rồi,
Dialogue: 0,0:01:46.16,0:01:49.56,Default,,0,0,0,,miễn cưỡng câu kéo sang\NGinpachi-sensei chỉ tổ thất bại thôi."
Dialogue: 0,0:01:49.56,0:01:51.04,Default,,0,0,0,,Nghiêm túc nhắc như vậy đó.
Dialogue: 0,0:01:51.04,0:01:52.30,Default,,0,0,0,,Kết thúc viên mãn quái gì!?
Dialogue: 0,0:01:52.30,0:01:55.54,Default,,0,0,0,,Như này chẳng phải Gintama\Nsẽ bị Dragon *beep* ghi hận sao!?
Dialogue: 0,0:01:55.54,0:01:56.64,Default,,0,0,0,,Giờ tôi đã nhìn ra rồi.
Dialogue: 0,0:01:56.64,0:02:00.08,Default,,0,0,0,,Cái người ta đợi không phải Ginpachi-sensei\Nmà là hành trình của Gintama GT.
Dialogue: 0,0:02:00.08,0:02:02.31,Default,,0,0,0,,Thật lòng phải\N"Xin lỗi Toriyama-sensei" rồi.
Dialogue: 0,0:02:02.37,0:02:06.05,Default,,0,0,0,,Tức là Gintama cũ muốn\N"Xin lỗi Toriyama-sensei!" chứ gì?
Dialogue: 0,0:02:06.21,0:02:09.31,Default,,0,0,0,,Tóm lại là trong lúc dân tình đang tưởng\N"Anime Gintama tái phát sóng"
Dialogue: 0,0:02:09.31,0:02:11.87,Default,,0,0,0,,một tác phẩm khác hẳn\Nlấy chủ đề học đường lại bắt đầu.
Dialogue: 0,0:02:11.89,0:02:13.85,Default,,0,0,0,,Kiểu gì fan cũng sẽ\Nthấy khó hiểu đúng không?
Dialogue: 0,0:02:13.88,0:02:14.86,Default,,0,0,0,,Chính vì thế!
Dialogue: 0,0:02:15.12,0:02:20.51,Default,,0,0,0,,Tôi mới chuyển giao cho cậu\Ncây gậy nhân vật chính!
Dialogue: 0,0:02:20.71,0:02:22.06,Default,,0,0,0,,Nào, nhìn qua bên đó đi.
Dialogue: 0,0:02:22.10,0:02:24.16,Default,,0,0,0,,Mọi người bắt đầu chuyển giao gậy rồi kìa.
Dialogue: 0,0:02:24.24,0:02:26.12,Default,,0,0,0,,Không, chỉ là thay đồ thôi mà?
Dialogue: 0,0:02:26.40,0:02:29.26,Default,,0,0,0,,Nhân sự mảng anime\Ncũng nghiêm túc chuyển giao đó.
Dialogue: 0,0:02:30.15,0:02:31.37,Default,,0,0,0,,Không nổi kìa!
Dialogue: 0,0:02:31.42,0:02:33.78,Default,,0,0,0,,ĐẠO DIỄN ĐỜI ĐẦU, ĐỜI HAI, ĐỜI BA\NGậy nặng quá chịu không nổi luôn mà.
Dialogue: 0,0:02:33.85,0:02:36.90,Default,,0,0,0,,Chuyển giao kiểu gì chỉ thấy\Ntạo áp lực nghiền cho nát người ấy!
Dialogue: 0,0:02:36.93,0:02:38.73,Default,,0,0,0,,Nhân tiện thì\Nnhân sự chủ chốt của Ginpachi
Dialogue: 0,0:02:38.73,0:02:41.21,Default,,0,0,0,,nhiều người đã nhận gậy theo nghĩa khác.
Dialogue: 0,0:02:41.24,0:02:42.34,Default,,0,0,0,,Đã có chuyện gì vậy!?
Dialogue: 0,0:02:42.34,0:02:45.58,Default,,0,0,0,,Trước khi chuyển giao nhân vật chính\Nhọ đã chọc giận ai đó à?
Dialogue: 0,0:02:45.82,0:02:47.24,Default,,0,0,0,,Tôi đã nói rồi mà.
Dialogue: 0,0:02:47.28,0:02:49.62,Default,,0,0,0,,Ta mà không chuyển giao\Nvai trò nhân vật chính
Dialogue: 0,0:02:49.62,0:02:51.62,Default,,0,0,0,,thì nhiều chỗ sẽ phát sinh thiệt hại đấy.
Dialogue: 0,0:02:51.90,0:02:54.14,Default,,0,0,0,,Nhìn đi, cả Shinpachi lẫn Kagura...
Dialogue: 0,0:02:54.47,0:02:55.16,Default,,0,0,0,,Này!
Dialogue: 0,0:02:55.18,0:02:57.53,Default,,0,0,0,,Sao lại có cảnh\Nchuyển giao gậy thực tế vậy!?
Dialogue: 0,0:02:57.55,0:02:59.27,Default,,0,0,0,,Lại còn có mùi Netflix nữa chứ.
Dialogue: 0,0:02:59.34,0:03:02.40,Default,,0,0,0,,Như này không phải Gintama GT\Nmà sẽ là Gintama Evolution đấy!?
Dialogue: 0,0:03:02.44,0:03:03.40,Default,,0,0,0,,Thì biết làm sao được.
Dialogue: 0,0:03:03.42,0:03:07.90,Default,,0,0,0,,Phải sớm ****** cho *****\Nthì mới ******* được.
Dialogue: 0,0:03:07.92,0:03:09.71,Default,,0,0,0,,Cũng bởi thời nay khó khăn lắm mà.
Dialogue: 0,0:03:09.72,0:03:11.79,Default,,0,0,0,,Chuyển giao kiểu đấy\Nlà tuyệt đối không được!
Dialogue: 0,0:03:12.04,0:03:12.89,Default,,0,0,0,,Tóm lại là thế.
Dialogue: 0,0:03:13.48,0:03:16.90,Default,,0,0,0,,Cậu hãy nhận lấy cây gậy\Nnhân vật chính này đi.
Dialogue: 0,0:03:27.56,0:03:29.56,Default,,0,0,0,,UMAIBON
Dialogue: 0,0:03:29.61,0:03:32.58,Default,,0,0,0,,Chỉ là Umaibon thôi à!?
Dialogue: 0,0:03:38.41,0:03:38.94,Default,,0,0,0,,Mơ à?
Dialogue: 0,0:03:41.32,0:03:42.57,Default,,0,0,0,,UMAIBON
Dialogue: 0,0:03:46.56,0:03:47.42,Default,,0,0,0,,Thầy ơi.
Dialogue: 0,0:03:47.83,0:03:50.17,Default,,0,0,0,,Mau bắt đầu vào phần chính đi ạ.
Dialogue: 0,0:03:52.72,0:03:54.73,Default,,0,0,0,,Nếu tôi là thần linh...
Dialogue: 0,0:03:54.73,0:03:57.97,Default,,0,0,0,,thì sẽ để thanh xuân\Nlà hồi kết của đời người.
Dialogue: 0,0:03:58.53,0:04:01.08,Default,,0,0,0,,Tôi mà là thần linh thì sẽ...
Dialogue: 0,0:04:01.47,0:04:04.35,Default,,0,0,0,,thêm kem ly sô-cô-la\Nvào thực đơn của trường.
Dialogue: 0,0:04:07.84,0:04:10.22,Default,,0,0,0,,Năm ba, lớp Z.
Dialogue: 0,0:04:11.06,0:04:13.67,Default,,0,0,0,,Ginpachi-sensei!
Dialogue: 0,0:04:14.98,0:04:20.57,Default,,0,0,0,,ANIME GINPACHI\NSẼ BẮT ĐẦU TỪ HÔM NAY.
Dialogue: 0,0:04:20.57,0:04:24.99,Default,,0,0,0,,NHỮNG GÌ GINTOKI NÓI Ở PHẦN MỞ ĐẦU\NĐA PHẦN LÀ SỰ THẬT.
Dialogue: 0,0:04:26.23,0:04:29.98,Default,,0,0,0,,TẬP 1: THẦY LUYỆN THI BẢO\NKHÔNG CẦN 100 ĐIỂM, CHỈ CẦN 70 THÔI
Dialogue: 0,0:04:29.98,0:04:31.98,Default,,0,0,0,,TRUNG HỌC GINTAMA
Dialogue: 0,0:04:32.60,0:04:36.25,Default,,0,0,0,,Mà thôi, nói thẳng nhé, Sakata-sensei.
Dialogue: 0,0:04:36.28,0:04:39.83,Default,,0,0,0,,Học sinh lớp 3-Z của thầy...
Dialogue: 0,0:04:39.84,0:04:40.49,Default,,0,0,0,,PHÒNG HIỆU TRƯỞNG
Dialogue: 0,0:04:40.49,0:04:42.58,Default,,0,0,0,,thành tích tệ hại quá mức rồi đấy.
Dialogue: 0,0:04:42.58,0:04:44.24,Default,,0,0,0,,HIỆU TRƯỞNG HATA\Nthành tích tệ hại quá mức rồi đấy.
Dialogue: 0,0:04:44.33,0:04:44.87,Default,,0,0,0,,Ể!?
Dialogue: 0,0:04:44.93,0:04:46.55,Default,,0,0,0,,Đây là điểm số của đợt kiểm tra này á?
Dialogue: 0,0:04:46.55,0:04:48.87,Default,,0,0,0,,HIỆU PHÓ JII\NKhông phải tuổi bình quân của nghệ sĩ trẻ hả?
Dialogue: 0,0:04:49.13,0:04:52.27,Default,,0,0,0,,Đây là điểm số đủ để đuổi học đó!
Dialogue: 0,0:04:52.49,0:04:54.09,Default,,0,0,0,,Lần nào kiểm tra cũng vậy...
Dialogue: 0,0:04:55.34,0:04:59.08,Default,,0,0,0,,CHỦ NHIỆM NĂM 3 LỚP Z -\NGIÁO VIÊN QUỐC NGỮ SAKATA GINPACHI
Dialogue: 0,0:04:59.60,0:05:01.61,Default,,0,0,0,,Vụ đó tôi biết chứ.
Dialogue: 0,0:05:01.65,0:05:03.35,Default,,0,0,0,,Dù gì cũng là chủ nhiệm tạm thời mà.
Dialogue: 0,0:05:03.37,0:05:05.61,Default,,0,0,0,,Sakata-sensei, hãy nghe cho nghiêm túc đi!
Dialogue: 0,0:05:05.63,0:05:06.59,Default,,0,0,0,,Vâng.
Dialogue: 0,0:05:09.13,0:05:11.61,Default,,0,0,0,,Thế tính sao đây, ông chủ?
Dialogue: 0,0:05:11.67,0:05:13.31,Default,,0,0,0,,Phải là hiệu trưởng tạm quyền.
Dialogue: 0,0:05:13.32,0:05:14.76,Default,,0,0,0,,Thừa cái "tạm quyền" kìa.
Dialogue: 0,0:05:15.10,0:05:18.53,Default,,0,0,0,,Cứ như này thì\Ntôi sẽ phải dùng biện pháp mạnh.
Dialogue: 0,0:05:18.53,0:05:20.35,Default,,0,0,0,,Biện pháp mạnh á?
Dialogue: 0,0:05:20.39,0:05:23.34,Default,,0,0,0,,Trong đợt kiểm tra sau ngày nghỉ\Ntổ chức vào tuần tới,
Dialogue: 0,0:05:23.34,0:05:27.42,Default,,0,0,0,,phải có ít nhất một môn\Nmà cả lớp được trên 80 điểm!
Dialogue: 0,0:05:27.43,0:05:29.81,Default,,0,0,0,,Trong trường hợp không thể...
Dialogue: 0,0:05:30.61,0:05:33.37,Default,,0,0,0,,toàn bộ lớp Z phải lên trường bổ túc\Ncả thứ bảy và chủ nhật!
Dialogue: 0,0:05:33.40,0:05:37.91,Default,,0,0,0,,Còn cậu sẽ bị cắt 20% lương!
Dialogue: 0,0:05:37.93,0:05:40.05,Default,,0,0,0,,Cắt lương! Cắt lương đó!
Dialogue: 0,0:05:40.86,0:05:43.88,Default,,0,0,0,,Cắt 20% lương á!?
Dialogue: 0,0:05:44.71,0:05:47.18,Default,,0,0,0,,Thật hả trời, vụ đó không đùa được đâu.
Dialogue: 0,0:05:47.87,0:05:50.30,Default,,0,0,0,,Thích thì chiều, hiệu trưởng đẫm máu.
Dialogue: 0,0:05:50.31,0:05:52.26,Default,,0,0,0,,Máu me như này là do cậu chứ ai.
Dialogue: 0,0:05:52.35,0:05:54.17,Default,,0,0,0,,Tốt thôi, tôi sẽ ra tay.
Dialogue: 0,0:05:54.47,0:05:55.85,Default,,0,0,0,,Không, nhất định tôi sẽ làm.
Dialogue: 0,0:05:56.67,0:06:00.02,Default,,0,0,0,,Không chỉ cuối tuần mà là\Nbổ túc sau giờ học cả ngày thường...
Dialogue: 0,0:06:00.02,0:06:03.45,Default,,0,0,0,,hay cắt lương 10% cũng được.
Dialogue: 0,0:06:03.60,0:06:04.28,Default,,0,0,0,,Tôi chiều hết.
Dialogue: 0,0:06:04.67,0:06:07.91,Default,,0,0,0,,Cậu vừa giảm nhẹ hình phạt\Ncho bản thân một cách vô tình kìa.
Dialogue: 0,0:06:07.94,0:06:12.04,Default,,0,0,0,,Hiệu trưởng à, Sakata-sensei\Nđã đề nghị như vậy rồi...
Dialogue: 0,0:06:12.06,0:06:14.46,Default,,0,0,0,,thì cứ duyệt vụ bổ túc\Nsau giờ học ngày thường đê?
Dialogue: 0,0:06:14.47,0:06:16.47,Default,,0,0,0,,Nói với hiệu trưởng kiểu gì đấy, hiệu phó!
Dialogue: 0,0:06:16.49,0:06:18.69,Default,,0,0,0,,Anh bạn à... À không, xin lỗi ạ.
Dialogue: 0,0:06:18.88,0:06:20.80,Default,,0,0,0,,Cậu thật sự chấp nhận như vậy hả?
Dialogue: 0,0:06:20.98,0:06:22.47,Default,,0,0,0,,Chấp nhận mà.
Dialogue: 0,0:06:22.66,0:06:25.79,Default,,0,0,0,,Đổi lại, chỉ giảm 10% lương của tôi nhé.
Dialogue: 0,0:06:25.82,0:06:27.17,Default,,0,0,0,,Vẫn bám víu vụ đó à.
Dialogue: 0,0:06:27.21,0:06:28.47,Default,,0,0,0,,Dĩ nhiên rồi.
Dialogue: 0,0:06:28.62,0:06:30.61,Default,,0,0,0,,Thế nhé, Mister Blood.
Dialogue: 0,0:06:30.63,0:06:33.87,Default,,0,0,0,,Này, đã bảo chính cậu\Nlàm tôi máu me be bét mà!
Dialogue: 0,0:06:34.58,0:06:38.56,Default,,0,0,0,,Mà thôi, tôi mong chờ kết quả lắm đó.
Dialogue: 0,0:06:38.57,0:06:42.71,Default,,0,0,0,,Ginpachi-sensei của lớp 3-Z à.
Dialogue: 0,0:06:48.28,0:06:49.73,Default,,0,0,0,,Tóm lại là...
Dialogue: 0,0:06:50.11,0:06:55.35,Default,,0,0,0,,trong đợt kiểm tra sau ngày nghỉ, phải có\Nít nhất một môn cả lớp được trên 80 điểm!
Dialogue: 0,0:06:55.49,0:06:56.46,Default,,0,0,0,,Cái gì?!
Dialogue: 0,0:06:57.23,0:06:58.26,Default,,0,0,0,,Này!
Dialogue: 0,0:06:58.31,0:07:00.30,Default,,0,0,0,,KAGURA\NĐồ bà vợ nội chợ nhà mày!
Dialogue: 0,0:07:00.30,0:07:03.09,Default,,0,0,0,,Sao dám tự tiện ăn\Nxúc xích bạch tuộc của tao!?
Dialogue: 0,0:07:03.86,0:07:07.43,Default,,0,0,0,,CATHERINE\NHừ, mỗi miếng xúc xích mà lắm mồm thế nhở.
Dialogue: 0,0:07:07.49,0:07:09.04,Default,,0,0,0,,Mau nhè ra cho tao!
Dialogue: 0,0:07:09.05,0:07:09.83,Default,,0,0,0,,Mau!
Dialogue: 0,0:07:09.93,0:07:12.29,Default,,0,0,0,,- Nào! Mau lên!\N- Này, có nghe không hả?
Dialogue: 0,0:07:14.23,0:07:15.69,Default,,0,0,0,,MONE
Dialogue: 0,0:07:18.02,0:07:18.80,Default,,0,0,0,,ỦY VIÊN KỶ LUẬT
Dialogue: 0,0:07:18.80,0:07:20.48,Default,,0,0,0,,HIJIKATA TOUSHIROU\NNày, Sougo.
Dialogue: 0,0:07:21.03,0:07:24.32,Default,,0,0,0,,Cái điện thoại đó chẳng phải của tôi à?
Dialogue: 0,0:07:25.65,0:07:26.73,Default,,0,0,0,,ỦY VIÊN KỶ LUẬT\NThì đúng thế.
Dialogue: 0,0:07:26.73,0:07:27.70,Default,,0,0,0,,OKITA SOUGO
Dialogue: 0,0:07:28.23,0:07:31.59,Default,,0,0,0,,Tại sao cậu lại dùng điện thoại của tôi\Nđăng ký mấy ứng dụng kết đôi?
Dialogue: 0,0:07:31.60,0:07:36.05,Default,,0,0,0,,Để Hijikata-san chậm lớn\Nsau này sẽ không cưới mayonnaise đó.
Dialogue: 0,0:07:36.07,0:07:38.01,Default,,0,0,0,,Vậy à, thế thì cảm ơn nhé.
Dialogue: 0,0:07:38.03,0:07:40.51,Default,,0,0,0,,Nhưng mà đừng có tự tiện!
Dialogue: 0,0:07:40.51,0:07:41.53,Default,,0,0,0,,A, có hồi âm rồi.
Dialogue: 0,0:07:41.53,0:07:43.83,Default,,0,0,0,,Đừng đùa nữa, mau trả cho tôi!
Dialogue: 0,0:07:43.83,0:07:45.52,Default,,0,0,0,,ỦY VIÊN KỶ LUẬT\NOtae-san!
Dialogue: 0,0:07:45.52,0:07:47.13,Default,,0,0,0,,ISAO KONDOU\NÔi!
Dialogue: 0,0:07:47.15,0:07:48.73,Default,,0,0,0,,Sáng nay bạn cũng đẹp tuyệt trần!
Dialogue: 0,0:07:48.78,0:07:51.78,Default,,0,0,0,,Đồng phục thủy thủ\Nnhìn như thể bộ đầm hoàng kim!
Dialogue: 0,0:07:51.89,0:07:53.48,Default,,0,0,0,,SHIMURA TAE
Dialogue: 0,0:07:54.13,0:07:57.31,Default,,0,0,0,,Có thể bỏ cách gọi Otae\Nnghe cổ lỗ sĩ đó không?
Dialogue: 0,0:07:57.51,0:08:00.35,Default,,0,0,0,,Chúng ta đã học sinh năm ba cấp ba rồi.
Dialogue: 0,0:08:00.80,0:08:01.77,Default,,0,0,0,,Vậy như này nhé?
Dialogue: 0,0:08:02.09,0:08:03.48,Default,,0,0,0,,Tae-pan có được không?
Dialogue: 0,0:08:03.49,0:08:05.52,Default,,0,0,0,,Không phải nữ phát thanh viên nhé,\Ntôi giết cậu đó.
Dialogue: 0,0:08:05.52,0:08:06.78,Default,,0,0,0,,Vậy thì Tae-po nhé!
Dialogue: 0,0:08:06.79,0:08:07.50,Default,,0,0,0,,Tôi giết cậu đó!
Dialogue: 0,0:08:07.50,0:08:09.01,Default,,0,0,0,,Vậy thì Tae-ti...
Dialogue: 0,0:08:09.05,0:08:10.88,Default,,0,0,0,,Cứng đầu thế!
Dialogue: 0,0:08:10.88,0:08:11.78,Default,,0,0,0,,Hự!
Dialogue: 0,0:08:16.16,0:08:17.99,Default,,0,0,0,,ỦY VIÊN HỌC TẬP\NNhìn rất giống.
Dialogue: 0,0:08:17.99,0:08:19.38,Default,,0,0,0,,KOTAROU KATSURA
Dialogue: 0,0:08:20.38,0:08:21.39,Default,,0,0,0,,ELIZABETH
Dialogue: 0,0:08:21.45,0:08:22.93,Default,,0,0,0,,Ôi trời.
Dialogue: 0,0:08:22.93,0:08:28.05,Default,,0,0,0,,Quả nhiên chỉ có làm thêm ban đêm\Nmới có lương giờ trên 1000 yên.
Dialogue: 0,0:08:28.05,0:08:29.29,Default,,0,0,0,,HASEGAWA TAIZOU\NHầy...
Dialogue: 0,0:08:29.59,0:08:31.45,Default,,0,0,0,,Vậy đấy, cố gắng làm kiểm tra nhé.
Dialogue: 0,0:08:31.48,0:08:32.19,Default,,0,0,0,,Hết.
Dialogue: 0,0:08:32.70,0:08:35.22,Default,,0,0,0,,Ấy, hết cái gì mà hết!
Dialogue: 0,0:08:35.25,0:08:36.94,Default,,0,0,0,,SHIMURA SHINPACHI\NThầy đã tự tiện hứa hẹn cái gì thế!?
Dialogue: 0,0:08:37.19,0:08:38.66,Default,,0,0,0,,Mọi người nghe cho kỹ đi!
Dialogue: 0,0:08:38.71,0:08:40.59,Default,,0,0,0,,Thầy vừa nói một vụ như vậy đó!
Dialogue: 0,0:08:40.71,0:08:41.25,Default,,0,0,0,,Hở?
Dialogue: 0,0:08:41.85,0:08:43.51,Default,,0,0,0,,Ể!?
Dialogue: 0,0:08:43.86,0:08:44.93,Default,,0,0,0,,Kiểm tra á?
Dialogue: 0,0:08:44.97,0:08:46.51,Default,,0,0,0,,Thế là sao chứ?
Dialogue: 0,0:08:46.72,0:08:48.81,Default,,0,0,0,,Em nhất quyết không bổ túc gì hết!
Dialogue: 0,0:08:48.81,0:08:50.29,Default,,0,0,0,,Nghe không lọt tai gì cả!
Dialogue: 0,0:08:50.86,0:08:55.31,Default,,0,0,0,,Vậy chẳng phải thầy khôn lỏi\Ngiảm hình phạt cho riêng mình sao?
Dialogue: 0,0:08:55.33,0:08:58.63,Default,,0,0,0,,Vì mấy trò thừa thãi của thầy\Nmà phải bổ túc cả ngày thường đó!
Dialogue: 0,0:08:58.97,0:09:03.29,Default,,0,0,0,,Mất khoảng thời gian sau giờ học thì\Nkhông thể đưa Elizabeth đi tản bộ được!
Dialogue: 0,0:09:03.32,0:09:05.54,Default,,0,0,0,,Như vậy làm thêm kiểu gì chứ!
Dialogue: 0,0:09:05.59,0:09:07.82,Default,,0,0,0,,Mấy đứa bây ồn quá!
Dialogue: 0,0:09:08.09,0:09:09.77,Default,,0,0,0,,Than khóc cái quái gì hả!
Dialogue: 0,0:09:10.18,0:09:11.17,Default,,0,0,0,,House!
Dialogue: 0,0:09:13.60,0:09:14.56,Default,,0,0,0,,LƯỢNG ĐƯỜNG
Dialogue: 0,0:09:14.56,0:09:18.07,Default,,0,0,0,,Chuyện tới nước này đều do\Ncái đầu bã đậu của mấy đứa.
Dialogue: 0,0:09:18.09,0:09:20.00,Default,,0,0,0,,Tôi chỉ là người bị liên lụy thôi.
Dialogue: 0,0:09:20.00,0:09:20.61,Default,,0,0,0,,Nghe này.
Dialogue: 0,0:09:20.67,0:09:25.06,Default,,0,0,0,,Không cần tất cả các môn\Nmà chỉ cần một môn 80 điểm thôi!
Dialogue: 0,0:09:26.33,0:09:27.93,Default,,0,0,0,,Kiên cường lên xem nào!
Dialogue: 0,0:09:32.06,0:09:34.05,Default,,0,0,0,,Tôi tin tưởng mấy đứa.
Dialogue: 0,0:09:34.79,0:09:35.31,Default,,0,0,0,,Ể!?
Dialogue: 0,0:09:35.73,0:09:36.49,Default,,0,0,0,,Nghe nhé.
Dialogue: 0,0:09:37.45,0:09:39.47,Default,,0,0,0,,Mấy đứa là quýt thối!
Dialogue: 0,0:09:39.48,0:09:40.57,Default,,0,0,0,,Không phải đâu!
Dialogue: 0,0:09:40.96,0:09:43.56,Default,,0,0,0,,Ấy, khúc đó có phải như thế đâu!
Dialogue: 0,0:09:44.45,0:09:45.64,Default,,0,0,0,,Xin lỗi mau!
Dialogue: 0,0:09:45.66,0:09:47.74,Default,,0,0,0,,Xin lỗi vì bất kính với Takeda **** đi!
Dialogue: 0,0:09:49.54,0:09:51.60,Default,,0,0,0,,Nào, bắt đầu hội nghị tìm đối sách thôi.
Dialogue: 0,0:09:51.63,0:09:52.23,Default,,0,0,0,,Thưa thầy!
Dialogue: 0,0:09:52.85,0:09:56.89,Default,,0,0,0,,Hình như ban nhạc khi tuyển thành viên\Nkhông nhận tóc dài và đầu gấu.
Dialogue: 0,0:09:57.19,0:09:59.40,Default,,0,0,0,,Như vậy là em bị loại sao?
Dialogue: 0,0:10:00.34,0:10:02.28,Default,,0,0,0,,Tóc dài như cậu thì không duyệt đâu.
Dialogue: 0,0:10:02.49,0:10:03.67,Default,,0,0,0,,Mà đó chỉ là tóc giả nhỉ?
Dialogue: 0,0:10:03.67,0:10:06.21,Default,,0,0,0,,Sao cũng được,\Nmau cắt hoặc gỡ xuống đi.
Dialogue: 0,0:10:06.24,0:10:07.79,Default,,0,0,0,,ĐÃ CHUẨN BỊ SẴN KHIẾU NẠI\NEm kiện thầy đấy.
Dialogue: 0,0:10:07.89,0:10:08.76,Default,,0,0,0,,Thưa thầy!
Dialogue: 0,0:10:08.78,0:10:12.73,Default,,0,0,0,,Vị trí cầm ghi-ta của em cao hơn mọi người\Nthì có được vào ban nhạc không ạ?
Dialogue: 0,0:10:12.75,0:10:15.05,Default,,0,0,0,,Em tìm hiểu\Nvề cái thứ gọi là "ghi-ta" đi đã.
Dialogue: 0,0:10:15.05,0:10:16.03,Default,,0,0,0,,Thưa thầy.
Dialogue: 0,0:10:16.03,0:10:19.94,Default,,0,0,0,,Có nhiều nghệ sĩ\Nsẽ đập phá nhạc cụ sau buổi diễn,
Dialogue: 0,0:10:19.97,0:10:23.12,Default,,0,0,0,,nhưng em thì muốn\Nđập lợn đất vào lúc đó cơ.
Dialogue: 0,0:10:23.35,0:10:25.29,Default,,0,0,0,,Tiền tiết kiệm mua mayonnaise của tôi!
Dialogue: 0,0:10:25.55,0:10:27.81,Default,,0,0,0,,Cũng được, thích thì cứ làm.
Dialogue: 0,0:10:27.87,0:10:30.32,Default,,0,0,0,,Hãy để ca sĩ của ban nhạc là Otae-san ạ!
Dialogue: 0,0:10:30.41,0:10:33.44,Default,,0,0,0,,Bạn ấy sẽ hát một bài tươi sáng\Nkhiến lồng ngực căng tràn hi vọng...
Dialogue: 0,0:10:33.46,0:10:36.21,Default,,0,0,0,,Xin lỗi nhé, ngực tôi không có căng.
Dialogue: 0,0:10:36.22,0:10:38.39,Default,,0,0,0,,Ấy ấy ấy, tôi không có ý đó...
Dialogue: 0,0:10:38.46,0:10:39.42,Default,,0,0,0,,Này, mọi người!
Dialogue: 0,0:10:39.42,0:10:41.01,Default,,0,0,0,,Đang đối phó với đợt kiểm tra mà!
Dialogue: 0,0:10:41.01,0:10:43.76,Default,,0,0,0,,Tại sao lại thành\Nbàn chuyện ban nhạc vậy!?
Dialogue: 0,0:10:44.13,0:10:45.52,Default,,0,0,0,,Này, do đứa nào thế?
Dialogue: 0,0:10:45.55,0:10:46.52,Default,,0,0,0,,Do thầy chứ ai!
Dialogue: 0,0:10:46.56,0:10:49.43,Default,,0,0,0,,Nguyên nhân là do thầy viết\N"Không duyệt đầu gấu tóc dài" đó!
Dialogue: 0,0:10:49.65,0:10:50.55,Default,,0,0,0,,Lắm lời thế.
Dialogue: 0,0:10:50.55,0:10:52.03,Default,,0,0,0,,Đùa một chút thì có sao đâu.
Dialogue: 0,0:10:52.03,0:10:54.03,Default,,0,0,0,,Giờ là lúc để đùa đấy à!?
Dialogue: 0,0:11:05.38,0:11:07.42,Default,,0,0,0,,HEDORO
Dialogue: 0,0:11:10.79,0:11:12.44,Default,,0,0,0,,À thì...
Dialogue: 0,0:11:12.70,0:11:15.67,Default,,0,0,0,,Ý em là... họp bàn nghiêm chỉnh đi à?
Dialogue: 0,0:11:17.11,0:11:18.89,Default,,0,0,0,,Ừm, tôi hiểu rồi.
Dialogue: 0,0:11:19.31,0:11:21.05,Default,,0,0,0,,Nghiêm túc nào.
Dialogue: 0,0:11:21.71,0:11:25.31,Default,,0,0,0,,Tôi sẽ nghiêm túc\Nđể giữ lại cái mạng này...
Dialogue: 0,0:11:25.82,0:11:26.54,Default,,0,0,0,,LƯỢNG ĐƯỜNG
Dialogue: 0,0:11:26.54,0:11:31.24,Default,,0,0,0,,Tóm lại là cứ dùng mọi cách\Nđể đạt 80 điểm là được.
Dialogue: 0,0:11:31.45,0:11:35.57,Default,,0,0,0,,Không từ thủ đoạn,\Nphải không từ thủ đoạn!
Dialogue: 0,0:11:35.76,0:11:36.50,Default,,0,0,0,,Dạ thưa...
Dialogue: 0,0:11:37.03,0:11:38.66,Default,,0,0,0,,Ý thầy là...
Dialogue: 0,0:11:38.71,0:11:39.83,Default,,0,0,0,,Rõ quá rồi còn gì.
Dialogue: 0,0:11:43.25,0:11:44.21,Default,,0,0,0,,Quay cóp.
Dialogue: 0,0:11:44.21,0:11:45.63,Default,,0,0,0,,Quay cóp á?
Dialogue: 0,0:11:45.69,0:11:49.73,Default,,0,0,0,,Chỉ cần quay cóp thì đạt 80 điểm\Ndễ như giật kẹo của trẻ con.
Dialogue: 0,0:11:49.74,0:11:50.28,Default,,0,0,0,,Thưa thầy!
Dialogue: 0,0:11:50.29,0:11:51.54,Default,,0,0,0,,Đó là ngược đãi trẻ em!
Dialogue: 0,0:11:51.58,0:11:52.50,Default,,0,0,0,,Chỉ là ví von thôi.
Dialogue: 0,0:11:52.62,0:11:53.91,Default,,0,0,0,,Em lớn rồi mà, phải hiểu chứ!
Dialogue: 0,0:11:53.91,0:11:55.95,Default,,0,0,0,,Nhưng thầy ơi, quay cóp thì có hơi...
Dialogue: 0,0:11:56.07,0:11:57.39,Default,,0,0,0,,Cái lũ ngốc này.
Dialogue: 0,0:11:57.47,0:11:59.50,Default,,0,0,0,,Đang họp bàn đối phó với bài kiểm tra đấy.
Dialogue: 0,0:11:59.68,0:12:02.17,Default,,0,0,0,,Đồng nghĩa với việc\Nhọp bàn cách quay cóp chứ gì nữa.
Dialogue: 0,0:12:02.18,0:12:03.85,Default,,0,0,0,,Ấy, đồng nghĩa kiểu gì lạ đời vậy!
Dialogue: 0,0:12:03.90,0:12:05.13,Default,,0,0,0,,Shin-chan.
Dialogue: 0,0:12:05.17,0:12:05.93,Default,,0,0,0,,Chị?
Dialogue: 0,0:12:06.46,0:12:07.96,Default,,0,0,0,,Em là con trai cơ mà.
Dialogue: 0,0:12:08.13,0:12:10.53,Default,,0,0,0,,Tới quay cóp còn không nổi\Nthì biết phải làm sao đây?
Dialogue: 0,0:12:10.58,0:12:13.27,Default,,0,0,0,,Ấy, đừng nói như kiểu\Nđang cãi nhau chứ...
Dialogue: 0,0:12:13.27,0:12:14.87,Default,,0,0,0,,Em sợ bị phát hiện sao?
Dialogue: 0,0:12:14.91,0:12:15.74,Default,,0,0,0,,Chị à!
Dialogue: 0,0:12:16.02,0:12:18.09,Default,,0,0,0,,Giờ không phải lúc càu nhàu đâu!
Dialogue: 0,0:12:18.09,0:12:19.74,Default,,0,0,0,,Hạ quyết tâm đi, Shinpachi!
Dialogue: 0,0:12:19.76,0:12:20.78,Default,,0,0,0,,Shinpachi!
Dialogue: 0,0:12:20.95,0:12:21.83,Default,,0,0,0,,Shin-chan!
Dialogue: 0,0:12:21.83,0:12:22.75,Default,,0,0,0,,N-Nhưng mà...
Dialogue: 0,0:12:23.44,0:12:24.98,Default,,0,0,0,,C-Có chuyện gì à...
Dialogue: 0,0:12:25.32,0:12:26.41,Default,,0,0,0,,Hedoro-san.
Dialogue: 0,0:12:28.93,0:12:30.79,Default,,0,0,0,,Hả, hãy quay cóp á!?
Dialogue: 0,0:12:30.82,0:12:32.76,Default,,0,0,0,,Tính cách coi trọng\Nsự đoàn kết của lớp à!?
Dialogue: 0,0:12:32.81,0:12:34.54,Default,,0,0,0,,Rồi, tôi hiểu rồi!
Dialogue: 0,0:12:35.12,0:12:40.81,Default,,0,0,0,,Nếu em chịu theo vụ này, tôi sẽ mời\NIdol Terakado Tsuu tới lễ hội văn hóa.
Dialogue: 0,0:12:48.23,0:12:49.23,Default,,0,0,0,,ĐỘI CẬN VỆ TERAKADO TSUU
Dialogue: 0,0:12:49.23,0:12:50.77,Default,,0,0,0,,ĐỘI TRƯỞNG
Dialogue: 0,0:12:51.83,0:12:52.69,Default,,0,0,0,,Tôi sẽ...
Dialogue: 0,0:12:53.20,0:12:55.79,Default,,0,0,0,,đưa kế hoạch mời cô ấy\Ncho ban tổ chức.
Dialogue: 0,0:12:56.03,0:12:57.99,Default,,0,0,0,,Như này là hết ý kiến nhé?
Dialogue: 0,0:12:58.15,0:12:59.59,Default,,0,0,0,,Như này thì đứa nào...
Dialogue: 0,0:12:59.59,0:13:02.08,Default,,0,0,0,,còn dám ý kiến hả!?
Dialogue: 0,0:13:02.09,0:13:03.79,Default,,0,0,0,,Lũ vô năng kia!
Dialogue: 0,0:13:03.83,0:13:05.91,Default,,0,0,0,,Mau nghĩ cách quay cóp mà không lộ!
Dialogue: 0,0:13:06.16,0:13:09.93,Default,,0,0,0,,Nghĩ đi, Chiến ký Lodoss!
Dialogue: 0,0:13:14.34,0:13:16.97,Default,,0,0,0,,THẦY GINPACHI Ở LỚP 3-Z
Dialogue: 0,0:13:17.19,0:13:18.55,Default,,0,0,0,,HÃY NGHĨ CÁCH QUAY CÓP MÀ KHÔNG LỘ
Dialogue: 0,0:13:18.55,0:13:20.02,Default,,0,0,0,,Giờ thì...
Dialogue: 0,0:13:20.34,0:13:22.34,Default,,0,0,0,,có ai nghĩ ra cách gì hay ho chưa?
Dialogue: 0,0:13:22.34,0:13:23.32,Default,,0,0,0,,Thầy ơi.
Dialogue: 0,0:13:23.74,0:13:26.68,Default,,0,0,0,,Đầu tiên, dùng vật cùn đánh ngất giám thị.
Dialogue: 0,0:13:26.70,0:13:29.02,Default,,0,0,0,,Hoặc có thể dùng chloroform để cho ngủ...
Dialogue: 0,0:13:29.06,0:13:30.42,Default,,0,0,0,,Có ý kiến nào khác không?
Dialogue: 0,0:13:30.42,0:13:31.52,Default,,0,0,0,,Như này nhé.
Dialogue: 0,0:13:31.76,0:13:36.28,Default,,0,0,0,,Em có cảm giác chúng ta nghĩ ngợi mãi\Nnhưng lại quên mất chuyện quan trọng.
Dialogue: 0,0:13:36.34,0:13:37.55,Default,,0,0,0,,Gì thế, gì thế?
Dialogue: 0,0:13:37.55,0:13:39.10,Default,,0,0,0,,Tự dưng muốn làm thám tử lừng danh à?
Dialogue: 0,0:13:39.10,0:13:40.78,Default,,0,0,0,,Trai tân bốn mắt,\Nnhạt nhẽo, chuyên bắt bẻ!
Dialogue: 0,0:13:40.78,0:13:42.92,Default,,0,0,0,,Trai tân á!?\NVừa nói trai tân đúng không!?
Dialogue: 0,0:13:42.92,0:13:44.02,Default,,0,0,0,,Tiếp tục nói đi.
Dialogue: 0,0:13:44.26,0:13:46.34,Default,,0,0,0,,Pháp sư bốn mắt, trai tân,\Nnhạt nhẽo, chuyên bắt lỗi.
Dialogue: 0,0:13:46.34,0:13:48.67,Default,,0,0,0,,Chưa tới 30 tuổi\Nthì chưa chốt là trai tân nhé!
Dialogue: 0,0:13:50.04,0:13:51.16,Default,,0,0,0,,Như này nhé.
Dialogue: 0,0:13:51.19,0:13:54.56,Default,,0,0,0,,Đầu tiên, nên quyết định\Nsẽ quay cóp ở môn nào, đúng không?
Dialogue: 0,0:13:54.91,0:13:58.36,Default,,0,0,0,,Còn nữa, em nghĩ\Nnếu không biết đề bài sẽ có gì...
Dialogue: 0,0:13:58.38,0:14:00.45,Default,,0,0,0,,thì không thể quay cóp được.
Dialogue: 0,0:14:02.89,0:14:04.16,Default,,0,0,0,,Những lời em nói...
Dialogue: 0,0:14:04.77,0:14:05.84,Default,,0,0,0,,Thầy hiểu chứ ạ?
Dialogue: 0,0:14:06.34,0:14:08.41,Default,,0,0,0,,À thì, Shinpachi-kun à...
Dialogue: 0,0:14:08.89,0:14:12.82,Default,,0,0,0,,Đề thi ấy nhé... đâu có dễ mà lấy được.
Dialogue: 0,0:14:13.42,0:14:16.68,Default,,0,0,0,,Ginpachi-sensei không phải là\Nngười ra đề môn quốc ngữ sao?
Dialogue: 0,0:14:17.42,0:14:20.96,Default,,0,0,0,,À, mấy cái việc thế này ấy...\Nthì phải để người khác, nói sao nhỉ...
Dialogue: 0,0:14:21.25,0:14:25.33,Default,,0,0,0,,Cần phải để cho những giáo viên\Nbình thường không biết tấu hài là gì...
Dialogue: 0,0:14:25.70,0:14:28.22,Default,,0,0,0,,Thầy vừa tự nhận mình là bất thường đấy ạ.
Dialogue: 0,0:14:29.22,0:14:31.60,Default,,0,0,0,,Tóm lại là vậy đấy, Shinpachi-kun.
Dialogue: 0,0:14:33.02,0:14:35.90,Default,,0,0,0,,Chúng ta... không thể quay cóp...
Dialogue: 0,0:14:36.55,0:14:37.80,Default,,0,0,0,,Hiểu thế đúng không nhỉ?
Dialogue: 0,0:14:38.88,0:14:41.27,Default,,0,0,0,,Thì... có vẻ vậy.
Dialogue: 0,0:14:43.46,0:14:44.85,Default,,0,0,0,,Vậy à...
Dialogue: 0,0:14:45.25,0:14:47.12,Default,,0,0,0,,Không làm được à...
Dialogue: 0,0:14:48.31,0:14:50.01,Default,,0,0,0,,Cũng phải thôi...
Dialogue: 0,0:14:51.25,0:14:56.41,Default,,0,0,0,,Không biết câu hỏi\Nthì khỏi quay cóp luôn nhở?
Dialogue: 0,0:14:56.90,0:14:58.73,Default,,0,0,0,,Đúng là vậy rồi...
Dialogue: 0,0:14:59.71,0:15:01.77,Default,,0,0,0,,Đừng có mà giỡn mặt!
Dialogue: 0,0:15:02.03,0:15:03.38,Default,,0,0,0,,Giờ tính sao! Tính sao đây!?
Dialogue: 0,0:15:03.58,0:15:05.81,Default,,0,0,0,,Đang tính cho cả lũ quay cóp cơ mà!
Dialogue: 0,0:15:06.12,0:15:07.00,Default,,0,0,0,,Ai biết chứ!
Dialogue: 0,0:15:10.32,0:15:14.34,Default,,0,0,0,,Thôi, em nghĩ giờ cách duy nhất là\Nmọi người phải học hành nghiêm túc.
Dialogue: 0,0:15:15.13,0:15:18.88,Default,,0,0,0,,Học hẳn hoi và\Nđàng hoàng đạt 80 điểm nào.
Dialogue: 0,0:15:19.16,0:15:24.14,Default,,0,0,0,,Nhưng dù không quay cóp,\Nnói học thì chọn môn nào bây giờ?
Dialogue: 0,0:15:24.88,0:15:26.96,Default,,0,0,0,,Sao không chọn tiếng Anh đi.
Dialogue: 0,0:15:27.55,0:15:28.18,Default,,0,0,0,,Tiếng Anh?
Dialogue: 0,0:15:28.69,0:15:29.07,Default,,0,0,0,,Vâng.
Dialogue: 0,0:15:29.79,0:15:30.76,Default,,0,0,0,,Thật ra môn tiếng Anh
Dialogue: 0,0:15:31.16,0:15:35.44,Default,,0,0,0,,hình như sẽ ra\Nba câu có trong sách bài tập.
Dialogue: 0,0:15:35.44,0:15:36.19,Default,,0,0,0,,TIN CHUẨN CHƯA BẠN ƠI?
Dialogue: 0,0:15:36.19,0:15:39.70,Default,,0,0,0,,Chỉ cần học thuộc lòng\Nlà dễ dàng lấy ít nhất 20 điểm.
Dialogue: 0,0:15:40.22,0:15:42.82,Default,,0,0,0,,Tôi ngán tiếng Anh lắm.
Dialogue: 0,0:15:42.82,0:15:43.88,Default,,0,0,0,,Vãi cả chưởng!
Dialogue: 0,0:15:43.88,0:15:46.13,Default,,0,0,0,,Nhìn mặt bà rõ ràng là\Nkiểu giỏi tiếng Anh mà!
Dialogue: 0,0:15:46.34,0:15:49.56,Default,,0,0,0,,Đánh giá người khác qua vẻ ngoài là\Nphân biệt ngoại hình đấy, đồ cận đụt!
Dialogue: 0,0:15:49.60,0:15:51.32,Default,,0,0,0,,Bà cũng xoáy ngoại hình tôi còn gì!
Dialogue: 0,0:15:51.85,0:15:52.99,Default,,0,0,0,,Chỉ có tiếng Anh thôi.
Dialogue: 0,0:15:53.16,0:15:55.87,Default,,0,0,0,,Chúng ta sẽ có chắc 20 điểm mà.
Dialogue: 0,0:15:55.93,0:15:58.03,Default,,0,0,0,,Vậy là chỉ còn 41 điểm nữa thôi nhỉ?
Dialogue: 0,0:15:58.05,0:15:59.80,Default,,0,0,0,,60 điểm! Là 60 điểm!
Dialogue: 0,0:15:59.93,0:16:01.22,Default,,0,0,0,,Toán cũng bết bát luôn à!!!
Dialogue: 0,0:16:01.41,0:16:02.81,Default,,0,0,0,,Cơ mà mọi người à!
Dialogue: 0,0:16:02.94,0:16:04.71,Default,,0,0,0,,Chỉ cần cố học là đâu sẽ vào đấy thôi!
Dialogue: 0,0:16:06.08,0:16:08.92,Default,,0,0,0,,Rồi, đã thành như vậy\Nthì cứ lần khần cũng vô ích.
Dialogue: 0,0:16:09.22,0:16:10.87,Default,,0,0,0,,Cứ theo ý của Shinpachi đi.
Dialogue: 0,0:16:11.24,0:16:12.35,Default,,0,0,0,,Này, mấy đứa.
Dialogue: 0,0:16:12.84,0:16:14.25,Default,,0,0,0,,Bỏ hẳn quay cóp đi nhé.
Dialogue: 0,0:16:14.76,0:16:16.23,Default,,0,0,0,,Mọi người cùng hợp sức.
Dialogue: 0,0:16:16.73,0:16:21.84,Default,,0,0,0,,Đoàn kết, học tập,\Nđạt trên 80 điểm chính là mục tiêu
Dialogue: 0,0:16:21.86,0:16:23.51,Default,,0,0,0,,để tất cả cùng phấn đấu!
Dialogue: 0,0:16:24.50,0:16:25.94,Default,,0,0,0,,Ô!
Dialogue: 0,0:16:27.05,0:16:28.80,Default,,0,0,0,,HÔM SAU, SAU GIỜ HỌC...
Dialogue: 0,0:16:33.43,0:16:34.93,Default,,0,0,0,,HẾT NỔI RỒI
Dialogue: 0,0:16:41.63,0:16:43.45,Default,,0,0,0,,Chỉ mới học có một chút...
Dialogue: 0,0:16:44.40,0:16:46.18,Default,,0,0,0,,Mà cả lớp đã thảm thế này...
Dialogue: 0,0:16:48.02,0:16:50.60,Default,,0,0,0,,Tôi không bảo mấy đứa\Nbiến thành người nước ngoài,
Dialogue: 0,0:16:50.72,0:16:54.40,Default,,0,0,0,,chỉ cần học thuộc câu hỏi\Nvới câu trả lời trong sách là đủ.
Dialogue: 0,0:16:54.72,0:16:55.86,Default,,0,0,0,,Này, ủy viên y tế!
Dialogue: 0,0:16:57.39,0:16:59.10,Default,,0,0,0,,Thầy gọi em ạ?
Dialogue: 0,0:16:59.10,0:17:00.21,Default,,0,0,0,,ỦY VIÊN Y TẾ - SARUTOBI AYAME
Dialogue: 0,0:17:00.42,0:17:02.64,Default,,0,0,0,,Tôi ra lệnh cho em thực hiện cứu hộ.
Dialogue: 0,0:17:02.78,0:17:05.64,Default,,0,0,0,,Trước hết, hãy động viên\Ncon khỉ đột đằng kia đi.
Dialogue: 0,0:17:06.20,0:17:07.72,Default,,0,0,0,,Đ-Động viên?
Dialogue: 0,0:17:08.92,0:17:10.37,Default,,0,0,0,,Động viên lỗ hậu à!?
Dialogue: 0,0:17:11.40,0:17:12.49,Default,,0,0,0,,Trị liệu châm cứu.
Dialogue: 0,0:17:13.40,0:17:14.77,Default,,0,0,0,,Châm kim vào lỗ hậu á!?
Dialogue: 0,0:17:14.80,0:17:16.08,Default,,0,0,0,,C-Chờ đã!
Dialogue: 0,0:17:16.08,0:17:17.65,Default,,0,0,0,,Động viên... lỗ hậu...
Dialogue: 0,0:17:21.68,0:17:24.06,Default,,0,0,0,,Á!
Dialogue: 0,0:17:24.20,0:17:26.69,Default,,0,0,0,,Rồi, mấy đứa khí thế lên nào.
Dialogue: 0,0:17:27.02,0:17:29.22,Default,,0,0,0,,Nếu không, ủy viên y tế\Nsẽ đến động viên đấy.
Dialogue: 0,0:17:29.63,0:17:30.26,Default,,0,0,0,,Vâng!
Dialogue: 0,0:17:31.00,0:17:32.51,Default,,0,0,0,,Dạ thưa, Sakata-sensei...
Dialogue: 0,0:17:32.92,0:17:33.40,Default,,0,0,0,,Hử?
Dialogue: 0,0:17:33.49,0:17:36.12,Default,,0,0,0,,Thầy có thể động viên em được không ạ?
Dialogue: 0,0:17:36.79,0:17:38.58,Default,,0,0,0,,Giống như mọi lần,\Nsâu thật là sâu ấy.
Dialogue: 0,0:17:38.60,0:17:40.07,Default,,0,0,0,,Như mọi lần là như thế nào cơ?
Dialogue: 0,0:17:40.07,0:17:43.08,Default,,0,0,0,,Trong tiểu thuyết mộng mơ dài kỳ\Nem đăng trên mạng,
Dialogue: 0,0:17:43.27,0:17:45.65,Default,,0,0,0,,thầy lúc nào cũng làm sâu ơi là sâu...
Dialogue: 0,0:17:45.76,0:17:47.38,Default,,0,0,0,,Đừng có tự ý đăng truyện!
Dialogue: 0,0:17:47.54,0:17:48.98,Default,,0,0,0,,Con mắm Natto!
Dialogue: 0,0:17:50.48,0:17:52.84,Default,,0,0,0,,Tóm lại, dù có\Nchuyện này chuyện nọ xảy ra...
Dialogue: 0,0:17:53.23,0:17:56.70,Default,,0,0,0,,bọn tôi đã cố gắng suốt một tuần\Nhọc thuộc cả quyển sách bài tập
Dialogue: 0,0:17:56.75,0:17:59.10,Default,,0,0,0,,và chào đón ngày kiểm tra.
Dialogue: 0,0:17:59.10,0:18:00.72,Default,,0,0,0,,NGÀY KIỂM TRA...
Dialogue: 0,0:18:02.06,0:18:04.14,Default,,0,0,0,,Câu hỏi khác hoàn toàn luôn à!
Dialogue: 0,0:18:04.62,0:18:05.20,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:05.54,0:18:07.06,Default,,0,0,0,,Câu hỏi gì thế này?
Dialogue: 0,0:18:07.18,0:18:08.48,Default,,0,0,0,,Siêu khó luôn ấy!
Dialogue: 0,0:18:08.88,0:18:12.55,Default,,0,0,0,,Tất cả những câu cả lớp sống chết học thuộc\Ntrong sách bài tập đều không có!
Dialogue: 0,0:18:13.37,0:18:14.85,Default,,0,0,0,,Không hiểu gì hết!
Dialogue: 0,0:18:22.28,0:18:25.45,Default,,0,0,0,,Tin chuẩn kiểu quái gì đấy!?\NGiỡn mặt nhau à!
Dialogue: 0,0:18:25.52,0:18:27.35,Default,,0,0,0,,20 điểm cái gì!
Dialogue: 0,0:18:27.42,0:18:28.82,Default,,0,0,0,,0 điểm xừ rồi còn đâu!
Dialogue: 0,0:18:28.85,0:18:30.25,Default,,0,0,0,,Đừng có mà chơi nhau chứ!
Dialogue: 0,0:18:30.25,0:18:30.86,Default,,0,0,0,,Chết đi.
Dialogue: 0,0:18:30.86,0:18:33.84,Default,,0,0,0,,Nếu có thời gian ngồi học\Nthì tao đã đi làm thêm rồi!
Dialogue: 0,0:18:34.02,0:18:35.50,Default,,0,0,0,,Chị thất vọng về em, Shin-chan.
Dialogue: 0,0:18:35.50,0:18:37.51,Default,,0,0,0,,TAO SẼ XÓA BỎ SỰ TỒN TẠI CỦA MÀY!\NVụ này tôi sẽ đi kiện!
Dialogue: 0,0:18:38.16,0:18:39.46,Default,,0,0,0,,Chờ đã!! Bây giờ là sao?
Dialogue: 0,0:18:39.78,0:18:43.28,Default,,0,0,0,,Giờ cả lớp đang đoàn kết\Ncùng chung mục tiêu đấy hả!?
Dialogue: 0,0:18:43.28,0:18:43.76,Default,,0,0,0,,Lắm mồm!
Dialogue: 0,0:18:43.86,0:18:46.06,Default,,0,0,0,,Mày là đồ thần đằng vô dụng!
Dialogue: 0,0:18:46.28,0:18:47.23,Default,,0,0,0,,Đưa tiền bồi thường đây!
Dialogue: 0,0:18:47.23,0:18:49.52,Default,,0,0,0,,LƯỢNG ĐƯỜNG
Dialogue: 0,0:18:54.64,0:18:57.76,Default,,0,0,0,,Xin lỗi vì xen ngang\Nbạo lực học đường nhé.
Dialogue: 0,0:18:58.01,0:18:59.36,Default,,0,0,0,,Có chuyện gì?
Dialogue: 0,0:18:59.67,0:19:00.72,Default,,0,0,0,,Còn hỏi nữa à?
Dialogue: 0,0:19:01.23,0:19:04.38,Default,,0,0,0,,Ta tới để nhìn mặt cái lớp\Nthua cuộc thảm hại này chứ sao.
Dialogue: 0,0:19:04.85,0:19:09.08,Default,,0,0,0,,Kể từ hôm nay, mấy đứa\Nsẽ phải bổ túc sau giờ học đấy nhé!
Dialogue: 0,0:19:09.31,0:19:12.76,Default,,0,0,0,,Sakata-sensei thì bị giảm 10% lương.
Dialogue: 0,0:19:13.20,0:19:14.76,Default,,0,0,0,,Về vụ đó thì...
Dialogue: 0,0:19:14.91,0:19:21.37,Default,,0,0,0,,tôi muốn nghe lý do chỉ có môn tiếng Anh\Ntự dưng lại khó hẳn như vậy đấy.
Dialogue: 0,0:19:22.20,0:19:25.08,Default,,0,0,0,,Cứ như là thầy đã biết trước...
Dialogue: 0,0:19:25.53,0:19:27.46,Default,,0,0,0,,Lớp Z đặt cược vào tiếng Anh vậy.
Dialogue: 0,0:19:29.74,0:19:31.71,Default,,0,0,0,,Thầy bày trò đúng không?
Dialogue: 0,0:19:32.06,0:19:33.84,Default,,0,0,0,,Lệnh cho giáo viên tiếng Anh...
Dialogue: 0,0:19:34.24,0:19:36.98,Default,,0,0,0,,ra đề thật khó đúng không?
Dialogue: 0,0:19:37.88,0:19:39.81,Default,,0,0,0,,Cậu nói cái gì đấy hả!
Dialogue: 0,0:19:41.99,0:19:43.58,Default,,0,0,0,,N-Này, cậu...
Dialogue: 0,0:19:43.88,0:19:46.72,Default,,0,0,0,,B-B-B-Bạo lực là sai...
Dialogue: 0,0:19:46.82,0:19:48.32,Default,,0,0,0,,Thầy, đừng làm vậy!
Dialogue: 0,0:19:57.28,0:20:00.60,Default,,0,0,0,,Vậy thì hiệu trưởng,\Nthầy biết cái camera này là gì không?
Dialogue: 0,0:20:03.12,0:20:04.04,Default,,0,0,0,,À thì...
Dialogue: 0,0:20:04.76,0:20:06.48,Default,,0,0,0,,Bị camera quay lén thế này...
Dialogue: 0,0:20:06.50,0:20:07.85,Default,,0,0,0,,hết đường lấy chồng rồi!
Dialogue: 0,0:20:07.88,0:20:09.77,Default,,0,0,0,,Kiện quả này thì thắng là chắc.
Dialogue: 0,0:20:09.95,0:20:10.97,Default,,0,0,0,,Đưa tiền bồi thường đây!
Dialogue: 0,0:20:11.13,0:20:13.01,Default,,0,0,0,,Giở trò quay lén lớp học.
Dialogue: 0,0:20:13.61,0:20:18.29,Default,,0,0,0,,Báo cáo với hội đồng giáo dục hay\Nhội đồng cải thiện đồng phục nhỉ?
Dialogue: 0,0:20:19.92,0:20:22.40,Default,,0,0,0,,Hừ! Ta chẳng liên quan gì hết!
Dialogue: 0,0:20:22.59,0:20:24.69,Default,,0,0,0,,Làm gì có chứng cứ, ta thắng là chắc!
Dialogue: 0,0:20:24.93,0:20:28.09,Default,,0,0,0,,Ta là người có quyền,\Nnên đám cải thiện đồng phục, à không...
Dialogue: 0,0:20:28.16,0:20:30.96,Default,,0,0,0,,đám hội đồng giáo dục cũng sẽ tin ta thôi!
Dialogue: 0,0:20:30.96,0:20:32.06,Default,,0,0,0,,Đồ khốn...
Dialogue: 0,0:20:32.06,0:20:33.44,Default,,0,0,0,,Thầy ơi!
Dialogue: 0,0:20:34.67,0:20:35.61,Default,,0,0,0,,Dừng lại đi.
Dialogue: 0,0:20:45.47,0:20:48.32,Default,,0,0,0,,CHỦ TỊCH - OTOSE
Dialogue: 0,0:20:48.32,0:20:50.32,Default,,0,0,0,,Chủ... chủ tịch...
Dialogue: 0,0:20:50.96,0:20:54.17,Default,,0,0,0,,Tôi cứ tưởng mới tập 1\Nthì bà sẽ không xuất hiện cơ.
Dialogue: 0,0:20:54.73,0:20:58.26,Default,,0,0,0,,Hiệu trưởng, thôi bày trò được rồi đấy.
Dialogue: 0,0:20:58.79,0:21:02.07,Default,,0,0,0,,Việc cậu gọi đám giáo viên tiếng Anh\Nlên phòng hiệu trưởng,
Dialogue: 0,0:21:02.23,0:21:05.92,Default,,0,0,0,,rồi lệnh cho họ ra đề thi thật khó ấy...
Dialogue: 0,0:21:06.67,0:21:08.78,Default,,0,0,0,,đều bị ghi lại trong này hết rồi.
Dialogue: 0,0:21:09.65,0:21:11.17,Default,,0,0,0,,Không chối được đâu.
Dialogue: 0,0:21:13.39,0:21:15.46,Default,,0,0,0,,Ginpachi à, hiệu trưởng ấy nhé.
Dialogue: 0,0:21:16.00,0:21:18.20,Default,,0,0,0,,Việc cậu lúc nào cũng uể oải,
Dialogue: 0,0:21:18.32,0:21:22.72,Default,,0,0,0,,mà vẫn được học sinh khá là nghe lời\Nđã làm thầy ấy ngứa mắt.
Dialogue: 0,0:21:22.87,0:21:23.75,Default,,0,0,0,,Thế nên...
Dialogue: 0,0:21:23.98,0:21:27.29,Default,,0,0,0,,thầy ấy mới tìm cách\Nđể cậu và học sinh rạn nứt.
Dialogue: 0,0:21:27.56,0:21:30.07,Default,,0,0,0,,Giống như vụ giở trò lần này ấy.
Dialogue: 0,0:21:31.07,0:21:33.45,Default,,0,0,0,,Xung đột nhàm chán kiểu này\Nnên dừng ở đây đi.
Dialogue: 0,0:21:33.84,0:21:37.53,Default,,0,0,0,,Việc lớp Z phải học bù\Nvà cắt lương Ginpachi đều hủy bỏ.
Dialogue: 0,0:21:39.11,0:21:39.85,Default,,0,0,0,,CHIẾN THẮNG
Dialogue: 0,0:21:39.85,0:21:42.23,Default,,0,0,0,,Chủ tịch đã nói vậy thì đành nghe theo.
Dialogue: 0,0:21:43.08,0:21:44.20,Default,,0,0,0,,Nghe rõ rồi chứ.
Dialogue: 0,0:21:44.55,0:21:45.63,Default,,0,0,0,,Ta biết rồi.
Dialogue: 0,0:21:47.37,0:21:49.85,Default,,0,0,0,,Thôi, lần này ông đã thua rồi.
Dialogue: 0,0:21:49.85,0:21:51.39,Default,,0,0,0,,Ông về phe ai đấy hả!?
Dialogue: 0,0:21:51.39,0:21:53.80,Default,,0,0,0,,Cái kiểu bàng quan\Nkhông liên quan đó là sao?
Dialogue: 0,0:21:53.83,0:21:55.33,Default,,0,0,0,,Có gì mà phải nóng thế.
Dialogue: 0,0:21:55.66,0:21:57.68,Default,,0,0,0,,Đã bảo cấm ăn nói kiểu đó\Nvới ta kia mà!
Dialogue: 0,0:21:58.65,0:21:59.45,Default,,0,0,0,,Thầy...
Dialogue: 0,0:22:00.71,0:22:03.81,Default,,0,0,0,,Về cơ bản,\Nthầy là một giáo viên vô tổ chức.
Dialogue: 0,0:22:06.22,0:22:09.04,Default,,0,0,0,,Nhưng phải nói sao nhỉ?
Dialogue: 0,0:22:09.80,0:22:11.47,Default,,0,0,0,,Thầy có chút ngầu đấy ạ.
Dialogue: 0,0:22:15.56,0:22:16.93,Default,,0,0,0,,Với lại hiệu trưởng à.
Dialogue: 0,0:22:16.93,0:22:20.30,Default,,0,0,0,,Đúng như chủ tịch đã nói,\Nhãy tăng 10% lương cho tôi!
Dialogue: 0,0:22:20.42,0:22:23.84,Default,,0,0,0,,Có ai nói gì vụ tăng lương đâu hả!
Dialogue: 0,0:23:55.81,0:23:59.69,Default,,0,0,0,,TẬP 2: CON NGƯỜI DÙ BÊN NGOÀI THAY ĐỔI\NTHÌ BÊN TRONG VẪN Y NGUYÊN
Dialogue: 0,0:23:59.76,0:24:04.79,Default,,0,0,0,,CÂY GẬY NHẬN TỪ NGƯỜI ĐÓ\NQUẢ THẬT NẶNG HƠN TÔI TƯỞNG.
Dialogue: 0,0:24:05.11,0:24:09.50,Default,,0,0,0,,CÁC FAN CỦA GINTAMA ƠI,\NHÃY DÕI THEO CHÚNG TÔI NHÉ.
