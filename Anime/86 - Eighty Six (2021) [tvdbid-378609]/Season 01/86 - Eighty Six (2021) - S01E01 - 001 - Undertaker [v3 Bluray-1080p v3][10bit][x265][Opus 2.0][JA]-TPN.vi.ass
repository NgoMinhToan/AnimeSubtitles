Comment: 0,0:22:04.97,0:22:05.01,OP_vie,,0,0,0,,First frame of ED

Dialogue: 20,0:09:24.92,0:09:26.50,[16:9] Main,,0,0,0,,{\an8}Thật tình...
Dialogue: 20,0:13:16.11,0:13:18.03,[16:9] Main,,0,0,0,,{\an8}Có chuyện gì vậy Pleiades?
Dialogue: 20,0:13:18.03,0:13:19.36,[16:9] Main,,0,0,0,,{\an8}Xin hãy trả lời!
Dialogue: 0,0:00:06.16,0:00:08.83,[16:9] Main,,0,0,0,,Handler One gọi Undertaker.
Dialogue: 0,0:00:08.83,0:00:13.48,[16:9] Main,,0,0,0,,Lực lượng nghênh kích của địch\Nđa số ở điểm 3-0-2 và 5-0-4.
Dialogue: 0,0:00:13.48,0:00:18.29,[16:9] Main,,0,0,0,,Lượng chiến xa quy mô cỡ đại đội, cùng\Nlực lượng bộ binh nhẹ đa dụng quy mô tương tự.
Dialogue: 0,0:00:18.29,0:00:21.62,[16:9] Main,,0,0,0,,Toàn bộ máy chiến đấu, mau tiến lên trấn áp.
Dialogue: 0,0:00:22.38,0:00:24.11,[16:9] Main,,0,0,0,,Cơ mà...
Dialogue: 0,0:00:24.11,0:00:27.84,[16:9] Main,,0,0,0,,Chiến lực chênh lệch thế này\Nthì chết sạch cho xem, bọn bây ấy...
Dialogue: 0,0:00:30.84,0:00:32.99,[16:9] Main,,0,0,0,,Đi mau nào!
Dialogue: 0,0:00:32.99,0:00:34.76,[16:9] Main,,0,0,0,,Đi đi, lũ lợn!
Dialogue: 0,0:00:35.85,0:00:38.31,[16:9] Main,,0,0,0,,Chiến đấu rồi hỏng hết đi!
Dialogue: 0,0:00:38.31,0:00:40.97,[16:9] Main,,0,0,0,,Lũ 86 xấc láo kia!
Dialogue: 0,0:00:48.11,0:00:49.57,[16:9] Main,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:00:50.70,0:00:52.74,[16:9] Main,,0,0,0,,Này, dừng lại đi.
Dialogue: 0,0:00:52.83,0:00:55.20,[16:9] Main,,0,0,0,,Này! Dừng lại đi.
Dialogue: 0,0:00:55.20,0:00:56.04,[16:9] Main,,0,0,0,,Đừng có lại đây!
Dialogue: 0,0:00:56.47,0:00:58.08,[16:9] Main,,0,0,0,,Im đi!
Dialogue: 0,0:00:58.08,0:00:59.32,[16:9] Main,,0,0,0,,Ồn quá!
Dialogue: 0,0:01:52.19,0:01:55.92,[16:9] Main,,0,0,0,,Như các bạn có thể thấy,\Nhôm nay quả là một ngày đẹp trời.
Dialogue: 0,0:01:55.92,0:02:00.18,[16:9] Main,,0,0,0,,Từ khu 1 tới khu 85, khắp cả nước\Nđều là thời tiết lý tưởng để đi chơi rồi.
Dialogue: 0,0:02:00.18,0:02:03.19,[16:9] Main,,0,0,0,,Sao không cùng gia đình hay bạn bè ra ngoài nhỉ.
Dialogue: 0,0:02:03.19,0:02:06.72,[16:9] Main,,0,0,0,,Ngày mai, tuy thời tiết sẽ xấu dần\Ntừ phía Đông sang,
Dialogue: 0,0:02:06.72,0:02:08.32,[16:9] Main,,0,0,0,,nhưng vẫn chưa cần thiết phải dùng ô.
Dialogue: 0,0:02:08.32,0:02:10.90,[16:9] Main,,0,0,0,,Chương trình xin kết thúc,\Nchúc quý khán giả một cuối tuần tốt lành.
Dialogue: 0,0:02:12.87,0:02:17.78,[16:9] Main,,0,0,0,,Tổng bộ Quân đội Cộng Hoà San Magnolia\Nxin được thông báo tình hình chiến sự hôm nay.
Dialogue: 0,0:02:18.33,0:02:22.28,[16:9] Main,,0,0,0,,Lực lượng cơ giới không người lái\Ncủa Đế Quốc Giad xâm phạm Chiến khu 17,
Dialogue: 0,0:02:22.28,0:02:26.93,[16:9] Main,,0,0,0,,lực lượng cơ giới thiết giáp Legion đã bị\Nlực lượng máy chiến đấu không người lái tự hành,
Dialogue: 0,0:02:26.93,0:02:31.00,[16:9] Main,,0,0,0,,những Juggernaut kiêu hãnh của đất nước ta\Nnghênh kích và phải rút lui do thiệt hại thảm khốc.
Dialogue: 0,0:02:31.00,0:02:35.36,[16:9] Main,,0,0,0,,Thiệt hại bên phía chúng ta là không đáng kể,\Nthiệt hại về nhân mạng là không có.
Dialogue: 0,0:02:35.36,0:02:38.60,[16:9] Main,,0,0,0,,Nhờ sự tham chiến của những cỗ máy\Nkhông người lái tiên tiến và nhân đạo...
Dialogue: 0,0:02:38.96,0:02:41.85,[16:9] Main,,0,0,0,,số tử sĩ hôm nay của đất nước\Nchúng ta vẫn là bằng 0.
Dialogue: 0,0:02:42.28,0:02:46.02,[16:9] Main,,0,0,0,,Ngày mà Nước Cộng Hoà chúng ta\Ngiáng công lý xuống lũ dị vật tà ác vong quốc...
Dialogue: 0,0:02:46.02,0:02:47.73,[16:9] Main,,0,0,0,,hẳn sẽ tới sớm thôi.
Dialogue: 0,0:02:48.41,0:02:50.53,[16:9] Main,,0,0,0,,Cộng Hoà San Magnolia muôn năm!
Dialogue: 0,0:02:50.53,0:02:52.68,[16:9] Main,,0,0,0,,Vinh quang cho lá cờ ngũ sắc!
Dialogue: 0,0:03:03.45,0:03:06.63,[16:9] Main,,0,0,0,,Chào buổi sáng, thưa cô Thiếu tá.
Dialogue: 0,0:03:10.49,0:03:14.91,[16:9] Main,,0,0,0,,Màn gào thét của lũ lợn hôm qua đúng là kiệt tác.
Dialogue: 0,0:03:14.91,0:03:16.29,[16:9] Main,,0,0,0,,Hoành tráng quá đi chứ.
Dialogue: 0,0:03:16.29,0:03:18.04,[16:9] Main,,0,0,0,,Hơn 50 cỗ máy đã đi đời đấy.
Dialogue: 0,0:03:18.04,0:03:20.10,[16:9] Main,,0,0,0,,Mà kể ra thì làm gì có người lái.
Dialogue: 0,0:03:22.21,0:03:26.10,[16:9] Main,,0,0,0,,Các quý ông ơi, cô công chúa\Nthích chơi búp bê đang trừng mắt kìa.
Dialogue: 0,0:03:26.10,0:03:29.81,[16:9] Main,,0,0,0,,Thiếu tá Milizé sao phải làm cái\Nbộ mặt đau buồn đó làm gì?
Dialogue: 0,0:03:29.81,0:03:32.65,[16:9] Main,,0,0,0,,Chỉ là mấy cỗ máy không người lái bị hỏng thôi mà.
Dialogue: 0,0:03:33.53,0:03:33.86,[16:9] Main,,0,0,0,,Mấy người-
Dialogue: 0,0:03:34.27,0:03:35.36,[16:9] Main,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:03:35.36,0:03:37.16,[16:9] Main,,0,0,0,,Chào buổi sáng, Annette.
Dialogue: 0,0:03:37.16,0:03:38.76,[16:9] Main,,0,0,0,,Cậu tới sớm quá nhỉ.
Dialogue: 0,0:03:38.76,0:03:40.11,[16:9] Main,,0,0,0,,Lúc nào cũng ngủ quên cơ mà.
Dialogue: 0,0:03:40.11,0:03:42.30,[16:9] Main,,0,0,0,,Công việc đấy, trắng đêm luôn.
Dialogue: 0,0:03:42.30,0:03:44.67,[16:9] Main,,0,0,0,,Đừng có gộp tớ chung với lũ ngốc đó!
Dialogue: 0,0:03:45.62,0:03:47.33,[16:9] Main,,0,0,0,,Kệ đi mà.
Dialogue: 0,0:03:48.92,0:03:50.40,[16:9] Main,,0,0,0,,Nơi đây đâu phải chiến trường.
Dialogue: 0,0:03:50.40,0:03:51.95,[16:9] Main,,0,0,0,,Mà là ở trong Gran Mur.
Dialogue: 0,0:03:51.95,0:03:54.26,[16:9] Main,,0,0,0,,Với cả trong 2 năm nữa sẽ không còn kẻ địch.
Dialogue: 0,0:03:54.26,0:03:58.59,[16:9] Main,,0,0,0,,Tình hình như thế mà còn dốc tận sức\Nvì đất nước như cậu mới là khác người đấy.
Dialogue: 0,0:03:58.59,0:04:01.05,[16:9] Main,,0,0,0,,Tớ chỉ là vì lương tâm đất nước-
Dialogue: 0,0:04:01.05,0:04:03.32,[16:9] Main,,0,0,0,,Hiểu rồi mà, tiểu thư ơi.
Dialogue: 0,0:04:03.32,0:04:06.64,[16:9] Main,,0,0,0,,Đầu óc tớ không đủ\Nđể nghe cậu diễn thuyết đâu.
Dialogue: 0,0:04:06.64,0:04:07.94,[16:9] Main,,0,0,0,,Thế là thế quái nào.
Dialogue: 0,0:04:08.21,0:04:11.24,[16:9] Main,,0,0,0,,Thân phận tên Processor đó\Nchỉ như "phụ tùng" thôi!
Dialogue: 0,0:04:11.24,0:04:12.53,[16:9] Main,,0,0,0,,Đúng thật.
Dialogue: 0,0:04:12.53,0:04:17.88,[16:9] Main,,0,0,0,,Tại sao người khu 1 chúng ta phải ngồi nghe\Nlũ lợn của khu 86 mỉa mai chứ!
Dialogue: 0,0:04:24.07,0:04:27.86,[16:9] Main,,0,0,0,,Sao cứ phải quan tâm\Ntới mấy cỗ máy không người lái vậy, Lena?
Dialogue: 0,0:04:27.86,0:04:30.54,[16:9] Main,,0,0,0,,Đám người họ...\Nkhông phải máy móc không người lái.
Dialogue: 0,0:04:31.80,0:04:33.59,[16:9] Main,,0,0,0,,Vậy thì để tớ hỏi lại.
Dialogue: 0,0:04:33.59,0:04:35.55,[16:9] Main,,0,0,0,,Sao cậu cứ phải để tâm tới vậy?
Dialogue: 0,0:04:35.99,0:04:37.45,[16:9] Main,,0,0,0,,Đám 86 ấy?
Dialogue: 0,0:04:45.04,0:04:46.68,[16:9] Main,,0,0,0,,Chiến trường gọi đó.
Dialogue: 0,0:04:47.03,0:04:48.32,[16:9] Main,,0,0,0,,Tiểu thư à.
Dialogue: 0,0:05:08.57,0:05:09.92,[16:9] Main,,0,0,0,,Bắt đầu xác nhận.
Dialogue: 0,0:05:09.92,0:05:11.87,[16:9] Main,,0,0,0,,Thiếu tá Vladilena Milizé.
Dialogue: 0,0:05:11.87,0:05:16.33,[16:9] Main,,0,0,0,,Sĩ quan Chỉ huy Chiến đội phòng vệ 3,\NChiến khu 9, mặt trận phía Đông.
Dialogue: 0,0:05:27.92,0:05:29.43,[16:9] Main,,0,0,0,,Khởi động Para-RAID!
Dialogue: 0,0:05:29.81,0:05:33.27,[16:9] Main,,0,0,0,,Đối tượng đồng bộ: Pleiades Processor.
Dialogue: 0,0:05:36.02,0:05:37.28,[16:9] Main,,0,0,0,,Đồng bộ hoàn tất.
Dialogue: 0,0:05:37.95,0:05:40.30,[16:9] Main,,0,0,0,,Handler One gọi Pleiades.
Dialogue: 0,0:05:40.30,0:05:42.36,[16:9] Main,,0,0,0,,Hôm nay lại nhờ mọi người nhé.
Dialogue: 0,0:05:43.62,0:05:45.83,[16:9] Main,,0,0,0,,Pleiades gọi Handler One.
Dialogue: 0,0:05:45.83,0:05:47.33,[16:9] Main,,0,0,0,,Đồng bộ tốt.
Dialogue: 0,0:05:48.43,0:05:49.91,[16:9] Main,,0,0,0,,Xin hãy cẩn thận.
Dialogue: 0,0:05:49.91,0:05:52.07,[16:9] Main,,0,0,0,,Lực lượng của địch sắp vào tầm bắn.
Dialogue: 0,0:05:52.07,0:05:53.04,[16:9] Main,,0,0,0,,Hãy hết sức chú ý-
Dialogue: 0,0:05:53.04,0:05:57.80,[16:9] Main,,0,0,0,,Lần nào cũng nói chuyện lịch sự với 86,\Nnhững kẻ không phải con người...
Dialogue: 0,0:05:58.35,0:06:00.30,[16:9] Main,,0,0,0,,Đúng là vất vả thật đấy...
Dialogue: 0,0:06:00.73,0:06:02.29,[16:9] Main,,0,0,0,,Quý cô "nhân loại" nhỉ?
Dialogue: 0,0:06:06.87,0:06:09.68,[16:9] Main,,0,0,0,,Đổi đơn vị phụ trách ạ?
Dialogue: 0,0:06:09.68,0:06:11.25,[16:9] Main,,0,0,0,,Thưa Chuẩn tướng Karlstahl?
Dialogue: 0,0:06:11.25,0:06:12.56,[16:9] Main,,0,0,0,,Ừm.
Dialogue: 0,0:06:12.56,0:06:16.78,[16:9] Main,,0,0,0,,Thật ra Handler của đơn vị đó đã xuất ngũ.
Dialogue: 0,0:06:16.78,0:06:21.32,[16:9] Main,,0,0,0,,Cần phải chọn gấp\Nmột Handler của đơn vị khác để thay thế.
Dialogue: 0,0:06:21.32,0:06:24.17,[16:9] Main,,0,0,0,,Không thể đợi tới lúc\Ncó quyết định bổ nhiệm thay thế...
Dialogue: 0,0:06:24.17,0:06:26.38,[16:9] Main,,0,0,0,,có phải đơn vị bảo vệ\Ncứ điểm trọng yếu không ạ?
Dialogue: 0,0:06:26.38,0:06:27.45,[16:9] Main,,0,0,0,,Phải.
Dialogue: 0,0:06:27.45,0:06:30.33,[16:9] Main,,0,0,0,,Mặt trận phía Đông, Chiến khu 1,\NChiến đội phòng vệ 1,
Dialogue: 0,0:06:30.65,0:06:33.21,[16:9] Main,,0,0,0,,tên thường gọi là Chiến đội Spearhead.
Dialogue: 0,0:06:33.48,0:06:36.65,[16:9] Main,,0,0,0,,Tập hợp toàn lính thâm niên\Ntừ khắp mặt trận phía Đông...
Dialogue: 0,0:06:36.65,0:06:39.10,[16:9] Main,,0,0,0,,Nói nôm na là một đơn vị tinh nhuệ.
Dialogue: 0,0:06:39.10,0:06:40.29,[16:9] Main,,0,0,0,,Sao lại thế...
Dialogue: 0,0:06:40.29,0:06:44.18,[16:9] Main,,0,0,0,,Một Thiếu tá non nớt như tôi\Nsao lại được giao trọng trách như vậy...
Dialogue: 0,0:06:44.18,0:06:48.71,[16:9] Main,,0,0,0,,Thiếu nữ thiên tài đã được thăng chức\Nthành Thiếu tá trẻ tuổi nhất mà nói vậy sao?
Dialogue: 0,0:06:48.71,0:06:51.97,[16:9] Main,,0,0,0,,Khiêm tốn quá mức chỉ chuốc lấy\Nác cảm không cần thiết thôi, Lena.
Dialogue: 0,0:06:52.93,0:06:55.76,[16:9] Main,,0,0,0,,Cháu xin lỗi, thưa chú Jérôme.
Dialogue: 0,0:06:55.76,0:06:58.48,[16:9] Main,,0,0,0,,Ta nghĩ Václav hẳn cũng tự hào lắm.
Dialogue: 0,0:06:59.10,0:07:01.33,[16:9] Main,,0,0,0,,Cô con gái giỏi giang của anh ấy cơ mà.
Dialogue: 0,0:07:03.21,0:07:04.45,[16:9] Main,,0,0,0,,Margareta sao rồi?
Dialogue: 0,0:07:04.70,0:07:07.13,[16:9] Main,,0,0,0,,Mẹ cháu vẫn như mọi khi ạ.
Dialogue: 0,0:07:07.13,0:07:08.67,[16:9] Main,,0,0,0,,Cứ nói cháu mau kết hôn.
Dialogue: 0,0:07:08.67,0:07:10.49,[16:9] Main,,0,0,0,,Hẳn rồi...
Dialogue: 0,0:07:10.49,0:07:13.73,[16:9] Main,,0,0,0,,Thật ra chẳng ai muốn làm Handler của họ đâu.
Dialogue: 0,0:07:13.73,0:07:15.91,[16:9] Main,,0,0,0,,Nhưng đó là đơn vị tinh nhuệ cơ mà?
Dialogue: 0,0:07:15.91,0:07:18.88,[16:9] Main,,0,0,0,,Với một quân nhân của nước Cộng Hoà\Nthì được chỉ huy họ...
Dialogue: 0,0:07:18.88,0:07:20.96,[16:9] Main,,0,0,0,,chẳng phải là một vinh dự hiếm có sao?
Dialogue: 0,0:07:20.96,0:07:22.10,[16:9] Main,,0,0,0,,Ừm.
Dialogue: 0,0:07:22.10,0:07:25.16,[16:9] Main,,0,0,0,,Nếu xét về đơn vị đó thì đúng là vậy...
Dialogue: 0,0:07:25.16,0:07:29.59,[16:9] Main,,0,0,0,,Nhưng cỗ máy Đội trưởng Chiến đội Spearhead,\Nmật danh Undertaker.
Dialogue: 0,0:07:29.59,0:07:31.93,[16:9] Main,,0,0,0,,Thứ này đang có chút vấn đề.
Dialogue: 0,0:07:31.93,0:07:32.72,[16:9] Main,,0,0,0,,Là gì ạ?
Dialogue: 0,0:07:33.37,0:07:35.48,[16:9] Main,,0,0,0,,Bị khiếp sợ mà gọi là "Tử Thần."
Dialogue: 0,0:07:36.07,0:07:39.70,[16:9] Main,,0,0,0,,Có vẻ nó đã làm gì đó\Nđể huỷ hoại Handler phụ trách.
Dialogue: 0,0:07:40.93,0:07:43.12,[16:9] Main,,0,0,0,,Processor làm với Handler sao?
Dialogue: 0,0:07:43.12,0:07:44.26,[16:9] Main,,0,0,0,,Không phải ngược lại ạ?
Dialogue: 0,0:07:44.26,0:07:45.42,[16:9] Main,,0,0,0,,Ừ.
Dialogue: 0,0:07:45.42,0:07:47.61,[16:9] Main,,0,0,0,,Không phải kiểu chuyện ma để doạ người chứ ạ?
Dialogue: 0,0:07:47.61,0:07:52.12,[16:9] Main,,0,0,0,,Ta không rảnh rỗi để gọi thuộc cấp\Ntới nói chuyện phiếm trong giờ làm việc đâu.
Dialogue: 0,0:07:52.12,0:07:54.69,[16:9] Main,,0,0,0,,Bất cứ Handler nào phụ trách\Nđơn vị có mặt Undertaker...
Dialogue: 0,0:07:54.69,0:07:58.58,[16:9] Main,,0,0,0,,đều xin chuyển đơn vị phụ trách hoặc xuất ngũ.
Dialogue: 0,0:07:58.95,0:08:00.79,[16:9] Main,,0,0,0,,Có cả người đột nhiên tự sát.
Dialogue: 0,0:08:01.77,0:08:04.00,[16:9] Main,,0,0,0,,Đúng là chuyện khó tin nhỉ...
Dialogue: 0,0:08:04.00,0:08:07.38,[16:9] Main,,0,0,0,,Hình như là bị ám ảnh bởi cái\N"tiếng nói của vong linh" gì đó.
Dialogue: 0,0:08:07.84,0:08:09.27,[16:9] Main,,0,0,0,,Vong linh?
Dialogue: 0,0:08:10.18,0:08:12.89,[16:9] Main,,0,0,0,,Nếu không muốn thì từ chối cũng được, Lena à.
Dialogue: 0,0:08:13.28,0:08:15.16,[16:9] Main,,0,0,0,,Cơ bản thì cháu quá nhiệt tình.
Dialogue: 0,0:08:15.16,0:08:17.99,[16:9] Main,,0,0,0,,Handler chỉ cần làm tối thiểu là\Ntheo dõi đơn vị qua màn hình,
Dialogue: 0,0:08:17.99,0:08:19.48,[16:9] Main,,0,0,0,,ra lệnh thì cứ để cho hiện trường—
Dialogue: 0,0:08:19.48,0:08:20.46,[16:9] Main,,0,0,0,,Cháu sẽ làm!
Dialogue: 0,0:08:20.46,0:08:24.15,[16:9] Main,,0,0,0,,Toàn tâm toàn ý nhận chức quản lý\Nlẫn Sĩ quan Chỉ huy Chiến đội Spearhead.
Dialogue: 0,0:08:24.83,0:08:27.72,[16:9] Main,,0,0,0,,Không cần phải làm gì hơn việc cần làm đâu.
Dialogue: 0,0:08:27.72,0:08:31.18,[16:9] Main,,0,0,0,,Cháu hãy hạn chế\Nviệc giao tiếp với Processor lại đi.
Dialogue: 0,0:08:31.18,0:08:34.16,[16:9] Main,,0,0,0,,Hiểu về thuộc cấp là nghĩa vụ của một sĩ quan ạ!
Dialogue: 0,0:08:34.50,0:08:35.49,[16:9] Main,,0,0,0,,Thật tình...
Dialogue: 0,0:08:36.04,0:08:38.19,[16:9] Main,,0,0,0,,Còn một chuyện nhỏ nữa.
Dialogue: 0,0:08:38.19,0:08:41.92,[16:9] Main,,0,0,0,,Đừng cứng đầu ghi chép\Nvề số tử sĩ vào báo cáo nữa.
Dialogue: 0,0:08:41.92,0:08:45.38,[16:9] Main,,0,0,0,,Theo công cáo thì ngoài chiến tuyến\Nkhông có con người nào cả,
Dialogue: 0,0:08:46.35,0:08:48.72,[16:9] Main,,0,0,0,,nên tử sĩ là không tồn tại.
Dialogue: 0,0:08:48.72,0:08:51.13,[16:9] Main,,0,0,0,,Dù vậy đi nữa thì cháu vẫn\Nkhông thể làm ngơ được.
Dialogue: 0,0:08:51.13,0:08:53.39,[16:9] Main,,0,0,0,,Việc này, căn bản không thể bỏ qua được—
Dialogue: 0,0:08:53.39,0:08:54.10,[16:9] Main,,0,0,0,,Lena!
Dialogue: 0,0:08:57.32,0:08:59.85,[16:9] Main,,0,0,0,,Cháu đúng là giống hệt Václav...
Dialogue: 0,0:09:02.96,0:09:03.86,[16:9] Main,,0,0,0,,Giờ thì,
Dialogue: 0,0:09:04.25,0:09:06.11,[16:9] Main,,0,0,0,,Thiếu tá Vladilena Milizé sẽ được...
Dialogue: 0,0:09:06.11,0:09:11.02,[16:9] Main,,0,0,0,,bổ nhiệm làm Handler, Sĩ quan Phó Chỉ huy\NChiến đội phòng vệ 1, Chiến khu 1.
Dialogue: 0,0:09:11.02,0:09:13.87,[16:9] Main,,0,0,0,,Hãy hoàn thành việc bàn giao\Ntrước khi nhậm chức.
Dialogue: 0,0:09:14.25,0:09:15.12,[16:9] Main,,0,0,0,,Cố gắng lên nhé.
Dialogue: 0,0:09:16.31,0:09:19.32,[16:9] Main,,0,0,0,,Tôi sẽ dốc hết sức cho tới nhiệm vụ cuối cùng.
Dialogue: 0,0:09:20.32,0:09:22.12,[16:9] Main,,0,0,0,,Thế... cậu nhận rồi à?
Dialogue: 0,0:09:26.50,0:09:29.25,[16:9] Main,,0,0,0,,Lena hiếu kỳ tới mức nào vậy?
Dialogue: 0,0:09:29.25,0:09:33.30,[16:9] Main,,0,0,0,,Ngoài cái vinh dự được giao cho\Nđơn vị tinh nhuệ, còn động lực nữa đó.
Dialogue: 0,0:09:33.30,0:09:36.51,[16:9] Main,,0,0,0,,Cái vụ "huỷ hoại Handler" ấy\Nkiểu gì cũng là bịa đặt thôi nhỉ?
Dialogue: 0,0:09:36.96,0:09:40.14,[16:9] Main,,0,0,0,,Chỉ là lời viện cớ của mấy kẻ\Nkhông có tinh thần làm việc thôi.
Dialogue: 0,0:09:40.14,0:09:42.35,[16:9] Main,,0,0,0,,Cái vụ có người tự sát là thật đấy.
Dialogue: 0,0:09:43.42,0:09:46.27,[16:9] Main,,0,0,0,,Handler của Chiến đội Spearhead\Nđã trở nên kỳ quái,
Dialogue: 0,0:09:46.27,0:09:49.19,[16:9] Main,,0,0,0,,rồi dùng súng đạn ghém\Ntự thổi bay đầu mình đó.
Dialogue: 0,0:09:49.51,0:09:51.15,[16:9] Main,,0,0,0,,Rồi, kiểm tra hoàn tất.
Dialogue: 0,0:09:51.15,0:09:52.45,[16:9] Main,,0,0,0,,Lần này không có gì bất thường.
Dialogue: 0,0:09:52.94,0:09:54.32,[16:9] Main,,0,0,0,,Đã vất vả rồi.
Dialogue: 0,0:09:56.16,0:09:58.36,[16:9] Main,,0,0,0,,Nhưng mà... sao lại tự sát chứ...
Dialogue: 0,0:09:58.36,0:10:00.25,[16:9] Main,,0,0,0,,Chỗ tớ cũng có yêu cầu điều tra gửi đến.
Dialogue: 0,0:10:00.57,0:10:02.72,[16:9] Main,,0,0,0,,Không phải lỗi của Para-RAID.
Dialogue: 0,0:10:02.72,0:10:06.75,[16:9] Main,,0,0,0,,Chưa bàn tới vụ bỏ việc, nhưng tự sát\Nthì đúng là bị dư luận để ý.
Dialogue: 0,0:10:07.07,0:10:08.07,[16:9] Main,,0,0,0,,Đã có chuyện gì à?
Dialogue: 0,0:10:08.07,0:10:08.96,[16:9] Main,,0,0,0,,Chịu...
Dialogue: 0,0:10:08.96,0:10:10.34,[16:9] Main,,0,0,0,,Chịu là sao...
Dialogue: 0,0:10:10.34,0:10:14.18,[16:9] Main,,0,0,0,,Bản thân Handler chết rồi\Nthì điều tra chân tướng kiểu gì.
Dialogue: 0,0:10:14.45,0:10:17.15,[16:9] Main,,0,0,0,,Phụ trách Đội phát triển\Nnói vậy mà nghe được à?
Dialogue: 0,0:10:17.15,0:10:18.77,[16:9] Main,,0,0,0,,Làm được gì thì đã làm rồi.
Dialogue: 0,0:10:18.77,0:10:21.17,[16:9] Main,,0,0,0,,Tóm lại thiết bị kết nối không có vấn đề.
Dialogue: 0,0:10:21.17,0:10:22.35,[16:9] Main,,0,0,0,,Vậy là xong rồi.
Dialogue: 0,0:10:22.35,0:10:26.40,[16:9] Main,,0,0,0,,Tớ đã nói "Nếu muốn biết bằng được thì cứ\Nmang "Undertaker" đó tới đây đi."
Dialogue: 0,0:10:26.81,0:10:28.93,[16:9] Main,,0,0,0,,Nhưng mà cái đám ngốc bên Bộ Vận tải lại nói...
Dialogue: 0,0:10:28.93,0:10:32.28,[16:9] Main,,0,0,0,,"Chuyến bay này không có chỗ cho lợn."
Dialogue: 0,0:10:33.49,0:10:35.93,[16:9] Main,,0,0,0,,Vậy thì Undertaker đã nói gì...
Dialogue: 0,0:10:35.93,0:10:37.12,[16:9] Main,,0,0,0,,Chỉ có văn bản báo cáo thôi.
Dialogue: 0,0:10:37.12,0:10:39.43,[16:9] Main,,0,0,0,,Nói là "Hoàn toàn không biết gì."
Dialogue: 0,0:10:39.43,0:10:43.02,[16:9] Main,,0,0,0,,Khi được bảo là Handler đã chết\Nthì vỏn vẹn "Vậy à" thôi.
Dialogue: 0,0:10:43.02,0:10:45.95,[16:9] Main,,0,0,0,,Dù gì cũng là 86 mà.
Dialogue: 0,0:10:45.95,0:10:50.32,[16:9] Main,,0,0,0,,Thật ra, bảo bị mất trí vì Para-RAID\Ncũng không phải không thể đâu.
Dialogue: 0,0:10:50.32,0:10:54.63,[16:9] Main,,0,0,0,,Cũng do một phần não bộ được hoạt hoá để\Nchia sẻ cảm giác với một người hoàn toàn xa lạ.
Dialogue: 0,0:10:55.00,0:10:58.08,[16:9] Main,,0,0,0,,Với cả về cơ bản chỉ đồng bộ thính giác thôi,
Dialogue: 0,0:10:58.08,0:11:01.24,[16:9] Main,,0,0,0,,đồng bộ cả thị giác nữa thì não bị nướng mất.
Dialogue: 0,0:11:01.24,0:11:04.27,[16:9] Main,,0,0,0,,Hoạt hoá quá mức có khi\Nkhông còn đường về đâu...
Dialogue: 0,0:11:04.73,0:11:08.90,[16:9] Main,,0,0,0,,Sử dụng Para-RAID thì phải chấp nhận nguy cơ đó.
Dialogue: 0,0:11:11.55,0:11:15.43,[16:9] Main,,0,0,0,,Cha của cậu là người đi đầu\Ntrong việc nghiên cứu thứ này, vậy mà...
Dialogue: 0,0:11:15.43,0:11:18.66,[16:9] Main,,0,0,0,,Bởi vì lý luận cơ sở do\Nnhà nghiên cứu khác xây dựng,
Dialogue: 0,0:11:18.66,0:11:21.88,[16:9] Main,,0,0,0,,nên thật ra sẽ có chỗ không hiểu rõ thôi.
Dialogue: 0,0:11:22.94,0:11:26.38,[16:9] Main,,0,0,0,,Này Lena, quả nhiên là\Nsang bên Bộ Nghiên cứu đi.
Dialogue: 0,0:11:26.38,0:11:29.05,[16:9] Main,,0,0,0,,Hiện giờ quân đội không phải nơi\Nđể chống thất nghiệp đâu.
Dialogue: 0,0:11:29.05,0:11:30.50,[16:9] Main,,0,0,0,,Sau 2 năm nữa Legion không còn nữa,
Dialogue: 0,0:11:30.50,0:11:33.82,[16:9] Main,,0,0,0,,thì cái mác "cựu quân nhân"\Nchẳng còn sức nặng đâu.
Dialogue: 0,0:11:34.47,0:11:35.65,[16:9] Main,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:11:35.65,0:11:37.22,[16:9] Main,,0,0,0,,Nhưng mà giờ đang là thời chiến.
Dialogue: 0,0:11:37.22,0:11:39.69,[16:9] Main,,0,0,0,,Nhưng hắn không phải Processor đàng hoàng đâu.
Dialogue: 0,0:11:39.69,0:11:41.95,[16:9] Main,,0,0,0,,Lúc Para-RAID có chuyện gì ai mà biết được.
Dialogue: 0,0:11:41.95,0:11:44.43,[16:9] Main,,0,0,0,,Đám 86 chết luôn thì chẳng sao.
Dialogue: 0,0:11:44.83,0:11:46.51,[16:9] Main,,0,0,0,,Còn cậu thì gay đấy.
Dialogue: 0,0:11:46.51,0:11:49.06,[16:9] Main,,0,0,0,,Dù thế đi nữa vẫn là hèn nhát.
Dialogue: 0,0:11:51.55,0:11:52.77,[16:9] Main,,0,0,0,,Rồi, rồi.
Dialogue: 0,0:11:54.75,0:11:56.57,[16:9] Main,,0,0,0,,Đúng là hiếu kỳ quá đi mà.
Dialogue: 0,0:11:59.28,0:12:01.03,[16:9] Main,,0,0,0,,Tớ đã thay đổi thiết lập rồi.
Dialogue: 0,0:12:01.48,0:12:02.36,[16:9] Main,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:12:02.36,0:12:03.56,[16:9] Main,,0,0,0,,Phải rồi, Lena.
Dialogue: 0,0:12:03.56,0:12:05.16,[16:9] Main,,0,0,0,,Tớ đã làm bánh Chiffon đấy.
Dialogue: 0,0:12:05.16,0:12:06.48,[16:9] Main,,0,0,0,,Có ăn không?
Dialogue: 0,0:12:06.48,0:12:07.83,[16:9] Main,,0,0,0,,Phải rồi...
Dialogue: 0,0:12:07.83,0:12:09.50,[16:9] Main,,0,0,0,,Hôm nay tớ xin kiếu.
Dialogue: 0,0:12:09.50,0:12:10.29,[16:9] Main,,0,0,0,,Vậy nhé.
Dialogue: 0,0:12:10.29,0:12:12.34,[16:9] Main,,0,0,0,,Trứng được dùng... là hàng thật đấy.
Dialogue: 0,0:12:12.67,0:12:13.25,[16:9] Main,,0,0,0,,Hả?
Dialogue: 0,0:12:14.95,0:12:15.80,[16:9] Main,,0,0,0,,Cả sữa luôn.
Dialogue: 0,0:12:15.80,0:12:16.66,[16:9] Main,,0,0,0,,Ế?
Dialogue: 0,0:12:19.26,0:12:20.97,[16:9] Main,,0,0,0,,Ngon quá đi!
Dialogue: 0,0:12:22.10,0:12:24.54,[16:9] Main,,0,0,0,,Sao? Cảm tưởng lâu lâu\Nmới được ăn đồ thật thế nào?
Dialogue: 0,0:12:24.54,0:12:26.01,[16:9] Main,,0,0,0,,Cực ngon ấy.
Dialogue: 0,0:12:26.01,0:12:28.60,[16:9] Main,,0,0,0,,Nhưng mà đúng là tớ vẫn\Nkhông ngờ là nó có vị thế này.
Dialogue: 0,0:12:29.33,0:12:32.20,[16:9] Main,,0,0,0,,Cứ ăn thức ăn tổng hợp mãi,\Nlàm tớ quên mất hương vị thật sự rồi.
Dialogue: 0,0:12:33.07,0:12:35.20,[16:9] Main,,0,0,0,,Có cả bánh su kem đó.
Dialogue: 0,0:12:36.12,0:12:39.42,[16:9] Main,,0,0,0,,Chắc không phải là loại toả ra mùi\Nphô mai nhưng bên trong chẳng có mẩu nào.
Dialogue: 0,0:12:39.42,0:12:41.87,[16:9] Main,,0,0,0,,Hay kiểu chuẩn bị bốc khói đen đâu nhỉ?
Dialogue: 0,0:12:41.87,0:12:42.55,[16:9] Main,,0,0,0,,Mấy món đó...
Dialogue: 0,0:12:42.55,0:12:47.12,[16:9] Main,,0,0,0,,Cái đó... là nói về món bánh\Nsu kem lần trước tớ làm tặng cậu đấy hả?
Dialogue: 0,0:12:50.39,0:12:51.83,[16:9] Main,,0,0,0,,Lần này thì không sao đâu.
Dialogue: 0,0:12:52.20,0:12:55.95,[16:9] Main,,0,0,0,,Hôm qua tớ tặng nó cho đối tượng\Nxem mặt thì anh ta sướng đến phát khóc đó.
Dialogue: 0,0:12:55.95,0:12:58.06,[16:9] Main,,0,0,0,,Lần này có vẻ là người tốt đấy chứ.
Dialogue: 0,0:12:58.06,0:13:00.20,[16:9] Main,,0,0,0,,Món quà khiến người đó vui đến vậy kia mà.
Dialogue: 0,0:13:00.20,0:13:01.64,[16:9] Main,,0,0,0,,Dĩ nhiên là thế rồi.
Dialogue: 0,0:13:01.64,0:13:06.97,[16:9] Main,,0,0,0,,Tớ còn gửi kèm cả tấm thiệp với dấu hôn cùng\Ndòng chữ "Gửi tới anh người em thương" đó.
Dialogue: 0,0:13:06.97,0:13:09.89,[16:9] Main,,0,0,0,,Rồi nhét nó vào hòm thư nơi\Nanh ta cùng người yêu sống với nhau.
Dialogue: 0,0:13:19.36,0:13:21.31,[16:9] Main,,0,0,0,,Đã có chuyện gì vậy?
Dialogue: 0,0:13:21.31,0:13:22.89,[16:9] Main,,0,0,0,,Handler One gọi Pleiades.
Dialogue: 0,0:13:22.89,0:13:23.87,[16:9] Main,,0,0,0,,Dừng lại đi.
Dialogue: 0,0:13:24.85,0:13:26.05,[16:9] Main,,0,0,0,,Anh ta chết rồi.
Dialogue: 0,0:13:32.69,0:13:34.26,[16:9] Main,,0,0,0,,Mẹ ơi...!
Dialogue: 0,0:13:34.26,0:13:35.85,[16:9] Main,,0,0,0,,Dừng công kích! Mau né đi!
Dialogue: 0,0:13:35.85,0:13:37.32,[16:9] Main,,0,0,0,,{\fad(0,450)}Lũ sắt vụn khốn kiếp!
Dialogue: 0,0:13:38.94,0:13:41.49,[16:9] Main,,0,0,0,,Handler One gọi toàn thể Chiến đội 3.
Dialogue: 0,0:13:42.52,0:13:45.19,[16:9] Main,,0,0,0,,Phe địch đã bắt đầu rút lui.
Dialogue: 0,0:13:45.19,0:13:48.02,[16:9] Main,,0,0,0,,Nhiệm vụ cảnh giới sẽ được\Nchuyển giao cho Chiến đội 4.
Dialogue: 0,0:13:48.38,0:13:51.25,[16:9] Main,,0,0,0,,Chiến đội 3 hãy quay trở về.
Dialogue: 0,0:13:51.25,0:13:52.63,[16:9] Main,,0,0,0,,Đã rõ.
Dialogue: 0,0:13:55.08,0:13:58.03,[16:9] Main,,0,0,0,,Đội Pleiades... 7 người đã hy sinh...
Dialogue: 0,0:13:59.99,0:14:02.40,[16:9] Main,,0,0,0,,Tôi thật sự đau lòng vì chuyện đó.
Dialogue: 0,0:14:03.97,0:14:08.82,[16:9] Main,,0,0,0,,Cảm ơn cô vì lúc nào cũng ban những lời\Ntốt lành cho chúng tôi, Handler One!
Dialogue: 0,0:14:11.02,0:14:12.41,[16:9] Main,,0,0,0,,Đây là báo cáo mới,
Dialogue: 0,0:14:12.41,0:14:15.13,[16:9] Main,,0,0,0,,Chiến đội 3 sẽ được tái biên chế,
Dialogue: 0,0:14:15.13,0:14:17.99,[16:9] Main,,0,0,0,,và một Handler mới sẽ chịu trách nhiệm.
Dialogue: 0,0:14:18.87,0:14:20.96,[16:9] Main,,0,0,0,,Xin cảm ơn các bạn đã đồng hành\Nđến giờ phút này.
Dialogue: 0,0:14:23.32,0:14:27.14,[16:9] Main,,0,0,0,,Tôi đã được chỉ định làm\NSĩ quan Chỉ huy Chiến đội Spearhead...
Dialogue: 0,0:14:28.04,0:14:30.11,[16:9] Main,,0,0,0,,Tin hay đó.
Dialogue: 0,0:14:30.92,0:14:34.19,[16:9] Main,,0,0,0,,Ngay lúc này tôi xin chân thành\Nchia buồn tới cô, Handler One.
Dialogue: 0,0:14:34.19,0:14:35.19,[16:9] Main,,0,0,0,,Cô nói vậy là ý—
Dialogue: 0,0:14:35.19,0:14:36.69,[16:9] Main,,0,0,0,,Hãy gửi lời hỏi thăm của tôi đến Tử Thần.
Dialogue: 0,0:15:01.07,0:15:02.96,[16:9] Main,,0,0,0,,Khởi động Para-RAID.
Dialogue: 0,0:15:04.35,0:15:05.56,[16:9] Main,,0,0,0,,Đối tượng đồng bộ:
Dialogue: 0,0:15:10.47,0:15:13.35,[16:9] Main,,0,0,0,,Spearhead Processor...
Dialogue: 0,0:15:45.25,0:15:47.08,[16:9] Main,,0,0,0,,Ném đẹp lắm!
Dialogue: 0,0:15:47.08,0:15:48.26,[16:9] Main,,0,0,0,,Vậy là hoà điểm, đổi người đi!
Dialogue: 0,0:15:49.02,0:15:51.81,[16:9] Main,,0,0,0,,Mấy đứa mau dọn dẹ—
Dialogue: 0,0:15:59.67,0:16:01.53,[16:9] Main,,0,0,0,,Nhộn nhịp thật đấy.
Dialogue: 0,0:16:01.53,0:16:02.73,[16:9] Main,,0,0,0,,Đằng kia cũng thế.
Dialogue: 0,0:16:02.73,0:16:05.36,[16:9] Main,,0,0,0,,Đợi đã... chờ... đợi chút đã...
Dialogue: 0,0:16:08.68,0:16:10.44,[16:9] Main,,0,0,0,,Trứng đây!
Dialogue: 0,0:16:13.48,0:16:14.66,[16:9] Main,,0,0,0,,Mọi người vất vả rồi.
Dialogue: 0,0:16:17.48,0:16:18.33,[16:9] Main,,0,0,0,,Ơ kìa?
Dialogue: 0,0:16:20.77,0:16:22.21,[16:9] Main,,0,0,0,,Giúp tớ một tay với!
Dialogue: 0,0:16:22.21,0:16:23.74,[16:9] Main,,0,0,0,,Đây đây.
Dialogue: 0,0:16:27.73,0:16:29.18,[16:9] Main,,0,0,0,,Được rồi.
Dialogue: 0,0:16:30.01,0:16:31.89,[16:9] Main,,0,0,0,,Ôi, hôm nay cũng giúp tôi nhiều nhiều vào.
Dialogue: 0,0:16:31.89,0:16:33.68,[16:9] Main,,0,0,0,,Phải là "phiền mọi người giúp đỡ" chứ hả?
Dialogue: 0,0:16:53.66,0:16:56.37,[16:9] Main,,0,0,0,,Hỡi anh chị em Chiến đội Spearhead.
Dialogue: 0,0:16:56.37,0:16:57.62,[16:9] Main,,0,0,0,,Đến giờ ăn sáng rồi đó.
Dialogue: 0,0:16:58.03,0:16:59.58,[16:9] Main,,0,0,0,,Tập hợp lại nào!
Dialogue: 0,0:16:59.58,0:17:01.10,[16:9] Main,,0,0,0,,Đây, đây!
Dialogue: 0,0:17:01.10,0:17:03.54,[16:9] Main,,0,0,0,,Đói thật đấy.\NỜ, chào buổi sáng.
Dialogue: 0,0:17:03.54,0:17:04.83,[16:9] Main,,0,0,0,,Buồn ngủ thật.\NChào buổi sáng.
Dialogue: 0,0:17:04.83,0:17:05.51,[16:9] Main,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:17:13.81,0:17:15.56,[16:9] Main,,0,0,0,,Mời mọi người ăn cơm!
Dialogue: 0,0:17:15.99,0:17:17.76,[16:9] Main,,0,0,0,,Vẫn còn cơm ốp lết đấy.
Dialogue: 0,0:17:17.76,0:17:18.73,[16:9] Main,,0,0,0,,Xin bát nữa!
Dialogue: 0,0:17:18.73,0:17:20.07,[16:9] Main,,0,0,0,,Bình tĩnh lại đi.
Dialogue: 0,0:17:20.07,0:17:22.32,[16:9] Main,,0,0,0,,Cậu không thể ăn từ tốn để cảm nhận hương vị à.
Dialogue: 0,0:17:22.32,0:17:23.02,[16:9] Main,,0,0,0,,Ngon chứ?
Dialogue: 0,0:17:23.02,0:17:23.92,[16:9] Main,,0,0,0,,Kuro.
Dialogue: 0,0:17:23.92,0:17:26.39,[16:9] Main,,0,0,0,,À vâng, xin mời ạ.
Dialogue: 0,0:17:26.39,0:17:28.81,[16:9] Main,,0,0,0,,Cơ mà lạ thật đấy nhỉ?
Dialogue: 0,0:17:28.81,0:17:30.06,[16:9] Main,,0,0,0,,Handler của bọn mình ấy.
Dialogue: 0,0:17:30.06,0:17:31.94,[16:9] Main,,0,0,0,,Là cuộc chiến hôm qua phải không?
Dialogue: 0,0:17:31.94,0:17:33.72,[16:9] Main,,0,0,0,,Hắn ta coi như hỏng rồi.
Dialogue: 0,0:17:33.72,0:17:36.70,[16:9] Main,,0,0,0,,Cậu cũng nghe thấy phải không?
Dialogue: 0,0:17:36.70,0:17:39.08,[16:9] Main,,0,0,0,,"Đừng lại đây! Này! Dừng lại đi!"
Dialogue: 0,0:17:41.71,0:17:43.33,[16:9] Main,,0,0,0,,Mấy người thôi đi.
Dialogue: 0,0:17:43.99,0:17:46.53,[16:9] Main,,0,0,0,,Chẳng khác gì mọi khi,\Nđúng là hết cách với chúng.
Dialogue: 0,0:17:46.53,0:17:47.84,[16:9] Main,,0,0,0,,Cái lũ lợn trắng ấy.
Dialogue: 0,0:17:48.42,0:17:51.47,[16:9] Main,,0,0,0,,Thế này thì ai kế nhiệm tiếp quản\Nthì cũng tương tự mà thôi.
Dialogue: 0,0:17:51.47,0:17:52.43,[16:9] Main,,0,0,0,,Nhỉ?
Dialogue: 0,0:17:52.70,0:17:56.35,[16:9] Main,,0,0,0,,Mà dù sao thì, hôm qua mọi người\Nđều được tiễn đưa mà.
Dialogue: 0,0:17:56.62,0:17:57.67,[16:9] Main,,0,0,0,,Đúng chứ Shin?
Dialogue: 0,0:17:58.24,0:18:00.60,[16:9] Main,,0,0,0,,Ừ, ổn cả rồi.
Dialogue: 0,0:18:03.09,0:18:07.57,[16:9] Main,,0,0,0,,Mà, dù có chết cũng được Tử Thần dẫn dắt.
Dialogue: 0,0:18:07.57,0:18:09.58,[16:9] Main,,0,0,0,,Nghe được đấy chứ.
Dialogue: 0,0:18:12.78,0:18:14.85,[16:9] Main,,0,0,0,,Gì vậy?
Dialogue: 0,0:18:15.43,0:18:16.37,[16:9] Main,,0,0,0,,Nè.
Dialogue: 0,0:18:36.79,0:18:39.03,[16:9] Main,,0,0,0,,Đau quá...
Dialogue: 0,0:18:39.03,0:18:39.97,[16:9] Main,,0,0,0,,Khốn kiếp...
Dialogue: 0,0:18:41.08,0:18:43.15,[16:9] Main,,0,0,0,,{\pos(959.66,1032.66)}Khốn kiếp!
Dialogue: 0,0:18:43.14,0:18:43.19,[16:9] Main,,0,0,0,,{\pos(961.14,1031.9)}Khốn kiếp!
