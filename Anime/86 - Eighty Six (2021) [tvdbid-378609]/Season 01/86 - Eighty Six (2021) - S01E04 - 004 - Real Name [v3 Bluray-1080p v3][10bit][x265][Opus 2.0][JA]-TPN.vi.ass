Dialogue: 0,0:00:48.11,0:00:48.81,[16:9] Main,,0,0,0,,Nhưng mà...
Dialogue: 0,0:00:48.81,0:00:50.31,[16:9] Main,,0,0,0,,Chiến đấu đã kết thúc.
Dialogue: 0,0:00:50.31,0:00:52.53,[16:9] Main,,0,0,0,,Cô cũng hết bổn phận quản lý còn gì.
Dialogue: 0,0:00:53.01,0:00:56.67,[16:9] Main,,0,0,0,,Laughing Fox đúng là đã quá lời,\Nnhưng chúng tôi cũng...
Dialogue: 0,0:00:56.67,0:01:00.04,[16:9] Main,,0,0,0,,Chẳng có tâm trạng\Nmà tâm tình vui vẻ với cô đâu.
Dialogue: 0,0:01:01.57,0:01:02.90,[16:9] Main,,0,0,0,,Tôi xin lỗi...
Dialogue: 0,0:01:08.55,0:01:09.80,[16:9] Main,,0,0,0,,{\i1}Tôi không muốn chết.
Dialogue: 0,0:01:16.02,0:01:17.99,[16:9] Main,,0,0,0,,Xin lỗi... Kaie...
Dialogue: 0,0:01:19.68,0:01:22.35,[16:9] Main,,0,0,0,,Vì đã hành xử như lũ lợn trắng...
Dialogue: 0,0:01:26.03,0:01:28.03,[16:9] Main,,0,0,0,,Mà làm vấy bẩn sự hy sinh của cậu...
Dialogue: 0,0:02:59.82,0:03:01.48,[16:9] Main,,0,0,0,,Lên này!
Dialogue: 0,0:03:03.19,0:03:04.15,[16:9] Main,,0,0,0,,Fight!
Dialogue: 0,0:03:04.15,0:03:04.46,[16:9] Main,,0,0,0,,Theo!
Dialogue: 0,0:03:06.06,0:03:07.33,[16:9] Main,,0,0,0,,Ê, này!
Dialogue: 0,0:03:07.33,0:03:08.72,[16:9] Main,,0,0,0,,Cẩn thận cái đi!
Dialogue: 0,0:03:08.72,0:03:10.47,[16:9] Main,,0,0,0,,Xin lỗi...
Dialogue: 0,0:03:10.47,0:03:13.09,[16:9] Main,,0,0,0,,Sao nào?
Dialogue: 0,0:03:13.09,0:03:15.37,[16:9] Main,,0,0,0,,Tiếp, tiếp đi!
Dialogue: 0,0:03:15.37,0:03:16.76,[16:9] Main,,0,0,0,,Chạy đi!
Dialogue: 0,0:03:17.41,0:03:19.01,[16:9] Main,,0,0,0,,Ném đi!
Dialogue: 0,0:03:23.99,0:03:25.62,[16:9] Main,,0,0,0,,A! Shiro!
Dialogue: 0,0:03:25.62,0:03:28.60,[16:9] Main,,0,0,0,,Đừng có cử động chứ, Shiro!
Dialogue: 0,0:03:30.90,0:03:34.26,[16:9] Main,,0,0,0,,Theo, cái mặt đấy là của con cáo mà.
Dialogue: 0,0:03:34.26,0:03:35.67,[16:9] Main,,0,0,0,,Có chút đáng sợ đấy.
Dialogue: 0,0:03:35.67,0:03:37.76,[16:9] Main,,0,0,0,,Cơ mà chẳng thấy cười gì cả...
Dialogue: 0,0:03:37.76,0:03:39.78,[16:9] Main,,0,0,0,,Cậu là Laughing Fox còn gì?
Dialogue: 0,0:03:39.78,0:03:41.53,[16:9] Main,,0,0,0,,Lắm chuyện thật.
Dialogue: 0,0:03:41.53,0:03:42.99,[16:9] Main,,0,0,0,,Bận tâm hả?
Dialogue: 0,0:03:42.99,0:03:44.62,[16:9] Main,,0,0,0,,Vì những lời đã nói với con ả đấy sao?
Dialogue: 0,0:03:45.81,0:03:47.00,[16:9] Main,,0,0,0,,Tôi không bận tâm!
Dialogue: 0,0:03:47.00,0:03:49.85,[16:9] Main,,0,0,0,,Không, quả nhiên là có bận tâm mà.
Dialogue: 0,0:03:49.85,0:03:50.82,[16:9] Main,,0,0,0,,Công nhận...
Dialogue: 0,0:03:53.85,0:03:55.01,[16:9] Main,,0,0,0,,Theo!
Dialogue: 0,0:03:56.05,0:03:58.34,[16:9] Main,,0,0,0,,Sửa lại chỗ đó nào~
Dialogue: 0,0:04:03.11,0:04:05.68,[16:9] Main,,0,0,0,,Đúng là bận tâm còn gì, bứt ra thế này cơ mà.
Dialogue: 0,0:04:05.68,0:04:08.35,[16:9] Main,,0,0,0,,Lại còn đúng cái cúc áo\Nlúc nào cũng bứt ra nữa chứ.
Dialogue: 0,0:04:08.35,0:04:09.82,[16:9] Main,,0,0,0,,Sao cũng được, chẳng có ý gì đâu.
Dialogue: 0,0:04:09.82,0:04:11.65,[16:9] Main,,0,0,0,,Nói vậy càng chuẩn bài Theo ấy.
Dialogue: 0,0:04:11.65,0:04:13.19,[16:9] Main,,0,0,0,,Ứ thèm nói nữa!
Dialogue: 0,0:04:14.51,0:04:16.86,[16:9] Main,,0,0,0,,Hôm qua chẳng giống cậu chút nào nhỉ.
Dialogue: 0,0:04:16.86,0:04:19.50,[16:9] Main,,0,0,0,,Cái cách nói chuyện đó tuy chẳng hay ho gì...
Dialogue: 0,0:04:19.99,0:04:21.62,[16:9] Main,,0,0,0,,nhưng đúng là hoài niệm thật.
Dialogue: 0,0:04:21.62,0:04:23.50,[16:9] Main,,0,0,0,,Đội trưởng Cáo ấy...
Dialogue: 0,0:04:27.79,0:04:30.68,[16:9] Main,,0,0,0,,Thôi bỏ đi... mọi người cũng thật là...
Dialogue: 0,0:04:30.68,0:04:33.99,[16:9] Main,,0,0,0,,Cũng bởi... đấy là chuyện đáng ghen tỵ đó.
Dialogue: 0,0:04:33.99,0:04:36.92,[16:9] Main,,0,0,0,,Theo đã gặp được một người như vậy cơ mà...
Dialogue: 0,0:04:36.92,0:04:38.34,[16:9] Main,,0,0,0,,Tự dưng nói cái gì vậy?
Dialogue: 0,0:04:38.34,0:04:41.72,[16:9] Main,,0,0,0,,Đấy là một người đáng để\Nchân thành khắc ghi đúng không?
Dialogue: 0,0:04:42.51,0:04:45.97,[16:9] Main,,0,0,0,,Tớ thì chỉ toàn gặp phải\Nnhững người không giống vậy thôi.
Dialogue: 0,0:04:49.95,0:04:51.23,[16:9] Main,,0,0,0,,Thế nhé, Shin!
Dialogue: 0,0:04:51.23,0:04:53.49,[16:9] Main,,0,0,0,,Lần tới không được làm liều nữa đâu!
Dialogue: 0,0:04:53.49,0:04:56.15,[16:9] Main,,0,0,0,,Cho tới lúc phụ tùng thay thế chuyển đến\Nthì hãy ngoan ngoãn hộ ta!
Dialogue: 0,0:04:56.15,0:04:57.47,[16:9] Main,,0,0,0,,Đấy là nếu có thể.
Dialogue: 0,0:04:59.77,0:05:01.01,[16:9] Main,,0,0,0,,Này, Theo!
Dialogue: 0,0:05:01.01,0:05:02.99,[16:9] Main,,0,0,0,,Chú mày cũng đừng có làm liều đấy.
Dialogue: 0,0:05:02.99,0:05:05.84,[16:9] Main,,0,0,0,,Ôi, lũ ranh con đứa nào cũng như đứa nào...
Dialogue: 0,0:05:06.33,0:05:09.21,[16:9] Main,,0,0,0,,Lúc nào cũng như sắp phọt máu tới nơi nhỉ?
Dialogue: 0,0:05:09.21,0:05:12.00,[16:9] Main,,0,0,0,,Dù đôi khi tôi cũng có muốn\Nchọc tức ông ấy đâu...
Dialogue: 0,0:05:12.74,0:05:14.71,[16:9] Main,,0,0,0,,Chuyện đó thì sao mà được chứ?
Dialogue: 0,0:05:18.39,0:05:19.22,[16:9] Main,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:05:22.62,0:05:26.58,[16:9] Main,,0,0,0,,Nếu là đội trưởng... thì sẽ nói gì nhỉ...\Nvới ả Handler ấy...
Dialogue: 0,0:05:27.89,0:05:29.44,[16:9] Main,,0,0,0,,Đội trưởng Cáo hả?
Dialogue: 0,0:05:29.44,0:05:30.57,[16:9] Main,,0,0,0,,Ừm.
Dialogue: 0,0:05:30.57,0:05:32.82,[16:9] Main,,0,0,0,,Quả nhiên là cả đội trưởng cũng giận thôi...
Dialogue: 0,0:05:33.85,0:05:35.92,[16:9] Main,,0,0,0,,Mà thôi, sao cũng được.
Dialogue: 0,0:05:35.92,0:05:38.36,[16:9] Main,,0,0,0,,Chắc cũng chẳng kết nối Para-RAID nữa đâu.
Dialogue: 0,0:05:39.01,0:05:42.06,[16:9] Main,,0,0,0,,Ả lợn trắng thích chơi trò thánh nữ ấy.
Dialogue: 0,0:05:42.06,0:05:44.74,[16:9] Main,,0,0,0,,Nếu là đội trưởng của cậu\Nthì sẽ không nói vậy đâu.
Dialogue: 0,0:05:46.74,0:05:50.32,[16:9] Main,,0,0,0,,Chẳng phải vẫn luôn nghĩ như vậy sao... cậu ấy?
Dialogue: 0,0:06:11.94,0:06:14.02,[16:9] Main,,0,0,0,,Cô có chuyện gì sao...
Dialogue: 0,0:06:14.19,0:06:17.01,[16:9] Main,,0,0,0,,Handler One?
Dialogue: 0,0:06:25.07,0:06:28.28,[16:9] Main,,0,0,0,,Rốt cuộc thì Lena vẫn là\Ncông dân Nước Cộng Hoà đó.
Dialogue: 0,0:06:28.29,0:06:32.41,[16:9] Main,,0,0,0,,Chúng ta thì vẫn cứ sống\Nở thế giới của chúng ta thôi.
Dialogue: 0,0:06:32.90,0:06:35.35,[16:9] Main,,0,0,0,,Chuyện đó... là chuyện không thể dung thứ...
Dialogue: 0,0:06:35.92,0:06:38.51,[16:9] Main,,0,0,0,,Chí ít thì tớ cũng không thể\Ndung thứ cho bản thân.
Dialogue: 0,0:06:38.51,0:06:40.81,[16:9] Main,,0,0,0,,Vậy thì cậu định không dung thứ kiểu gì?
Dialogue: 0,0:06:40.81,0:06:43.97,[16:9] Main,,0,0,0,,Mò ra khu 86, rồi cùng họ chiến đấu hả?
Dialogue: 0,0:06:43.97,0:06:45.63,[16:9] Main,,0,0,0,,Rõ ràng là không thể còn gì?
Dialogue: 0,0:06:46.44,0:06:50.18,[16:9] Main,,0,0,0,,Việc Lena cần làm lúc này là\Nchiều chuộng bản thân đó.
Dialogue: 0,0:06:50.87,0:06:53.05,[16:9] Main,,0,0,0,,Tớ lỡ làm hơi nhiều pudding rồi.
Dialogue: 0,0:06:53.05,0:06:54.19,[16:9] Main,,0,0,0,,Annette...
Dialogue: 0,0:06:54.19,0:06:55.94,[16:9] Main,,0,0,0,,Xin lỗi, nhưng giờ tớ không có tâm trạng...
Dialogue: 0,0:06:55.94,0:06:57.82,[16:9] Main,,0,0,0,,Đừng cố quá người ơi.
Dialogue: 0,0:06:59.75,0:07:01.40,[16:9] Main,,0,0,0,,Thế giới này ấy nhé...
Dialogue: 0,0:07:01.40,0:07:05.35,[16:9] Main,,0,0,0,,Cho phép chúng ta lén lút ngồi ăn pudding\Ngiữa ban ngày là một thế giới tuyệt vời đó.
Dialogue: 0,0:07:05.35,0:07:07.00,[16:9] Main,,0,0,0,,Chẳng có gì tuyệt đâu.
Dialogue: 0,0:07:07.00,0:07:07.87,[16:9] Main,,0,0,0,,Một chút cũng không.
Dialogue: 0,0:07:07.87,0:07:11.79,[16:9] Main,,0,0,0,,Thật tình, mỗi cái chuyện không hỏi tên\Nthì có làm sao chứ?
Dialogue: 0,0:07:11.79,0:07:14.89,[16:9] Main,,0,0,0,,Đại khái thì chuyện biết tên\Ncũng có cần thiết đâu.
Dialogue: 0,0:07:14.89,0:07:17.17,[16:9] Main,,0,0,0,,Đằng nào từ giờ cũng không gặp nhau cơ mà.
Dialogue: 0,0:07:17.17,0:07:19.01,[16:9] Main,,0,0,0,,Henrietta Penrose.
Dialogue: 0,0:07:19.38,0:07:20.98,[16:9] Main,,0,0,0,,Tự dưng cậu làm sao vậy?
Dialogue: 0,0:07:20.98,0:07:22.71,[16:9] Main,,0,0,0,,Đó là tên của cậu.
Dialogue: 0,0:07:22.71,0:07:25.58,[16:9] Main,,0,0,0,,Tớ biết tên của cậu.
Dialogue: 0,0:07:25.58,0:07:26.74,[16:9] Main,,0,0,0,,Vì chúng ta là bạn bè.
Dialogue: 0,0:07:27.45,0:07:28.59,[16:9] Main,,0,0,0,,Vậy thì sao chứ?
Dialogue: 0,0:07:28.59,0:07:31.71,[16:9] Main,,0,0,0,,Cái tên chính là con người.
Dialogue: 0,0:07:31.71,0:07:34.35,[16:9] Main,,0,0,0,,Vậy mà tớ đã chà đạp lên nó.
Dialogue: 0,0:07:35.18,0:07:38.10,[16:9] Main,,0,0,0,,Tớ đã không coi họ như con người.
Dialogue: 0,0:07:38.10,0:07:39.86,[16:9] Main,,0,0,0,,Nghĩ nhiều quá rồi.
Dialogue: 0,0:07:39.86,0:07:43.61,[16:9] Main,,0,0,0,,Nói chung thì giữa Lena và 86\Nchẳng có bạn bè hay gì cả.
Dialogue: 0,0:07:43.61,0:07:45.31,[16:9] Main,,0,0,0,,Nhưng cùng là con người với nhau mà...
Dialogue: 0,0:07:45.31,0:07:47.15,[16:9] Main,,0,0,0,,Nếu quả thật có nghĩ như vậy thì...
Dialogue: 0,0:07:47.15,0:07:50.12,[16:9] Main,,0,0,0,,thì cậu đã hỏi thẳng tên họ từ đầu rồi.
Dialogue: 0,0:07:51.56,0:07:54.02,[16:9] Main,,0,0,0,,Đây cũng là dịp tốt đấy.
Dialogue: 0,0:07:54.02,0:07:56.29,[16:9] Main,,0,0,0,,Đừng có dính líu sâu thêm thì hơn đó.
Dialogue: 0,0:07:56.29,0:07:58.50,[16:9] Main,,0,0,0,,Tại sao chứ, cự tuyệt họ ngay như vậy...
Dialogue: 0,0:07:58.50,0:08:00.00,[16:9] Main,,0,0,0,,Vì chẳng thể làm gì chứ sao.
Dialogue: 0,0:08:01.05,0:08:04.21,[16:9] Main,,0,0,0,,Ở đây có pudding, còn đằng đó thì không.
Dialogue: 0,0:08:04.67,0:08:07.25,[16:9] Main,,0,0,0,,Chúng ta khác với họ.
Dialogue: 0,0:08:07.25,0:08:08.90,[16:9] Main,,0,0,0,,Dù là phương diện gì đi nữa...
Dialogue: 0,0:08:08.90,0:08:11.54,[16:9] Main,,0,0,0,,Thế nên càng dính dáng chỉ càng hối hận thôi.
Dialogue: 0,0:08:11.54,0:08:12.21,[16:9] Main,,0,0,0,,Nhưng mà—
Dialogue: 0,0:08:12.21,0:08:13.21,[16:9] Main,,0,0,0,,Lena...
Dialogue: 0,0:08:13.21,0:08:15.77,[16:9] Main,,0,0,0,,chiến tranh nổ ra cũng là chuyện đã rồi.
Dialogue: 0,0:08:16.85,0:08:18.60,[16:9] Main,,0,0,0,,Chẳng thể trở lại thời đó được đâu.
Dialogue: 0,0:08:21.20,0:08:22.55,[16:9] Main,,0,0,0,,Tóm lại là...
Dialogue: 0,0:08:22.55,0:08:25.61,[16:9] Main,,0,0,0,,Mau nghỉ làm Handler\Nvà chuyển sang Bộ Nghiên cứu đi.
Dialogue: 0,0:08:25.61,0:08:26.85,[16:9] Main,,0,0,0,,Đã bảo là...
Dialogue: 0,0:08:28.00,0:08:29.13,[16:9] Main,,0,0,0,,Tớ không nghỉ đâu.
Dialogue: 0,0:08:29.76,0:08:30.45,[16:9] Main,,0,0,0,,Vị trí Handler ấy...
Dialogue: 0,0:08:33.77,0:08:36.79,[16:9] Main,,0,0,0,,Những lời của bạn thân thì phải lắng nghe chứ?
Dialogue: 0,0:08:39.69,0:08:41.18,[16:9] Main,,0,0,0,,Vladilena Milizé.
Dialogue: 0,0:08:47.81,0:08:49.67,[16:9] Main,,0,0,0,,{\i1}Hãy tới quan sát chiến trường đi.
Dialogue: 0,0:08:51.00,0:08:53.28,[16:9] Main,,0,0,0,,{\i1}Tự mình chứng kiến những chuyện đang xảy ra...
Dialogue: 0,0:08:54.21,0:08:55.56,[16:9] Main,,0,0,0,,{\i1}Tất cả mọi thứ ngoài đó...
Dialogue: 0,0:08:58.43,0:09:02.08,[16:9] Main,,0,0,0,,Chiến tranh đang diễn ra phải không, thưa cha?
Dialogue: 0,0:09:02.08,0:09:03.47,[16:9] Main,,0,0,0,,Ừm, phải rồi.
Dialogue: 0,0:09:03.47,0:09:07.38,[16:9] Main,,0,0,0,,Và rồi, chúng ta đã đồng lòng\Nlàm một chuyện còn tồi tệ hơn thế.
Dialogue: 0,0:09:07.38,0:09:08.78,[16:9] Main,,0,0,0,,Chuyện tồi tệ ạ?
Dialogue: 0,0:09:11.00,0:09:12.53,[16:9] Main,,0,0,0,,Chúng ta nhất định phải ngăn nó lại...
Dialogue: 0,0:09:13.43,0:09:14.48,[16:9] Main,,0,0,0,,Cái chuyện này...
Dialogue: 0,0:09:15.93,0:09:16.79,[16:9] Main,,0,0,0,,Càng sớm càng tốt...
Dialogue: 0,0:09:18.98,0:09:22.54,[16:9] Main,,0,0,0,,Cậu có thể vòng qua lên\Ncăn cứ tiền tuyến một chút được không?
Dialogue: 0,0:09:22.54,0:09:23.78,[16:9] Main,,0,0,0,,Tuân lệnh, thưa Đại tá!
Dialogue: 0,0:09:36.41,0:09:37.20,[16:9] Main,,0,0,0,,Sao thế?
Dialogue: 0,0:09:39.36,0:09:40.47,[16:9] Main,,0,0,0,,Chú...
Dialogue: 0,0:09:43.31,0:09:45.19,[16:9] Main,,0,0,0,,Tới tận bây giờ cháu vẫn không thể quên.
Dialogue: 0,0:09:45.19,0:09:50.06,[16:9] Main,,0,0,0,,Nơi cuối cùng cha đã đưa cháu tới...\Nchiến trường ở khu 86.
Dialogue: 0,0:09:51.79,0:09:53.79,[16:9] Main,,0,0,0,,Tuy rất đau lòng vì chuyện của cha...
Dialogue: 0,0:09:54.54,0:09:57.99,[16:9] Main,,0,0,0,,Nhưng... cháu nghĩ là\Nthật tốt vì mình đã chứng kiến.
Dialogue: 0,0:09:58.96,0:10:00.08,[16:9] Main,,0,0,0,,Thật tốt?
Dialogue: 0,0:10:00.08,0:10:00.83,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:10:01.44,0:10:03.90,[16:9] Main,,0,0,0,,Được tận mắt nhìn thấy khu 86,
Dialogue: 0,0:10:03.90,0:10:07.04,[16:9] Main,,0,0,0,,đã khiến cháu hiểu ra\Nhiện thực về đất nước này.
Dialogue: 0,0:10:07.04,0:10:11.16,[16:9] Main,,0,0,0,,Cháu đã có thể giác ngộ lý tưởng...\Nmà Nước Cộng Hoà đã vứt bỏ.
Dialogue: 0,0:10:11.16,0:10:11.80,[16:9] Main,,0,0,0,,Thế nên là...
Dialogue: 0,0:10:14.57,0:10:20.58,[16:9] Main,,0,0,0,,Václav là một người đàn ông nhân hậu luôn\Nôm lấy lý tưởng muốn Nước Cộng Hoà tốt đẹp hơn.
Dialogue: 0,0:10:21.18,0:10:24.80,[16:9] Main,,0,0,0,,Cậu ấy cũng là một người chồng,\Nmột người cha tốt phải không?
Dialogue: 0,0:10:24.80,0:10:28.15,[16:9] Main,,0,0,0,,Vậy nên cậu ấy mới muốn cho cháu biết về\Nsự thật của đất nước này.
Dialogue: 0,0:10:28.67,0:10:31.08,[16:9] Main,,0,0,0,,Một người đầy lòng chính nghĩa như vậy,
Dialogue: 0,0:10:31.08,0:10:33.75,[16:9] Main,,0,0,0,,mà lại bỏ mạng vì bị quân địch tấn công...
Dialogue: 0,0:10:33.75,0:10:37.91,[16:9] Main,,0,0,0,,với tư cách là một người bạn thân,\Nta thực sự lấy làm tiếc.
Dialogue: 0,0:10:37.91,0:10:39.00,[16:9] Main,,0,0,0,,Tuy nhiên...
Dialogue: 0,0:10:40.16,0:10:42.25,[16:9] Main,,0,0,0,,Cậu ấy đã không nhận thức được.
Dialogue: 0,0:10:43.35,0:10:45.33,[16:9] Main,,0,0,0,,Về... điều gì ạ...
Dialogue: 0,0:10:45.33,0:10:48.26,[16:9] Main,,0,0,0,,Việc bản thân không khác với\Nnhững người dân Cộng Hoà kia,
Dialogue: 0,0:10:48.26,0:10:51.68,[16:9] Main,,0,0,0,,cũng chỉ là kẻ đứng trên đài cao\Nmà nhìn xuống mà thôi.
Dialogue: 0,0:10:51.68,0:10:55.18,[16:9] Main,,0,0,0,,Dù có kể lể về bình đẳng thế nào đi nữa,\Ncuối cùng cũng chỉ là chuyện của người ta.
Dialogue: 0,0:10:55.64,0:11:00.40,[16:9] Main,,0,0,0,,Cậu ta vô thức mà cho rằng\Nkẻ chết trên chiến trường chỉ có 86 mà thôi.
Dialogue: 0,0:11:00.40,0:11:03.60,[16:9] Main,,0,0,0,,Đó là lý do cậu ta dám dẫn cháu ra chiến trường.
Dialogue: 0,0:11:03.60,0:11:08.31,[16:9] Main,,0,0,0,,Chính vì cái sự bất cần\Nđể thực hiện cái lý tưởng đó, mà Václav...
Dialogue: 0,0:11:08.89,0:11:11.48,[16:9] Main,,0,0,0,,mới biến thành một kẻ vô tri, một kẻ ngu ngốc.
Dialogue: 0,0:11:13.56,0:11:18.21,[16:9] Main,,0,0,0,,Lena, ta không muốn cháu trở nên giống cậu ấy.
Dialogue: 0,0:11:20.68,0:11:23.57,[16:9] Main,,0,0,0,,Thôi bỏ đi, cháu đã làm tốt lắm rồi.
Dialogue: 0,0:11:24.20,0:11:28.21,[16:9] Main,,0,0,0,,Việc giao cho cháu một chiến đội phức tạp\Ncũng có một phần trách nhiệm ở ta.
Dialogue: 0,0:11:28.21,0:11:32.84,[16:9] Main,,0,0,0,,Nhưng là do ta muốn cháu tự mình\Nnhận thức được tình trạng của đất nước này.
Dialogue: 0,0:11:32.84,0:11:35.34,[16:9] Main,,0,0,0,,Tuy nhiên cháu cũng không cần phải cố gắng quá.
Dialogue: 0,0:11:35.34,0:11:38.93,[16:9] Main,,0,0,0,,Không, cháu vẫn muốn là Handler\Nchịu trách nhiệm Chiến đội Spearhead—
Dialogue: 0,0:11:38.93,0:11:41.56,[16:9] Main,,0,0,0,,Quốc kỳ Nước Cộng Hoà chúng ta\Nbiểu thị cho điều gì?
Dialogue: 0,0:11:43.31,0:11:49.56,[16:9] Main,,0,0,0,,Tự Do, Bình Đẳng, Bác Ái,\NChính Nghĩa và Chính Trực.
Dialogue: 0,0:11:50.99,0:11:51.57,[16:9] Main,,0,0,0,,Chú muốn nói gì chứ?
Dialogue: 0,0:11:51.57,0:11:54.48,[16:9] Main,,0,0,0,,Cháu có thông suốt được ý nghĩa của nó không?
Dialogue: 0,0:11:55.45,0:11:57.02,[16:9] Main,,0,0,0,,Nhìn vào hiện thực đi!
Dialogue: 0,0:11:57.02,0:12:00.07,[16:9] Main,,0,0,0,,Những thứ đẹp đẽ đó\Nkhông có ở Nước Cộng Hoà này.
Dialogue: 0,0:12:00.07,0:12:02.76,[16:9] Main,,0,0,0,,Cháu đã truy cầu lý tưởng một cách thái quá.
Dialogue: 0,0:12:02.76,0:12:04.96,[16:9] Main,,0,0,0,,Cả với người khác, lẫn bản thân.
Dialogue: 0,0:12:05.42,0:12:10.08,[16:9] Main,,0,0,0,,Lý tưởng là thứ cao xa chẳng thể với tới\Nnên mới được gọi là lý tưởng.
Dialogue: 0,0:12:10.08,0:12:13.72,[16:9] Main,,0,0,0,,Việc biết không thể với tới,\Nnhưng vẫn truy cầu nó...
Dialogue: 0,0:12:13.72,0:12:17.00,[16:9] Main,,0,0,0,,Cháu có nghĩ là việc ngu ngốc và hèn hạ không?
Dialogue: 20,0:12:19.20,0:12:23.10,[16:9] Main,,0,0,0,,{\an8}Tổng bộ Quân đội Cộng Hoà San Magnolia\Nxin được thông báo tình hình chiến sự hôm nay.
Dialogue: 20,0:12:36.69,0:12:40.95,[16:9] Main,,0,0,0,,{\an8}Thiệt hại bên phía chúng ta là không đáng kể,\N thiệt hại về nhân mạng là không có.
Dialogue: 20,0:12:40.95,0:12:44.43,[16:9] Main,,0,0,0,,{\an8}Nhờ sự tham chiến của những cỗ máy\N không người lái tiên tiến và nhân đạo...
Dialogue: 20,0:12:44.43,0:12:48.00,[16:9] Main,,0,0,0,,{\an8}số tử sĩ hôm nay của đất nước chúng ta vẫn là bằng 0.
Dialogue: 20,0:12:54.00,0:12:55.75,[16:9] Main,,0,0,0,,{\an8}Cộng Hoà San Magnolia muôn năm!
Dialogue: 20,0:12:56.17,0:12:58.22,[16:9] Main,,0,0,0,,{\an8}Vinh quang cho lá cờ ngũ sắc!
Dialogue: 0,0:12:23.10,0:12:26.70,[16:9] Main,,0,0,0,,{\i1}Đuổi chúng tôi ra chiến trường,\Nsử dụng chúng tôi như vũ khí để chiến đấu...
Dialogue: 0,0:12:26.70,0:12:30.23,[16:9] Main,,0,0,0,,{\i1}Tự ban cái quyền trốn trong bức tường ấm áp\Nmà quan sát mọi thứ từ trên cao...
Dialogue: 0,0:12:30.23,0:12:34.05,[16:9] Main,,0,0,0,,{\i1}Cái kiểu hưởng thụ \Nvới vẻ mặt điềm nhiên của cô lúc này...
Dialogue: 0,0:12:34.05,0:12:36.69,[16:9] Main,,0,0,0,,{\i1}Nếu đó không phải coi bọn tôi là lợn thì coi là gì hả?
Dialogue: 0,0:12:37.32,0:12:38.17,[16:9] Main,,0,0,0,,{\i1}Cô nghĩ là...
Dialogue: 0,0:12:38.17,0:12:40.89,[16:9] Main,,0,0,0,,{\i1}bọn tôi chiến đấu vì muốn thế hả?
Dialogue: 0,0:12:42.01,0:12:43.61,[16:9] Main,,0,0,0,,{\i1}Các người đã nhốt bọn tôi bên ngoài...
Dialogue: 0,0:12:43.61,0:12:45.66,[16:9] Main,,0,0,0,,{\i1}ép bọn tôi chiến đấu...
Dialogue: 0,0:12:45.66,0:12:48.71,[16:9] Main,,0,0,0,,{\i1}Trong 9 năm, các người đã khiến\N cả triệu người phải chết rồi đấy!
Dialogue: 0,0:12:48.71,0:12:50.64,[16:9] Main,,0,0,0,,{\i1}Hàng ngày chỉ nhẹ nhàng hỏi thăm vài câu...
Dialogue: 0,0:12:50.64,0:12:55.75,[16:9] Main,,0,0,0,,{\i1}mà đã tự coi đó là "đối xử như con người" à.
Dialogue: 0,0:12:58.49,0:13:00.84,[16:9] Main,,0,0,0,,{\i1}Cô không hợp với trách nhiệm đó đâu.
Dialogue: 0,0:13:00.85,0:13:02.47,[16:9] Main,,0,0,0,,{\i1}Hãy đổi cho người khác đi thì hơn.
Dialogue: 0,0:13:02.48,0:13:04.42,[16:9] Main,,0,0,0,,{\i1}Đừng đi đằng đó, Kirschblüte!
Dialogue: 0,0:13:04.42,0:13:05.56,[16:9] Main,,0,0,0,,{\i1}Trước khi cô hối hận.
Dialogue: 0,0:13:05.56,0:13:06.68,[16:9] Main,,0,0,0,,{\i1}Tôi không muốn chết.
Dialogue: 0,0:13:07.45,0:13:09.27,[16:9] Main,,0,0,0,,Khởi động Para-RAID!
Dialogue: 0,0:13:09.60,0:13:10.94,[16:9] Main,,0,0,0,,Đối tượng đồng bộ:
Dialogue: 0,0:13:12.52,0:13:13.88,[16:9] Main,,0,0,0,,Undertaker!
Dialogue: 0,0:13:22.33,0:13:25.00,[16:9] Main,,0,0,0,,{\an8}Cô có chuyện gì sao? Handler One.
Dialogue: 0,0:13:28.09,0:13:31.95,[16:9] Main,,0,0,0,,Undertaker, tôi có thể nói chuyện\Nvới anh bây giờ không?
Dialogue: 0,0:13:31.95,0:13:32.56,[16:9] Main,,0,0,0,,Xin mời.
Dialogue: 0,0:13:34.58,0:13:35.53,[16:9] Main,,0,0,0,,Tôi xin lỗi.
Dialogue: 0,0:13:36.53,0:13:39.95,[16:9] Main,,0,0,0,,Chuyện ngày hôm qua...\Ncả từ trước đến nay nữa...
Dialogue: 0,0:13:41.31,0:13:44.05,[16:9] Main,,0,0,0,,Tôi thực sự xin lỗi.
Dialogue: 0,0:13:46.21,0:13:50.41,[16:9] Main,,0,0,0,,Tôi tên là Lena, Vladilena Milizé.
Dialogue: 0,0:13:51.32,0:13:53.87,[16:9] Main,,0,0,0,,Tôi biết là đã quá muộn,
Dialogue: 0,0:13:55.69,0:13:59.17,[16:9] Main,,0,0,0,,nhưng có thể cho tôi biết\Ntên của mọi người được không?
Dialogue: 0,0:14:00.74,0:14:03.89,[16:9] Main,,0,0,0,,Nếu như cô đang để ý đến lời của Laughing Fox,
Dialogue: 0,0:14:04.36,0:14:05.85,[16:9] Main,,0,0,0,,thì đó là việc không cần thiết.
Dialogue: 0,0:14:06.61,0:14:09.99,[16:9] Main,,0,0,0,,Đó cũng không phải là\Nsuy nghĩ của tất cả chúng tôi.
Dialogue: 0,0:14:09.99,0:14:12.96,[16:9] Main,,0,0,0,,Tình trạng này cũng không phải do cô tạo nên,
Dialogue: 0,0:14:12.96,0:14:16.95,[16:9] Main,,0,0,0,,nên tôi cũng hiểu đó không phải là thứ\Nmà một mình cô có thể giải quyết.
Dialogue: 0,0:14:17.49,0:14:21.09,[16:9] Main,,0,0,0,,Nếu bị đổ trách nhiệm cho những gì bất khả thi,\Nnhững gì cô không làm...
Dialogue: 0,0:14:21.09,0:14:22.76,[16:9] Main,,0,0,0,,thì không việc gì phải bận tâm cả.
Dialogue: 0,0:14:22.76,0:14:27.77,[16:9] Main,,0,0,0,,Nhưng mà, việc không thèm hỏi\Ntên mọi người, vẫn là do tôi bất lịch sự.
Dialogue: 0,0:14:27.77,0:14:29.85,[16:9] Main,,0,0,0,,Đó cũng là do không cần thiết mà thôi.
Dialogue: 0,0:14:29.85,0:14:33.73,[16:9] Main,,0,0,0,,Dù sử dụng phương tiện liên lạc mà Legion\Nkhông thể theo dõi là Para-RAID,
Dialogue: 0,0:14:33.73,0:14:36.18,[16:9] Main,,0,0,0,,nhưng vẫn dùng Call Sign\Nkhi thực thi nhiệm vụ...
Dialogue: 0,0:14:36.18,0:14:39.43,[16:9] Main,,0,0,0,,và thông tin cá nhân của Prosessor cũng\Nkhông được hiển thị là tại sao cô có biết không?
Dialogue: 0,0:14:40.12,0:14:44.52,[16:9] Main,,0,0,0,,Để cho Handler không nghĩ đến việc\NProcessor là con người phải không?
Dialogue: 0,0:14:44.52,0:14:45.03,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:14:45.76,0:14:48.72,[16:9] Main,,0,0,0,,Chỉ sau một năm hoạt động,\Nhầu hết Processor đều sẽ chết.
Dialogue: 0,0:14:49.40,0:14:53.13,[16:9] Main,,0,0,0,,Với một Handler thì theo sát lượng thương vong\Nnhư vậy là một áp lực quá lớn.
Dialogue: 0,0:14:53.13,0:14:54.75,[16:9] Main,,0,0,0,,Hẳn là họ đã nghĩ vậy.
Dialogue: 0,0:14:54.75,0:14:56.60,[16:9] Main,,0,0,0,,Như thế là hèn nhát!
Dialogue: 0,0:14:56.60,0:14:57.72,[16:9] Main,,0,0,0,,Tôi...
Dialogue: 0,0:14:59.37,0:15:02.15,[16:9] Main,,0,0,0,,Tôi cũng... quá hèn nhát...
Dialogue: 0,0:15:03.03,0:15:06.20,[16:9] Main,,0,0,0,,Thú thật là tôi cũng đã từng nghĩ\Nhay cứ vậy mà mình bỏ chạy...
Dialogue: 0,0:15:07.54,0:15:10.85,[16:9] Main,,0,0,0,,Nhưng quả nhiên tôi không muốn\Nbản thân mình cứ hèn nhát như vậy.
Dialogue: 0,0:15:11.59,0:15:17.29,[16:9] Main,,0,0,0,,Vậy nên, liệu anh có thể cho tôi biết\Ntên thật của mọi người được không?
Dialogue: 0,0:15:23.08,0:15:26.93,[16:9] Main,,0,0,0,,Người chiến tử hôm qua,\NKirschblüte là Kaie Taniya.
Dialogue: 0,0:15:27.62,0:15:29.45,[16:9] Main,,0,0,0,,Đội phó Wehrwolf là Raiden Shuga.
Dialogue: 0,0:15:30.12,0:15:33.25,[16:9] Main,,0,0,0,,Laughing Fox: Theoto Rikka.
Dialogue: 0,0:15:33.25,0:15:35.93,[16:9] Main,,0,0,0,,Snow Witch: Anju Emma.
Dialogue: 0,0:15:35.93,0:15:38.51,[16:9] Main,,0,0,0,,Gunslinger: Kurena Kukumila.
Dialogue: 0,0:15:39.35,0:15:41.63,[16:9] Main,,0,0,0,,Black Dog: Daiya Irma.
Dialogue: 0,0:16:02.53,0:16:03.64,[16:9] Main,,0,0,0,,Hết rồi.
Dialogue: 0,0:16:04.33,0:16:05.74,[16:9] Main,,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:16:05.74,0:16:08.61,[16:9] Main,,0,0,0,,Xin hãy gọi tôi là Lena.
Dialogue: 0,0:16:08.61,0:16:10.86,[16:9] Main,,0,0,0,,Tôi xin được phép hỏi, cấp bậc của cô là gì ạ?
Dialogue: 0,0:16:10.86,0:16:12.21,[16:9] Main,,0,0,0,,Là Thiếu tá.
Dialogue: 0,0:16:12.21,0:16:14.24,[16:9] Main,,0,0,0,,Mặc dù chỉ mới lên chức mà thôi.
Dialogue: 0,0:16:14.24,0:16:17.37,[16:9] Main,,0,0,0,,Vậy thì từ giờ tôi xin phép\Nđược gọi cô là Thiếu tá Milizé.
Dialogue: 0,0:16:18.18,0:16:19.39,[16:9] Main,,0,0,0,,Cô có vừa lòng không ạ.
Dialogue: 0,0:16:20.16,0:16:21.09,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:16:23.24,0:16:25.01,[16:9] Main,,0,0,0,,Anh đang làm gì vậy ạ?
Dialogue: 0,0:16:25.01,0:16:28.38,[16:9] Main,,0,0,0,,Tôi đang lưu lại tên của Kaie.
Dialogue: 0,0:16:29.01,0:16:31.26,[16:9] Main,,0,0,0,,Vì 86 không có mộ phần.
Dialogue: 0,0:16:32.43,0:16:35.51,[16:9] Main,,0,0,0,,Đó là vì lời hứa của tôi khi ở chiến đội đầu tiên.
Dialogue: 0,0:16:36.32,0:16:40.17,[16:9] Main,,0,0,0,,Khắc tên người chết vào mảnh vỡ\Nlấy từ cỗ máy của họ,
Dialogue: 0,0:16:40.17,0:16:42.06,[16:9] Main,,0,0,0,,và để những người còn sống giữ chúng.
Dialogue: 0,0:16:42.55,0:16:47.69,[16:9] Main,,0,0,0,,Thế rồi người sống sót cuối cùng,\Nsẽ dẫn tất cả mọi người đến cuối con đường.
Dialogue: 0,0:16:48.79,0:16:50.57,[16:9] Main,,0,0,0,,Vào lúc đó tôi là người cuối cùng còn sống.
Dialogue: 0,0:16:51.19,0:16:52.57,[16:9] Main,,0,0,0,,Từ trước đến giờ vẫn luôn là vậy.
Dialogue: 0,0:16:53.51,0:16:56.68,[16:9] Main,,0,0,0,,Vậy nên dù là ở chiến đội này,\Nđó cũng là nghĩa vụ của tôi.
Dialogue: 0,0:16:57.17,0:16:58.99,[16:9] Main,,0,0,0,,Vẫn luôn như vậy suốt 5 năm nay...
Dialogue: 0,0:16:59.85,0:17:03.34,[16:9] Main,,0,0,0,,Đến nay đã có bao nhiêu người rồi ạ?
Dialogue: 0,0:17:03.76,0:17:07.71,[16:9] Main,,0,0,0,,561 người, bao gồm cả Kaie.
Dialogue: 0,0:17:07.71,0:17:09.91,[16:9] Main,,0,0,0,,Và tất cả bọn họ, anh vẫn luôn...
Dialogue: 0,0:17:09.91,0:17:13.72,[16:9] Main,,0,0,0,,Tôi vẫn luôn nhớ tới họ,\Nvì tôi còn phải dẫn họ đi nữa.
Dialogue: 0,0:17:13.72,0:17:18.58,[16:9] Main,,0,0,0,,Tôi sẽ mang tất cả những đồng đội đã chiến tử\Nbên mình, đến nơi cuối cùng tôi có thể đến.
Dialogue: 0,0:17:21.67,0:17:24.92,[16:9] Main,,0,0,0,,Chính vì vậy anh mới có mật danh là\NUndertaker phải không?
Dialogue: 0,0:17:24.92,0:17:26.29,[16:9] Main,,0,0,0,,Một phần là thế.
Dialogue: 0,0:17:26.89,0:17:30.96,[16:9] Main,,0,0,0,,Còn tôi thì chẳng dám đối diện với những\Nthuộc hạ tử trận, mà chỉ biết đau buồn.
Dialogue: 0,0:17:32.04,0:17:34.52,[16:9] Main,,0,0,0,,Thực lòng... xin lỗi.
Dialogue: 0,0:17:36.33,0:17:41.61,[16:9] Main,,0,0,0,,Nhưng nếu được thì liệu tôi có thể trực tiếp\Nxin lỗi toàn bộ mọi người được không ạ?
Dialogue: 0,0:17:41.61,0:17:43.21,[16:9] Main,,0,0,0,,Vậy thì liên kết với họ nhé.
Dialogue: 0,0:17:44.45,0:17:45.68,[16:9] Main,,0,0,0,,Bây giờ luôn sao?
Dialogue: 0,0:17:45.68,0:17:47.47,[16:9] Main,,0,0,0,,Không, không cần đâu ạ!
Dialogue: 0,0:17:45.68,0:17:47.47,[16:9] Main,,0,0,0,,{\an8}Xin hãy đợi một lát.
Dialogue: 0,0:17:47.47,0:17:47.88,[16:9] Main,,0,0,0,,Ế?
Dialogue: 0,0:19:13.29,0:19:14.72,[16:9] Main,,0,0,0,,Gọi toàn thể chiến đội.
Dialogue: 0,0:19:15.59,0:19:18.55,[16:9] Main,,0,0,0,,Chuyện hôm qua, lẫn hành xử từ trước đến nay...
Dialogue: 0,0:19:18.55,0:19:20.60,[16:9] Main,,0,0,0,,Tôi thực lòng xin lỗi mọi người.
Dialogue: 0,0:19:21.31,0:19:22.84,[16:9] Main,,0,0,0,,Tôi là Handler...
Dialogue: 0,0:19:23.39,0:19:25.35,[16:9] Main,,0,0,0,,Vladilena Milizé.
Dialogue: 0,0:19:25.35,0:19:28.52,[16:9] Main,,0,0,0,,Tôi đã không đối xử với các bạn như con người...
Dialogue: 0,0:19:28.52,0:19:30.86,[16:9] Main,,0,0,0,,Chính bản thân tôi cũng đã\Nkhông nhận thức được điều đó...
Dialogue: 0,0:19:31.37,0:19:33.90,[16:9] Main,,0,0,0,,Nên bị các bạn cự tuyệt như vậy là lẽ dĩ nhiên.
Dialogue: 0,0:19:34.80,0:19:38.03,[16:9] Main,,0,0,0,,Nhưng dù vậy, nếu như\Ncác bạn vẫn sẵn lòng cho tôi biết.
Dialogue: 0,0:19:38.03,0:19:39.60,[16:9] Main,,0,0,0,,Thì lúc này, hãy cho tôi biết tên—
Dialogue: 0,0:19:39.60,0:19:42.40,[16:9] Main,,0,0,0,,Ầy, cô hỏi Shin hết rồi phải không?
Dialogue: 0,0:19:42.40,0:19:43.41,[16:9] Main,,0,0,0,,Phiền vãi chưởng—
Dialogue: 0,0:19:44.38,0:19:45.71,[16:9] Main,,0,0,0,,Tôi đã hỏi anh ấy.
Dialogue: 0,0:19:45.71,0:19:49.55,[16:9] Main,,0,0,0,,Nhưng đó không phải\Ndo các bạn tự mình nói cho tôi.
Dialogue: 0,0:19:52.78,0:19:54.05,[16:9] Main,,0,0,0,,Tại cậu làm chuyện không đâu đấy!
Dialogue: 0,0:19:54.05,0:19:55.99,[16:9] Main,,0,0,0,,Cậu đang hối hận kia mà.
Dialogue: 0,0:19:55.99,0:19:57.93,[16:9] Main,,0,0,0,,Chưa nói đến nội dung, từ cái cách nói ấy.
Dialogue: 0,0:20:02.31,0:20:06.27,[16:9] Main,,0,0,0,,Dấu hiệu trên Juggernaut của tôi là con cáo cười.
Dialogue: 0,0:20:06.63,0:20:08.77,[16:9] Main,,0,0,0,,Nhưng đó là kế thừa từ người khác.
Dialogue: 0,0:20:08.77,0:20:10.23,[16:9] Main,,0,0,0,,Thế là sao?
Dialogue: 0,0:20:10.23,0:20:13.36,[16:9] Main,,0,0,0,,Anh ấy là đội trưởng\Ncủa chiến đội đầu tiên tôi gia nhập.
Dialogue: 0,0:20:13.80,0:20:16.86,[16:9] Main,,0,0,0,,Lúc nào cũng vui vẻ, tươi tỉnh như thằng ngốc...
Dialogue: 0,0:20:16.86,0:20:19.64,[16:9] Main,,0,0,0,,Còn là cựu quân nhân mạnh một cách ngớ ngẩn.
Dialogue: 0,0:20:20.71,0:20:22.96,[16:9] Main,,0,0,0,,Anh ấy cũng là một Alba như cô.
Dialogue: 0,0:20:24.34,0:20:27.55,[16:9] Main,,0,0,0,,Một kẻ quái dị luôn cho rằng\Nchỉ để 86 chiến đấu là kỳ quái.
Dialogue: 0,0:20:27.55,0:20:30.32,[16:9] Main,,0,0,0,,Rồi tự mình quay trở lại tuyến đầu tiền tuyến.
Dialogue: 0,0:20:30.96,0:20:32.42,[16:9] Main,,0,0,0,,Tôi đã cực kỳ ghét anh ta.
Dialogue: 0,0:20:32.42,0:20:35.17,[16:9] Main,,0,0,0,,Nhưng rồi, đến cuối anh ta đã không trở về.
Dialogue: 0,0:20:35.71,0:20:38.18,[16:9] Main,,0,0,0,,Không trở lại, mà chết ở ngoài này.
Dialogue: 0,0:20:39.16,0:20:41.57,[16:9] Main,,0,0,0,,Khi cố gắng bảo vệ Processor khác,
Dialogue: 0,0:20:41.57,0:20:43.81,[16:9] Main,,0,0,0,,anh ta đã nhận bọc hậu mà chết.
Dialogue: 0,0:20:44.39,0:20:48.67,[16:9] Main,,0,0,0,,Cũng chẳng phải tôi định làm\Nnhững thứ như đội trưởng đâu.
Dialogue: 0,0:20:48.67,0:20:51.09,[16:9] Main,,0,0,0,,Chỉ là, chừng nào cô vẫn còn\Ntrốn trong bức tường đó,
Dialogue: 0,0:20:51.09,0:20:53.40,[16:9] Main,,0,0,0,,nghĩa là không hề ngang hàng với bọn tôi...
Dialogue: 0,0:20:53.40,0:20:55.65,[16:9] Main,,0,0,0,,và tôi cũng sẽ không coi cô là đồng đội.
Dialogue: 0,0:20:56.01,0:20:57.45,[16:9] Main,,0,0,0,,Chỉ vậy thôi.
Dialogue: 0,0:20:57.45,0:21:01.83,[16:9] Main,,0,0,0,,Vậy "người tốt" mà Kaie nói\Nlà người ấy phải không?
Dialogue: 0,0:21:01.83,0:21:04.96,[16:9] Main,,0,0,0,,Không phải chỉ đội trưởng đâu,\Nmà là tất cả.
Dialogue: 0,0:21:04.96,0:21:07.54,[16:9] Main,,0,0,0,,Những con người đã quyết tử mà chiến đấu.
Dialogue: 0,0:21:07.99,0:21:12.54,[16:9] Main,,0,0,0,,Dẫu họ cùng chung chủng tộc với\Nlũ Alba đã tạo ra cái thế giới khốn nạn này.
Dialogue: 0,0:21:13.00,0:21:15.42,[16:9] Main,,0,0,0,,Thế thôi, câu chuyện nhảm nhí đến đây là hết.
Dialogue: 0,0:21:15.42,0:21:18.45,[16:9] Main,,0,0,0,,À, tôi là Theoto Rikka.
Dialogue: 0,0:21:18.45,0:21:22.62,[16:9] Main,,0,0,0,,Cô thích gọi là Theo, Rikka hay\Nbé lợn dễ thương gì đó đều được hết.
Dialogue: 0,0:21:22.62,0:21:25.51,[16:9] Main,,0,0,0,,Thực lòng xin lỗi\Nvì những chuyện cho đến hôm qua...
Dialogue: 0,0:21:25.51,0:21:28.18,[16:9] Main,,0,0,0,,Cái đó thì thôi đi, phiền quá đấy.
Dialogue: 0,0:21:28.57,0:21:30.81,[16:9] Main,,0,0,0,,Tôi là Đội phó, Raiden Shuga.
Dialogue: 0,0:21:31.16,0:21:32.23,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:21:32.23,0:21:34.12,[16:9] Main,,0,0,0,,Trước hết cho tôi xin lỗi.
Dialogue: 0,0:21:34.12,0:21:38.73,[16:9] Main,,0,0,0,,Xin lỗi vì đã cười việc cô gọi đến mỗi tối\Nnên chúng tôi đã coi cô như con lợn nguỵ thiện,
Dialogue: 0,0:21:38.73,0:21:42.91,[16:9] Main,,0,0,0,,một con lợn không biết điểm dừng\Nthích giả làm thánh nữ.
Dialogue: 0,0:21:42.91,0:21:46.28,[16:9] Main,,0,0,0,,Cho phép tôi xin lỗi về việc đó, tôi đã sai.
Dialogue: 0,0:21:46.28,0:21:48.16,[16:9] Main,,0,0,0,,Tiền đề là vậy,
Dialogue: 0,0:21:48.69,0:21:53.65,[16:9] Main,,0,0,0,,còn lại đúng như Theo đã nói, chúng tôi\Nkhông hề coi cô ngang hàng với bản thân.
Dialogue: 0,0:21:53.65,0:21:58.37,[16:9] Main,,0,0,0,,Tôi vẫn coi cô là con ngốc khi dù dẫm đạp\Nnhưng vẫn mở miệng nói những điều tươi đẹp.
Dialogue: 0,0:21:58.37,0:22:02.03,[16:9] Main,,0,0,0,,Chuyện đó sẽ chẳng thay đổi được,\Nmà tôi cũng chẳng có cách nhìn nào khác.
Dialogue: 0,0:22:02.99,0:22:07.21,[16:9] Main,,0,0,0,,Nếu cô bằng lòng với việc đó, thì tôi vẫn\Nsẵn lòng tiếp đãi cô như từ trước đến nay.
Dialogue: 0,0:22:07.21,0:22:09.68,[16:9] Main,,0,0,0,,Quan điểm cá nhân của tôi là\Nkhông ủng hộ việc này.
Dialogue: 0,0:22:09.68,0:22:12.52,[16:9] Main,,0,0,0,,Cô không hợp với công việc của Handler.
Dialogue: 0,0:22:12.52,0:22:14.09,[16:9] Main,,0,0,0,,Nên bỏ đi thì hơn.
Dialogue: 0,0:22:16.02,0:22:18.39,[16:9] Main,,0,0,0,,Nếu có thể giết thời gian cùng mọi người,
Dialogue: 0,0:22:18.39,0:22:20.59,[16:9] Main,,0,0,0,,thì từ nay về sau tôi vẫn sẽ tiếp tục gọi tới.
Dialogue: 0,0:22:21.72,0:22:24.29,[16:9] Main,,0,0,0,,Cô đúng là con ngốc hết thuốc chữa.
Dialogue: 0,0:22:24.29,0:22:27.03,[16:9] Main,,0,0,0,,À đúng rồi, mau gửi cho bọn tôi bản đồ đi.
Dialogue: 0,0:22:27.03,0:22:29.58,[16:9] Main,,0,0,0,,Chắc hôm qua cô bận khóc quá,\Nnên quên mất chứ gì.
Dialogue: 0,0:22:29.58,0:22:30.58,[16:9] Main,,0,0,0,,Tôi gửi luôn đây!
Dialogue: 0,0:22:30.58,0:22:32.81,[16:9] Main,,0,0,0,,Chào cô, Thiếu tá Milizé,
Dialogue: 0,0:22:32.81,0:22:34.04,[16:9] Main,,0,0,0,,Daiya Irma kính báo.
Dialogue: 0,0:22:34.04,0:22:35.88,[16:9] Main,,0,0,0,,Tôi là Haruto, mong cô chỉ bảo.
Dialogue: 0,0:22:35.88,0:22:38.03,[16:9] Main,,0,0,0,,Tôi là Anju Emma, thưa Thiếu tá.
Dialogue: 0,0:22:40.27,0:22:41.63,[16:9] Main,,0,0,0,,Kurena Kukumila.
Dialogue: 0,0:22:41.63,0:22:42.84,[16:9] Main,,0,0,0,,Tôi là Lecca!
Dialogue: 0,0:22:42.84,0:22:43.49,[16:9] Main,,0,0,0,,Tôi là Chise.
Dialogue: 0,0:22:43.49,0:22:45.55,[16:9] Main,,0,0,0,,Mình là bé Kino.
Dialogue: 0,0:22:45.55,0:22:47.93,[16:9] Main,,0,0,0,,{\fad(0,300)}Xin cảm ơn mọi người.
Dialogue: 0,0:22:55.93,0:22:58.19,[16:9] Main,,0,0,0,,A, xin phép anh, Undertaker.
Dialogue: 0,0:22:58.19,0:22:59.40,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:22:59.40,0:23:03.76,[16:9] Main,,0,0,0,,Hình như tôi vẫn chưa được biết tên anh.
Dialogue: 0,0:23:03.76,0:23:06.27,[16:9] Main,,0,0,0,,Có khi nào anh không muốn xưng tên sao?
Dialogue: 0,0:23:06.27,0:23:09.21,[16:9] Main,,0,0,0,,Không, chỉ là tôi quên thôi.
Dialogue: 0,0:23:09.21,0:23:11.95,[16:9] Main,,0,0,0,,Xin thứ lỗi, tôi là Shinei Nouzen.
Dialogue: 0,0:23:11.95,0:23:12.83,[16:9] Main,,0,0,0,,Nouzen?
Dialogue: 0,0:23:13.51,0:23:14.45,[16:9] Main,,0,0,0,,Có gì sao?
Dialogue: 0,0:23:14.45,0:23:18.42,[16:9] Main,,0,0,0,,Tôi không chắc, nhưng anh có biết\NShourei Nouzen không?
Dialogue: 0,0:23:19.36,0:23:23.40,[16:9] Main,,0,0,0,,Anh ấy có mật danh là Dullahan\Nvới ký hiệu là kỵ sĩ không đầu.
Dialogue: 0,0:23:32.77,0:23:34.03,[16:9] Main,,0,0,0,,Đó là anh tôi.
