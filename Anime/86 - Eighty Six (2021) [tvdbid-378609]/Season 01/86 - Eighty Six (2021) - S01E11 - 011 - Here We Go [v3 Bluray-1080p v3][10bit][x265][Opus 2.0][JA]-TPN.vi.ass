Dialogue: 0,0:02:33.36,0:02:35.61,[16:9] Main,,0,0,0,,Cũng không thể dẫn nó theo được nữa rồi.
Dialogue: 0,0:02:36.54,0:02:38.55,[16:9] Main,,0,0,0,,Tôi muốn ít nhiều báo đáp nó như thế này.
Dialogue: 0,0:02:40.86,0:02:41.81,[16:9] Main,,0,0,0,,Với cả...
Dialogue: 0,0:02:43.11,0:02:45.67,[16:9] Main,,0,0,0,,Chắc chúng ta cũng\Nchẳng tiến thêm được bao xa đâu.
Dialogue: 0,0:02:50.92,0:02:53.79,[16:9] Main,,0,0,0,,Rốt cuộc thì còn mỗi cỗ máy của Shin à.
Dialogue: 0,0:02:53.79,0:02:56.06,[16:9] Main,,0,0,0,,Súng trường và súng lục đều có, nhưng mà...
Dialogue: 0,0:02:56.06,0:02:58.28,[16:9] Main,,0,0,0,,Đạn thì cũng chỉ có giới hạn thôi.
Dialogue: 0,0:02:58.55,0:03:01.25,[16:9] Main,,0,0,0,,Công ten nơ bị phá huỷ đúng là đau thật đấy.
Dialogue: 0,0:03:01.25,0:03:04.16,[16:9] Main,,0,0,0,,Phần lớn đạn dược và nhiên liệu\Ncũng theo đó mà cháy rồi.
Dialogue: 0,0:03:04.16,0:03:05.24,[16:9] Main,,0,0,0,,Cả đồ ăn nữa.
Dialogue: 0,0:03:05.24,0:03:07.29,[16:9] Main,,0,0,0,,Ừ, cả đồ ăn nữa nhỉ.
Dialogue: 0,0:03:08.06,0:03:09.91,[16:9] Main,,0,0,0,,Bên này xong rồi đó.
Dialogue: 0,0:03:09.91,0:03:10.80,[16:9] Main,,0,0,0,,Còn bên đó?
Dialogue: 0,0:03:10.80,0:03:12.17,[16:9] Main,,0,0,0,,Không vấn đề.
Dialogue: 0,0:03:12.57,0:03:14.15,[16:9] Main,,0,0,0,,Vậy xuất phát thôi.
Dialogue: 0,0:03:14.15,0:03:17.00,[16:9] Main,,0,0,0,,Còn chần chừ nữa là Legion lại phát hiện ra đấy.
Dialogue: 20,0:03:17.00,0:03:17.51,[16:9] Main,,0,0,0,,Ừ.
Dialogue: 20,0:03:17.51,0:03:19.09,[16:9] Main,,0,0,0,,Còn việc lái thì sao?
Dialogue: 0,0:03:19.09,0:03:21.51,[16:9] Main,,0,0,0,,Cứ để cho Shin lo như thế mãi\Ncũng đâu có được.
Dialogue: 0,0:03:21.81,0:03:24.37,[16:9] Main,,0,0,0,,Tuỳ tình hình mà thay phiên nhau thì sao?
Dialogue: 0,0:03:24.37,0:03:25.49,[16:9] Main,,0,0,0,,Vậy cũng được.
Dialogue: 0,0:03:25.49,0:03:28.81,[16:9] Main,,0,0,0,,Nhưng mà phải leo lên Undertaker à?
Dialogue: 0,0:03:29.76,0:03:30.77,[16:9] Main,,0,0,0,,Cậu bất mãn à?
Dialogue: 0,0:03:30.77,0:03:37.19,[16:9] Main,,0,0,0,,Bởi vì thiết lập thông số của Shin một chút\Nkhoảng giãn cũng không có, thật sự đáng sợ lắm.
Dialogue: 0,0:03:37.19,0:03:39.24,[16:9] Main,,0,0,0,,Giới hạn mọi chỗ cũng bị bỏ sạch nữa.
Dialogue: 0,0:03:39.59,0:03:41.42,[16:9] Main,,0,0,0,,Vậy thì để tớ lái đầu tiên đi.
Dialogue: 0,0:03:41.42,0:03:43.07,[16:9] Main,,0,0,0,,Ể? Để tôi làm cho.
Dialogue: 0,0:03:43.07,0:03:45.15,[16:9] Main,,0,0,0,,Ban nãy, cậu ý kiến ý cò cơ mà.
Dialogue: 0,0:03:45.15,0:03:48.62,[16:9] Main,,0,0,0,,Với cả tớ bị hạ đầu tiên,\Nnên thành ra vẫn chưa hề mệt mỏi gì.
Dialogue: 0,0:03:50.63,0:03:55.38,[16:9] Main,,0,0,0,,Vậy thì nếu Legion xuất hiện,\Nkhi đó ai đang lái thì sẽ chiến đấu nhé?
Dialogue: 0,0:03:55.76,0:03:56.75,[16:9] Main,,0,0,0,,Không ý kiến.
Dialogue: 0,0:03:56.75,0:03:57.55,[16:9] Main,,0,0,0,,Không!
Dialogue: 0,0:04:15.15,0:04:16.82,[16:9] Main,,0,0,0,,Kurena, dừng lại đi.
Dialogue: 0,0:04:26.39,0:04:28.97,[16:9] Main,,0,0,0,,Hướng 10 giờ, dưới vách đá có một cái hốc.
Dialogue: 0,0:04:28.97,0:04:30.06,[16:9] Main,,0,0,0,,Hãy tới chỗ đó.
Dialogue: 0,0:04:30.06,0:04:31.05,[16:9] Main,,0,0,0,,Đã rõ.
Dialogue: 0,0:04:31.05,0:04:32.17,[16:9] Main,,0,0,0,,Đi mau đi.
Dialogue: 0,0:04:56.44,0:04:58.77,[16:9] Main,,0,0,0,,Nhờ Shin nên mới thoát được phen vừa rồi nhỉ.
Dialogue: 0,0:04:58.77,0:05:01.48,[16:9] Main,,0,0,0,,Dù thế thật nhưng phải công nhận\Nsố lượng đông ghê.
Dialogue: 0,0:05:01.48,0:05:03.78,[16:9] Main,,0,0,0,,Từ lúc tới đây, bọn chúng ngày càng đông nhở?
Dialogue: 0,0:05:03.78,0:05:06.87,[16:9] Main,,0,0,0,,Vậy là đang ngày càng tới gần\Nthành luỹ của chúng à?
Dialogue: 0,0:05:07.89,0:05:09.00,[16:9] Main,,0,0,0,,Có lẽ vậy.
Dialogue: 0,0:05:10.45,0:05:11.83,[16:9] Main,,0,0,0,,Mọi người, phía trước kìa.
Dialogue: 0,0:05:39.99,0:05:41.40,[16:9] Main,,0,0,0,,Là trường học à?
Dialogue: 0,0:05:41.40,0:05:43.29,[16:9] Main,,0,0,0,,Ể? Vậy sao?
Dialogue: 0,0:05:43.29,0:05:44.13,[16:9] Main,,0,0,0,,Có lẽ.
Dialogue: 0,0:05:44.13,0:05:48.15,[16:9] Main,,0,0,0,,Phải rồi, Kurena đã bao giờ\Nđược tới trường đâu.
Dialogue: 0,0:05:48.15,0:05:52.32,[16:9] Main,,0,0,0,,Tuy khác biệt về quốc gia và văn hoá\Nnhưng trường học trông vẫn hao hao nhau.
Dialogue: 0,0:05:53.13,0:05:55.95,[16:9] Main,,0,0,0,,Đây là... trường học...
Dialogue: 0,0:05:57.25,0:06:00.08,[16:9] Main,,0,0,0,,Nè! Hôm nay, ngủ lại ở đây đi!
Dialogue: 0,0:06:02.19,0:06:03.72,[16:9] Main,,0,0,0,,Cứ vậy đi.
Dialogue: 0,0:06:27.45,0:06:29.11,[16:9] Main,,0,0,0,,Kurena đọc được à?
Dialogue: 0,0:06:29.11,0:06:30.79,[16:9] Main,,0,0,0,,Không.
Dialogue: 0,0:06:30.79,0:06:32.20,[16:9] Main,,0,0,0,,Nhưng trông có vẻ vui.
Dialogue: 0,0:06:32.53,0:06:34.30,[16:9] Main,,0,0,0,,Đúng là hoài niệm thật.
Dialogue: 0,0:06:34.30,0:06:36.45,[16:9] Main,,0,0,0,,Cậu thích hả? Chuyện học hành ấy.
Dialogue: 0,0:06:36.45,0:06:37.71,[16:9] Main,,0,0,0,,Không có.
Dialogue: 0,0:06:41.37,0:06:42.55,[16:9] Main,,0,0,0,,Bạn Raiden Shuga.
Dialogue: 0,0:06:43.67,0:06:44.93,[16:9] Main,,0,0,0,,Ơ kìa?
Dialogue: 0,0:06:44.93,0:06:48.32,[16:9] Main,,0,0,0,,Bạn Raiden nghỉ học hay sao?
Dialogue: 0,0:06:49.39,0:06:51.14,[16:9] Main,,0,0,0,,Bạn Raiden Shuga!
Dialogue: 20,0:06:51.14,0:06:51.89,[16:9] Main,,0,0,0,,Có!
Dialogue: 20,0:06:51.89,0:06:52.52,[16:9] Main,,0,0,0,,Rồi!
Dialogue: 0,0:06:52.78,0:06:54.28,[16:9] Main,,0,0,0,,Bạn Theoto Rikka.
Dialogue: 0,0:06:54.28,0:06:55.65,[16:9] Main,,0,0,0,,Có mặt.
Dialogue: 0,0:06:55.65,0:06:57.65,[16:9] Main,,0,0,0,,Bạn Kurena Kukumila.
Dialogue: 0,0:07:03.86,0:07:04.99,[16:9] Main,,0,0,0,,Có!
Dialogue: 0,0:07:05.72,0:07:07.24,[16:9] Main,,0,0,0,,Bạn Anju Emma.
Dialogue: 0,0:07:07.24,0:07:07.82,[16:9] Main,,0,0,0,,Có!
Dialogue: 0,0:07:08.54,0:07:10.28,[16:9] Main,,0,0,0,,Bạn Shinei Nouzen.
Dialogue: 0,0:07:12.53,0:07:13.51,[16:9] Main,,0,0,0,,Có.
Dialogue: 0,0:07:15.55,0:07:18.25,[16:9] Main,,0,0,0,,Nếu không dùng để học thì chỉ là gỗ đốt thôi.
Dialogue: 0,0:07:19.43,0:07:21.00,[16:9] Main,,0,0,0,,Ra là thế.
Dialogue: 20,0:07:23.51,0:07:25.76,[16:9] Main,,0,0,0,,Đây là một kiểu sự kiện gì đó à?
Dialogue: 0,0:07:25.76,0:07:27.92,[16:9] Main,,0,0,0,,Phá trường phá lớp?
Dialogue: 0,0:07:31.95,0:07:32.81,[16:9] Main,,0,0,0,,Được rồi.
Dialogue: 0,0:07:33.32,0:07:34.77,[16:9] Main,,0,0,0,,Nhóm lửa kiểu gì?
Dialogue: 0,0:07:37.92,0:07:39.70,[16:9] Main,,0,0,0,,Cái đó là sách giáo khoa mà?
Dialogue: 0,0:07:39.70,0:07:42.09,[16:9] Main,,0,0,0,,Đúng là thấy tội lỗi ghê...
Dialogue: 0,0:07:42.09,0:07:44.23,[16:9] Main,,0,0,0,,Sách mà không đọc được\Nthì có để làm gì chứ.
Dialogue: 0,0:07:44.57,0:07:46.15,[16:9] Main,,0,0,0,,Đúng đấy.
Dialogue: 0,0:08:03.84,0:08:06.10,[16:9] Main,,0,0,0,,Vẫn còn sót lại à?
Dialogue: 0,0:08:06.10,0:08:07.46,[16:9] Main,,0,0,0,,Ừm.
Dialogue: 0,0:08:07.46,0:08:09.32,[16:9] Main,,0,0,0,,Viên cuối cùng.
Dialogue: 0,0:08:17.35,0:08:19.98,[16:9] Main,,0,0,0,,Thế này là xong món tráng miệng sau bữa ăn.
Dialogue: 0,0:08:27.61,0:08:29.03,[16:9] Main,,0,0,0,,{\an8}Nhiêu đây là hết rồi đấy.
Dialogue: 0,0:08:30.91,0:08:33.37,[16:9] Main,,0,0,0,,Thế này chắc chỉ hết hôm nay thôi nhỉ?
Dialogue: 0,0:08:33.37,0:08:34.34,[16:9] Main,,0,0,0,,Ừ.
Dialogue: 0,0:08:34.92,0:08:38.33,[16:9] Main,,0,0,0,,Chuyến leo núi vui vẻ...\Nsắp sửa kết thúc rồi sao.
Dialogue: 0,0:08:42.52,0:08:43.84,[16:9] Main,,0,0,0,,Xuất phát thôi!
Dialogue: 0,0:08:43.84,0:08:45.31,[16:9] Main,,0,0,0,,Vâng!
Dialogue: 0,0:08:45.91,0:08:48.29,[16:9] Main,,0,0,0,,Buổi sáng là tới lượt tớ nhỉ.
Dialogue: 0,0:08:48.29,0:08:49.71,[16:9] Main,,0,0,0,,Ừ, nhờ cậu.
Dialogue: 0,0:08:49.71,0:08:52.13,[16:9] Main,,0,0,0,,Mới đi học một ngày đã tốt nghiệp à?
Dialogue: 0,0:08:52.13,0:08:54.41,[16:9] Main,,0,0,0,,Chúng ta ưu tú khủng khiếp luôn còn gì?
Dialogue: 0,0:08:54.41,0:08:56.13,[16:9] Main,,0,0,0,,Tương lai hứa hẹn quá đi chứ.
Dialogue: 0,0:08:56.13,0:08:58.35,[16:9] Main,,0,0,0,,Này nhé...
Dialogue: 0,0:08:56.13,0:08:58.35,[16:9] Main Alt,,0,0,0,,Không được nói thế...
Dialogue: 0,0:09:07.49,0:09:08.82,[16:9] Main,,0,0,0,,Leo lên chỗ này à?
Dialogue: 0,0:09:08.82,0:09:09.74,[16:9] Main,,0,0,0,,Chịu.
Dialogue: 0,0:09:10.25,0:09:11.62,[16:9] Main,,0,0,0,,Có đúng đường không đấy?
Dialogue: 0,0:09:11.62,0:09:13.32,[16:9] Main,,0,0,0,,Cứ thế này đi tiếp cũng được nhỉ?
Dialogue: 0,0:09:14.06,0:09:15.21,[16:9] Main,,0,0,0,,Phải.
Dialogue: 0,0:09:15.21,0:09:16.33,[16:9] Main,,0,0,0,,Đã rõ.
Dialogue: 0,0:09:29.20,0:09:31.34,[16:9] Main,,0,0,0,,Anju, chuẩn bị đổi phiên đi.
Dialogue: 0,0:09:31.34,0:09:32.35,[16:9] Main,,0,0,0,,Ể?
Dialogue: 0,0:09:33.05,0:09:34.37,[16:9] Main,,0,0,0,,Không phải hơi sớm sao?
Dialogue: 0,0:09:34.37,0:09:36.45,[16:9] Main,,0,0,0,,Tớ sẽ lái tới lúc trưa cơ mà.
Dialogue: 0,0:09:36.45,0:09:37.73,[16:9] Main,,0,0,0,,Tôi chán rồi.
Dialogue: 0,0:09:38.24,0:09:41.27,[16:9] Main,,0,0,0,,Cậu nói cái gì vậy...
Dialogue: 20,0:09:38.24,0:09:41.27,[16:9] Main,,0,0,0,,{\an8}Thật tình! Giật hết cả mình!
Dialogue: 0,0:09:41.27,0:09:42.42,[16:9] Main,,0,0,0,,Công nhận...
Dialogue: 0,0:09:42.42,0:09:46.51,[16:9] Main,,0,0,0,,Ai mà ngờ lại có thời gian có thể\Nthảnh thơi như thế này chứ.
Dialogue: 0,0:09:46.51,0:09:49.28,[16:9] Main,,0,0,0,,Ngoài ngắm cảnh ra cũng chẳng còn việc gì khác.
Dialogue: 0,0:09:49.28,0:09:54.86,[16:9] Main,,0,0,0,,Đáng ra Shin nên mang một cuốn sách tranh\Ntừ ngôi trường đó có phải hơn không.
Dialogue: 0,0:09:55.60,0:09:56.72,[16:9] Main,,0,0,0,,Cũng phải.
Dialogue: 0,0:09:57.28,0:09:58.78,[16:9] Main,,0,0,0,,Đã vất vả rồi.
Dialogue: 0,0:09:58.78,0:10:00.87,[16:9] Main,,0,0,0,,Dù tớ cũng có vất vả tí gì đâu.
Dialogue: 0,0:10:00.87,0:10:03.41,[16:9] Main,,0,0,0,,Shin à, đằng này được rồi.
Dialogue: 0,0:10:05.00,0:10:06.95,[16:9] Main,,0,0,0,,Vậy thì tới Kurena canh gác.
Dialogue: 0,0:10:06.95,0:10:09.42,[16:9] Main,,0,0,0,,Hả? Thế là đổi lượt nhé!
Dialogue: 0,0:10:17.35,0:10:21.32,[16:9] Main,,0,0,0,,Ai lái thì người đó chiến đấu,\Nchuyện đó đã quyết sẵn đúng không?
Dialogue: 0,0:10:21.92,0:10:22.88,[16:9] Main,,0,0,0,,Cậu...
Dialogue: 0,0:10:22.88,0:10:24.56,[16:9] Main,,0,0,0,,Từ đầu đã định như thế đúng không?
Dialogue: 0,0:10:25.47,0:10:27.98,[16:9] Main,,0,0,0,,Dù có làm gì đi nữa,\Nvẫn có những đơn vị không thể tránh né được.
Dialogue: 0,0:10:28.51,0:10:30.99,[16:9] Main,,0,0,0,,Đã không tránh được\Nthì chỉ còn cách chiến đấu.
Dialogue: 0,0:10:31.28,0:10:33.59,[16:9] Main,,0,0,0,,Thế nên cậu mới đột nhiên đổi phiên...
Dialogue: 0,0:10:33.59,0:10:34.91,[16:9] Main,,0,0,0,,Shin quá đáng thật!
Dialogue: 0,0:10:36.37,0:10:37.62,[16:9] Main,,0,0,0,,Không thể thế này được!
Dialogue: 0,0:10:37.62,0:10:39.99,[16:9] Main,,0,0,0,,Mấy cậu cứ như vậy mà đi tiếp đi.
Dialogue: 0,0:10:39.99,0:10:42.54,[16:9] Main,,0,0,0,,Vào trong rừng thì sẽ khó mà bị phát hiện.
Dialogue: 0,0:10:42.54,0:10:46.21,[16:9] Main,,0,0,0,,Cứ đi tiếp một thời gian thì sẽ sạch tiếng Legion.
Dialogue: 0,0:10:47.49,0:10:51.44,[16:9] Main,,0,0,0,,Nếu ở đó còn người,\Nthì hãy cố nhờ họ bảo hộ.
Dialogue: 0,0:10:51.44,0:10:52.91,[16:9] Main,,0,0,0,,Đừng có nói nhảm!
Dialogue: 0,0:10:52.91,0:10:56.34,[16:9] Main,,0,0,0,,Như thế thì Shin sẽ\Ntrở thành mồi nhử có phải không?!
Dialogue: 0,0:10:56.34,0:10:58.86,[16:9] Main,,0,0,0,,Mọi người sẽ đi cùng nhau kia mà?
Dialogue: 0,0:10:58.86,0:11:00.93,[16:9] Main,,0,0,0,,Tại sao đến giây phút cuối này...
Dialogue: 0,0:11:03.17,0:11:05.06,[16:9] Main,,0,0,0,,Cậu lại bỏ đi một mình...
Dialogue: 0,0:11:06.39,0:11:07.61,[16:9] Main,,0,0,0,,Sao lại thế hả!
Dialogue: 0,0:11:10.43,0:11:12.23,[16:9] Main,,0,0,0,,Khốn kiếp, cậu ta ngắt rồi.
Dialogue: 0,0:11:14.71,0:11:16.24,[16:9] Main,,0,0,0,,Thằng ngu này.
Dialogue: 0,0:11:48.30,0:11:49.33,[16:9] Main,,0,0,0,,Đợi tôi với.
Dialogue: 0,0:11:50.32,0:11:51.69,[16:9] Main,,0,0,0,,Tớ cũng đi nữa.
Dialogue: 0,0:11:53.91,0:11:54.78,[16:9] Main,,0,0,0,,Mọi người hiểu chứ?
Dialogue: 0,0:11:55.17,0:11:57.99,[16:9] Main,,0,0,0,,Làm sao có thể để\NShin đi một mình như thế được.
Dialogue: 0,0:12:01.11,0:12:02.05,[16:9] Main,,0,0,0,,Đúng vậy.
Dialogue: 0,0:12:08.67,0:12:11.42,[16:9] Main,,0,0,0,,Là loại siêu pháo tầm xa lúc đó.
Dialogue: 0,0:12:11.42,0:12:12.75,[16:9] Main,,0,0,0,,Ta sẽ giết.
Dialogue: 0,0:12:13.42,0:12:15.03,[16:9] Main,,0,0,0,,Ta sẽ giết!
Dialogue: 1,0:12:15.03,0:12:21.76,[16:9] Main,,0,0,0,,Đàn ông,{\alpha&HFF&} đàn bà, trẻ con, người già, quý tộc, bần dân...
Dialogue: 2,0:12:16.22,0:12:21.76,[16:9] Main,,0,0,0,,{\alpha&HFF&}Đàn ông, {\1a&H00&\3a&H00&\4a&HA0&}đàn bà, {\alpha&HFF&}trẻ con, người già, quý tộc, bần dân...
Dialogue: 3,0:12:17.22,0:12:21.76,[16:9] Main,,0,0,0,,{\alpha&HFF&}Đàn ông, đàn bà, {\1a&H00&\3a&H00&\4a&HA0&}trẻ con, {\alpha&HFF&}người già, quý tộc, bần dân...
Dialogue: 4,0:12:18.22,0:12:21.76,[16:9] Main,,0,0,0,,{\alpha&HFF&}Đàn ông, đàn bà, trẻ con, {\1a&H00&\3a&H00&\4a&HA0&}người già, {\alpha&HFF&}quý tộc, bần dân...
Dialogue: 5,0:12:19.41,0:12:21.76,[16:9] Main,,0,0,0,,{\alpha&HFF&}Đàn ông, đàn bà, trẻ con, người già, {\1a&H00&\3a&H00&\4a&HA0&}quý tộc, {\alpha&HFF&}bần dân...
Dialogue: 6,0:12:20.27,0:12:21.76,[16:9] Main,,0,0,0,,{\alpha&HFF&}Đàn ông, đàn bà, trẻ con, người già, quý tộc, {\1a&H00&\3a&H00&\4a&HA0&}bần dân...
Dialogue: 0,0:12:21.76,0:12:24.62,[16:9] Main,,0,0,0,,Tất cả những kẻ làm hại đến Công chúa điện hạ...
Dialogue: 0,0:12:24.62,0:12:27.23,[16:9] Main,,0,0,0,,Ta sẽ giết sạch tất cả các ngươi!
Dialogue: 0,0:12:35.15,0:12:37.03,[16:9] Main,,0,0,0,,Lúc này mà lại...
Dialogue: 0,0:12:41.83,0:12:45.56,[16:9] Main,,0,0,0,,Ngươi nhắm tới cái đầu này à?
Dialogue: 0,0:12:52.84,0:12:53.95,[16:9] Main,,0,0,0,,Shin!
Dialogue: 0,0:12:58.05,0:13:00.47,[16:9] Main,,0,0,0,,Khốn kiếp! Quay mặt lại đây cho tao!
Dialogue: 0,0:13:04.21,0:13:05.51,[16:9] Main,,0,0,0,,Bọn này tới ngay đây!
Dialogue: 0,0:13:05.51,0:13:06.75,[16:9] Main,,0,0,0,,Đừng bỏ cuộc!
Dialogue: 0,0:13:06.75,0:13:07.96,[16:9] Main,,0,0,0,,Tỉnh táo lại mau!
Dialogue: 0,0:13:07.96,0:13:09.53,[16:9] Main,,0,0,0,,Shin!
Dialogue: 0,0:13:09.53,0:13:10.95,[16:9] Main,,0,0,0,,Đừng từ bỏ!
Dialogue: 0,0:13:09.53,0:13:10.95,[16:9] Main,,0,0,0,,{\an8}Nghe thấy không vậy?!
Dialogue: 0,0:13:10.95,0:13:13.16,[16:9] Main,,0,0,0,,Shin! Mau trả lời đi!
Dialogue: 0,0:13:13.16,0:13:14.98,[16:9] Main,,0,0,0,,Cái lũ ngốc này.
Dialogue: 0,0:13:14.98,0:13:16.75,[16:9] Main,,0,0,0,,Với thứ vũ khí đó thì...
Dialogue: 0,0:13:16.75,0:13:18.82,[16:9] Main,,0,0,0,,Làm sao mà thắng nổi Legion đây...
Dialogue: 0,0:13:30.91,0:13:31.75,[16:9] Main,,0,0,0,,Đạn...
Dialogue: 0,0:13:36.50,0:13:37.46,[16:9] Main,,0,0,0,,Theo!
Dialogue: 0,0:13:42.22,0:13:43.26,[16:9] Main,,0,0,0,,Khốn kiếp!
Dialogue: 0,0:13:55.06,0:13:56.57,[16:9] Main,,0,0,0,,{\i1}Ngu ngốc...
Dialogue: 0,0:13:57.28,0:14:00.41,[16:9] Main,,0,0,0,,{\i1}Thật sự... ngu ngốc quá đi...
Dialogue: 0,0:14:07.25,0:14:09.20,[16:9] Main,,0,0,0,,{\i1}Liệu sau khi mình trở thành Legion rồi...
Dialogue: 0,0:14:10.50,0:14:12.62,[16:9] Main,,0,0,0,,{\i1}Mình sẽ gọi tên ai đây...
Dialogue: 0,0:14:49.44,0:14:51.17,[16:9] Main,,0,0,0,,Fido thì nó không có ở đây đâu.
Dialogue: 0,0:14:52.04,0:14:53.75,[16:9] Main,,0,0,0,,Bọn nhóc mang nó đi rồi.
Dialogue: 0,0:14:56.81,0:14:59.00,[16:9] Main,,0,0,0,,Vậy ra nó không phải là chó nhỉ?
Dialogue: 0,0:14:59.00,0:15:00.86,[16:9] Main,,0,0,0,,Thiếu tá Milizé.
Dialogue: 0,0:15:00.86,0:15:01.87,[16:9] Main,,0,0,0,,Phải không nhỉ?
Dialogue: 0,0:15:01.87,0:15:02.91,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:15:02.91,0:15:04.90,[16:9] Main,,0,0,0,,Đến tận đây làm gì vậy?
Dialogue: 0,0:15:04.90,0:15:06.45,[16:9] Main,,0,0,0,,Cô đang chịu quản chế cơ mà?
Dialogue: 0,0:15:06.45,0:15:10.57,[16:9] Main,,0,0,0,,Vâng, cũng nhờ thế mà tôi có thời gian\Nthị sát trực tiếp nơi tiền tuyến.
Dialogue: 0,0:15:12.09,0:15:14.91,[16:9] Main,,0,0,0,,Xem luôn mấy tên\Nsắp lên đài tử hình hả?
Dialogue: 0,0:15:14.91,0:15:18.41,[16:9] Main,,0,0,0,,Dù nghe tin đồn rồi,\Nnhưng cô nhóc đúng là khác người đấy.
Dialogue: 0,0:15:20.14,0:15:21.11,[16:9] Main,,0,0,0,,Cứ xem đi.
Dialogue: 0,0:15:21.72,0:15:22.48,[16:9] Main,,0,0,0,,Ế?
Dialogue: 0,0:15:22.48,0:15:25.19,[16:9] Main,,0,0,0,,Dù cũng chẳng còn gì nhiều,
Dialogue: 0,0:15:25.19,0:15:27.09,[16:9] Main,,0,0,0,,nhưng nếu thích thì tuỳ cô thôi.
Dialogue: 0,0:15:29.32,0:15:30.13,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:15:34.93,0:15:39.00,[16:9] Main,,0,0,0,,Đến giờ tôi cũng đã phải tiễn đưa\Nkhông biết bao đám nhóc con rồi...
Dialogue: 0,0:15:39.49,0:15:42.07,[16:9] Main,,0,0,0,,nhưng đây là lần đầu có Handler đến nơi này.
Dialogue: 0,0:15:42.67,0:15:44.28,[16:9] Main,,0,0,0,,Trung uý Aldrecht.
Dialogue: 0,0:15:44.28,0:15:45.01,[16:9] Main,,0,0,0,,Chú là...
Dialogue: 0,0:15:45.01,0:15:46.70,[16:9] Main,,0,0,0,,Là Alba.
Dialogue: 0,0:15:46.70,0:15:48.19,[16:9] Main,,0,0,0,,Giống với cô đấy.
Dialogue: 0,0:15:49.24,0:15:51.41,[16:9] Main,,0,0,0,,Nhưng vợ tôi là 86.
Dialogue: 0,0:15:51.41,0:15:54.11,[16:9] Main,,0,0,0,,Lúc vợ và con gái tôi bị dẫn đi,
Dialogue: 0,0:15:54.11,0:15:56.27,[16:9] Main,,0,0,0,,tôi đã nhuộm tóc để đi theo họ.
Dialogue: 0,0:15:56.83,0:16:00.53,[16:9] Main,,0,0,0,,Tuy đã đệ đơn để hai người họ\Nlấy lại được quyền công dân...
Dialogue: 0,0:16:00.53,0:16:04.31,[16:9] Main,,0,0,0,,Nhưng cuối cùng thì cả hai\Nđều chết nơi chiến trường.
Dialogue: 0,0:16:05.57,0:16:08.86,[16:9] Main,,0,0,0,,Lúc nhóm mấy đứa Shin tới,\Ntôi đã bí mật hỏi chúng nó rồi.
Dialogue: 0,0:16:08.86,0:16:13.83,[16:9] Main,,0,0,0,,Rằng có con Legion nào đang tìm kiếm\Nthằng khốn nạn không thể bảo vệ vợ con không.
Dialogue: 0,0:16:14.59,0:16:16.29,[16:9] Main,,0,0,0,,Nếu có thì sao ạ?
Dialogue: 0,0:16:16.29,0:16:19.71,[16:9] Main,,0,0,0,,Thì tôi sẽ đến để họ giết.
Dialogue: 0,0:16:20.91,0:16:23.52,[16:9] Main,,0,0,0,,Nhưng cậu ta nói không có con nào như thế.
Dialogue: 0,0:16:23.52,0:16:26.72,[16:9] Main,,0,0,0,,Chẳng có bất kỳ con Legion nào gọi tên tôi hết.
Dialogue: 0,0:16:27.48,0:16:29.86,[16:9] Main,,0,0,0,,Nghe thấy thế tôi đã cảm thấy\Nđược cứu rỗi đôi chút.
Dialogue: 0,0:16:31.26,0:16:36.01,[16:9] Main,,0,0,0,,Cả vợ và con gái tôi đến lúc chết\Ncũng không bị cầm tù nơi chiến trường này.
Dialogue: 0,0:16:36.01,0:16:37.98,[16:9] Main,,0,0,0,,Nếu như tôi đi về phía đó,
Dialogue: 0,0:16:38.86,0:16:39.85,[16:9] Main,,0,0,0,,hẳn là sẽ gặp được họ thôi.
Dialogue: 0,0:16:43.61,0:16:45.73,[16:9] Main,,0,0,0,,Mỗi lần, trước lệnh trinh sát đặc biệt,
Dialogue: 0,0:16:46.13,0:16:48.68,[16:9] Main,,0,0,0,,tôi vẫn luôn nói trước\Nvới bọn trẻ rằng mình là Alba.
Dialogue: 0,0:16:48.68,0:16:51.11,[16:9] Main,,0,0,0,,Rằng chúng cứ thoải mái mà căm hận.
Dialogue: 0,0:16:51.11,0:16:53.87,[16:9] Main,,0,0,0,,Cũng nói luôn nếu thấy uất quá\Nthì giết tôi đi cũng được.
Dialogue: 0,0:16:55.31,0:16:58.47,[16:9] Main,,0,0,0,,Cuối cùng, chẳng có đứa nào\Ngiết quách tôi đi cho xong.
Dialogue: 0,0:16:58.47,0:17:00.46,[16:9] Main,,0,0,0,,Lần này cũng vậy.
Dialogue: 0,0:17:00.46,0:17:03.17,[16:9] Main,,0,0,0,,Nhờ thế mà lần này cũng không chết được.
Dialogue: 0,0:17:04.61,0:17:06.68,[16:9] Main,,0,0,0,,Phiền cô rồi.
Dialogue: 0,0:17:06.68,0:17:07.88,[16:9] Main,,0,0,0,,Đi xem nhanh đi.
Dialogue: 0,0:17:10.53,0:17:12.15,[16:9] Main,,0,0,0,,Cảm ơn chú ạ.
Dialogue: 0,0:18:17.39,0:18:19.57,[16:9] Main,,0,0,0,,{\i1}À, bọn tôi nuôi nó ở quân khu này.
Dialogue: 0,0:18:19.57,0:18:22.40,[16:9] Main,,0,0,0,,{\i1}Là một bé mèo đen\Nriêng phần đầu chân thì lại trắng đó.
Dialogue: 0,0:18:22.40,0:18:25.42,[16:9] Main,,0,0,0,,{\i1}Chẳng hiểu sao lại quấn lấy Undertaker nhất nhỉ?
Dialogue: 0,0:18:26.27,0:18:28.52,[16:9] Main,,0,0,0,,{\i1}Rõ ràng cậu ấy chẳng nựng tí nào...
Dialogue: 0,0:18:28.52,0:18:32.42,[16:9] Main,,0,0,0,,{\i1}Nó có đến ưỡn ẹo làm nũng thì\Ncậu ta cũng chỉ xoa đầu qua loa thôi mà.
Dialogue: 0,0:18:32.75,0:18:36.68,[16:9] Main,,0,0,0,,{\i1}Thay vì nói là quấn lấy hắn,\Ncó khi chỉ coi như cái giường êm thôi ấy.
Dialogue: 0,0:18:36.68,0:18:38.43,[16:9] Main,,0,0,0,,{\i1}Lúc này cũng vậy còn gì?
Dialogue: 0,0:18:38.43,0:18:41.33,[16:9] Main,,0,0,0,,{\i1}Ừ, thì lúc đọc sách cậu ấy có cựa quậy gì đâu.
Dialogue: 0,0:18:41.33,0:18:44.56,[16:9] Main,,0,0,0,,{\i1}Vậy thì chắc chắn nó khỏi theo\NBlack Dog, do ồn ào quá mà.
Dialogue: 0,0:18:44.56,0:18:46.44,[16:9] Main,,0,0,0,,{\i1}Quá đáng! Lại còn bất công nữa!
Dialogue: 0,0:18:46.44,0:18:47.94,[16:9] Main,,0,0,0,,{\i1}Tôi yêu cầu cải tổ đó!
Dialogue: 0,0:18:55.80,0:18:57.53,[16:9] Main,,0,0,0,,{\i1}Tên nó là gì vậy?
Dialogue: 0,0:18:57.80,0:18:58.47,[16:9] Main,,0,0,0,,{\i1}Kuro.
Dialogue: 0,0:18:58.47,0:18:58.99,[16:9] Main,,0,0,0,,{\i1}Shiro.
Dialogue: 0,0:18:58.99,0:18:59.55,[16:9] Main,,0,0,0,,{\i1}Nike.
Dialogue: 0,0:18:59.55,0:19:00.24,[16:9] Main,,0,0,0,,{\i1}Kitty.
Dialogue: 0,0:19:00.24,0:19:00.82,[16:9] Main,,0,0,0,,{\i1}Chibi.
Dialogue: 0,0:19:00.82,0:19:02.00,[16:9] Main,,0,0,0,,{\i1}Remarque.
Dialogue: 0,0:19:03.75,0:19:08.29,[16:9] Main,,0,0,0,,{\i1}Đã bảo là dùng tên tác giả cuốn sách\Ncậu đang đọc gán cho nó là tuỳ tiện quá thể rồi.
Dialogue: 0,0:19:08.29,0:19:09.34,[16:9] Main,,0,0,0,,{\i1}Bỏ đi hộ cái.
Dialogue: 0,0:19:09.34,0:19:12.63,[16:9] Main,,0,0,0,,{\i1\fad(0,2100)}Cơ mà lại đang đọc cái gì vậy,\Ncậu có sở thích tệ thật đấy.
Dialogue: 0,0:19:25.57,0:19:28.59,[16:9] Main,,0,0,0,,{\i1}Nếu cô cất công đến mức tìm ra cái món này,
Dialogue: 0,0:19:28.59,0:19:30.73,[16:9] Main,,0,0,0,,{\i1}thì cô đúng thật là con đại ngốc.
Dialogue: 0,0:19:31.27,0:19:32.79,[16:9] Main,,0,0,0,,{\i1}Raiden Shuga.
Dialogue: 0,0:19:33.93,0:19:35.20,[16:9] Main,,0,0,0,,{\i1}Viết tên giúp cô vậy.
Dialogue: 0,0:19:35.58,0:19:40.60,[16:9] Main,,0,0,0,,{\i1}Đằng nào kiểu này, cô chẳng khóc rống lên,\Nmà chẳng biết ai với ai.
Dialogue: 0,0:19:40.60,0:19:42.15,[16:9] Main,,0,0,0,,{\i1}Theoto Rikka.
Dialogue: 0,0:19:53.22,0:19:55.01,[16:9] Main,,0,0,0,,{\i1}Nhận nuôi con mèo giúp bọn tôi nhé.
Dialogue: 0,0:19:55.01,0:19:58.32,[16:9] Main,,0,0,0,,{\i1}Đằng nào cô cũng giả làm\Nngười tốt mãi rồi mà, được chứ?
Dialogue: 0,0:19:58.32,0:19:59.98,[16:9] Main,,0,0,0,,{\i1}Kurena Kukumila.
Dialogue: 0,0:19:59.98,0:20:02.03,[16:9] Main,,0,0,0,,{\i1}Bọn tôi vẫn chưa đặt tên cho nó đâu,
Dialogue: 0,0:20:02.03,0:20:04.77,[16:9] Main,,0,0,0,,{\i1}nên Thiếu tá hãy đặt cho nó\Nmột cái tên dễ thương vào nhé.
Dialogue: 0,0:20:05.38,0:20:06.52,[16:9] Main,,0,0,0,,{\i1}Anju Emma.
Dialogue: 0,0:20:28.61,0:20:32.89,[16:9] Main,,0,0,0,,{\i1}Nếu một ngày nào đó, cô đến được nơi bọn tôi đã đến...
Dialogue: 0,0:20:32.89,0:20:35.34,[16:9] Main,,0,0,0,,{\i1}thì có thể đặt hoa ở đấy không?
Dialogue: 0,0:20:36.21,0:20:37.68,[16:9] Main,,0,0,0,,{\i1}Shinei Nouzen.
Dialogue: 0,0:20:41.19,0:20:44.03,[16:9] Main,,0,0,0,,{\i1}Mình vẫn có thể cất bước tiếp.
Dialogue: 0,0:20:44.67,0:20:48.05,[16:9] Main,,0,0,0,,{\i1}Vì đến giây phút cuối cùng,\Nhọ vẫn tin rằng như vậy.
Dialogue: 0,0:20:58.93,0:21:00.20,[16:9] Main,,0,0,0,,{\i0}Đi thôi nào.
Dialogue: 0,0:21:00.75,0:21:02.46,[16:9] Main,,0,0,0,,{\i0}Gọi mày là gì đây nhỉ?
Dialogue: 0,0:21:04.84,0:21:06.03,[16:9] Main,,0,0,0,,{\i1}Phải chiến đấu thôi.
Dialogue: 0,0:21:06.75,0:21:08.88,[16:9] Main,,0,0,0,,{\i1}Cho đến khi vận mệnh của thân xác này cạn kiệt.
Dialogue: 0,0:21:09.55,0:21:11.12,[16:9] Main,,0,0,0,,{\i1}Cho đến thời khắc cuối cùng...
Dialogue: 0,0:22:45.16,0:22:46.32,[16:9] Main,,0,0,0,,{\i1}Shin.
Dialogue: 0,0:22:53.11,0:22:54.33,[16:9] Main,,0,0,0,,Xin lỗi nhé...
Dialogue: 0,0:22:55.43,0:22:59.76,[16:9] Main,,0,0,0,,Tại anh gọi mãi, mà khiến em tới tận nơi này.
Dialogue: 0,0:23:16.01,0:23:17.08,[16:9->2.39] Main,,0,0,0,,Đi thôi nào.
