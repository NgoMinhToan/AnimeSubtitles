Dialogue: 0,0:02:15.87,0:02:20.96,[16:9] Main,,0,0,0,,Mà đơn giản thì ta cứ đập Legion\Nnhư từ trước tới giờ nhỉ?
Dialogue: 0,0:02:20.96,0:02:21.50,[16:9] Main,,0,0,0,,Phải.
Dialogue: 0,0:02:21.99,0:02:25.72,[16:9] Main,,0,0,0,,Thuận theo nguyện vọng\N"Muốn được chiến đấu ở tiền tuyến" của các cô cậu,
Dialogue: 0,0:02:25.72,0:02:28.73,[16:9] Main,,0,0,0,,thì ít nhất đây là đề xuất cá nhân của tôi.
Dialogue: 0,0:02:28.73,0:02:33.01,[16:9] Main,,0,0,0,,Vấn đề đáng nói là sĩ quan khách mời\Nsẽ làm thượng cấp trực tiếp...
Dialogue: 0,0:02:36.01,0:02:37.45,[16:9] Main,,0,0,0,,À, cũng không vấn đề...
Dialogue: 0,0:02:37.45,0:02:38.59,[16:9] Main,,0,0,0,,Được đấy chứ.
Dialogue: 0,0:02:38.59,0:02:39.46,[16:9] Main,,0,0,0,,Phải đó.
Dialogue: 0,0:02:39.46,0:02:40.01,[16:9] Main,,0,0,0,,Ờ.
Dialogue: 0,0:02:40.90,0:02:42.77,[16:9] Main,,0,0,0,,Shin, cậu thì sao?
Dialogue: 0,0:02:50.10,0:02:53.48,[16:9] Main,,0,0,0,,Quân lực mặt trận phía Tây\Nthực tế đã tổn thất 60%.
Dialogue: 0,0:02:53.48,0:02:55.56,[16:9] Main,,0,0,0,,Tất cả các Trường Sĩ quan, Trường Đặc chủng,
Dialogue: 0,0:02:55.56,0:02:59.91,[16:9] Main,,0,0,0,,căn cứ huấn luyện tân binh của các cơ quan\Ngiáo dục đang đôn người lên làm lính dự bị.
Dialogue: 0,0:02:59.91,0:03:02.67,[16:9] Main,,0,0,0,,Nhưng không thể phủ nhận\Nviệc chưa được huấn luyện đầy đủ.
Dialogue: 0,0:03:02.67,0:03:09.21,[16:9] Main,,0,0,0,,Mặt khác, lực lượng chiến đấu của Legion tuy đã\Ngiảm sút nhưng các cơ sở sản xuất vẫn nguyên vẹn.
Dialogue: 0,0:03:09.21,0:03:13.90,[16:9] Main,,0,0,0,,Tình hình chiến sự sau này\Ntôi nghĩ nhất định sẽ ngày càng tồi tệ.
Dialogue: 0,0:03:13.90,0:03:19.02,[16:9] Main,,0,0,0,,Tức là cứ thế này thì phía nhân loại\Nsẽ dần bị áp đảo và bại trận...
Dialogue: 0,0:03:19.02,0:03:20.18,[16:9] Main,,0,0,0,,Phải vậy không?
Dialogue: 0,0:03:20.18,0:03:21.00,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:03:21.00,0:03:23.74,[16:9] Main,,0,0,0,,Chúng ta sẽ tiếp tục duy trì phòng tuyến như hiện tại,
Dialogue: 0,0:03:23.74,0:03:26.62,[16:9] Main,,0,0,0,,thành lập những đơn vị cơ động độc lập...
Dialogue: 0,0:03:26.62,0:03:30.00,[16:9] Main,,0,0,0,,và liên tục sử dụng để tập trung tiêu diệt\Ncác căn cứ trọng yếu của Legion.
Dialogue: 0,0:03:30.00,0:03:33.06,[16:9] Main,,0,0,0,,Thật không ngờ ngài\Ncũng đưa ra đề xuất tương tự.
Dialogue: 0,0:03:33.06,0:03:37.30,[16:9] Main,,0,0,0,,Một đơn vị tiến công cơ động\Nchỉ gồm các 86 sẽ được thành lập.
Dialogue: 0,0:03:37.30,0:03:40.58,[16:9] Main,,0,0,0,,Xin thất lễ, liệu có phải ý của ngài\Ncũng là như thế chăng?
Dialogue: 0,0:03:40.86,0:03:44.28,[16:9] Main,,0,0,0,,Nói ra thì đó chính là nguyện vọng của họ...
Dialogue: 0,0:03:45.58,0:03:49.54,[16:9] Main,,0,0,0,,Họ có giá trị quan của riêng bản thân họ,
Dialogue: 0,0:03:49.54,0:03:53.00,[16:9] Main,,0,0,0,,bản thân tôi thì lại chẳng có\Nquyền cự tuyệt vì thương hại đâu.
Dialogue: 0,0:03:53.00,0:03:58.59,[16:9] Main,,0,0,0,,Nếu như hiện giờ họ vẫn chọn chiến trường,\Nthì tôi muốn để họ được làm đồng đội của nhau.
Dialogue: 0,0:03:58.59,0:04:04.64,[16:9] Main,,0,0,0,,Về những người 86... liệu họ có chấp nhận\Nngười chỉ huy khách mời đó không?
Dialogue: 0,0:04:04.64,0:04:06.35,[16:9] Main,,0,0,0,,Tôi đã nói chuyện rồi.
Dialogue: 0,0:04:06.35,0:04:11.58,[16:9] Main,,0,0,0,,Mặc dù tôi cũng có lo lắng,\Nnhưng có vẻ là không cần thiết rồi.
Dialogue: 0,0:04:11.58,0:04:12.36,[16:9] Main,,0,0,0,,Dù sao thì...
Dialogue: 0,0:04:19.82,0:04:22.12,[16:9] Main,,0,0,0,,Còn đây là của bác gửi.
Dialogue: 0,0:04:23.89,0:04:24.87,[16:9] Main,,0,0,0,,Cảm ơn bác.
Dialogue: 0,0:04:32.40,0:04:33.59,[16:9] Main,,0,0,0,,Đã lâu không gặp.
Dialogue: 0,0:04:34.22,0:04:35.33,[16:9] Main,,0,0,0,,Eugene.
Dialogue: 0,0:04:37.09,0:04:39.70,[16:9] Main,,0,0,0,,Xin lỗi, mãi tôi mới tới thăm.
Dialogue: 0,0:04:43.26,0:04:47.41,[16:9] Main,,0,0,0,,Eugene, mặt trận phía Tây\Nvẫn như hồi cậu còn sống.
Dialogue: 0,0:04:47.41,0:04:49.35,[16:9] Main,,0,0,0,,Rốt cuộc là vẫn cầm cự được...
Dialogue: 0,0:04:51.40,0:04:54.95,[16:9] Main,,0,0,0,,Trước đây cậu từng hỏi tại sao\Ntôi lại chiến đấu nhỉ?
Dialogue: 0,0:04:54.95,0:04:57.24,[16:9] Main,,0,0,0,,Nói thật, tôi vẫn chưa biết được.
Dialogue: 0,0:04:58.11,0:05:03.13,[16:9] Main,,0,0,0,,Bởi vì tôi chẳng có lý do nào\Ngiống với cái cậu từng nói cả.
Dialogue: 0,0:05:04.01,0:05:06.65,[16:9] Main,,0,0,0,,Nhưng họ...
Dialogue: 0,0:05:06.65,0:05:10.03,[16:9] Main,,0,0,0,,Những người tôi đã hứa\Nsẽ đưa họ đồng hành tới cùng...
Dialogue: 0,0:05:10.03,0:05:13.50,[16:9] Main,,0,0,0,,Tôi đã ngộ ra thứ mình muốn\Ncho họ thấy không phải chiến trường.
Dialogue: 0,0:05:21.89,0:05:22.92,[16:9] Main,,0,0,0,,Biển...
Dialogue: 0,0:05:23.68,0:05:27.22,[16:9] Main,,0,0,0,,Khung cảnh mà cậu từng nói\Nmuốn một ngày sẽ cho em gái thấy...
Dialogue: 0,0:05:27.22,0:05:29.31,[16:9] Main,,0,0,0,,Tôi không nghĩ là bản thân muốn thấy...
Dialogue: 0,0:05:30.42,0:05:33.14,[16:9] Main,,0,0,0,,Nhưng tôi nghĩ rằng\N"Muốn cho họ thấy biển."
Dialogue: 0,0:05:33.72,0:05:37.58,[16:9] Main,,0,0,0,,Cho họ thấy những gì chưa biết,\Nnhững gì chưa từng thấy...
Dialogue: 0,0:05:38.15,0:05:43.57,[16:9] Main,,0,0,0,,Tôi nghĩ rằng hiện giờ, lý do để chiến đấu\Nchẳng phải cứ vậy cũng được sao.
Dialogue: 0,0:05:45.92,0:05:47.36,[16:9] Main,,0,0,0,,Tôi sẽ lại đến.
Dialogue: 0,0:05:47.36,0:05:51.58,[16:9] Main,,0,0,0,,Lần tới, tôi sẽ kể cho cậu nghe\Nvề những gì cậu chưa được thấy...
Dialogue: 0,0:05:55.24,0:05:56.33,[16:9] Main,,0,0,0,,Marcel...
Dialogue: 0,0:05:57.84,0:05:59.58,[16:9] Main,,0,0,0,,Là do Nina viết đấy.
Dialogue: 0,0:06:00.19,0:06:01.73,[16:9] Main,,0,0,0,,Em gái của Eugene...
Dialogue: 0,0:06:04.21,0:06:07.25,[16:9] Main,,0,0,0,,Con bé vẫn tiếp tục viết thư\Ncho người anh đã khuất.
Dialogue: 0,0:06:07.96,0:06:09.38,[16:9] Main,,0,0,0,,Là lỗi của tôi.
Dialogue: 0,0:06:13.29,0:06:14.43,[16:9] Main,,0,0,0,,Chờ đã.
Dialogue: 0,0:06:16.28,0:06:18.74,[16:9] Main,,0,0,0,,Tại sao cậu lại nhận chứ...
Dialogue: 0,0:06:19.42,0:06:20.84,[16:9] Main,,0,0,0,,Do tôi đó...
Dialogue: 0,0:06:20.84,0:06:23.49,[16:9] Main,,0,0,0,,Phong thư này... gửi cho cậu...
Dialogue: 0,0:06:23.92,0:06:26.72,[16:9] Main,,0,0,0,,Là do chính tôi đã bảo Nina viết thư đó!
Dialogue: 0,0:06:26.72,0:06:31.95,[16:9] Main,,0,0,0,,Dù đau lòng, dù khó chịu đi nữa, nhưng tôi lại\Nkhông muốn cho rằng bản thân có lỗi...
Dialogue: 0,0:06:35.32,0:06:39.37,[16:9] Main,,0,0,0,,Tất cả... tôi đã đổ hết lên cậu...
Dialogue: 0,0:06:42.78,0:06:44.51,[16:9] Main,,0,0,0,,Xin lỗi...
Dialogue: 0,0:06:46.61,0:06:48.07,[16:9] Main,,0,0,0,,Xin lỗi...
Dialogue: 0,0:06:52.27,0:06:53.43,[16:9] Main,,0,0,0,,Xin lỗi.
Dialogue: 0,0:06:57.79,0:07:00.54,[16:9] Main,,0,0,0,,Cả cậu... lẫn cô bé...
Dialogue: 0,0:07:03.88,0:07:04.95,[16:9] Main,,0,0,0,,Tôi...
Dialogue: 0,0:07:22.06,0:07:24.32,[16:9] Main,,0,0,0,,Cười được như thế là tốt rồi nhỉ.
Dialogue: 0,0:07:38.94,0:07:40.74,[16:9] Main,,0,0,0,,Cảm ơn anh ạ!
Dialogue: 0,0:07:43.31,0:07:46.74,[16:9] Main,,0,0,0,,Shin ấy nhé, không đổi dấu hiệu cá nhân sao?
Dialogue: 0,0:07:50.36,0:07:51.25,[16:9] Main,,0,0,0,,Không thích à?
Dialogue: 0,0:07:51.25,0:07:53.89,[16:9] Main,,0,0,0,,Cũng chẳng phải không thích vẽ đâu...
Dialogue: 0,0:07:53.89,0:07:55.75,[16:9] Main,,0,0,0,,Nhưng trông nó cứ kiểu điềm gở ấy.
Dialogue: 0,0:07:56.61,0:07:58.00,[16:9] Main,,0,0,0,,Dù nói kiểu này cũng hơi kỳ...
Dialogue: 0,0:07:58.64,0:08:01.00,[16:9] Main,,0,0,0,,Nhưng cậu đâu cần phải\Ngánh vác nó làm gì nữa?
Dialogue: 0,0:08:08.26,0:08:11.20,[16:9] Main,,0,0,0,,Có lẽ là thế, nhưng mà...
Dialogue: 0,0:08:11.20,0:08:14.22,[16:9] Main,,0,0,0,,Dùng suốt 6 năm rồi\Nthì giờ còn điềm gở gì nữa,
Dialogue: 0,0:08:14.22,0:08:16.33,[16:9] Main,,0,0,0,,với cả cũng chẳng thấy nặng đâu.
Dialogue: 0,0:08:16.33,0:08:17.89,[16:9] Main,,0,0,0,,Rồi, rồi!
Dialogue: 0,0:08:20.22,0:08:21.98,[16:9] Main,,0,0,0,,Có vẻ đã vượt qua rồi nhỉ.
Dialogue: 0,0:08:22.62,0:08:24.13,[16:9] Main,,0,0,0,,Bao nhiêu là chuyện...
Dialogue: 0,0:08:24.13,0:08:25.70,[16:9] Main,,0,0,0,,Nhìn thấy rõ kiểu đó luôn.
Dialogue: 0,0:08:26.68,0:08:28.20,[16:9] Main,,0,0,0,,Chắc vậy...
Dialogue: 0,0:08:28.20,0:08:29.57,[16:9] Main,,0,0,0,,Nhưng mà...
Dialogue: 0,0:08:30.06,0:08:33.13,[16:9] Main,fad leadout,0,0,0,,{\fad(0,743)}Giờ chắc là tôi đã có thể\Nthực sự tiễn đưa rồi.
Dialogue: 0,0:08:51.73,0:08:53.01,[16:9] Main,,0,0,0,,Anh...
Dialogue: 0,0:08:54.51,0:08:58.60,[16:9] Main,,0,0,0,,{\i1}Nhìn về tương lai không có anh khó khăn lắm.
Dialogue: 0,0:08:59.61,0:09:03.11,[16:9] Main,,0,0,0,,{\i1}Em không mong cũng chẳng muốn thứ gì.
Dialogue: 0,0:09:03.93,0:09:07.61,[16:9] Main,,0,0,0,,{\i1}Em vẫn chưa hiểu rằng\Nbản thân mình sống vì điều gì.
Dialogue: 0,0:09:08.19,0:09:08.78,[16:9] Main,,0,0,0,,{\i1}Nhưng mà...
Dialogue: 0,0:09:09.99,0:09:11.41,[16:9] Main,,0,0,0,,Tôi vẽ thật đấy nhé!
Dialogue: 0,0:09:17.29,0:09:18.41,[16:9] Main,,0,0,0,,Tôi...
Dialogue: 0,0:09:21.69,0:09:25.29,[16:9] Main,,0,0,0,,{\i1}Cạnh em là những người\Nkhông có ý định bỏ em mà đi.
Dialogue: 0,0:09:27.55,0:09:30.30,[16:9] Main,,0,0,0,,{\i1}Có người nói với em rằng\N như này cũng được.
Dialogue: 0,0:09:30.77,0:09:31.77,[16:9] Main,,0,0,0,,{\i1}Chính vì thế...
Dialogue: 0,0:09:32.21,0:09:33.89,[16:9] Main,,0,0,0,,{\i1}Có lẽ là không sao nữa rồi.
Dialogue: 0,0:09:35.61,0:09:37.16,[16:9] Main,,0,0,0,,{\i1}Em có thể tự bước đi.
Dialogue: 0,0:09:38.77,0:09:39.91,[16:9] Main,,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:09:49.90,0:09:51.33,[16:9] Main,,0,0,0,,Tôi hiểu mà.
Dialogue: 0,0:09:51.89,0:09:54.33,[16:9] Main,,0,0,0,,Không có chuyện quên mọi người đâu...
Dialogue: 0,0:09:55.43,0:09:56.55,[16:9] Main,,0,0,0,,Tôi...
Dialogue: 0,0:09:59.38,0:10:00.79,[16:9] Main,,0,0,0,,Là Tử Thần mà!
Dialogue: 0,0:10:04.93,0:10:06.21,[16:9] Main,,0,0,0,,{\i1}Chiến đấu nào.
Dialogue: 0,0:10:06.73,0:10:11.32,[16:9] Main,,0,0,0,,{\i1}Bởi vì sẽ chẳng thể nào thực hiện được\Nnơi thế giới đang bị Legion trói buộc này.
Dialogue: 0,0:10:14.52,0:10:16.01,[16:9] Main,,0,0,0,,{\i1}Vì họ...
Dialogue: 0,0:10:16.96,0:10:18.70,[16:9] Main,,0,0,0,,{\i1}Vì mấy người đó...
Dialogue: 0,0:10:24.39,0:10:27.02,[16:9] Main,,0,0,0,,{\fad(100,0)\i1}Vì cô ấy...
Dialogue: 0,0:10:45.46,0:10:49.80,[16:9] Main,,0,0,0,,Tôi có thể trở về được cũng là nhờ các bạn.
Dialogue: 0,0:10:57.81,0:10:59.32,[16:9] Main,,0,0,0,,Tôi sẽ không quên.
Dialogue: 0,0:11:29.47,0:11:32.22,[16:9] Main,,0,0,0,,Con trở lại rồi, thưa cha.
Dialogue: 0,0:11:35.48,0:11:37.48,[16:9] Main,,0,0,0,,Vào cái đêm lễ hội cách mạng...
Dialogue: 0,0:11:37.99,0:11:40.68,[16:9] Main,,0,0,0,,Cuộc tấn công lớn của Legion đã diễn ra.
Dialogue: 0,0:11:41.35,0:11:45.43,[16:9] Main,,0,0,0,,Con đã cùng rất nhiều đồng đội\Ncùng nhau chiến đấu.
Dialogue: 0,0:11:45.94,0:11:51.44,[16:9] Main,,0,0,0,,Cùng với những người thuộc khu 86\Nđã đáp lại lời kêu gọi.
Dialogue: 0,0:11:53.14,0:11:54.32,[16:9] Main,,0,0,0,,Tôi sẽ không quên.
Dialogue: 0,0:11:59.42,0:12:00.70,[16:9] Main,,0,0,0,,Tuy nhiên...
Dialogue: 0,0:12:01.46,0:12:03.86,[16:9] Main,,0,0,0,,Nước Cộng Hoà đã diệt vong.
Dialogue: 0,0:12:04.46,0:12:06.96,[16:9] Main,,0,0,0,,Chỉ trong đúng một tuần ngắn ngủi.
Dialogue: 0,0:12:09.71,0:12:14.30,[16:9] Main,,0,0,0,,Nhưng dù vậy, chúng con\Nvẫn xoay sở duy trì được phòng tuyến.
Dialogue: 0,0:12:14.30,0:12:16.69,[16:9] Main,,0,0,0,,Khoảng hai tháng sau đó,
Dialogue: 0,0:12:16.69,0:12:19.30,[16:9] Main,,0,0,0,,đội quân cứu viện đã đến nơi.
Dialogue: 0,0:12:19.78,0:12:24.93,[16:9] Main,,0,0,0,,Từ phía Đông xa xôi, vượt qua lãnh thổ\NLegion thống trị, ở phía bên kia biên giới.
Dialogue: 0,0:12:26.50,0:12:28.69,[16:9] Main,,0,0,0,,Họ, Liên Bang Giad...
Dialogue: 0,0:12:28.69,0:12:34.94,[16:9] Main,,0,0,0,,Từ đầu đã biết rõ việc Nước Cộng Hoà\Náp bức những người 86.
Dialogue: 0,0:12:35.49,0:12:38.23,[16:9] Main,,0,0,0,,Những người vẫn còn sống sót ở ngoài khu 86,
Dialogue: 0,0:12:38.23,0:12:39.70,[16:9] Main,,0,0,0,,đã được Liên Bang cứu giúp,
Dialogue: 0,0:12:40.13,0:12:44.54,[16:9] Main,,0,0,0,,chỉ cần có nguyện vọng thì họ sẵn sàng\Nđể bất kỳ ai trở thành công dân Liên Bang.
Dialogue: 0,0:12:45.20,0:12:48.00,[16:9] Main,,0,0,0,,Những sự việc tàn nhẫn đó... giờ đã kết thúc...
Dialogue: 0,0:12:49.52,0:12:52.52,[16:9] Main,,0,0,0,,Đội quân cứu viện lúc này vẫn đang trú đóng,
Dialogue: 0,0:12:52.52,0:12:55.75,[16:9] Main,,0,0,0,,và đang duy trì viện trợ người dân\Nở mức tối thiểu, thế nhưng...
Dialogue: 0,0:12:57.54,0:13:00.36,[16:9] Main,,0,0,0,,Này! Sao thằng này lại được nhiều hơn hả?
Dialogue: 0,0:13:00.36,0:13:01.58,[16:9] Main,,0,0,0,,Làm hẳn hoi xem nào.
Dialogue: 0,0:13:01.58,0:13:05.32,[16:9] Main,,0,0,0,,Không đối xử bình đẳng được đấy hả?\NCái lũ vấy màu này.
Dialogue: 0,0:13:10.42,0:13:12.84,[16:9] Main,,0,0,0,,Tại sao lại thành ra thế này chứ...
Dialogue: 0,0:13:16.81,0:13:19.20,[16:9] Main,,0,0,0,,Với những người dân\Nkhông nhận thức được tội lỗi đó...
Dialogue: 0,0:13:19.20,0:13:21.42,[16:9] Main,,0,0,0,,thì đó sẽ chẳng thể nào là sự trừng phạt.
Dialogue: 0,0:13:21.99,0:13:25.03,[16:9] Main,,0,0,0,,Liệu có đúng như những gì chú đã nói không...
Dialogue: 0,0:13:25.03,0:13:26.32,[16:9] Main,,0,0,0,,Thưa cha...
Dialogue: 0,0:13:33.93,0:13:35.50,[16:9] Main,,0,0,0,,Đại tá Milizé...
Dialogue: 0,0:13:35.93,0:13:37.25,[16:9] Main,,0,0,0,,Đó là...
Dialogue: 0,0:13:37.25,0:13:38.96,[16:9] Main,,0,0,0,,Xin đừng bận tâm.
Dialogue: 0,0:13:39.63,0:13:41.12,[16:9] Main,,0,0,0,,Vậy à...
Dialogue: 0,0:13:42.14,0:13:43.69,[16:9] Main,,0,0,0,,Một lần nữa...
Dialogue: 0,0:13:43.69,0:13:48.73,[16:9] Main,,0,0,0,,Khi chúng ta vẫn đang bị Legion bao vây,\Nvới sự dũng mãnh, họ đã đẩy lùi chiến tuyến,
Dialogue: 0,0:13:48.73,0:13:52.25,[16:9] Main,,0,0,0,,và đoạt lại đến tận khu số 1 này giúp chúng ta.
Dialogue: 0,0:13:52.25,0:13:53.77,[16:9] Main,,0,0,0,,Như Đại tá đã biết...
Dialogue: 0,0:13:54.11,0:13:59.54,[16:9] Main,,0,0,0,,Họ chính là các vị Quân đội Liên Bang uy mãnh\Nđược vũ trang tân tiến và có sĩ khí cao ngất.
Dialogue: 0,0:13:59.54,0:14:00.28,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:14:00.28,0:14:04.82,[16:9] Main,,0,0,0,,Lần này, để chiếm lại những khu vực\Ntừ nơi đây lên phía Bắc,
Dialogue: 0,0:14:04.82,0:14:09.37,[16:9] Main,,0,0,0,,bên phía Quân đội Liên Bang muốn tuyển\Nchỉ huy điều phái từ phía chúng ta.
Dialogue: 0,0:14:10.00,0:14:14.14,[16:9] Main,,0,0,0,,Và cô đã có nguyện vọng\Nlàm chỉ huy đơn vị tái chiếm đó...
Dialogue: 0,0:14:14.14,0:14:15.96,[16:9] Main,,0,0,0,,Không sai chứ?
Dialogue: 0,0:14:15.96,0:14:17.21,[16:9] Main,,0,0,0,,Không sai.
Dialogue: 0,0:14:17.21,0:14:22.22,[16:9] Main,,0,0,0,,Ôi, là cấp trên của cô,\Ntôi biết là cô sẽ làm như vậy mà.
Dialogue: 0,0:14:22.56,0:14:24.51,[16:9] Main,,0,0,0,,Tôi cũng có chung cảm nghĩ như vậy đó.
Dialogue: 0,0:14:24.51,0:14:26.75,[16:9] Main,,0,0,0,,Hãy cố gắng nhiều vào nhé.
Dialogue: 0,0:14:28.56,0:14:31.14,[16:9] Main,,0,0,0,,Thế cậu định đi Liên Bang thật à?
Dialogue: 0,0:14:31.78,0:14:32.77,[16:9] Main,,0,0,0,,Ừ.
Dialogue: 0,0:14:36.24,0:14:37.76,[16:9] Main,,0,0,0,,Cậu không bất ngờ sao?
Dialogue: 0,0:14:37.76,0:14:39.37,[16:9] Main,,0,0,0,,Giờ sao nổi nữa...
Dialogue: 0,0:14:39.37,0:14:43.52,[16:9] Main,,0,0,0,,Cỡ đó mà đã bất ngờ thì sao ở cạnh Lena được.
Dialogue: 0,0:14:44.57,0:14:47.87,[16:9] Main,,0,0,0,,Cậu biết từ ngày đó đã khiến tớ\Nbất ngờ nhiều thế nào không?
Dialogue: 0,0:14:57.42,0:15:00.63,[16:9] Main,,0,0,0,,Thật là... tớ bất ngờ đủ một đời rồi.
Dialogue: 0,0:15:03.63,0:15:04.38,[16:9] Main,,0,0,0,,Hả?
Dialogue: 20,0:15:04.99,0:15:07.34,[16:9] Main,,0,0,0,,Tại sao? Cái này cũng có thể ư?
Dialogue: 20,0:15:05.56,0:15:06.48,[16:9] Main Alt,Top,0,0,0,,Cậu làm sao đấy?
Dialogue: 0,0:15:07.34,0:15:10.68,[16:9] Main,,0,0,0,,Cái này! Là thiết bị RAID\Nbên Liên Bang đã chế tạo!
Dialogue: 0,0:15:10.68,0:15:13.27,[16:9] Main,,0,0,0,,Chẳng hiểu sao lại được thiết lập\Ngiống Nước Cộng Hoà ấy.
Dialogue: 0,0:15:13.98,0:15:15.71,[16:9] Main,,0,0,0,,Hử? Tình cờ à?
Dialogue: 20,0:15:15.71,0:15:18.02,[16:9] Main,,0,0,0,,Không, không, gì mà tình cờ thế...
Dialogue: 20,0:15:16.79,0:15:18.02,[16:9] Main Alt,Top,0,0,0,,Là sao cơ?
Dialogue: 0,0:15:18.02,0:15:21.71,[16:9] Main,,0,0,0,,Đó là hàng của Liên Bang\Nmà lại có kỹ thuật của bên mình ấy!
Dialogue: 0,0:15:21.71,0:15:25.49,[16:9] Main,,0,0,0,,Nếu không gặp được những 86 còn sống,\Nthì không thể làm nổi đâu...
Dialogue: 0,0:15:26.32,0:15:29.62,[16:9] Main,,0,0,0,,Nhưng mà... làm sao có chuyện\NLiên Bang gặp được người 86...
Dialogue: 0,0:15:29.62,0:15:32.54,[16:9] Main,,0,0,0,,trước cả khi cuộc tấn công lớn diễn ra...
Dialogue: 0,0:15:40.10,0:15:41.20,[16:9] Main,,0,0,0,,Thiệt tình.
Dialogue: 0,0:15:41.20,0:15:42.31,[16:9] Main,,0,0,0,,Xin lỗi.
Dialogue: 0,0:15:42.31,0:15:44.02,[16:9] Main,,0,0,0,,Thôi thì đằng nào cũng thế,
Dialogue: 0,0:15:44.02,0:15:46.00,[16:9] Main,,0,0,0,,sang bên kia rồi sẽ rõ thôi.
Dialogue: 0,0:15:46.69,0:15:47.91,[16:9] Main,,0,0,0,,Annette.
Dialogue: 0,0:15:47.91,0:15:51.13,[16:9] Main,,0,0,0,,Tại sao cậu lại có thiết bị RAID\Ncủa bên Liên Bang vậy?
Dialogue: 0,0:15:51.13,0:15:52.88,[16:9] Main,,0,0,0,,Thì tình nguyện đi chứ sao?
Dialogue: 0,0:15:53.64,0:15:56.39,[16:9] Main,,0,0,0,,Tớ sẽ được điều phái\Nvới tư cách Sĩ quan Kỹ thuật.
Dialogue: 0,0:15:57.08,0:15:59.65,[16:9] Main,,0,0,0,,Tớ cũng sẽ đi Liên Bang.
Dialogue: 0,0:16:01.40,0:16:04.55,[16:9] Main,,0,0,0,,Lúc nào cũng cố gắng hết mình đến cùng.
Dialogue: 0,0:16:04.55,0:16:06.43,[16:9] Main,,0,0,0,,Luôn nhìn thấy một Lena như vậy,
Dialogue: 0,0:16:06.43,0:16:10.32,[16:9] Main,,0,0,0,,tớ dần nghĩ "Thôi, đành thế vậy" ấy mà.
Dialogue: 0,0:16:10.90,0:16:12.70,[16:9] Main,,0,0,0,,Mà không chỉ có tớ đâu.
Dialogue: 0,0:16:12.70,0:16:15.32,[16:9] Main,,0,0,0,,Có lẽ cả những người khác nữa.
Dialogue: 0,0:16:16.08,0:16:17.71,[16:9] Main,,0,0,0,,Tóm lại.
Dialogue: 0,0:16:17.71,0:16:21.29,[16:9] Main,,0,0,0,,Nếu đã sử dụng Para-RAID\Nthì tớ nhất định phải đi chứ sao.
Dialogue: 0,0:16:22.66,0:16:24.22,[16:9] Main,,0,0,0,,Lại bên nhau nữa rồi nhé.
Dialogue: 0,0:16:24.22,0:16:25.38,[16:9] Main,,0,0,0,,Lena!
Dialogue: 0,0:16:30.14,0:16:31.39,[16:9] Main,,0,0,0,,Ừ!
Dialogue: 0,0:16:32.34,0:16:34.54,[16:9] Main,,0,0,0,,Annette đúng thật là!
Dialogue: 0,0:16:38.37,0:16:41.78,[16:9] Main,,0,0,0,,Xin thứ lỗi, còn nhiều thứ vẫn đang lên kế hoạch.
Dialogue: 0,0:16:41.78,0:16:43.15,[16:9] Main,,0,0,0,,À vâng...
Dialogue: 0,0:16:43.77,0:16:46.03,[16:9] Main,,0,0,0,,Thế nhưng... cái này...
Dialogue: 0,0:16:46.03,0:16:48.22,[16:9] Main,Top,0,0,0,,{\an8}Không phải tôi coi thường cô đâu.
Dialogue: 0,0:16:48.22,0:16:49.75,[16:9] Main,Top,0,0,0,,{\an8}Đại tá Milizé.
Dialogue: 0,0:16:49.75,0:16:51.11,[16:9] Main,Top,0,0,0,,{\an8}Cùng với những người 86,
Dialogue: 0,0:16:51.11,0:16:53.18,[16:9] Main,Top,0,0,0,,{\an8}cô đã chiến đấu phòng thủ đến cùng.
Dialogue: 0,0:16:53.18,0:16:56.04,[16:9] Main,Top,0,0,0,,{\an8}Chúng tôi luôn hoan nghênh\Nmột người chỉ huy như cô.
Dialogue: 0,0:16:57.06,0:16:58.78,[16:9] Main,,0,0,0,,Xin cảm ơn.
Dialogue: 0,0:16:58.78,0:17:01.17,[16:9] Main,,0,0,0,,Tôi sẽ nỗ lực hết mình.
Dialogue: 0,0:17:02.93,0:17:04.40,[16:9] Main,,0,0,0,,Vậy hẹn gặp lại.
Dialogue: 0,0:17:04.40,0:17:05.35,[16:9] Main,,0,0,0,,Ở đất nước của tôi.
Dialogue: 0,0:17:22.15,0:17:24.40,[16:9] Main,,0,0,0,,{\i1}Chí ít thì ta cũng sẽ câu giờ được.
Dialogue: 0,0:17:25.02,0:17:28.65,[16:9] Main,,0,0,0,,{\i1}Cứ tha hồ mà đối mặt với\Nhiện thực tàn khốc đi, Lena.
Dialogue: 0,0:17:29.18,0:17:34.91,[16:9] Main,,0,0,0,,{\i1}Để thấy cái giấc mơ ngây thơ mà\Ncháu hằng ao ước bị đập tan trước hiện thực.
Dialogue: 0,0:17:39.96,0:17:41.32,[16:9] Main,,0,0,0,,Chú à...
Dialogue: 0,0:17:41.91,0:17:44.24,[16:9] Main,,0,0,0,,Xin hãy cho cháu thêm chút thời gian.
Dialogue: 0,0:17:50.77,0:17:53.32,[16:9] Main,,0,0,0,,Cho đến khi giấc mơ của cháu vỡ nát.
Dialogue: 0,0:17:56.35,0:17:57.98,[16:9] Main,,0,0,0,,Ôi chà, ôi chà.
Dialogue: 0,0:17:57.98,0:18:00.81,[16:9] Main,,0,0,0,,Tôi đã đợi cô đấy, Bloody Regina.
Dialogue: 0,0:18:01.32,0:18:03.60,[16:9] Main,,0,0,0,,Tuy hơi gấp, nhưng ta hãy đi thôi nào.
Dialogue: 0,0:18:07.58,0:18:10.01,[16:9] Main,,0,0,0,,Có nơi tôi muốn chỉ cô xem.
Dialogue: 0,0:18:36.92,0:18:38.33,[16:9] Main,,0,0,0,,Tôi sẽ không quên.
Dialogue: 0,0:18:40.13,0:18:41.54,[16:9] Main,,0,0,0,,Tôi sẽ không quên...
Dialogue: 0,0:18:42.86,0:18:44.09,[16:9] Main,,0,0,0,,Tôi sẽ không quên...
Dialogue: 0,0:18:46.66,0:18:48.32,[16:9] Main,,0,0,0,,Tôi sẽ không quên...
Dialogue: 0,0:18:50.28,0:18:52.00,[16:9] Main,,0,0,0,,Tôi sẽ không quên...
Dialogue: 0,0:19:00.68,0:19:01.72,[16:9] Main,,0,0,0,,{\i1}Phải chiến đấu.
Dialogue: 0,0:19:02.55,0:19:04.37,[16:9] Main,,0,0,0,,{\i1}Để đến được nơi họ đã đặt chân tới,
Dialogue: 0,0:19:04.37,0:19:08.38,[16:9] Main,fad leadout,0,0,0,,{\i1\t(3443,0,\c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&)}nơi chỉ những người\Nluôn tiến bước tới cùng mới đến được.
Dialogue: 0,0:19:10.29,0:19:12.02,[16:9] Main,,0,0,0,,{\i1}Để chiến đấu đến cùng.
Dialogue: 0,0:19:18.13,0:19:22.02,[16:9] Main,,0,0,100,,{\fad(100,0)\i1}Để sống sót đến cùng...
Dialogue: 0,0:19:23.80,0:19:26.01,[16:9->4:3] Main,,0,0,0,,Phiền mày theo \Ncùng chúng nó đấy.
Dialogue: 0,0:19:42.01,0:19:46.04,[16:9->4:3] Main,,0,0,0,,Thật ra lúc đấy, tao cũng thấy rồi.
Dialogue: 0,0:19:46.04,0:19:48.02,[16:9->4:3] Main,,0,0,0,,Mà cũng chẳng nhớ đâu.
Dialogue: 0,0:19:48.96,0:19:52.00,[16:9->4:3] Main,,0,0,0,,Cô ấy, có khuôn mặt \Nthế nào ấy nhỉ?
Dialogue: 0,0:19:55.22,0:19:57.70,[16:9->4:3] Main,,0,0,0,,Hình như đi cùng \Nmột bé mèo đen đấy.
Dialogue: 0,0:20:01.22,0:20:03.89,[16:9->4:3] Main,,0,0,0,,Lỡ là Kitty thật thì... nhỉ?
Dialogue: 0,0:20:07.64,0:20:08.81,[16:9->4:3] Main,,0,0,0,,Nhỉ?
Dialogue: 0,0:20:09.52,0:20:10.56,[16:9->4:3] Main,,0,0,0,,Cái này á?
Dialogue: 0,0:20:12.52,0:20:13.90,[16:9->4:3] Main,,0,0,0,,Cái này thì sao?
Dialogue: 0,0:20:16.96,0:20:19.49,[16:9->4:3] Main,,0,0,0,,Đúng cái này rồi!
Dialogue: 0,0:20:21.45,0:20:23.20,[16:9->4:3] Main,,0,0,0,,Theo! Cái gì thế nà—
Dialogue: 0,0:20:23.33,0:20:26.78,[16:9->4:3] Main,,0,0,0,,Shin còn lâu mới thế nhé,\Nhọ có phải kiểu đấy đâu!
Dialogue: 0,0:20:26.78,0:20:29.00,[16:9->4:3] Main,,0,0,0,,Mà mình chơi thân\Nvới cậu ấy lâu hơn.
Dialogue: 0,0:20:29.00,0:20:30.96,[16:9->4:3] Main,,0,0,0,,Đằng đó rõ là em gái còn gì!
Dialogue: 20,0:20:31.71,0:20:32.79,[16:9->4:3] Main,,0,0,0,,Thắng rồi!
Dialogue: 20,0:20:31.71,0:20:32.79,[16:9->4:3] Main Alt,,0,0,0,,Theo!
Dialogue: 0,0:20:35.66,0:20:38.05,[16:9->4:3] Main,,0,0,0,,Đúng là cảnh nam nữ\Nhội ngộ lý tưởng mà!
Dialogue: 0,0:20:43.26,0:20:46.27,[16:9->4:3] Main,,0,0,0,,Trẫm cũng sẽ làm cô ấy bất ngờ!
Dialogue: 0,0:20:47.27,0:20:49.98,[16:9->4:3] Main,,0,0,0,,Cái gì cơ? Bloody Regina?
Dialogue: 0,0:20:49.98,0:20:51.40,[16:9->4:3] Main,,0,0,0,,Đặt tên nghe gớm thật đấy.
Dialogue: 0,0:20:51.40,0:20:54.14,[16:9->4:3] Main,,0,0,0,,Không biết có nhận ra\Nbọn mình ngay không nhỉ?
Dialogue: 0,0:20:51.40,0:20:53.08,[16:9->4:3] Main,,0,0,240,,{\an8}Mày có thấy như vậy không?
Dialogue: 20,0:20:54.14,0:20:56.40,[16:9->4:3] Main,,0,0,0,,Nếu nhận ra thì \Nđúng là vui thật đấy.
Dialogue: 20,0:20:56.40,0:20:58.53,[16:9->4:3] Main,,0,0,0,,Nhưng không nhận ra \Ncũng không sao.
Dialogue: 0,0:21:02.73,0:21:05.84,[16:9->4:3] Main,,0,0,0,,Xin lỗi đã để các vị phải đợi.
Dialogue: 0,0:21:05.84,0:21:10.44,[16:9->4:3] Main,,0,0,0,,Không, tôi sẽ không coi khoảng thời gian\Nviếng người đã khuất là trễ giờ đâu.
Dialogue: 0,0:21:10.44,0:21:14.35,[16:9->4:3] Main,,0,0,0,,Xin mời, để tôi giới thiệu cô với những \Nthuộc cấp sẽ được giao cho cô.
Dialogue: 0,0:21:14.35,0:21:16.58,[16:9->4:3] Main,,0,0,0,,Ơ? Ngay bây giờ ấy ạ?
Dialogue: 0,0:21:16.58,0:21:17.72,[16:9->4:3] Main,,0,0,0,,Phải.
Dialogue: 0,0:21:17.72,0:21:19.68,[16:9->4:3] Main,,0,0,0,,Này, có thật là "ấy" không đấy?
Dialogue: 0,0:21:19.68,0:21:21.26,[16:9->4:3] Main,,0,0,0,,Thì cũng nhiều chuyện xảy ra mà.
Dialogue: 0,0:21:21.70,0:21:23.01,[16:9->4:3] Main,,0,0,0,,Cũng phải.
Dialogue: 0,0:21:33.06,0:21:37.78,[16:9] Main,,0,0,0,,Tôi là Đại tá của Quân đội Nước Cộng Hoà\NSan Magnolia, Vladilena Milizé.
Dialogue: 0,0:21:37.78,0:21:39.07,[16:9] Main,,0,0,0,,Lần đầu ra mắt các vị.
Dialogue: 0,0:21:41.38,0:21:43.88,[16:9] Main,,0,0,0,,Không phải lần đầu đâu ạ.
Dialogue: 0,0:21:43.88,0:21:47.92,[16:9] Main,,0,0,0,,Đúng ra đây là lần đầu\Nchúng tôi được gặp cô trực tiếp.
Dialogue: 0,0:21:50.43,0:21:53.08,[16:9] Main,,0,0,0,,Đã lâu không gặp, Handler One.
Dialogue: 0,0:21:56.81,0:21:58.84,[16:9] Main,,0,0,0,,Tôi là Đại uý của Quân đội Liên Bang Giad...
Dialogue: 0,0:21:59.30,0:22:01.86,[16:9] Main,,0,0,0,,Cựu Đội trưởng Chiến đội Spearhead.
Dialogue: 0,0:22:02.43,0:22:03.97,[16:9] Main,,0,0,0,,Shinei Nouzen.
Dialogue: 0,0:22:16.61,0:22:17.73,[16:9] Main,,0,0,0,,Shin...
Dialogue: 0,0:22:48.44,0:22:50.10,[16:9] Main,,0,0,0,,Đúng là cô ngố thật.
Dialogue: 0,0:22:50.84,0:22:52.16,[16:9] Main,,0,0,0,,Raiden!
Dialogue: 0,0:22:52.16,0:22:53.48,[16:9] Main,,0,0,0,,Đây là chúng tôi á?
Dialogue: 0,0:22:53.77,0:22:55.24,[16:9] Main,,0,0,0,,Theo!
Dialogue: 0,0:22:55.24,0:22:58.32,[16:9] Main,,0,0,0,,Về chú mèo, cảm ơn cô nhiều.
Dialogue: 0,0:22:58.32,0:22:59.24,[16:9] Main,,0,0,0,,Anju...
Dialogue: 0,0:22:59.24,0:23:00.73,[16:9] Main,,0,0,0,,Còn sống thế này là tốt lắm rồi.
Dialogue: 0,0:23:01.20,0:23:02.12,[16:9] Main,,0,0,0,,Kurena!
Dialogue: 0,0:23:02.12,0:23:03.70,[16:9] Main,,0,0,0,,Sao nào!
Dialogue: 0,0:23:03.70,0:23:05.07,[16:9] Main,,0,0,0,,Làm một pô kỷ niệm chứ!
Dialogue: 0,0:23:05.07,0:23:06.24,[16:9] Main,,0,0,0,,Ừ!
Dialogue: 0,0:23:06.24,0:23:07.24,[16:9] Main,,0,0,0,,Nghe hay đấy.
Dialogue: 0,0:23:11.21,0:23:13.87,[16:9] Main,,0,0,0,,Tôi đã luôn đuổi theo mọi người.
Dialogue: 0,0:23:14.38,0:23:16.04,[16:9] Main,,0,0,0,,Tôi biết.
Dialogue: 0,0:23:16.04,0:23:18.12,[16:9] Main,,0,0,0,,Giờ đã đuổi kịp rồi.
Dialogue: 0,0:23:18.12,0:23:19.08,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:23:21.15,0:23:22.45,[16:9] Main,,0,0,0,,Từ giờ trở đi...
Dialogue: 0,0:23:23.76,0:23:26.00,[16:9] Main,,0,0,0,,Tôi sẽ chiến đấu cùng mọi người.
