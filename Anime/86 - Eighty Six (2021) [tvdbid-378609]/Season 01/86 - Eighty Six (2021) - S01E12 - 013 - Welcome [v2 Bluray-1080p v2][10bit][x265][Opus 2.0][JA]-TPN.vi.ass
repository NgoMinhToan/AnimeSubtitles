Dialogue: 1,0:23:34.98,0:23:39.98,DedzuyaSigns,,0,0,0,,{\fnCambridge vR\fs60\c&H000000&\blur0.65\pos(960,689.48)}It's Too Late
Dialogue: 0,0:00:06.92,0:00:08.87,[16:9] Main,,0,0,0,,Cyclops gọi Handler One.
Dialogue: 0,0:00:08.87,0:00:13.11,[16:9] Main,,0,0,0,,Chúng tôi vừa mới tới ga đầu\N tại điểm 1-2-2 của tuyến đường sắt cao tốc cũ.
Dialogue: 0,0:00:13.11,0:00:14.29,[16:9] Main,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:00:14.29,0:00:17.66,[16:9] Main,,0,0,0,,Ra-đa bị đánh lừa nên lúc nhận ra thì đã muộn.
Dialogue: 0,0:00:17.66,0:00:20.88,[16:9] Main,,0,0,0,,Với đội lính mới thì trận này sẽ căng đây!
Dialogue: 0,0:00:21.75,0:00:23.36,[16:9] Main,,0,0,0,,Di chuyển như nào đây?
Dialogue: 0,0:00:23.36,0:00:27.30,[16:9] Main,,0,0,0,,Triển khai chủ lực ở điểm 0-6-2,\Nhãy dùng đội biệt động dẫn dụ địch.
Dialogue: 0,0:00:27.30,0:00:30.30,[16:9] Main,,0,0,0,,Nếu là chỗ đó thì vẫn trong tầm bắn\Ncủa số pháo nghênh kích còn lại.
Dialogue: 0,0:00:30.73,0:00:33.10,[16:9] Main,,0,0,0,,Nghênh kích ngay trước mặt căn cứ sao?
Dialogue: 0,0:00:33.10,0:00:37.06,[16:9] Main,,0,0,0,,Nếu chúng vượt qua được thì sẽ chỉ còn mỗi\Nbãi mìn và pháo nghênh kích cản đường còn gì?
Dialogue: 0,0:00:37.70,0:00:42.69,[16:9] Main,,0,0,0,,Tuy nhiên, để giữ mạng thì đó là vị trí\Ntốt nhất ta có thể đạt được lúc này.
Dialogue: 0,0:00:44.21,0:00:45.69,[16:9] Main,,0,0,0,,Đã rõ!
Dialogue: 0,0:00:46.05,0:00:47.36,[16:9] Main,,0,0,0,,Thưa Nữ Vương Bệ Hạ!
Dialogue: 0,0:00:52.05,0:00:57.16,[16:9] Main,,0,0,0,,Tổng bộ Quân đội Cộng Hoà San Magnolia\Nxin được thông báo tình hình chiến sự hôm nay.
Dialogue: 0,0:00:57.16,0:01:01.86,[16:9] Main,,0,0,0,,{\an8}Lực lượng máy chiến đấu không người lái tự hành của\NNước Cộng Hoà chúng ta, Juggernaut đã nghênh kích
Dialogue: 0,0:01:01.86,0:01:05.71,[16:9] Main,,0,0,0,,{\an8}khiến cho lực lượng cơ giới thiết giáp Legion\Nchịu thiệt hại nặng nề mà rút chạy.
Dialogue: 0,0:01:05.71,0:01:09.00,[16:9] Main,,0,0,0,,Nhờ sự tham chiến của những cỗ máy\Nkhông người lái tiên tiến và nhân đạo...
Dialogue: 0,0:01:09.00,0:01:12.43,[16:9] Main,,0,0,0,,số tử sĩ hôm nay của đất nước\Nchúng ta vẫn là bằng 0.
Dialogue: 0,0:01:12.43,0:01:16.39,[16:9] Main,,0,0,0,,Ngày mà Nước Cộng Hoà chúng ta\Ngiáng công lý xuống lũ dị vật tà ác vong quốc...
Dialogue: 0,0:01:16.39,0:01:18.76,[16:9] Main,,0,0,0,,hẳn sẽ tới sớm thôi.
Dialogue: 0,0:01:18.76,0:01:20.81,[16:9] Main,,0,0,0,,Cộng Hoà San Magnolia muôn năm!
Dialogue: 0,0:01:20.81,0:01:22.94,[16:9] Main,,0,0,0,,Vinh quang cho lá cờ ngũ sắc!
Dialogue: 0,0:01:27.19,0:01:30.37,[16:9] Main,,0,0,0,,Công chúa điện hạ chuyên đập phá búp bê giá đáo.
Dialogue: 0,0:01:30.37,0:01:35.11,[16:9] Main,,0,0,0,,Tỷ lệ Legion bị tắm máu lợn mà đi đời hôm nay\Ncũng thật sự tuyệt vời đó ạ.
Dialogue: 0,0:01:35.11,0:01:39.70,[16:9] Main,,0,0,0,,Quả thật không hổ danh\N"Nữ Vương đẫm máu", Bloody Regina!
Dialogue: 0,0:01:39.70,0:01:44.08,[16:9] Main,,0,0,0,,Đã phân biệt được người và lợn\Nchưa đấy, Nữ Vương ơi?
Dialogue: 0,0:01:44.08,0:01:46.90,[16:9] Main,,0,0,0,,Thật tình, mặt không chút đổi sắc...
Dialogue: 0,0:01:46.90,0:01:48.91,[16:9] Main,,0,0,0,,Nó nghĩ cái quái gì thế không biết...
Dialogue: 0,0:01:48.91,0:01:54.44,[16:9] Main,,0,0,0,,Chỉ vì lũ lợn mà từ chức Thiếu tá,\Nrồi còn tự nhuộm đen quân phục...
Dialogue: 0,0:01:54.44,0:01:58.68,[16:9] Main,,0,0,0,,Cái lũ Legion thì chưa tới 2 năm nữa\Nsẽ đi đời rồi trở nên vô dụng nhở.
Dialogue: 0,0:01:58.68,0:02:00.63,[16:9] Main,,0,0,0,,Nó sinh ra trong danh gia phải không?
Dialogue: 0,0:02:00.63,0:02:04.05,[16:9] Main,,0,0,0,,Cứ chẳng cần làm gì mà vui sống\Ncó phải hơn không?
Dialogue: 0,0:02:09.15,0:02:10.48,[16:9] Main,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:02:10.48,0:02:11.49,[16:9] Main,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:02:11.99,0:02:13.49,[16:9] Main,,0,0,0,,Đây là thứ cậu nhờ.
Dialogue: 0,0:02:13.49,0:02:15.55,[16:9] Main,,0,0,0,,Có chuyện tớ muốn xác nhận đó.
Dialogue: 0,0:02:15.55,0:02:17.97,[16:9] Main,,0,0,0,,Thiết lập bổ sung của thiết bị RAID.
Dialogue: 0,0:02:17.97,0:02:19.26,[16:9] Main,,0,0,0,,Tớ hiểu rồi.
Dialogue: 0,0:02:19.26,0:02:21.10,[16:9] Main,,0,0,0,,Vậy thì hai tiếng nữa tớ sẽ qua.
Dialogue: 0,0:02:21.10,0:02:22.63,[16:9] Main,,0,0,0,,Ừ, thế nhé.
Dialogue: 0,0:02:28.13,0:02:31.13,[16:9] Main,,0,0,0,,Định khiến tôi phải nói\Nbao lần nữa hả, Đại uý Milizé?
Dialogue: 0,0:02:33.38,0:02:35.88,[16:9] Main,,0,0,0,,Dùng pháo nghênh kích mà không được phép...
Dialogue: 0,0:02:35.88,0:02:40.85,[16:9] Main,,0,0,0,,Cung ứng vật tư không có trong kế hoạch,\Nrồi còn ra chỉ thị trực tiếp cho chiến đội khác...
Dialogue: 0,0:02:41.47,0:02:44.19,[16:9] Main,,0,0,0,,Cô có biết bao nhiêu lời phàn nàn\Nđã được gửi lên không?
Dialogue: 0,0:02:44.62,0:02:48.73,[16:9] Main,,0,0,0,,Đừng có tốn công vô ích vì lũ 86 nữa.
Dialogue: 0,0:02:48.73,0:02:53.63,[16:9] Main,,0,0,0,,Vốn có thể tránh tất cả những chuyện đó...\Nnếu như ngài chịu cấp phép đó.
Dialogue: 0,0:02:53.63,0:02:54.74,[16:9] Main,,0,0,0,,Thưa Trung tá.
Dialogue: 0,0:02:54.74,0:02:56.13,[16:9] Main,,0,0,0,,Cái gì?
Dialogue: 0,0:02:56.13,0:02:59.92,[16:9] Main,,0,0,0,,Chuyện bên kia phàn nàn hay ngài phàn nàn,\Nthế nào cũng được...
Dialogue: 0,0:02:59.92,0:03:01.97,[16:9] Main,,0,0,0,,Đó chẳng phải cái tôi cần quan tâm.
Dialogue: 0,0:03:01.97,0:03:03.96,[16:9] Main,,0,0,0,,Đừng có bố láo, con ranh con!
Dialogue: 0,0:03:04.37,0:03:06.47,[16:9] Main,,0,0,0,,Chỉ là Đại uý thì biết thân biết phận đ—
Dialogue: 0,0:03:06.47,0:03:08.46,[16:9] Main,,0,0,0,,Chỉ cần biết thân biết phận là được ạ?
Dialogue: 0,0:03:09.27,0:03:12.92,[16:9] Main,,0,0,0,,Thành tích chiến đấu của thuộc hạ\Nđang được tính cho ngài như thế...
Dialogue: 0,0:03:12.92,0:03:14.13,[16:9] Main,,0,0,0,,Cái gì cơ...
Dialogue: 0,0:03:14.13,0:03:18.56,[16:9] Main,,0,0,0,,Nếu như một Handler hàng đầu như tôi\Nmà bị có tỷ lệ tiêu diệt Legion sụt giảm...
Dialogue: 0,0:03:18.56,0:03:21.72,[16:9] Main,,0,0,0,,Chắc là ngài sẽ chẳng thể hy vọng\Nleo cao hơn nữa được đâu...
Dialogue: 0,0:03:22.25,0:03:23.18,[16:9] Main,,0,0,0,,Nhỉ?
Dialogue: 0,0:03:28.92,0:03:32.43,[16:9] Main,,0,0,0,,Cô ăn nói cho cẩn thận đi, Đại uý.
Dialogue: 0,0:03:32.43,0:03:35.18,[16:9] Main,,0,0,0,,Đã thất lễ rồi, thưa ngài Trung tá.
Dialogue: 0,0:04:07.19,0:04:10.62,[16:9] Main,,0,0,0,,Vậy thì vụ vật tư bổ sung xin nhờ phía đó nhé.
Dialogue: 0,0:04:10.62,0:04:11.66,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:04:11.66,0:04:12.72,[16:9] Main,,0,0,0,,Đại uý.
Dialogue: 0,0:04:12.72,0:04:17.35,[16:9] Main,,0,0,0,,Tôi đã điều tra tỷ lệ pháo nghênh kích còn\Nhoạt động của Chiến khu 8, mặt trận phía Nam...
Dialogue: 0,0:04:17.35,0:04:19.91,[16:9] Main,,0,0,0,,Quả nhiên là tổng cộng chỉ còn khoảng 2 phần.
Dialogue: 0,0:04:19.91,0:04:21.76,[16:9] Main,,0,0,0,,Thật sự là thế sao...
Dialogue: 0,0:04:22.27,0:04:24.16,[16:9] Main,,0,0,0,,Về tổn thất của các mặt trận—
Dialogue: 0,0:04:24.16,0:04:26.57,[16:9] Main,,0,0,0,,Kia kìa! Nhìn đi, nhìn đi!
Dialogue: 0,0:04:26.57,0:04:28.54,[16:9] Main,,0,0,0,,Tuyết! Tuyết rơi kìa!
Dialogue: 0,0:04:31.60,0:04:33.67,[16:9] Main,,0,0,0,,Đã sang hẳn mùa đông rồi nhỉ.
Dialogue: 0,0:04:36.37,0:04:38.01,[16:9] Main,,0,0,0,,Cyclops gọi Handler One.
Dialogue: 0,0:04:38.01,0:04:39.38,[16:9] Main,,0,0,0,,Cô có nghe thấy không?
Dialogue: 0,0:04:39.38,0:04:41.34,[16:9] Main,,0,0,0,,Ừm! Có chuyện gì thế?
Dialogue: 0,0:04:41.34,0:04:43.85,[16:9] Main,,0,0,0,,Trong lúc tuần tra đã phát hiện\Nlực lượng của địch.
Dialogue: 0,0:04:43.85,0:04:45.35,[16:9] Main,,0,0,0,,Xin nhờ cô hạ lệnh.
Dialogue: 0,0:04:45.60,0:04:46.73,[16:9] Main,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:04:47.43,0:04:49.02,[16:9] Main,,0,0,0,,Nhờ mọi người tiếp tục tiến hành.
Dialogue: 0,0:04:49.68,0:04:50.69,[16:9] Main,,0,0,0,,Cyclops.
Dialogue: 0,0:04:50.69,0:04:52.95,[16:9] Main,,0,0,0,,Hãy báo cáo tình hình quân địch.
Dialogue: 0,0:04:59.64,0:05:02.21,[16:9] Main,,0,0,0,,Xin lỗi, tớ tới muộn.
Dialogue: 0,0:05:04.54,0:05:06.58,[16:9] Main,,0,0,0,,Sớm sủa quá đi ấy nhở?
Dialogue: 0,0:05:10.73,0:05:12.61,[16:9] Main,,0,0,0,,Mau vào chuyện đi nào.
Dialogue: 0,0:05:13.91,0:05:15.46,[16:9] Main,,0,0,0,,Lena...
Dialogue: 0,0:05:17.99,0:05:18.95,[16:9] Main,,0,0,0,,Ừ.
Dialogue: 0,0:05:23.95,0:05:25.10,[16:9] Main,,0,0,0,,Tôi nắm được rồi.
Dialogue: 0,0:05:25.10,0:05:27.31,[16:9] Main,,0,0,0,,Cô đã vất vả báo cáo rồi.
Dialogue: 0,0:05:27.31,0:05:28.28,[16:9] Main,,0,0,0,,Ừm.
Dialogue: 0,0:05:28.28,0:05:30.43,[16:9] Main,,0,0,0,,Việc dự đoán lũ Legion đó nhờ cô nhé.
Dialogue: 0,0:05:30.43,0:05:31.81,[16:9] Main,,0,0,0,,Nữ Vương Bệ Hạ.
Dialogue: 0,0:05:31.81,0:05:33.94,[16:9] Main,,0,0,0,,Ừ, trong khả năng có thể.
Dialogue: 0,0:05:34.63,0:05:38.84,[16:9] Main,,0,0,0,,Từ giờ, đôi bên hãy cùng hợp sức\Nđể có được kết quả tốt nhất nhé.
Dialogue: 0,0:05:40.23,0:05:41.90,[16:9] Main,,0,0,0,,Cái đấy thì dĩ nhiên còn gì?
Dialogue: 0,0:05:41.90,0:05:45.05,[16:9] Main,,0,0,0,,Cô là Handler của bọn này cơ mà.
Dialogue: 0,0:05:45.05,0:05:46.45,[16:9] Main,,0,0,0,,Trông cậy ở cô đó.
Dialogue: 0,0:05:46.45,0:05:47.94,[16:9] Main,,0,0,0,,Tôi cũng vậy.
Dialogue: 0,0:05:47.94,0:05:51.97,[16:9] Main,,0,0,0,,Những thông tin cô thu được từ chiến trường\Ncũng rất quan trọng mà, Cyclops.
Dialogue: 0,0:05:53.66,0:05:58.03,[16:9] Main,,0,0,0,,Những lúc như này chẳng phải\Ncứ gọi tên thật cũng được sao?
Dialogue: 0,0:05:58.03,0:06:01.34,[16:9] Main,,0,0,0,,Nếu không gọi thì cô hỏi tên làm gì chứ?
Dialogue: 0,0:06:02.65,0:06:03.81,[16:9] Main,,0,0,0,,Chuyện đó...
Dialogue: 0,0:06:06.91,0:06:08.38,[16:9] Main,,0,0,0,,Với tôi...
Dialogue: 0,0:06:08.38,0:06:10.98,[16:9] Main,,0,0,0,,Đó chính là trách nhiệm của một Handler.
Dialogue: 0,0:06:11.32,0:06:14.29,[16:9] Main,,0,0,0,,Đúng là lúc nào cũng nghiêm túc...
Dialogue: 0,0:06:14.29,0:06:15.95,[16:9] Main,,0,0,0,,Cô cứng nhắc thật chứ...
Dialogue: 0,0:06:17.65,0:06:19.82,[16:9] Main,,0,0,0,,Có bị coi là như nào tôi cũng không ngại đâu.
Dialogue: 0,0:06:21.70,0:06:23.30,[16:9] Main,,0,0,0,,Dù thế đi nữa...
Dialogue: 0,0:06:23.30,0:06:26.32,[16:9] Main,,0,0,0,,Cũng nhờ có cô mà có lẽ bọn tôi\Nvẫn còn giữ được mạng dài đó...
Dialogue: 0,0:06:26.85,0:06:30.29,[16:9] Main,,0,0,0,,Muốn cảm ơn cô lắm, nhưng chắc vài tháng tới\Ntôi sẽ bị chuyển tới Spearhead thôi.
Dialogue: 0,0:06:31.15,0:06:33.84,[16:9] Main,,0,0,0,,Cả cái tên mạnh nhất mà tôi biết nữa...
Dialogue: 0,0:06:33.84,0:06:37.42,[16:9] Main,,0,0,0,,Tới cùng thì bị cử đi làm\Nnhiệm vụ "trinh sát đặc biệt."
Dialogue: 0,0:06:37.42,0:06:40.82,[16:9] Main,,0,0,0,,Chắc cậu ta đi đời thật rồi...
Dialogue: 0,0:06:40.82,0:06:45.27,[16:9] Main,,0,0,0,,Cái tên Tử Thần không đầu...\Nlúc nào cũng toàn dùng kiếm đó.
Dialogue: 0,0:06:48.24,0:06:49.58,[16:9] Main,,0,0,0,,Hỏi thật nhé...
Dialogue: 0,0:06:49.58,0:06:52.90,[16:9] Main,,0,0,0,,Không biết việc tôi chuyển sang đội đó\Nvà việc Legion tấn công...
Dialogue: 0,0:06:52.90,0:06:54.55,[16:9] Main,,0,0,0,,cái nào sẽ tới trước đây nhỉ?
Dialogue: 0,0:06:55.40,0:06:56.59,[16:9] Main,,0,0,0,,Tôi không biết.
Dialogue: 0,0:06:58.06,0:06:58.69,[16:9] Main,,0,0,0,,Tuy nhiên...
Dialogue: 0,0:06:59.14,0:07:02.61,[16:9] Main,,0,0,0,,Việc chuẩn bị đối đầu với cuộc tấn công lớn\Ncủa Legion đã được dự đoán trước...
Dialogue: 0,0:07:02.61,0:07:04.70,[16:9] Main,,0,0,0,,Là chuyện tôi nên làm vào lúc này.
Dialogue: 0,0:07:05.79,0:07:09.36,[16:9] Main,,0,0,0,,Mặc dù tôi đã quyết định sẽ hợp lực với cô...
Dialogue: 0,0:07:09.36,0:07:11.31,[16:9] Main,,0,0,0,,Nhưng dù chuẩn bị\Nthì vẫn chẳng có cửa thắng đâu.
Dialogue: 0,0:07:11.93,0:07:13.58,[16:9] Main,,0,0,0,,Dù vậy cô vẫn làm sao?
Dialogue: 0,0:07:17.82,0:07:18.93,[16:9] Main,,0,0,0,,Dù vậy đi nữa...
Dialogue: 0,0:07:22.05,0:07:23.66,[16:9] Main,,0,0,0,,Được rồi, Cyclops.
Dialogue: 0,0:07:23.66,0:07:27.19,[16:9] Main,,0,0,0,,Đừng quên bản báo cáo\Ncủa nhiệm vụ tuần tra nhé.
Dialogue: 0,0:07:27.19,0:07:28.48,[16:9] Main,,0,0,0,,Đã rõ!
Dialogue: 0,0:07:33.53,0:07:34.81,[16:9] Main,,0,0,0,,Dù vậy đi nữa...
Dialogue: 0,0:07:37.00,0:07:39.92,[16:9] Main,,0,0,0,,{\i1}Họ đã nói tôi phải sống sót...
Dialogue: 0,0:07:42.24,0:07:43.30,[16:9] Main,,0,0,0,,{\i1}Chiến đấu...
Dialogue: 0,0:07:43.89,0:07:45.84,[16:9] Main,,0,0,0,,{\i1}Họ đã tin tưởng tôi sẽ sống sót...
Dialogue: 0,0:07:54.77,0:07:56.12,[16:9] Main,,0,0,0,,{\i1}Những người đã không còn đó...
Dialogue: 0,0:07:56.93,0:07:58.54,[16:9] Main,,0,0,0,,{\i1}Tôi phải đáp lại lời của họ...
Dialogue: 0,0:08:06.60,0:08:07.38,[16:9] Main,,0,0,0,,{\fad(100,0)}Shin.
Dialogue: 0,0:08:28.05,0:08:29.72,[16:9->2.39] Main,,0,0,0,,Anh chỉ đi được tới đây thôi.
Dialogue: 0,0:08:31.02,0:08:33.87,[16:9->2.39] Main,,0,0,0,,Từ đoạn này trở đi...\NEm tự đi được nhỉ?
Dialogue: 0,0:08:34.49,0:08:36.87,[16:9->2.39] Main,,0,0,0,,Có cả những đồng đội đã sát cánh cùng em mà.
Dialogue: 0,0:08:42.10,0:08:44.56,[16:9->2.39] Main,,0,0,0,,Em đã lớn đùng thế này rồi nhỉ...
Dialogue: 0,0:08:45.92,0:08:47.16,[16:9->2.39] Main,,0,0,0,,Thôi...
Dialogue: 0,0:08:47.16,0:08:49.22,[16:9->2.39] Main,,0,0,0,,Đừng để bản thân bị ràng buộc bởi anh nữa.
Dialogue: 0,0:08:50.19,0:08:52.83,[16:9->2.39] Main,,0,0,0,,Chuyện về anh thì em cứ quên đi cũng được.
Dialogue: 0,0:08:55.93,0:08:56.96,[16:9->2.39] Main,,0,0,0,,À...
Dialogue: 0,0:08:57.86,0:08:58.98,[16:9->2.39] Main,,0,0,0,,Mà thôi...
Dialogue: 0,0:08:59.75,0:09:00.61,[16:9->2.39] Main,,0,0,0,,Quả nhiên là...
Dialogue: 0,0:09:00.61,0:09:03.34,[16:9->2.39] Main,,0,0,0,,Anh cũng muốn thi thoảng em sẽ nhớ tới anh.
Dialogue: 0,0:09:04.62,0:09:06.39,[16:9->2.39] Main,,0,0,0,,Em hãy sống thật tự do...
Dialogue: 0,0:09:07.12,0:09:08.71,[16:9->2.39] Main,,0,0,0,,Hãy hạnh phúc...
Dialogue: 0,0:09:10.03,0:09:11.28,[16:9->2.39] Main,,0,0,0,,Rồi nửa chừng ấy...
Dialogue: 0,0:09:12.81,0:09:13.92,[16:9->2.39] Main,,0,0,0,,Đôi lúc nhớ về anh nhé.
Dialogue: 0,0:09:16.67,0:09:17.85,[16:9->2.39] Main,,0,0,0,,Bảo trọng.
Dialogue: 0,0:09:19.25,0:09:20.24,[16:9->2.39] Main,,0,0,0,,Hãy...
Dialogue: 0,0:09:21.29,0:09:22.76,[16:9->2.39] Main,,0,0,0,,Hạnh phúc nhé...
Dialogue: 0,0:09:32.39,0:09:34.14,[16:9->2.39] Main,,0,0,0,,{\fad(0,200)}Anh ơi!
Dialogue: 0,0:10:08.05,0:10:09.92,[16:9] Main,,0,0,0,,Biết rồi mà.
Dialogue: 0,0:10:09.92,0:10:11.76,[16:9] Main,,0,0,0,,Chỉ nói chuyện một chút thôi.
Dialogue: 0,0:10:15.72,0:10:16.99,[16:9] Main,,0,0,0,,Cậu đã tỉnh nhỉ?
Dialogue: 0,0:10:16.99,0:10:18.06,[16:9] Main,,0,0,0,,Xin chào.
Dialogue: 0,0:10:18.92,0:10:22.06,[16:9] Main,,0,0,0,,Trước hết có thể cho tôi biết tên không?
Dialogue: 0,0:10:26.31,0:10:29.53,[16:9] Main,,0,0,0,,Chà, cái đám tướng lĩnh cứ lo quá,
Dialogue: 0,0:10:29.53,0:10:32.03,[16:9] Main,,0,0,0,,nên cứ dùng biện pháp đề phòng sinh hoá\Nđể tránh tình huống xấu...
Dialogue: 0,0:10:32.60,0:10:35.03,[16:9] Main,,0,0,0,,Nhưng mà cái bộ dạng này đúng là thất lễ thật.
Dialogue: 0,0:10:38.51,0:10:40.92,[16:9] Main,,0,0,0,,Tôi tên là Ernst.
Dialogue: 0,0:10:40.92,0:10:42.04,[16:9] Main,,0,0,0,,Còn cậu?
Dialogue: 0,0:10:44.44,0:10:45.79,[16:9] Main,,0,0,0,,Shinei...
Dialogue: 0,0:10:46.41,0:10:47.35,[16:9] Main,,0,0,0,,Nouzen...
Dialogue: 0,0:10:49.54,0:10:52.44,[16:9] Main,,0,0,0,,Hoan nghênh đã tới Liên Bang Giad.
Dialogue: 0,0:10:53.15,0:10:53.98,[16:9] Main,,0,0,0,,Giad...?
Dialogue: 0,0:10:53.98,0:10:56.47,[16:9] Main,,0,0,0,,Ấy chết, phải giải thích đã nhỉ.
Dialogue: 0,0:10:56.47,0:11:00.70,[16:9] Main,,0,0,0,,Chúng tôi đã đánh đổ kẻ tạo ra Legion\Nđể gây chiến là "Đế Quốc" Giad ban đầu...
Dialogue: 0,0:11:00.70,0:11:02.40,[16:9] Main,,0,0,0,,Giờ đổi thành "Liên Bang."
Dialogue: 0,0:11:02.40,0:11:06.65,[16:9] Main,,0,0,0,,Cũng vì lẽ đó mà hiện giờ chúng tôi\Nvẫn đang chiến đấu với Legion còn sót lại.
Dialogue: 0,0:11:08.13,0:11:11.33,[16:9] Main,,0,0,0,,Cậu đã được tìm thấy ở\Nmặt trận phía Tây của đất nước chúng tôi.
Dialogue: 0,0:11:12.03,0:11:13.32,[16:9] Main,,0,0,0,,Cậu đã bị Legion bắt giữ...
Dialogue: 0,0:11:16.96,0:11:18.37,[16:9] Main,,0,0,0,,A, xin lỗi, xin lỗi!
Dialogue: 0,0:11:18.37,0:11:20.87,[16:9] Main,,0,0,0,,Hẳn là cậu lo lắng chuyện đó nhỉ?
Dialogue: 0,0:11:24.83,0:11:26.12,[16:9] Main,,0,0,0,,Vì cậu ngủ mãi,
Dialogue: 0,0:11:26.52,0:11:28.88,[16:9] Main,,0,0,0,,nên tôi mới để tỷ lệ trong suốt là 0%.
Dialogue: 0,0:11:32.38,0:11:38.19,[16:9] Main,,0,0,0,,Do cả hai bên đều chưa hiểu rõ\Ntoàn bộ sự tình chuyện gì đã xảy ra.
Dialogue: 0,0:11:38.19,0:11:40.35,[16:9] Main,,0,0,0,,Để sau cũng được,\Nnhưng cậu nhớ ra được gì đó thì—
Dialogue: 0,0:11:40.35,0:11:41.54,[16:9] Main,,0,0,0,,Thưa ngài!
Dialogue: 0,0:11:41.54,0:11:42.39,[16:9] Main,,0,0,0,,Cũng đến lúc rồi ạ.
Dialogue: 0,0:11:43.70,0:11:44.60,[16:9] Main,,0,0,0,,Đây.
Dialogue: 0,0:11:45.13,0:11:49.01,[16:9] Main,,0,0,0,,Chị gái đáng sợ đằng kia chắc bực lắm rồi,\Nnên giờ tôi sẽ rời đi nhé.
Dialogue: 0,0:11:49.01,0:11:50.48,[16:9] Main,,0,0,0,,Nhưng chỉ riêng việc này tôi phải nói.
Dialogue: 0,0:11:50.90,0:11:56.31,[16:9] Main,,0,0,0,,Các bạn là những vị khách ngoại quốc đầu tiên\Nkể từ khi đất nước này thành lập.
Dialogue: 0,0:11:56.31,0:11:58.91,[16:9] Main,,0,0,0,,Nhưng việc cho các bạn nhập quốc thế nào thì...
Dialogue: 0,0:11:58.91,0:12:01.79,[16:9] Main,,0,0,0,,do quá bận rộn với lũ Legion\Nnên vẫn chưa quyết được.
Dialogue: 0,0:12:01.79,0:12:04.12,[16:9] Main,,0,0,0,,Cứ yên tâm, tôi sẽ không\Nđối xử tệ với các bạn đâu.
Dialogue: 0,0:12:05.23,0:12:06.76,[16:9] Main,,0,0,0,,Hân hạnh gặp mặt...
Dialogue: 0,0:12:06.76,0:12:08.77,[16:9] Main,,0,0,0,,Tôi là Ernst Zimmerman.
Dialogue: 0,0:12:09.34,0:12:13.66,[16:9] Main,,0,0,0,,Hiện là tổng thống lâm thời của\NLiên Bang Cộng Hoà Giad.
Dialogue: 0,0:12:14.99,0:12:16.13,[16:9] Main,,0,0,0,,Kết quả phân tích thế nào?
Dialogue: 0,0:12:16.50,0:12:22.51,[16:9] Main,,0,0,0,,Có thể nói không phải là gián điệp của \NCộng Hoà San Magnolia cũng như của các nước khác.
Dialogue: 0,0:12:22.51,0:12:28.39,[16:9] Main,,0,0,0,,Vậy khả năng là một loại Legion mới,\Nhay một vật chứa vũ khí sinh học thì sao?
Dialogue: 0,0:12:28.39,0:12:32.94,[16:9] Main,,0,0,0,,Kết quả điều tra hiện thời và quét sau vận chuyển\Nđều không có gì bất thường.
Dialogue: 0,0:12:32.94,0:12:34.53,[16:9] Main,,0,0,0,,Còn cái thứ ở cùng họ thì sao?
Dialogue: 0,0:12:34.86,0:12:36.76,[16:9] Main,,0,0,0,,Dù là loại hơi cũ một chút...
Dialogue: 0,0:12:36.76,0:12:38.92,[16:9] Main,,0,0,0,,Nhưng có thể chắc chắn nó là Dinosauria.
Dialogue: 0,0:12:39.52,0:12:42.53,[16:9] Main,,0,0,0,,À, thế còn vật đính vào tai họ là cái gì?
Dialogue: 0,0:12:43.02,0:12:46.04,[16:9] Main,,0,0,0,,Đúng như lời khai của họ, đó là máy liên lạc.
Dialogue: 0,0:12:46.37,0:12:48.73,[16:9] Main,,0,0,0,,Có vẻ nó vốn là\Nnăng lực ngoại cảm của một thị tộc...
Dialogue: 0,0:12:48.73,0:12:51.03,[16:9] Main,,0,0,0,,và đã được cải tiến để sử dụng.
Dialogue: 0,0:12:51.03,0:12:52.17,[16:9] Main,,0,0,0,,Hiện đại thật đấy.
Dialogue: 0,0:12:52.81,0:12:57.68,[16:9] Main,,0,0,0,,Tôi nghĩ rằng loại bỏ chúng luôn\Nthì sẽ an toàn hơn cho Liên Bang đấy.
Dialogue: 0,0:13:04.66,0:13:05.47,[16:9] Main,,0,0,0,,Shin!
Dialogue: 0,0:13:06.31,0:13:08.82,[16:9] Main,,0,0,0,,Cậu ngủ nguyên 3 ngày đấy nhé.
Dialogue: 0,0:13:08.82,0:13:12.62,[16:9] Main,,0,0,0,,Thật đấy, Kurena khóc rống lên khổ lắm đấy nhé.
Dialogue: 0,0:13:12.62,0:13:13.69,[16:9] Main,,0,0,0,,Tớ có khóc đâu!
Dialogue: 0,0:13:15.77,0:13:17.69,[16:9] Main,,0,0,0,,Shin ơi~
Dialogue: 0,0:13:17.69,0:13:20.45,[16:9] Main,,0,0,0,,Biết là giờ thì không được,
Dialogue: 0,0:13:20.45,0:13:22.61,[16:9] Main,,0,0,0,,nhưng khi nào cậu khoẻ lại thì...
Dialogue: 0,0:13:22.61,0:13:24.20,[16:9] Main,,0,0,0,,Xác định trước đi nhé.
Dialogue: 0,0:13:25.70,0:13:28.42,[16:9] Main,,0,0,0,,Xin lỗi, cả bọn đều vậy.
Dialogue: 0,0:13:28.42,0:13:31.71,[16:9] Main,,0,0,0,,Cơ mà, lần tới mà còn làm cái trò đấy\Nthì tôi đấm cậu thật luôn.
Dialogue: 0,0:13:33.89,0:13:35.17,[16:9] Main,,0,0,0,,Thật ra, tôi cũng đâu có định chết—
Dialogue: 0,0:13:35.17,0:13:36.40,[16:9] Main,,0,0,0,,Tôi bực đấy.
Dialogue: 0,0:13:36.40,0:13:41.47,[16:9] Main,,0,0,0,,Dù không định chết, nhưng cậu biết\Nchiến đấu một mình thì chắc chắn sẽ chết mà.
Dialogue: 0,0:13:41.92,0:13:45.11,[16:9] Main,,0,0,0,,Cái đó thì mọi người\Nai chẳng nghĩ qua một lần.
Dialogue: 0,0:13:45.11,0:13:47.29,[16:9] Main,,0,0,0,,Nhưng chính vì vậy càng không thể tha thứ.
Dialogue: 0,0:13:47.29,0:13:50.60,[16:9] Main,,0,0,0,,Vì biết chắc mình sẽ chết,\Nlàm vậy là xấu tính lắm biết không?
Dialogue: 0,0:13:51.11,0:13:52.85,[16:9] Main,,0,0,0,,Đừng có như thế nữa.
Dialogue: 0,0:13:53.49,0:13:55.81,[16:9] Main,,0,0,0,,Tớ lo lắm đấy nhé...
Dialogue: 0,0:14:00.84,0:14:01.91,[16:9] Main,,0,0,0,,Xin lỗi.
Dialogue: 0,0:14:04.90,0:14:07.58,[16:9] Main,,0,0,0,,Nhưng mà, không biết sẽ ra sao đây.
Dialogue: 0,0:14:08.14,0:14:09.56,[16:9] Main,,0,0,0,,Chuyện từ giờ ấy.
Dialogue: 0,0:14:13.04,0:14:14.25,[16:9] Main,,0,0,0,,Chuyện là như vậy đó...
Dialogue: 0,0:14:14.71,0:14:18.17,[16:9] Main,,0,0,0,,Từ hôm nay, các bạn đã trở thành\Nngười dân của Liên Bang rồi nhé.
Dialogue: 0,0:14:21.17,0:14:22.49,[16:9] Main,,0,0,0,,Ơ kìa?
Dialogue: 0,0:14:22.49,0:14:24.81,[16:9] Main,,0,0,0,,Sau gần một tháng mới gặp lại...
Dialogue: 0,0:14:24.81,0:14:28.18,[16:9] Main,,0,0,0,,Câu mở đầu của ông là\N"Chuyện là như vậy đó..." mà được à?
Dialogue: 0,0:14:28.18,0:14:29.36,[16:9] Main,,0,0,0,,Thế à?
Dialogue: 0,0:14:29.36,0:14:30.38,[16:9] Main,,0,0,0,,Được thật không?
Dialogue: 0,0:14:30.38,0:14:34.44,[16:9] Main,,0,0,0,,Cái việc để lũ trẻ con có mục đích bất minh bị\Nnước khác trục xuất thành người dân ấy?
Dialogue: 0,0:14:35.29,0:14:38.45,[16:9] Main,,0,0,0,,Cứ loại bỏ luôn\Nchẳng phải đỡ hoạ về sau hay sao?
Dialogue: 0,0:14:38.45,0:14:40.27,[16:9] Main,,0,0,0,,Cậu muốn bị chúng tôi giết sao?
Dialogue: 0,0:14:41.39,0:14:42.97,[16:9] Main,,0,0,0,,Cứu giúp chúng tôi như vậy...
Dialogue: 0,0:14:42.97,0:14:44.52,[16:9] Main,,0,0,0,,thì các ông đạt được lợi ích gì?
Dialogue: 0,0:14:44.52,0:14:46.15,[16:9] Main,,0,0,0,,Một cái xã hội...
Dialogue: 0,0:14:46.15,0:14:49.73,[16:9] Main,,0,0,0,,chỉ vì không đạt được lợi ích\Nmà vứt bỏ những đứa trẻ ngay trước mắt,
Dialogue: 0,0:14:49.73,0:14:52.16,[16:9] Main,,0,0,0,,xét đến cùng thì cũng chẳng ai đạt được gì.
Dialogue: 0,0:14:52.56,0:14:54.83,[16:9] Main,,0,0,0,,Với lại, chỉ vì không rõ mục đích...
Dialogue: 0,0:14:54.83,0:14:58.79,[16:9] Main,,0,0,0,,mà bắt buộc phải giết chết\Ntrẻ con để có thể sinh tồn...
Dialogue: 0,0:15:00.15,0:15:03.30,[16:9] Main,,0,0,0,,Thì cái nhân loại này cứ nên diệt vong đi thì hơn.
Dialogue: 0,0:15:08.28,0:15:12.75,[16:9] Main,,0,0,0,,Trước hết thì, tôi sẽ thành\Nngười giám hộ của các bạn.
Dialogue: 0,0:15:12.75,0:15:16.23,[16:9] Main,,0,0,0,,Đầu tiên các bạn cứ nghỉ ngơi thật thoải mái,\Nrồi tham quan đất nước này.
Dialogue: 0,0:15:16.23,0:15:19.61,[16:9] Main,,0,0,0,,Sau đó, hãy tự quyết định việc mình muốn làm.
Dialogue: 0,0:15:28.06,0:15:31.49,[16:9] Main,,0,0,0,,{\an8}Về cỗ máy Juggernaut chúng ta thu được đó...
Dialogue: 10,0:15:31.49,0:15:35.61,[16:9] Main,,0,0,0,,tạm thời chưa bàn đến tính năng,\Nnhưng lịch sử chiến đấu thì quả là tuyệt vời.
Dialogue: 0,0:15:35.61,0:15:37.31,[16:9] Main,,0,0,0,,Tôi rất mong muốn được nói chuyện với họ.
Dialogue: 0,0:15:37.31,0:15:39.17,[16:9] Main,,0,0,0,,Ấy, chúng tôi đặt trước rồi nhé.
Dialogue: 0,0:15:39.17,0:15:39.55,[16:9] Main,,0,0,0,,Hả?
Dialogue: 0,0:15:39.55,0:15:41.17,[16:9] Main,,0,0,0,,Đừng hòng bọn tôi nhường nhé.
Dialogue: 0,0:15:41.17,0:15:42.01,[16:9] Main,,0,0,0,,Cái gì?
Dialogue: 0,0:15:42.01,0:15:44.01,[16:9] Main,,0,0,0,,Dữ liệu thực chiến về chiến đấu cơ động cao...
Dialogue: 0,0:15:44.01,0:15:46.12,[16:9] Main,,0,0,0,,cùng với những người từng đối đầu Legion.
Dialogue: 0,0:15:46.12,0:15:48.76,[16:9] Main,,0,0,0,,Họ quá hoàn hảo với vị trí\Nngười vận hành máy thử nghiệm của tôi.
Dialogue: 0,0:15:49.04,0:15:51.64,[16:9] Main,,0,0,0,,Để họ lái Vánagandr chậm chạp\Nquá là lãng phí.
Dialogue: 0,0:15:51.64,0:15:53.14,[16:9] Main,,0,0,0,,Cái gì hả? Đồ nhện nữ.
Dialogue: 0,0:15:53.14,0:15:54.47,[16:9] Main,,0,0,0,,Ý kiến gì? Con bọ cánh cứng?
Dialogue: 0,0:15:54.47,0:15:57.56,[16:9] Main,,0,0,0,,Nếu chỉ muốn nói chuyện thôi thì được.
Dialogue: 0,0:15:57.56,0:15:59.78,[16:9] Main,,0,0,0,,Nhưng để họ thành người vận hành thì không.
Dialogue: 0,0:15:59.78,0:16:02.21,[16:9] Main,,0,0,0,,Như thế thì khác gì lũ Nước Cộng Hoà.
Dialogue: 0,0:16:02.21,0:16:04.61,[16:9] Main,,0,0,0,,Nhưng trong buổi gặp mặt với cố vấn tâm lý,
Dialogue: 0,0:16:04.61,0:16:07.49,[16:9] Main,,0,0,0,,tất cả đều trả lời rằng muốn trở lại chiến trường.
Dialogue: 0,0:16:08.92,0:16:10.20,[16:9] Main,,0,0,0,,Đó là bởi...
Dialogue: 0,0:16:11.11,0:16:14.49,[16:9] Main,,0,0,0,,ngoài chiến trường ra\Nthì họ vẫn chưa biết gì hết.
Dialogue: 0,0:16:14.93,0:16:17.37,[16:9] Main,,0,0,0,,Có làm thì phải có hưởng.
Dialogue: 0,0:16:17.37,0:16:22.00,[16:9] Main,,0,0,0,,Một khi đã rời khỏi cuộc chiến,\Nhọ xứng đáng được hưởng cuộc sống yên bình.
Dialogue: 0,0:16:22.64,0:16:26.01,[16:9] Main,,0,0,0,,Nếu ở tổ quốc, họ không được\Nđối xử như vậy, thì hãy là bây giờ.
Dialogue: 0,0:16:28.02,0:16:31.18,[16:9] Main,,0,0,0,,Tôi muốn chí ít Liên Bang chúng ta\Nphải hành xử đúng đắn.
Dialogue: 0,0:16:31.18,0:16:32.01,[16:9] Main,,0,0,0,,Vì đó chính là...
Dialogue: 0,0:16:33.47,0:16:36.21,[16:9] Main,,0,0,0,,thứ mà con người ta gọi là lý tưởng.
Dialogue: 0,0:17:03.52,0:17:05.92,[16:9] Main,,0,0,0,,Hãy cứu giúp những đồng bào đáng thương!
Dialogue: 0,0:17:05.92,0:17:07.72,[16:9] Main,,0,0,0,,Hãy cứu họ thôi!
Dialogue: 0,0:17:07.72,0:17:10.66,[16:9] Main,,0,0,0,,Những người 86 bọn họ chỉ là nạn nhân!
Dialogue: 0,0:17:10.66,0:17:12.49,[16:9] Main,,0,0,0,,Là nạn nhân!
Dialogue: 0,0:17:12.49,0:17:15.18,[16:9] Main,,0,0,0,,Hãy cứu giúp những đồng bào đáng thương!
Dialogue: 0,0:17:15.18,0:17:17.58,[16:9] Main,,0,0,0,,Mọi người ai cũng đều vui hết.
Dialogue: 0,0:17:17.58,0:17:20.23,[16:9] Main,,0,0,0,,Khi biết đến tin tức các bạn\Nđược chúng tôi bảo hộ.
Dialogue: 0,0:17:20.23,0:17:24.31,[16:9] Main,,0,0,0,,Và vẫn còn những nước khác\Nngoài chúng tôi còn tồn tại...
Dialogue: 0,0:17:24.86,0:17:27.83,[16:9] Main,,0,0,0,,Nhưng khi biết được các bạn\Ntừng bị đối xử như thế nào...
Dialogue: 0,0:17:27.83,0:17:32.32,[16:9] Main,,0,0,0,,Dân chúng đã bắt đầu thề rằng\Nmuốn cứu giúp các bạn đấy.
Dialogue: 0,0:17:36.14,0:17:38.84,[16:9] Main,,0,0,0,,Đây là nhà của tôi đó.
Dialogue: 0,0:17:38.84,0:17:42.62,[16:9] Main,,0,0,0,,Từ hôm nay đây sẽ là\Nngôi nhà để các bạn trở về đó.
Dialogue: 0,0:17:46.04,0:17:46.85,[16:9] Main,,0,0,0,,Xin chào mừng—
Dialogue: 0,0:17:46.85,0:17:49.92,[16:9] Main,,0,0,0,,Mau lên đi! Ta mới đẩy cái bàn mà!
Dialogue: 0,0:17:49.92,0:17:51.61,[16:9] Main,,0,0,0,,Không mau lên thì...
Dialogue: 0,0:17:54.91,0:17:56.48,[16:9] Main,,0,0,0,,Đến rồi đấy à?
Dialogue: 0,0:17:56.48,0:17:59.06,[16:9] Main,,0,0,0,,Hỡi những kẻ đáng thương bị đất nước xua đuổi.
Dialogue: 0,0:18:02.46,0:18:07.44,[16:9] Main,,0,0,0,,Đất nước Giad vĩ đại chúng ta sẽ dùng\Nlòng từ bi và thương hại mà tiếp đãi các ngươi.
Dialogue: 0,0:18:07.44,0:18:10.37,[16:9] Main,,0,0,0,,Đừng có kỳ vọng mấy thứ báo đáp phàm tục,
Dialogue: 0,0:18:10.37,0:18:13.16,[16:9] Main,,0,0,0,,cứ dùng cả tấm lòng mà cảm tạ chúng ta đi.
Dialogue: 0,0:18:14.19,0:18:15.68,[16:9] Main,,0,0,0,,Này mắt đỏ.
Dialogue: 0,0:18:15.68,0:18:17.89,[16:9] Main,,0,0,0,,Sao ngươi lại quay mặt về đằng sau hả?
Dialogue: 0,0:18:17.89,0:18:19.34,[16:9] Main,,0,0,0,,Tưởng em nói với ai khác.
Dialogue: 0,0:18:19.34,0:18:21.77,[16:9] Main,,0,0,0,,Chính ngươi đóng cái cửa đấy vào chứ ai hả?
Dialogue: 0,0:18:21.77,0:18:23.71,[16:9] Main,,0,0,0,,Trêu ngươi trẫm đấy à?
Dialogue: 0,0:18:25.28,0:18:28.17,[16:9] Main,,0,0,0,,Thế mới bảo lũ người Nước Cộng Hoà\Ntoàn một lũ thấp hèn.
Dialogue: 0,0:18:28.17,0:18:29.41,[16:9] Main,,0,0,0,,Con gái ông à?
Dialogue: 0,0:18:29.41,0:18:30.78,[16:9] Main,,0,0,0,,Tuy nói như vậy thì không đúng cho lắm...
Dialogue: 0,0:18:30.78,0:18:32.86,[16:9] Main,,0,0,0,,nhưng ông nên dạy dỗ nó\Ncẩn thận đi thì hơn đấy.
Dialogue: 0,0:18:32.86,0:18:34.25,[16:9] Main,,0,0,0,,À không...
Dialogue: 0,0:18:34.25,0:18:35.87,[16:9] Main,,0,0,0,,Con bé không phải là con tôi—
Dialogue: 0,0:18:35.87,0:18:39.07,[16:9] Main,,0,0,0,,Ai mà là con gái của tên nô bộc hèn kém này hả?
Dialogue: 0,0:18:39.07,0:18:39.75,[16:9] Main,,0,0,0,,Trẫm là—
Dialogue: 0,0:18:39.75,0:18:41.68,[16:9] Main,,0,0,0,,Frederica Rosenfort.
Dialogue: 0,0:18:41.68,0:18:44.93,[16:9] Main,,0,0,0,,Vì có chút sự tình nên tôi đang chăm sóc con bé.
Dialogue: 0,0:18:48.90,0:18:51.53,[16:9] Main,,0,0,0,,Giải thích nhiều thì phiền phức quá.
Dialogue: 0,0:18:51.53,0:18:54.88,[16:9] Main,,0,0,0,,Trên giấy tờ thì con bé là con gái tôi.
Dialogue: 0,0:18:54.88,0:18:59.06,[16:9] Main,,0,0,0,,Nhưng dù sao thì từ giờ\Nmọi người sẽ sống cùng nhau.
Dialogue: 0,0:18:59.06,0:19:00.91,[16:9] Main,,0,0,0,,Tuy con bé hơi không biết điều chút,
Dialogue: 0,0:19:00.91,0:19:04.66,[16:9] Main,,0,0,0,,nhưng nếu mấy đứa cứ coi là em gái\Nmà chơi thân với nó thì tôi vui lắm.
Dialogue: 0,0:19:05.89,0:19:07.29,[16:9] Main,,0,0,0,,Em gái cơ đấy...
Dialogue: 0,0:19:07.29,0:19:12.12,[16:9] Main,,0,0,0,,À! Trên giấy tờ thì mọi người\Ncũng là con nuôi của tôi.
Dialogue: 0,0:19:12.12,0:19:15.30,[16:9] Main,,0,0,0,,Thế nên cứ gọi "cha ơi" cũng được đó.
Dialogue: 0,0:19:21.92,0:19:23.56,[16:9] Main,,0,0,0,,Đùa thôi mà.
Dialogue: 0,0:19:28.50,0:19:31.69,[16:9] Main,,0,0,0,,Ngươi, cổ sao bị thương vậy?
Dialogue: 0,0:19:31.96,0:19:34.44,[16:9] Main,,0,0,0,,Frederica! Dừng lại đi.
Dialogue: 0,0:19:34.44,0:19:36.45,[16:9] Main,,0,0,0,,Tôi đã nói về tình hình của bọn họ rồi mà.
Dialogue: 0,0:19:36.95,0:19:40.45,[16:9] Main,,0,0,0,,Vết thương không muốn bị\Nngười khác chạm tới, cô cũng có kia mà?
Dialogue: 0,0:19:44.56,0:19:47.25,[16:9] Main,,0,0,0,,Và người được phân công\Nchữa lành những vết thương đó...
Dialogue: 0,0:19:47.25,0:19:50.10,[16:9] Main,,0,0,0,,Chính là trẫm, người em gái dễ thương này.
Dialogue: 0,0:19:50.10,0:19:53.92,[16:9] Main,,0,0,0,,Thay thế cho hạnh phúc gia đình, mái ấm\Nvà hạnh phúc mà các ngươi đã đánh mất...
Dialogue: 0,0:19:53.92,0:19:58.37,[16:9] Main,,0,0,0,,Chính là cách nghĩ từ bi quảng đại\Ncủa chính phủ Liên Bang chúng ta đó.
Dialogue: 0,0:19:58.37,0:20:01.10,[16:9] Main,,0,0,0,,Cứ tha hồ chiều chuộng trẫm đi nhé.
Dialogue: 0,0:20:01.34,0:20:02.56,[16:9] Main,,0,0,0,,Lũ anh trai kia!
Dialogue: 0,0:20:05.85,0:20:07.20,[16:9] Main,,0,0,0,,Teresa!
Dialogue: 0,0:20:07.20,0:20:09.31,[16:9] Main,,0,0,0,,Chưa gì bọn họ đã bắt nạt trẫm rồi!
Dialogue: 0,0:20:09.74,0:20:16.03,[16:9] Main,,0,0,0,,Vâng vâng, nhưng nãy giờ từ đầu đến cuối,\Ncô Frederica là người sai mà.
Dialogue: 0,0:20:16.03,0:20:17.71,[16:9] Main,,0,0,0,,Ta có làm sai gì đâu chứ...
Dialogue: 0,0:20:17.71,0:20:19.96,[16:9] Main,,0,0,0,,Tôi là người sẽ chăm sóc cho các vị.
Dialogue: 0,0:20:19.96,0:20:21.92,[16:9] Main,,0,0,0,,Tên tôi là Teresa.
Dialogue: 0,0:20:24.02,0:20:27.16,[16:9] Main,,0,0,0,,Xin chào mừng mọi người đã trở về nhà.
Dialogue: 0,0:20:31.77,0:20:34.80,[16:9] Main,,0,0,0,,Mọi người ai cũng đi ngủ sớm cả, chán chết.
Dialogue: 0,0:20:41.17,0:20:43.41,[16:9] Main,,0,0,0,,Xin lỗi nhé, chắc cậu đang mệt rồi.
Dialogue: 0,0:20:43.92,0:20:45.95,[16:9] Main,,0,0,0,,Tôi có cầm cái này giúp cậu.
Dialogue: 0,0:20:45.95,0:20:47.68,[16:9] Main,,0,0,0,,Có vẻ như nó ở trong buồng máy.
Dialogue: 0,0:20:48.75,0:20:49.90,[16:9] Main,,0,0,0,,Là của cậu phải không?
Dialogue: 0,0:20:54.81,0:20:55.75,[16:9] Main,,0,0,0,,Vâng.
Dialogue: 0,0:20:59.36,0:21:01.68,[16:9] Main,,0,0,0,,Cô vất vả rồi, Teresa.
Dialogue: 0,0:21:01.68,0:21:03.44,[16:9] Main,,0,0,0,,Không đâu thưa ông chủ.
Dialogue: 0,0:21:03.44,0:21:06.23,[16:9] Main,,0,0,0,,Những cô cậu bé tầm tuổi đó phải ăn nhiều,
Dialogue: 0,0:21:06.23,0:21:08.08,[16:9] Main,,0,0,0,,nên nấu cho họ tôi thấy rất có ý nghĩa.
Dialogue: 0,0:21:08.41,0:21:09.80,[16:9] Main,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:21:09.80,0:21:12.29,[16:9] Main,,0,0,0,,Tôi nghĩ cô sẽ phải vất vả nhiều đó.
Dialogue: 0,0:21:12.29,0:21:14.04,[16:9] Main,,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:21:14.04,0:21:18.55,[16:9] Main,,0,0,0,,Phụng sự cho ông chủ là nghĩa vụ của tôi mà.
Dialogue: 0,0:21:19.79,0:21:21.80,[16:9] Main,,0,0,0,,Cô có nghĩ là tôi xấu tính không?
Dialogue: 0,0:21:23.29,0:21:25.91,[16:9] Main,,0,0,0,,Đây là hành động đánh đổi\Nmột cách ngu ngốc chăng?
Dialogue: 0,0:21:26.80,0:21:29.82,[16:9] Main,,0,0,0,,Việc tôi dùng họ để thế chỗ ấy.
Dialogue: 0,0:21:29.82,0:21:33.57,[16:9] Main,,0,0,0,,Không đâu thưa ông chủ,\Nhọ không phải là thế chỗ.
Dialogue: 0,0:21:33.57,0:21:39.44,[16:9] Main,,0,0,0,,Vì bất kỳ ai cũng đều là\Nnhững cá nhân tồn tại riêng biệt.
Dialogue: 0,0:21:39.44,0:21:43.36,[16:9] Main,,0,0,0,,Thế nhưng, con người ta\Nvẫn có những tính toán riêng.
Dialogue: 0,0:21:43.36,0:21:46.10,[16:9] Main,,0,0,0,,Dù có là với hình thức nào đi nữa.
Dialogue: 0,0:21:46.10,0:21:48.33,[16:9] Main,,0,0,0,,Câu nói đó là nhắm đến ai vậy?
Dialogue: 0,0:21:49.06,0:21:50.30,[16:9] Main,,0,0,0,,Thưa Nữ Vương Bệ Hạ.
Dialogue: 0,0:21:58.88,0:21:59.97,[16:9] Main,,0,0,0,,Kiri...
