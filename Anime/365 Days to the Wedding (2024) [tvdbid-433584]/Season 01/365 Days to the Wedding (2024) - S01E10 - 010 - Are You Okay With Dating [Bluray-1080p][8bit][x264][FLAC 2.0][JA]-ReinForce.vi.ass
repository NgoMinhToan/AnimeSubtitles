Comment: 0,0:03:09.97,0:03:14.68,Sign,,0,0,0,,{\an8}"10 - Buổi Hẹn Có Suôn Sẻ Không Đây?"
Dialogue: 0,0:00:00.00,0:00:01.98,Sign,,0,0,0,,"Kinshicho"
Dialogue: 0,0:01:53.32,0:01:57.49,Sign,,0,0,0,,"Chúng Ta Sẽ Kết Hôn Thật Sao?"
Dialogue: 0,0:03:05.96,0:03:09.72,Sign,,0,0,0,,"Hamura"
Dialogue: 0,0:03:09.96,0:03:14.67,sign_generic,text,0,0,0,,{\fnSVN-Georgia\b1\blur6\an7\bord4.5\3c&HEFEEEA&\fade(500,1)\pos(669.588,852.933)}Buổi Hẹn Có Suôn Sẻ Không Đây?
Dialogue: 0,0:03:40.20,0:03:44.19,Sign,,0,0,0,,"Quầy Thông Tin Du Lịch Thành Phố Hamura"
Dialogue: 0,0:03:44.20,0:03:49.17,Sign,,0,0,0,,"Cứ đi theo chúng tôi - Bochi Komori"
Dialogue: 0,0:03:54.13,0:03:58.13,Sign,,0,0,0,,"Đài Nước Cho Ngựa"
Dialogue: 0,0:04:01.13,0:04:06.14,Sign,,0,0,0,,"Giữ Sạch Dòng Sông"
Dialogue: 0,0:08:38.61,0:08:40.02,Sign,,0,0,0,,"Chuông Hạnh Phúc"
Dialogue: 0,0:08:40.03,0:08:44.37,Sign,,0,0,0,,"Đứng đây có thể nhìn thấy Đỉnh Phú Sĩ.\NRung chuông khi cầu nguyện bằng trái tim"
Dialogue: 0,0:09:57.89,0:10:00.64,Sign,,0,0,0,,"Cầu dẫn nước Tamagawa"
Dialogue: 0,0:10:36.30,0:10:39.30,Sign,,0,0,0,,"Phục Hồi Dòng Sông"
Dialogue: 0,0:16:02.90,0:16:07.91,Sign,,0,0,0,,{\an8}"Chúng Ta Sẽ Kết Hôn Thật Sao?"
Dialogue: 0,0:16:07.92,0:16:12.91,Sign,,0,0,0,,{\an8}"Chúng Ta Sẽ Kết Hôn Thật Sao?"
Dialogue: 0,0:18:17.06,0:18:19.38,Sign,,0,0,0,,"Tama, bản đồ Tokyo"
Dialogue: 0,0:20:06.70,0:20:09.36,Sign,,0,0,0,,"Chi nhánh Anchorage"\N"Còn 301 ngày nữa khai trương"
Dialogue: 0,0:21:27.71,0:21:29.38,Sign,,0,0,0,,"Kiềm chế!"
Dialogue: 0,0:00:08.44,0:00:11.73,Default,,0,0,0,,{\i1}Tại sao Oohara phải gọi cho mình chứ?{\i0}
Dialogue: 0,0:00:12.04,0:00:14.99,Default,,0,0,0,,{\i1}Sao cậu ấy phải ngỏ lời như vậy?{\i0}
Dialogue: 0,0:00:15.91,0:00:20.37,Default,,0,0,0,,{\i1}Yêu đương và kết hôn đúng là\Nkhông hiểu nổi và giống như tra tấn.{\i0}
Dialogue: 0,0:00:22.42,0:00:25.91,Default,,0,0,0,,{\i1}Đến lúc phải đoạn tuyệt cảm xúc rồi!{\i0}
Dialogue: 0,0:00:32.36,0:00:33.13,Default,,0,0,0,,Ủa?
Dialogue: 0,0:00:34.38,0:00:37.13,Default,,0,0,0,,Chị Honjoji? Gì vậy?
Dialogue: 0,0:00:42.81,0:00:46.18,Default,,0,0,0,,Oohara, tôi và cậu hẹn hò đi.
Dialogue: 0,0:00:47.59,0:00:48.28,Default,,0,0,0,,Sao?
Dialogue: 0,0:00:52.09,0:00:55.86,Default,,0,0,0,,Cho tôi biết ngày nghỉ tiếp theo\Nlà ngày nào rồi chúng ta hẹn hò.
Dialogue: 0,0:00:55.87,0:00:57.26,Default,,0,0,0,,Ừm...
Dialogue: 0,0:00:57.27,0:00:59.80,Default,,0,0,0,,Chúng ta sẽ hẹn hò! Vậy có được không?
Dialogue: 0,0:01:00.57,0:01:03.44,Default,,0,0,0,,Được... tôi đồng ý...
Dialogue: 0,0:01:07.23,0:01:11.20,Default,,0,0,0,,Rất cảm kích. Đến lúc đó\Ntôi sẽ thông báo địa điểm.
Dialogue: 0,0:01:11.21,0:01:12.16,Default,,0,0,0,,Gặp sau.
Dialogue: 0,0:01:15.02,0:01:17.94,Default,,0,0,0,,À và tôi xin lỗi\Nvì đã không bắt máy khi cậu gọi.
Dialogue: 0,0:04:07.85,0:04:13.53,Default,,0,0,0,,{\i1}Mình đang tuyệt vọng\Nvì chị ấy không bắt máy{\i0}
Dialogue: 0,0:04:13.54,0:04:15.40,Default,,0,0,0,,{\i1}mà giờ bọn mình hẹn hò sao?{\i0}
Dialogue: 0,0:04:16.12,0:04:19.48,Default,,0,0,0,,{\i1}Đây là câu trả lời\Ncho lời tỏ tình của mình à?{\i0}
Dialogue: 0,0:04:20.15,0:04:23.15,Default,,0,0,0,,{\i1}Chị ấy có vẻ kích động đến lạ.{\i0}
Dialogue: 0,0:04:24.10,0:04:27.20,Default,,0,0,0,,{\i1}Trước hết, sao lại chọn chỗ này chứ?{\i0}
Dialogue: 0,0:04:27.21,0:04:28.21,Default,,0,0,0,,{\i1}Không phải đây là...{\i0}
Dialogue: 0,0:04:28.22,0:04:30.36,Default,,0,0,0,,Đó là Đập Lấy Nước Hamura.
Dialogue: 0,0:04:34.38,0:04:35.75,Default,,0,0,0,,Chị Honjoji!
Dialogue: 0,0:04:38.10,0:04:40.17,Default,,0,0,0,,Cậu mang giày da sao?
Dialogue: 0,0:04:40.54,0:04:43.21,Default,,0,0,0,,Tôi có nhắn là\Nnên mặc trang phục phù hợp để đi dạo.
Dialogue: 0,0:04:43.22,0:04:44.04,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:44.42,0:04:47.14,Default,,0,0,0,,Tôi sẽ đi dọc Cầu Dẫn Nước Tamagawa.
Dialogue: 0,0:04:47.15,0:04:49.13,Default,,0,0,0,,Nếu thấy chán thì cậu có thể về.
Dialogue: 0,0:04:49.14,0:04:49.74,Default,,0,0,0,,Thế thôi.
Dialogue: 0,0:04:51.16,0:04:52.05,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:52.33,0:04:55.76,Default,,0,0,0,,{\i1}Không cân nhắc hay ép mình làm\Nđiều gì mình không thích!{\i0}
Dialogue: 0,0:04:55.77,0:04:59.06,Default,,0,0,0,,{\i1}Mình sẽ không lạc lối\Ntrong chuyện tình ngớ ngẩn này nữa!{\i0}
Dialogue: 0,0:04:59.33,0:05:01.67,Default,,0,0,0,,{\i1}Hôm nay mình sẽ là chính mình,\Nkhông hơn không kém!{\i0}
Dialogue: 0,0:05:02.23,0:05:05.43,Default,,0,0,0,,{\i1}Cậu ấy nhìn thấy con người này\Nthay vì con người ở chỗ làm{\i0}
Dialogue: 0,0:05:05.44,0:05:08.61,Default,,0,0,0,,{\i1}thì Oohara sẽ nhận ra\Ncậu ấy đã chọn lầm người.{\i0}
Dialogue: 0,0:05:08.62,0:05:11.69,Default,,0,0,0,,{\i1}Sau đó, mình sẽ trở về\Nvới cuộc sống yên bình!{\i0}
Dialogue: 0,0:05:12.01,0:05:14.03,Default,,0,0,0,,{\i1}Đây là con người thật của mình,\Nphơi bày tất cả.{\i0}
Dialogue: 0,0:05:14.43,0:05:15.95,Default,,0,0,0,,{\i1}Oohara...{\i0}
Dialogue: 0,0:05:16.30,0:05:18.55,Default,,0,0,0,,{\i1}mong cậu sẽ hoàn toàn cảm thấy thất vọng!{\i0}
Dialogue: 0,0:05:21.90,0:05:24.23,Default,,0,0,0,,Anh em Tamagawa kìa!
Dialogue: 0,0:05:25.23,0:05:27.36,Default,,0,0,0,,{\i1}Chuyện gì thế này?{\i0}
Dialogue: 0,0:05:27.37,0:05:30.70,Default,,0,0,0,,{\i1}Hôm qua chị Honjoji có vẻ giận dữ.{\i0}
Dialogue: 0,0:05:30.71,0:05:34.96,Default,,0,0,0,,{\i1}Nhưng chị ấy nói đây là buổi hẹn hò.{\i0}
Dialogue: 0,0:05:35.50,0:05:38.22,Default,,0,0,0,,{\i1}Nhưng không khí có hơi lạ...{\i0}
Dialogue: 0,0:05:39.95,0:05:41.79,Default,,0,0,0,,{\i1}Cầu dẫn nước Tamagawa,{\i0}
Dialogue: 0,0:05:41.80,0:05:44.97,Default,,0,0,0,,{\i1}do anh em Tamagawa khai quật,{\i0}
Dialogue: 0,0:05:44.98,0:05:47.96,Default,,0,0,0,,{\i1}cống dẫn nước trải dài\Ntừ Hamura đến Yotsuya.{\i0}
Dialogue: 0,0:05:48.60,0:05:53.46,Default,,0,0,0,,Chị Honjoji này. Sao chúng ta đi tham quan\NCầu dẫn nước Tamagawa thế?
Dialogue: 0,0:05:53.47,0:05:56.72,Default,,0,0,0,,Vì nó xuất hiện trên Bochi Komori.
Dialogue: 0,0:05:56.73,0:05:59.43,Default,,0,0,0,,Bochi Komori đây.
Dialogue: 0,0:05:59.44,0:06:04.44,Default,,0,0,0,,Hôm nay, chúng tôi đang đứng\Nở đầu Cầu Tamagawa, Đường dẫn nước Hamura.
Dialogue: 0,0:06:04.45,0:06:08.27,Default,,0,0,0,,Anh Komori, thật không ngờ\Nta vẫn đang ở Tokyo.
Dialogue: 0,0:06:08.28,0:06:10.26,Default,,0,0,0,,Thật vậy.
Dialogue: 0,0:06:10.27,0:06:16.54,Default,,0,0,0,,Tuyệt quá. Nước từ con đập\Nđang chảy qua Cầu Tamagawa.
Dialogue: 0,0:06:17.18,0:06:17.92,Default,,0,0,0,,Ồ!
Dialogue: 0,0:06:18.45,0:06:20.53,Default,,0,0,0,,Giờ thì chủ đề hôm nay là gì?
Dialogue: 0,0:06:20.54,0:06:25.17,Default,,0,0,0,,Để xem... Thời Edo, Cầu Tamagawa\Ndẫn nước cho Tokyo như thế nào?
Dialogue: 0,0:06:26.11,0:06:30.99,Default,,0,0,0,,Có ai kiến thức cấp hai này không?
Dialogue: 0,0:06:31.00,0:06:37.24,Default,,0,0,0,,Cầu Tamagawa được xây dựng vào năm 1653\Nđể dẫn nước vào kinh đô.
Dialogue: 0,0:06:37.25,0:06:40.55,Default,,0,0,0,,Hiện tại nơi đây được xem\Nlà địa danh lịch sử.
Dialogue: 0,0:06:40.56,0:06:44.92,Default,,0,0,0,,Và nghe này, chiếc cầu tiếp tục dẫn nước\Nđến ngày hôm nay.
Dialogue: 0,0:06:44.93,0:06:47.68,Default,,0,0,0,,Tôi là fan của chương trình
Dialogue: 0,0:06:47.69,0:06:51.14,Default,,0,0,0,,nên ngày nghỉ thường đến thăm\Ncác địa điểm được nhắc đến.
Dialogue: 0,0:06:51.15,0:06:55.30,Default,,0,0,0,,Vậy sao? Tôi cũng xem tập đó.
Dialogue: 0,0:06:55.31,0:07:00.30,Default,,0,0,0,,Vậy sao? Tôi nhớ hồi ở Aso mình từng hỏi\Ncậu có phải fan chương trình đó hay không.
Dialogue: 0,0:07:00.99,0:07:04.11,Default,,0,0,0,,Hồi đi học, tôi thường ghé qua\NCầu dẫn nước Tamagawa
Dialogue: 0,0:07:04.65,0:07:06.55,Default,,0,0,0,,vì hồi đó tôi sống ở Hachioji...
Dialogue: 0,0:07:07.52,0:07:10.72,Default,,0,0,0,,Thậm chí tôi từng đi dọc\Nbờ đê của con sông gần đây.
Dialogue: 0,0:07:10.73,0:07:12.04,Default,,0,0,0,,Tôi háo hức muốn đi lại.
Dialogue: 0,0:07:12.85,0:07:14.81,Default,,0,0,0,,{\i1}Thấy chưa, Oohara!{\i0}
Dialogue: 0,0:07:14.82,0:07:17.36,Default,,0,0,0,,{\i1}Đây là ngày nghỉ cực kỳ buồn chán,\Nđến tôi còn phải công nhận!{\i0}
Dialogue: 0,0:07:17.37,0:07:18.88,Default,,0,0,0,,Hay thật đấy.
Dialogue: 0,0:07:19.24,0:07:22.51,Default,,0,0,0,,Tôi chưa từng tự mình\Nđi xem các địa điểm trong chương trình.
Dialogue: 0,0:07:24.76,0:07:28.29,Default,,0,0,0,,{\i1}Cậu ấy có xem tập tuần trước không?{\i0}
Dialogue: 0,0:07:28.64,0:07:29.92,Default,,0,0,0,,{\i1}Tập về Hakone ấy?{\i0}
Dialogue: 0,0:07:32.90,0:07:35.22,Default,,0,0,0,,{\i1}Không được, không được lung lạc.{\i0}
Dialogue: 0,0:07:35.23,0:07:37.19,Default,,0,0,0,,{\i1}Cứ là chính mình... cứ là chính mình...{\i0}
Dialogue: 0,0:07:37.97,0:07:39.68,Default,,0,0,0,,{\i1}Chuyện lúc nãy là sao nhỉ?{\i0}
Dialogue: 0,0:07:45.51,0:07:49.63,Default,,0,0,0,,{\i1}Nước này được dẫn qua kênh.{\i0}
Dialogue: 0,0:07:52.41,0:07:55.11,Default,,0,0,0,,{\i1}Ôi, Bờ Đê Tachikawa.{\i0}
Dialogue: 0,0:07:55.12,0:07:58.63,Default,,0,0,0,,{\i1}Từ đây, Cầu Aqueduct dẫn nước qua hai vực{\i0}
Dialogue: 0,0:07:58.64,0:08:01.62,Default,,0,0,0,,{\i1}đến tận đồng bằng Musashino.{\i0}
Dialogue: 0,0:08:01.63,0:08:03.45,Default,,0,0,0,,{\i1}Đúng là kỳ công xây dựng!{\i0}
Dialogue: 0,0:08:16.22,0:08:17.35,Default,,0,0,0,,{\i1}Tốt lắm.{\i0}
Dialogue: 0,0:08:17.64,0:08:19.65,Default,,0,0,0,,{\i1}Cậu ấy có vẻ chán, đúng như mình dự đoán!{\i0}
Dialogue: 0,0:08:19.66,0:08:21.04,Default,,0,0,0,,{\i1}Giờ thì về nhà đi!{\i0}
Dialogue: 0,0:08:27.37,0:08:30.86,Default,,0,0,0,,{\i1}Đây là... chị Honjoji lúc bình thường.{\i0}
Dialogue: 0,0:08:50.88,0:08:52.44,Default,,0,0,0,,Ừm, chị... Honjoji...
Dialogue: 0,0:09:09.69,0:09:11.26,Default,,0,0,0,,Chị Honjoji... này...
Dialogue: 0,0:09:11.27,0:09:13.18,Default,,0,0,0,,Đến lúc ăn trưa...
Dialogue: 0,0:10:13.78,0:10:15.35,Default,,0,0,0,,{\i1}Điểm Quan Sát Kodaira.{\i0}
Dialogue: 0,0:10:15.79,0:10:18.70,Default,,0,0,0,,{\i1}Đây là nơi nước sông đi vào ống{\i0}
Dialogue: 0,0:10:19.05,0:10:21.62,Default,,0,0,0,,{\i1}đến Khu Lọc Nước Higashimurayama.{\i0}
Dialogue: 0,0:10:22.05,0:10:24.26,Default,,0,0,0,,{\i1}Từ điểm này thì hết thấy nước tự nhiên.{\i0}
Dialogue: 0,0:10:26.68,0:10:27.87,Default,,0,0,0,,{\i1}Có một cây cầu nhỏ.{\i0}
Dialogue: 0,0:10:28.68,0:10:31.84,Default,,0,0,0,,{\i1}Trèo xuống từ đây thì có thể\Nđến rìa Cầu dẫn nước.{\i0}
Dialogue: 0,0:10:31.85,0:10:32.84,Default,,0,0,0,,{\i1}Mình háo hức quá!{\i0}
Dialogue: 0,0:10:33.87,0:10:36.29,Default,,0,0,0,,{\i1}Phần còn lại của dòng sông được cải tạo{\i0}
Dialogue: 0,0:10:36.30,0:10:39.30,Default,,0,0,0,,{\i1}trong dự án phục hồi dòng sông.{\i0}
Dialogue: 0,0:10:42.30,0:10:47.56,Default,,0,0,0,,{\i1}Nước này từng được dùng\Nđể sinh hoạt ở thời Edo.{\i0}
Dialogue: 0,0:10:48.13,0:10:53.94,Default,,0,0,0,,{\i1}Dẫn nước qua đồng bằng cằn cỗi\Nđến chỗ con người,{\i0}
Dialogue: 0,0:10:54.64,0:10:56.89,Default,,0,0,0,,{\i1}nhờ vậy mà tạo ra địa hình hoàn toàn mới.{\i0}
Dialogue: 0,0:10:57.48,0:11:00.32,Default,,0,0,0,,{\i1}Chỉ cần cầu dẫn nước\Nlà đủ tạo nên thế giới.{\i0}
Dialogue: 0,0:11:35.91,0:11:37.96,Default,,0,0,0,,Tuyệt vời làm sao...
Dialogue: 0,0:11:37.97,0:11:39.51,Default,,0,0,0,,Thật vậy.
Dialogue: 0,0:11:42.45,0:11:44.66,Default,,0,0,0,,Khoan, cậu vẫn ở đây sao?
Dialogue: 0,0:11:44.67,0:11:46.22,Default,,0,0,0,,Xin lỗi...
Dialogue: 0,0:11:46.23,0:11:51.14,Default,,0,0,0,,Tôi vô thức trả lời\Nkhi tìm hiểu về cầu dẫn nước.
Dialogue: 0,0:11:51.15,0:11:55.05,Default,,0,0,0,,{\i1}Mình lạc vào thế giới riêng.{\i0}
Dialogue: 0,0:11:55.06,0:11:58.93,Default,,0,0,0,,{\i1}Không thể nào? Cậu ấy nhìn thấy hết\Nkhúc mình lạc vào thế giới thần tiên ư?{\i0}
Dialogue: 0,0:11:58.94,0:12:02.03,Default,,0,0,0,,{\i1}Được rồi, mình muốn\Ncho cậu ấy thấy con người thật{\i0}
Dialogue: 0,0:12:02.36,0:12:04.59,Default,,0,0,0,,{\i1}nhưng thế thì hơi thật quá.{\i0}
Dialogue: 0,0:12:05.00,0:12:07.43,Default,,0,0,0,,Chắc cậu thấy chán lắm.
Dialogue: 0,0:12:07.44,0:12:09.81,Default,,0,0,0,,Không cần ép mình đi theo đâu!
Dialogue: 0,0:12:09.82,0:12:12.55,Default,,0,0,0,,Thật ra tôi đang thấy rất vui.
Dialogue: 0,0:12:13.65,0:12:17.85,Default,,0,0,0,,Tôi chưa từng thấy\Nchị Honjoji vui đến thế.
Dialogue: 0,0:12:18.23,0:12:22.34,Default,,0,0,0,,Có vẻ chị rất yêu thích bản đồ.
Dialogue: 0,0:12:24.34,0:12:27.37,Default,,0,0,0,,Đúng hơn là tôi có cản trở\Nchị tận hưởng niềm vui không?
Dialogue: 0,0:12:27.38,0:12:29.56,Default,,0,0,0,,Hả? Không hề!
Dialogue: 0,0:12:31.35,0:12:34.02,Default,,0,0,0,,{\i1}Không thể có chuyện thế này.{\i0}
Dialogue: 0,0:12:34.03,0:12:36.33,Default,,0,0,0,,{\i1}Chuyện này lẽ ra đâu có gì vui.{\i0}
Dialogue: 0,0:12:36.34,0:12:38.73,Default,,0,0,0,,{\i1}Chỉ là một ngày vô tri của mình.{\i0}
Dialogue: 0,0:12:39.69,0:12:41.67,Default,,0,0,0,,{\i1}Cậu ấy nói thế thôi.{\i0}
Dialogue: 0,0:12:42.31,0:12:45.19,Default,,0,0,0,,{\i1}Oohara có phải là người không?{\i0}
Dialogue: 0,0:12:46.15,0:12:49.16,Default,,0,0,0,,{\i1}Hay cậu là ma vậy?{\i0}
Dialogue: 0,0:12:52.19,0:12:54.42,Default,,0,0,0,,Oohara là gì thế?
Dialogue: 0,0:12:54.43,0:12:55.12,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:55.45,0:12:58.85,Default,,0,0,0,,Cậu thích thế này\Nthì không bình thường chút nào.
Dialogue: 0,0:12:58.86,0:13:02.49,Default,,0,0,0,,Ta chỉ đi ngắm\Ncầu dẫn nước và mấy cái vực.
Dialogue: 0,0:13:02.50,0:13:05.36,Default,,0,0,0,,Đây là việc mà tôi thấy vui.
Dialogue: 0,0:13:05.37,0:13:07.01,Default,,0,0,0,,A... ừm...
Dialogue: 0,0:13:07.37,0:13:11.94,Default,,0,0,0,,Tôi không hiểu nổi\Nsao tôi tiếp tục ở bên cậu.
Dialogue: 0,0:13:13.01,0:13:14.20,Default,,0,0,0,,Chính vì vậy...
Dialogue: 0,0:13:19.23,0:13:21.77,Default,,0,0,0,,đây sẽ là lần cuối ta gặp nhau.
Dialogue: 0,0:13:24.25,0:13:25.26,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:26.20,0:13:28.83,Default,,0,0,0,,Tôi sẽ xung phong chuyển đến Alaska.
Dialogue: 0,0:13:29.39,0:13:31.52,Default,,0,0,0,,Kế hoạch hủy bỏ.
Dialogue: 0,0:13:31.53,0:13:33.78,Default,,0,0,0,,Đó là điều tôi muốn nói với cậu hôm nay.
Dialogue: 0,0:13:34.58,0:13:38.49,Default,,0,0,0,,Tôi sợ hãi con người tôi khi ở bên cậu.
Dialogue: 0,0:13:42.18,0:13:43.72,Default,,0,0,0,,Ra thế...
Dialogue: 0,0:13:45.41,0:13:47.42,Default,,0,0,0,,Vậy... kết thúc rồi.
Dialogue: 0,0:13:48.02,0:13:49.17,Default,,0,0,0,,Phải.
Dialogue: 0,0:14:02.18,0:14:04.18,Default,,0,0,0,,{\i1}Tại sao... mình...{\i0}
Dialogue: 0,0:14:05.38,0:14:07.11,Default,,0,0,0,,{\i1}lại muốn bật khóc?{\i0}
Dialogue: 0,0:14:09.48,0:14:11.05,Default,,0,0,0,,{\i1}Chuyện gì thế này?{\i0}
Dialogue: 0,0:14:12.60,0:14:16.94,Default,,0,0,0,,{\i1}Mình sẽ dập tắt cảm xúc... như bao lần{\i0}
Dialogue: 0,0:14:17.34,0:14:21.34,Default,,0,0,0,,{\i1}vì mình không muốn thất vọng...\Nhay bị thất vọng...{\i0}
Dialogue: 0,0:14:21.82,0:14:23.19,Default,,0,0,0,,{\i1}Vì vậy mình dập tắt nó...{\i0}
Dialogue: 0,0:14:24.44,0:14:26.39,Default,,0,0,0,,{\i1}Làm thế có đúng không?{\i0}
Dialogue: 0,0:14:27.96,0:14:30.62,Default,,0,0,0,,{\i1}Không. Không hề!{\i0}
Dialogue: 0,0:14:30.95,0:14:35.90,Default,,0,0,0,,{\i1}Sự thật là... mình...{\i0}
Dialogue: 0,0:14:37.02,0:14:39.00,Default,,0,0,0,,{\i1}Mình muốn ở bên Oohara!{\i0}
Dialogue: 0,0:14:40.18,0:14:42.38,Default,,0,0,0,,{\i1}Mình có nên đi không?{\i0}
Dialogue: 0,0:14:42.81,0:14:47.40,Default,,0,0,0,,{\i1}Lúc nào cũng vậy...\Nmình cứ chấp nhận, không chống trả...{\i0}
Dialogue: 0,0:14:47.88,0:14:52.71,Default,,0,0,0,,{\i1}Mình định hèn như vậy đến bao giờ?\NThế này thì không được gì cả.{\i0}
Dialogue: 0,0:14:53.79,0:14:55.26,Default,,0,0,0,,{\i1}Đừng bỏ đi!{\i0}
Dialogue: 0,0:14:55.95,0:14:58.87,Default,,0,0,0,,{\i1}Đừng... bỏ đi!{\i0}
Dialogue: 0,0:15:00.69,0:15:03.44,Default,,0,0,0,,{\i1}Mình không thể đánh mất\Nngười quan trọng như vậy với mình.{\i0}
Dialogue: 0,0:16:23.49,0:16:35.18,Default,,0,0,0,,{\i1}Cái gì thế này?{\i0}
Dialogue: 0,0:16:52.72,0:16:54.07,Default,,0,0,0,,Ừm...
Dialogue: 0,0:16:55.45,0:16:58.10,Default,,0,0,0,,Cậu... đợi một chút.
Dialogue: 0,0:17:10.70,0:17:13.99,Default,,0,0,0,,Oohara, ta đánh giá lại\Ntình huống khó xử này nhé?
Dialogue: 0,0:17:14.00,0:17:15.71,Default,,0,0,0,,Đánh giá lại?
Dialogue: 0,0:17:15.72,0:17:19.37,Default,,0,0,0,,Đúng vậy.\NCó nhiều việc ngoài dự đoán đã diễn ra.
Dialogue: 0,0:17:19.38,0:17:21.51,Default,,0,0,0,,Thật lòng tôi không khó chịu.
Dialogue: 0,0:17:21.85,0:17:24.56,Default,,0,0,0,,Lúc đầu, ta còn không phải bạn bè.
Dialogue: 0,0:17:24.57,0:17:28.90,Default,,0,0,0,,Chúng ta là đồng nghiệp, đàn chị, đàn em\Nvà đồng phạm trong vụ kết hôn giả.
Dialogue: 0,0:17:29.41,0:17:30.52,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:17:31.30,0:17:34.21,Default,,0,0,0,,Đồng nghiệp không tự tiện\Nxông vào nhà đối phương
Dialogue: 0,0:17:34.22,0:17:37.70,Default,,0,0,0,,hay đi dạo dưới trời đêm ở Aso,\Nđúng không nào?
Dialogue: 0,0:17:37.71,0:17:39.47,Default,,0,0,0,,Có thể nói vậy.
Dialogue: 0,0:17:39.48,0:17:42.94,Default,,0,0,0,,Vậy cụ thể thì...\Nsao chúng ta lại làm mấy chuyện như thế?
Dialogue: 0,0:17:43.47,0:17:45.57,Default,,0,0,0,,Cậu có biết câu trả lời không?
Dialogue: 0,0:17:45.58,0:17:49.52,Default,,0,0,0,,Giờ chị nhắc tôi mới thấy,\Nsao chúng ta làm mấy việc đó nhỉ?
Dialogue: 0,0:17:49.53,0:17:51.45,Default,,0,0,0,,Tôi cũng không hiểu.
Dialogue: 0,0:17:51.86,0:17:56.91,Default,,0,0,0,,Vì vậy tôi thiết kế buổi hẹn này\Nvới ý định đơn giản hóa mọi thứ.
Dialogue: 0,0:17:57.56,0:18:00.89,Default,,0,0,0,,Vậy mà buổi hẹn đơn sơ, tẻ nhạt này\Nlại thú vị với cậu
Dialogue: 0,0:18:00.90,0:18:04.34,Default,,0,0,0,,và khi tôi định kết thúc tất cả,\Nchúng ta nắm tay...
Dialogue: 0,0:18:04.35,0:18:05.80,Default,,0,0,0,,nhìn vào mắt nhau...
Dialogue: 0,0:18:08.06,0:18:11.55,Default,,0,0,0,,Sao kết quả lại là ta hôn nhau thế?
Dialogue: 0,0:18:12.51,0:18:16.67,Default,,0,0,0,,Tôi cũng không chắc nữa.
Dialogue: 0,0:18:17.06,0:18:19.38,Default,,0,0,0,,Cậu cầm bản đồ này đi.
Dialogue: 0,0:18:19.39,0:18:22.67,Default,,0,0,0,,Xin lỗi nhưng cậu đi một mình nhé.
Dialogue: 0,0:18:22.68,0:18:23.28,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:23.29,0:18:25.61,Default,,0,0,0,,Tôi cần về nhà suy nghĩ.
Dialogue: 0,0:18:29.16,0:18:32.55,Default,,0,0,0,,À, tôi không khó chịu gì đâu.\NThật sự là không.
Dialogue: 0,0:18:35.58,0:18:38.20,Default,,0,0,0,,{\i1}Chị Honjoji hay thật đấy.{\i0}
Dialogue: 0,0:18:38.49,0:18:40.87,Default,,0,0,0,,{\i1}Sao chị ấy bình tĩnh như vậy nhỉ?{\i0}
Dialogue: 0,0:18:46.10,0:18:49.00,Default,,0,0,0,,{\i1}Bọn mình đã hôn nhau!{\i0}
Dialogue: 0,0:19:46.59,0:19:51.84,Default,,0,0,0,,{\i1}Hôn... Bọn mình đã hôn!{\i0}
Dialogue: 0,0:19:55.25,0:19:59.35,Default,,0,0,0,,A lô? Oohara và Honjoji sao?
Dialogue: 0,0:20:02.31,0:20:04.35,Default,,0,0,0,,Vâng, ra thế.
Dialogue: 0,0:20:05.64,0:20:06.69,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:20:14.81,0:20:15.68,Default,,0,0,0,,Chào...
Dialogue: 0,0:20:24.55,0:20:27.88,Default,,0,0,0,,Chào... buổi sáng.
Dialogue: 0,0:20:28.59,0:20:29.99,Default,,0,0,0,,Ừm, mời chị.
Dialogue: 0,0:20:30.00,0:20:31.25,Default,,0,0,0,,Không, cậu vào trước đi...
Dialogue: 0,0:20:31.93,0:20:33.54,Default,,0,0,0,,Ừm...
Dialogue: 0,0:20:33.55,0:20:34.38,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:20:36.36,0:20:37.75,Default,,0,0,0,,Chào buổi sáng!
Dialogue: 0,0:20:37.76,0:20:42.26,Default,,0,0,0,,Hai anh chị vẫn thân thiết nhỉ.\NTôi có làm gián đoạn gì không?
Dialogue: 0,0:20:44.18,0:20:46.44,Default,,0,0,0,,Không đâu, mời cậu vào trước.
Dialogue: 0,0:20:47.01,0:20:48.71,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:20:48.72,0:20:50.89,Default,,0,0,0,,Ôi trời, buồn ngủ quá.
Dialogue: 0,0:20:51.21,0:20:53.28,Default,,0,0,0,,Có tin gì về vé đặt này không?
Dialogue: 0,0:20:53.29,0:20:54.45,Default,,0,0,0,,Vẫn đang xử lý.
Dialogue: 0,0:20:54.46,0:20:56.09,Default,,0,0,0,,Được rồi, xong năm hồ sơ.
Dialogue: 0,0:20:56.10,0:20:58.65,Default,,0,0,0,,Nhờ chị Honjoji xử lý cái này.
Dialogue: 0,0:20:58.66,0:20:59.23,Default,,0,0,0,,Được.
Dialogue: 0,0:21:00.02,0:21:00.98,Default,,0,0,0,,Oohara.
Dialogue: 0,0:21:01.32,0:21:03.27,Default,,0,0,0,,Nhờ cậu kiểm tra bên phía khách sạn.
Dialogue: 0,0:21:03.28,0:21:04.50,Default,,0,0,0,,Vâng!
Dialogue: 0,0:21:08.15,0:21:09.91,Default,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:21:09.92,0:21:11.37,Default,,0,0,0,,Không có chi.
Dialogue: 0,0:21:11.82,0:21:14.93,Default,,0,0,0,,Đây là Bellagio ở Las Vegas sao?
Dialogue: 0,0:21:14.94,0:21:17.00,Default,,0,0,0,,Phải và ừm...
Dialogue: 0,0:21:17.32,0:21:20.11,Default,,0,0,0,,Mục này là Bellagio\Ncòn mục này là Caesars.
Dialogue: 0,0:21:20.12,0:21:21.62,Default,,0,0,0,,Tôi nhớ rồi.
Dialogue: 0,0:21:21.63,0:21:25.88,Default,,0,0,0,,{\i1}Không ổn rồi. Mình cứ nghĩ về hôm qua!{\i0}
Dialogue: 0,0:21:26.27,0:21:27.70,Default,,0,0,0,,{\i1}Bình tĩnh lại. Bình tĩnh.{\i0}
Dialogue: 0,0:21:27.71,0:21:29.38,Default,,0,0,0,,{\i1}Đang ở chỗ làm đấy!{\i0}
Dialogue: 0,0:21:29.82,0:21:34.64,Default,,0,0,0,,{\i1}Sao mà mình bình tĩnh được?\NNgười mình hôn đang ở trước mặt!{\i0}
Dialogue: 0,0:21:34.94,0:21:38.00,Default,,0,0,0,,{\i1}Mình quá tuổi chộn rộn\Nvì việc vụn vặt đó rồi!{\i0}
Dialogue: 0,0:21:38.01,0:21:41.27,Default,,0,0,0,,{\i1}Phải rồi, mình đâu phải\Ncậu nhóc 12 tuổi nữa!{\i0}
Dialogue: 0,0:21:41.66,0:21:46.92,Default,,0,0,0,,{\i1}Thôi đi! Bọn mình mà làm chuyện lạ thì\Nsẽ khiến người khác nghi ngờ là có chuyện!{\i0}
Dialogue: 0,0:21:48.52,0:21:51.82,Default,,0,0,0,,{\i1}Khoan! Bọn mình cũng đâu kết hôn thật.{\i0}
Dialogue: 0,0:21:52.42,0:21:55.08,Default,,0,0,0,,Honjoji. Oohara. Gặp tôi chút nhé?
Dialogue: 0,0:21:55.09,0:21:55.90,Default,,0,0,0,,Vâng.
Dialogue: 0,0:21:58.91,0:22:02.52,Default,,0,0,0,,Tôi có chuyện quan trọng cần thảo luận.
